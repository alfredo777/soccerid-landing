  /* ================================================
     CSS VARIABLES — EMBED VIDEO THEME
     ================================================ */
  :root {
    --embed-video-accent: #a96bef;
    --embed-video-accent-glow: rgba(169, 107, 239, 0.30);
    --embed-video-accent-soft: rgba(169, 107, 239, 0.18);
    --embed-video-accent-border: rgba(169, 107, 239, 0.35);
    --embed-video-accent-border-hover: rgba(169, 107, 239, 0.65);
    --embed-video-bg-dark: #0a0a0a;
    --embed-video-bg-card: #111111;
    --embed-video-bg-overlay: rgba(0, 0, 0, 0.88);
    --embed-video-text-primary: #ffffff;
    --embed-video-text-muted: #888888;
    --embed-video-text-dark: #0a0a0a;
    --embed-video-danger: #e53935;
    --embed-video-radius-lg: 14px;
    --embed-video-radius-md: 10px;
    --embed-video-radius-sm: 20px;
    --embed-video-shadow-mini:
      0 8px 32px var(--embed-video-accent-soft),
      0 2px 12px rgba(0, 0, 0, 0.7);
    --embed-video-shadow-mini-hover:
      0 12px 40px var(--embed-video-accent-glow),
      0 4px 16px rgba(0, 0, 0, 0.8);
    --embed-video-shadow-lightbox:
      0 0 60px var(--embed-video-accent-soft),
      0 0 120px rgba(0, 0, 0, 0.6);
    --embed-video-transition-smooth: 0.3s cubic-bezier(.4, 0, .2, 1);
    --embed-video-transition-fade: 0.4s ease;
  }

  /* ===== RESET & BASE ===== */
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }


  /* ================================================
     EMBED VIDEO — MINI PLAYER FLOTANTE
     ================================================ */
  .embed-video-float {
    position: fixed;
    bottom: 200px;
    right: 24px;
    width: 280px;
    height: 158px;
    z-index: 9998;
    border-radius: var(--embed-video-radius-lg);
    overflow: hidden;
    box-shadow: var(--embed-video-shadow-mini);
    cursor: pointer;
    transition:
      transform var(--embed-video-transition-smooth),
      box-shadow 0.3s ease,
      opacity var(--embed-video-transition-fade);
    opacity: 0;
    transform: translateY(30px) scale(0.95);
    border: 2px solid var(--embed-video-accent-border);
    background: var(--embed-video-bg-card);
  }

  .embed-video-float.embed-video-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .embed-video-float:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: var(--embed-video-shadow-mini-hover);
    border-color: var(--embed-video-accent-border-hover);
  }

  .embed-video-float iframe {
    width: 100%;
    height: 100%;
    border: none;
    pointer-events: none;
    display: block;
  }

  /* ===== EMBED VIDEO — Play Overlay ===== */
  .embed-video-play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.25);
    transition: background 0.3s ease;
  }

  .embed-video-float:hover .embed-video-play-overlay {
    background: rgba(0, 0, 0, 0.10);
  }

  .embed-video-play-overlay svg {
    width: 48px;
    height: 48px;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
    transition: transform 0.3s ease;
  }

  .embed-video-float:hover .embed-video-play-overlay svg {
    transform: scale(1.15);
  }

  /* ===== EMBED VIDEO — Badge ===== */
  .embed-video-badge {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: var(--embed-video-accent);
    color: var(--embed-video-text-dark);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--embed-video-radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    pointer-events: none;
  }

  /* ===== EMBED VIDEO — Close Mini Button ===== */
  .embed-video-close-mini {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.7);
    color: var(--embed-video-text-primary);
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    transition: background 0.2s, transform 0.2s;
    line-height: 1;
  }

  .embed-video-close-mini:hover {
    background: var(--embed-video-danger);
    transform: scale(1.1);
  }

  /* ================================================
     EMBED VIDEO — LIGHTBOX (FULLSCREEN)
     ================================================ */
  .embed-video-lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0);
    backdrop-filter: blur(0px);
    visibility: hidden;
    transition:
      background var(--embed-video-transition-fade),
      backdrop-filter var(--embed-video-transition-fade),
      visibility 0s 0.4s;
  }

  .embed-video-lightbox-overlay.embed-video-lightbox-active {
    background: var(--embed-video-bg-overlay);
    backdrop-filter: blur(12px);
    visibility: visible;
    transition:
      background var(--embed-video-transition-fade),
      backdrop-filter var(--embed-video-transition-fade),
      visibility 0s 0s;
  }

  /* ===== EMBED VIDEO — Lightbox Content ===== */
  .embed-video-lightbox-content {
    position: relative;
    width: 90vw;
    max-width: 960px;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--embed-video-shadow-lightbox);
    border: 2px solid var(--embed-video-accent-border);
    transform: scale(0.8);
    opacity: 0;
    transition:
      transform var(--embed-video-transition-fade),
      opacity var(--embed-video-transition-fade);
    background: var(--embed-video-bg-card);
  }

  .embed-video-lightbox-overlay.embed-video-lightbox-active .embed-video-lightbox-content {
    transform: scale(1);
    opacity: 1;
  }

  .embed-video-lightbox-content iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* ===== EMBED VIDEO — Lightbox Close Button ===== */
  .embed-video-lightbox-close {
    position: absolute;
    top: -48px;
    right: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.2);
    background: rgba(0, 0, 0, 0.6);
    color: var(--embed-video-text-primary);
    font-size: 22px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    line-height: 1;
  }

  .embed-video-lightbox-close:hover {
    background: var(--embed-video-accent);
    border-color: var(--embed-video-accent);
    transform: scale(1.1);
  }

  /* ================================================
     EMBED VIDEO — RESPONSIVE / MOBILE
     ================================================ */
  @media (max-width: 768px) {
    .embed-video-float {
      width: 180px;
      height: 102px;
      bottom: 140px;
      right: 12px;
      border-radius: var(--embed-video-radius-md);
    }
    .embed-video-play-overlay svg {
      width: 34px;
      height: 34px;
    }
    .embed-video-badge {
      font-size: 9px;
      padding: 2px 7px;
      bottom: 5px;
      left: 5px;
    }
    .embed-video-close-mini {
      width: 22px;
      height: 22px;
      font-size: 13px;
      top: 4px;
      right: 4px;
    }
    .embed-video-lightbox-content {
      width: 95vw;
      border-radius: var(--embed-video-radius-md);
    }
    .embed-video-lightbox-close {
      top: -42px;
      width: 34px;
      height: 34px;
      font-size: 18px;
    }
  }

  @media (max-width: 400px) {
    .embed-video-float {
      width: 150px;
      height: 85px;
      bottom: 120px;
      right: 10px;
    }
    .embed-video-play-overlay svg {
      width: 28px;
      height: 28px;
    }
  }

  /* ===== EMBED VIDEO — Pulse Glow Animation ===== */
  @keyframes embedVideoPulseGlow {
    0%, 100% { box-shadow: var(--embed-video-shadow-mini); }
    50% { box-shadow: var(--embed-video-shadow-mini-hover); }
  }

  .embed-video-float.embed-video-visible {
    animation: embedVideoPulseGlow 2.5s ease-in-out 3;
  }