/* ==========================================================================
   SOCCER iD - Estilos Principales
   ========================================================================== 
   
   ÍNDICE:
   1. Fuentes y Reset
   2. Variables y Base
   3. Preloader
   4. Hero Section
   5. Layout Principal
   6. Bento Grid (Servicios)
   7. Galería Masonry
   8. Lightbox
   9. Seguros iD
   10. Copa 2026
   11. Media Section
   12. Eventos
   13. Contacto
   14. Footer
   15. Panel de Detalle
   16. Testimonios
   17. Modal de Eventos
   18. Media Queries (Responsivo)
   
   ========================================================================== */

/* ==========================================================================
   1. FUENTES Y RESET
   ========================================================================== */

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVvaooCP.ttf?v=ms6q0ctq') format('truetype');
    font-weight: 400;
    font-display: swap;
}

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVvoooCP.ttf?v=ms6q0ctq') format('truetype');
    font-weight: 500;
    font-display: swap;
}

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVsEpYCP.ttf?v=ms6q0ctq') format('truetype');
    font-weight: 600;
    font-display: swap;
}

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVs9pYCP.ttf?v=ms6q0ctq') format('truetype');
    font-weight: 700;
    font-display: swap;
}

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVtapYCP.ttf?v=ms6q0ctq') format('truetype');
    font-weight: 800;
    font-display: swap;
}

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVtzpYCP.ttf?v=ms6q0ctq') format('truetype');
    font-weight: 900;
    font-display: swap;
}

/* Reset básico */
*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* ==========================================================================
   2. VARIABLES Y BASE
   ========================================================================== */

:root {
    /* Colores principales */
    --color-primary: #667eea;
    --color-secondary: #764ba2;
    --color-accent: #f093fb;
    --color-whatsapp: #25D366;
    --color-whatsapp-dark: #128C7E;
    
    /* Fondos */
    --bg-dark-1: #0f0f1a;
    --bg-dark-2: #1a1a2e;
    --bg-dark-3: #16213e;
    --bg-card: rgba(255, 255, 255, 0.05);
    
    /* Texto */
    --text-primary: #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.8);
    --text-muted: rgba(255, 255, 255, 0.6);
    --text-subtle: rgba(255, 255, 255, 0.5);
    
    /* Bordes */
    --border-light: rgba(255, 255, 255, 0.1);
    --border-medium: rgba(255, 255, 255, 0.2);
    
    /* Espaciado */
    --spacing-xs: 8px;
    --spacing-sm: 12px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 40px;
    --spacing-xxl: 60px;
    
    /* Bordes redondeados */
    --radius-sm: 12px;
    --radius-md: 16px;
    --radius-lg: 20px;
    --radius-xl: 24px;
    --radius-full: 50px;
    
    /* Transiciones */
    --transition-fast: 0.2s ease;
    --transition-normal: 0.3s ease;
    --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    
    /* Sombras */
    --shadow-sm: 0 4px 15px rgba(0, 0, 0, 0.2);
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.4);
    --shadow-primary: 0 15px 40px rgba(102, 126, 234, 0.3);
    --shadow-whatsapp: 0 15px 40px rgba(37, 211, 102, 0.4);
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Raleway', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: linear-gradient(135deg, var(--bg-dark-1) 0%, var(--bg-dark-2) 50%, var(--bg-dark-3) 100%);
    min-height: 100vh;
    color: var(--text-primary);
    overflow-x: hidden;
    line-height: 1.6;
}

/* ==========================================================================
   3. PRELOADER
   ========================================================================== */

.preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--bg-dark-1) 0%, var(--bg-dark-2) 50%, var(--bg-dark-3) 100%);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease, visibility 0.5s ease;
}

.preloader.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

.preloader-logo-container {
    position: relative;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.preloader-spinner {
    position: absolute;
    width: 120px;
    height: 120px;
    border: 3px solid transparent;
    border-top-color: var(--color-primary);
    border-right-color: var(--color-secondary);
    border-radius: 50%;
    animation: preloaderSpin 1.2s linear infinite;
}

.preloader-spinner::before {
    content: '';
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    bottom: 8px;
    border: 3px solid transparent;
    border-top-color: var(--color-accent);
    border-left-color: var(--color-primary);
    border-radius: 50%;
    animation: preloaderSpin 1.8s linear infinite reverse;
}

@keyframes preloaderSpin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.preloader-logo {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
}

.preloader-logo svg {
    width: 100%;
    height: 100%;
}

.preloader-text {
    margin-top: 30px;
    font-size: 1.8rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -1px;
    animation: preloaderPulse 1.5s ease-in-out infinite;
}

@keyframes preloaderPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
}

.preloader-subtext {
    margin-top: 10px;
    font-size: 0.85rem;
    color: var(--text-subtle);
    letter-spacing: 3px;
    text-transform: uppercase;
}

/* ==========================================================================
   4. HERO SECTION
   ========================================================================== */

.hero-section {
    position: relative;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.hero-video-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

/* Overlay gradiente sobre el video/imagen */
.hero-video-container::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        180deg, 
        rgba(15, 15, 26, 0.4) 0%, 
        rgba(15, 15, 26, 0.6) 50%, 
        rgba(15, 15, 26, 0.95) 100%
    );
    z-index: 2;
}

.hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 0 20px;
    max-width: 900px;
}

.hero-logo-text {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -2px;
    margin-bottom: 10px;
}

.hero-tagline {
    font-size: clamp(1.2rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 20px;
    line-height: 1.4;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
}

/* Indicador de scroll */
.scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-decoration: none;
}

.scroll-indicator:hover {
    transform: translateX(-50%) translateY(-5px);
}

.scroll-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    letter-spacing: 2px;
    text-transform: uppercase;
}

.scroll-arrow {
    width: 30px;
    height: 50px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 25px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
}

.scroll-arrow::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: scrollBounce 2s infinite;
}

@keyframes scrollBounce {
    0%, 100% { 
        transform: translateY(0); 
        opacity: 1; 
    }
    50% { 
        transform: translateY(20px); 
        opacity: 0.3; 
    }
}

/* ==========================================================================
   SELECTOR DE IDIOMA
   ========================================================================== */

.language-selector-container {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 9999;
}

.language-selector {
  display: flex;
  gap: 8px;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: 8px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.lang-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  background: transparent;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
  color: rgba(255, 255, 255, 0.6);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
}

.lang-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.9);
}

.lang-btn.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  box-shadow: 0 2px 10px rgba(102, 126, 234, 0.4);
}

.lang-flag {
  font-size: 18px;
  line-height: 1;
}

.lang-text {
  font-weight: 600;
  letter-spacing: 0.5px;
}

/* Responsive */
@media (max-width: 768px) {
  .language-selector-container {
    top: 10px;
    right: 10px;
  }
  
  .language-selector {
    padding: 6px;
  }
  
  .lang-btn {
    padding: 6px 10px;
  }
  
  .lang-text {
    display: none;
  }
  
  .lang-flag {
    font-size: 20px;
  }
}

/* Animación de cambio de idioma */
@keyframes fadeInContent {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.bento-item,
.event-card,
.section-header,
.contact-card,
.footer-content {
  animation: fadeInContent 0.4s ease forwards;
}


/* ==========================================================================
   5. LAYOUT PRINCIPAL
   ========================================================================== */

.main-container {
    padding: 80px 20px;
    transition: 
        transform var(--transition-slow), 
        opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.main-container.slide-out {
    transform: scale(0.95);
    opacity: 0;
    pointer-events: none;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
}

/* Encabezados de sección */
.section-header {
    text-align: center;
    margin-bottom: 50px;
}

.section-header h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 10px;
}

.section-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
}

.bento-grid-section {
    margin-bottom: 40px;
}

/* ==========================================================================
   6. BENTO GRID (SERVICIOS) - SISTEMA RESPONSIVO CORREGIDO
   ========================================================================== */

/*
 * El Bento Grid usa CSS Grid con áreas nombradas para mejor control.
 * Desktop: 4 columnas
 * Tablet: 2 columnas
 * Mobile: 1 columna
 */

.bento-grid {
    display: grid;
    gap: var(--spacing-md);
    width: 100%;
}

/* ----- DESKTOP (> 1024px): Layout de 4 columnas ----- */
.bento-grid-first {
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 180px);
    grid-template-areas:
        "quienes quienes soccer vip"
        "quienes quienes seguros seguros";
}

.bento-grid-second {
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 180px);
    grid-template-areas:
        "copa fan media media"
        "opiniones opiniones opiniones opiniones";
}

/* Asignación de áreas - Grid 1 */
.bento-grid-first .item-quienes { grid-area: quienes; }
.bento-grid-first .item-soccer { grid-area: soccer; }
.bento-grid-first .item-vip { grid-area: vip; }
.bento-grid-first .item-seguros { grid-area: seguros; }

/* Asignación de áreas - Grid 2 */
.bento-grid-second .item-copa { grid-area: copa; }
.bento-grid-second .item-fan { grid-area: fan; }
.bento-grid-second .item-media { grid-area: media; }
.bento-grid-second .item-opiniones { grid-area: opiniones; }

/* Estilos base de cada item */
.bento-item {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
    transform: translateZ(0);
    will-change: transform;
    background: linear-gradient(135deg, #1e1e30 0%, #2a2a40 100%);
    border: 1px solid var(--border-light);
    min-height: 180px;
}

/* Imagen de fondo con pseudo-elemento */
.bento-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform var(--transition-slow);
    z-index: 1;
}

/* Overlay oscuro sobre la imagen */
.bento-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        180deg, 
        rgba(0, 0, 0, 0.2) 0%, 
        rgba(0, 0, 0, 0.4) 50%, 
        rgba(0, 0, 0, 0.8) 100%
    );
    z-index: 2;
}

/* Imágenes de fondo para cada item */
.item-quienes::before { background-image: url('/assets/images/somoss.jpg?v=ms6q0ctq'); }
.item-soccer::before { background-image: url('/assets/images/idcup.jpg?v=ms6q0ctq'); }
.item-seguros::before { background-image: url('/assets/images/news3.png?v=ms6q0ctq'); }
.item-vip::before { background-image: url('/assets/images/vip2.jpg?v=ms6q0ctq'); }
.item-copa::before { background-image: url('/assets/images/copa26.jpg?v=ms6q0ctq'); }
.item-fan::before { background-image: url('/assets/images/fan.png?v=ms6q0ctq'); }
.item-media::before { background-image: url('/assets/images/media.png?v=ms6q0ctq'); }
.item-opiniones::before { background-image: url('/assets/images/opi2.jpg?v=ms6q0ctq'); }

/* Contenido del bento item */
.bento-content {
    position: relative;
    z-index: 3;
    height: 100%;
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
}

.bento-content h3 {
    font-size: clamp(1rem, 1.5vw, 1.4rem);
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1.3;
}

/* Hover effects */
.bento-item:hover {
    transform: translateY(-4px);
    transition: transform var(--transition-normal);
}

.bento-item:hover::before {
    transform: scale(1.05);
}

/* Animaciones de entrada (staggered) */
.bento-grid-first .bento-item,
.bento-grid-second .bento-item {
    opacity: 0;
    transform: translateY(40px) scale(0.95);
}

.bento-grid-first .bento-item.animated,
.bento-grid-second .bento-item.animated {
    animation: staggeredSlideIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes staggeredSlideIn {
    0% { 
        opacity: 0; 
        transform: translateY(40px) scale(0.95); 
    }
    60% { 
        opacity: 1; 
        transform: translateY(-5px) scale(1.02); 
    }
    100% { 
        opacity: 1; 
        transform: translateY(0) scale(1); 
    }
}

/* ==========================================================================
   7. GALERÍA MASONRY
   ========================================================================== */

.masonry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-sm);
    width: 100%;
}

.masonry-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    transition: 
        transform var(--transition-normal), 
        box-shadow var(--transition-normal);
    min-height: 200px;
}

/* Items altos ocupan 2 filas */
.masonry-item.tall {
    grid-row: span 2;
}

.masonry-item:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-primary);
    z-index: 5;
}

.masonry-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow);
}

.masonry-item:hover img {
    transform: scale(1.05);
}

.masonry-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px 16px 16px;
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.85) 100%);
    color: white;
    font-size: 0.95rem;
    font-weight: 600;
}

/* Tarjeta de texto en la galería */
.masonry-text-card {
    background: linear-gradient(
        135deg, 
        rgba(102, 126, 234, 0.15) 0%, 
        rgba(118, 75, 162, 0.15) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 200px;
    grid-row: span 2;
}

.masonry-text-card h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 800;
    margin-bottom: 16px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
}

.masonry-text-card p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.7;
}

/* ==========================================================================
   8. LIGHTBOX
   ========================================================================== */

.lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-normal);
}

.lightbox.active {
    display: flex;
    opacity: 1;
}

.lightbox-content {
    position: relative;
    max-width: 90%;
    max-height: 90%;
}

.lightbox-content img {
    max-width: 100%;
    max-height: 85vh;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
}

.lightbox-close {
    position: absolute;
    top: -50px;
    right: 0;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    color: white;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
}

.lightbox-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
}

.lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    color: white;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
}

.lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.2);
}

.lightbox-prev { left: -70px; }
.lightbox-next { right: -70px; }

/* ==========================================================================
   9. SEGUROS iD
   ========================================================================== */

.seguros-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: calc(100vh - 140px);
    justify-content: center;
}

.seguros-header {
    text-align: center;
    max-width: 700px;
    margin-bottom: 40px;
}

.seguros-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 16px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.seguros-header p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
}

.iphone-video-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
}

/* Mockup de iPhone */
.iphone-frame {
    position: relative;
    width: 300px;
    height: 620px;
    background: linear-gradient(135deg, #1a1a2e 0%, #0a0a15 100%);
    border-radius: 50px;
    padding: 12px;
    box-shadow: 
        0 50px 100px rgba(0, 0, 0, 0.5), 
        0 0 0 3px #2a2a40, 
        inset 0 0 0 1px rgba(255, 255, 255, 0.1);
}

.iphone-notch {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 32px;
    background: #000;
    border-radius: 0 0 20px 20px;
    z-index: 10;
}

.iphone-notch::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    background: #1a1a2e;
    border-radius: 50%;
}

.iphone-screen {
    width: 100%;
    height: 100%;
    background: #000;
    border-radius: 40px;
    overflow: hidden;
    position: relative;
}

.iphone-screen video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.iphone-home-indicator {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 4px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
}

/* Botón CTA */
.cta-conoce-mas {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border: none;
    border-radius: 14px;
    color: white;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-decoration: none;
}

.cta-conoce-mas:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-primary);
}

/* ==========================================================================
   10. COPA 2026
   ========================================================================== */

.copa-fullscreen-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - 70px);
    margin: -30px;
    width: calc(100% + 60px);
}

.copa-text-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 60px 50px;
    text-align: center;
}

.copa-text-content {
    max-width: 480px;
}

.copa-text-section h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 24px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
}

.copa-text-section p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 36px;
}

/* Botón WhatsApp */
.whatsapp-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 36px;
    background: linear-gradient(135deg, var(--color-whatsapp), var(--color-whatsapp-dark));
    border: none;
    border-radius: var(--radius-full);
    color: white;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-decoration: none;
}

.whatsapp-contact-btn:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-whatsapp);
}

.whatsapp-contact-btn svg {
    width: 24px;
    height: 24px;
    fill: white;
}

/* Banner de la Copa */
.copa-banner-section {
    position: relative;
    overflow: hidden;
}

.copa-banner-section img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.copa-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        135deg, 
        rgba(102, 126, 234, 0.4) 0%, 
        rgba(118, 75, 162, 0.4) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
}

.copa-banner-overlay .banner-tag {
    display: inline-block;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    padding: 8px 20px;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
    width: fit-content;
}

.copa-banner-overlay h3 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 12px;
}

.copa-banner-overlay p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    max-width: 350px;
}

/* ==========================================================================
   11. MEDIA SECTION
   ========================================================================== */

.media-articles-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
}

.media-article-card {
    display: flex;
    gap: 24px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-normal);
    text-decoration: none;
    color: inherit;
}

.media-article-card:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateX(8px);
    border-color: rgba(102, 126, 234, 0.3);
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.15);
}

.media-article-image {
    width: 240px;
    min-width: 240px;
    height: 160px;
    overflow: hidden;
}

.media-article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
}

.media-article-card:hover .media-article-image img {
    transform: scale(1.05);
}

.media-article-body {
    padding: 24px 24px 24px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
}

.media-article-source {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--text-subtle);
    font-weight: 600;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.media-article-source::before {
    content: '';
    width: 8px;
    height: 8px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 50%;
}

.media-article-card h4 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 10px;
    line-height: 1.4;
    color: var(--text-primary);
}

.media-article-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
}

.media-article-arrow {
    margin-left: auto;
    padding-right: 24px;
    display: flex;
    align-items: center;
    opacity: 0;
    transform: translateX(-10px);
    transition: all var(--transition-normal);
}

.media-article-card:hover .media-article-arrow {
    opacity: 1;
    transform: translateX(0);
}

/* Video Section */
.video-section-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.video-section-title::before {
    content: '';
    width: 4px;
    height: 24px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 2px;
}

.video-embed-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* Aspect ratio 16:9 */
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow-md);
}

.video-embed-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
}

/* ==========================================================================
   12. EVENTOS
   ========================================================================== */

.events-section {
    padding: 80px 20px;
    background: linear-gradient(
        180deg, 
        transparent 0%, 
        rgba(102, 126, 234, 0.05) 50%, 
        transparent 100%
    );
}

.events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: 40px;
}

.event-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    overflow: hidden;
    cursor: pointer;
    transition: all var(--transition-normal);
}

.event-card:hover {
    transform: translateY(-8px);
    border-color: rgba(102, 126, 234, 0.5);
    box-shadow: 0 20px 40px rgba(102, 126, 234, 0.2);
}

.event-image {
    position: relative;
    height: 180px;
    overflow: hidden;
}

.event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
}

.event-card:hover .event-image img {
    transform: scale(1.1);
}

.event-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: white;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
}

.event-body {
    padding: var(--spacing-lg);
}

.event-date {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 16px;
}

.event-teams {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 20px;
}

.event-team {
    text-align: center;
    flex: 1;
}

.team-shield {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1a1a2e, #2a2a40);
    margin: 0 auto 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    border: 2px solid var(--border-light);
}

.team-name {
    font-weight: 600;
    font-size: 0.95rem;
}

.event-vs {
    font-size: 1.2rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.3);
}

.event-venue {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 20px;
}

.event-cta {
    width: 100%;
    padding: 14px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border: none;
    border-radius: var(--radius-sm);
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all var(--transition-normal);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Raleway', sans-serif;
}

.event-cta:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-primary);
}

/* Botón ver todos los eventos */
.view-all-events {
    display: flex;
    justify-content: center;
}

.view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 40px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    color: white;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    font-family: 'Raleway', sans-serif;
}

.view-all-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

/* ==========================================================================
   13. CONTACTO
   ========================================================================== */

.contact-section {
    padding: 80px 20px;
    text-align: center;
}

.contact-card {
    max-width: 700px;
    margin: 0 auto;
    background: linear-gradient(
        135deg, 
        rgba(37, 211, 102, 0.1) 0%, 
        rgba(37, 211, 102, 0.05) 100%
    );
    border: 1px solid rgba(37, 211, 102, 0.3);
    border-radius: 30px;
    padding: 60px 40px;
}

.contact-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-whatsapp), var(--color-whatsapp-dark));
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.contact-icon svg {
    width: 40px;
    height: 40px;
    fill: white;
}

.contact-card h2 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 800;
    margin-bottom: 16px;
}

.contact-card p {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 30px;
    line-height: 1.6;
}

.whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 40px;
    background: linear-gradient(135deg, var(--color-whatsapp), var(--color-whatsapp-dark));
    border: none;
    border-radius: var(--radius-full);
    color: white;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-decoration: none;
    font-family: 'Raleway', sans-serif;
}

.whatsapp-btn:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-whatsapp);
}

.whatsapp-btn svg {
    width: 24px;
    height: 24px;
    fill: white;
}

/* ==========================================================================
   14. FOOTER
   ========================================================================== */

.footer {
    background: rgba(0, 0, 0, 0.3);
    border-top: 1px solid var(--border-light);
    padding: 60px 20px 30px;
}

.footer-content {
    max-width: 1200px;
    margin: 0 auto;
}

.footer-main {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-bottom: 40px;
}

.footer-brand,
.footer-social,
.footer-actions {
    text-align: center;
}

.footer-logo {
    font-size: 2rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 16px;
}

.footer-tagline {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
}

.footer-social h4,
.footer-actions h4 {
    font-size: 1rem;
    margin-bottom: 20px;
    color: var(--text-secondary);
}

.social-links {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
}

.social-link {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
    text-decoration: none;
}

.social-link:hover {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    transform: translateY(-3px);
}

.social-link.email-link:hover {
    background: linear-gradient(135deg, #EA4335, #FBBC05);
}

.social-link svg {
    width: 22px;
    height: 22px;
    fill: white;
}

.back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-decoration: none;
}

.back-to-top:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

.footer-bottom {
    border-top: 1px solid var(--border-light);
    padding-top: 30px;
    text-align: center;
}

.footer-copyright {
    color: var(--text-subtle);
    font-size: 0.9rem;
    margin-bottom: 16px;
}

.footer-links {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.footer-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--transition-normal);
}

.footer-link:hover {
    color: var(--color-primary);
}

.footer-website {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--transition-normal);
}

.footer-website:hover {
    color: var(--color-secondary);
}

/* ==========================================================================
   15. PANEL DE DETALLE
   ========================================================================== */

.detail-panel {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 1000;
    overflow: hidden;
    transform: scale(0.8);
    opacity: 0;
    visibility: hidden;
    transition: 
        transform var(--transition-slow), 
        opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), 
        visibility 0.5s;
    pointer-events: none;
}

.detail-panel.active {
    transform: scale(1);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.detail-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow-y: auto;
    padding: 0;
}

.panel-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 20px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-light);
}

.back-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    font-family: 'Raleway', sans-serif;
}

.back-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateX(-5px);
}

.panel-tag {
    background: rgba(255, 255, 255, 0.15);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: none;
}

.panel-body {
    padding: 30px;
    max-width: 1400px;
    margin: 0 auto;
}

.panel-body.no-padding {
    padding: 0;
    max-width: 100%;
}

.panel-body.fx-padding {
    max-width: 100%;
}

.panel-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 20px;
    line-height: 1.1;
}

.panel-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 40px;
    max-width: 800px;
}

/* Colores de fondo para cada panel */
.panel-quienes { background: linear-gradient(135deg, #1a1025 0%, #2d1a4e 50%, #1e1535 100%); }
.panel-soccer { background: linear-gradient(135deg, #1a1530 0%, #2a1f50 50%, #1c1235 100%); }
.panel-seguros { background: linear-gradient(135deg, #201530 0%, #351a55 50%, #251040 100%); }
.panel-vip { background: linear-gradient(135deg, #1a1035 0%, #301a60 50%, #1f1040 100%); }
.panel-copa { background: linear-gradient(135deg, #251540 0%, #3a1a65 50%, #2a1050 100%); }
.panel-fan { background: linear-gradient(135deg, #1e1540 0%, #2f1a55 50%, #221045 100%); }
.panel-media { background: linear-gradient(135deg, #201035 0%, #351555 50%, #251040 100%); }
.panel-opiniones { background: linear-gradient(135deg, #1c1530 0%, #2c1a4a 50%, #1e1235 100%); }

/* ==========================================================================
   16. TESTIMONIOS
   ========================================================================== */

.testimonials-container {
    position: relative;
    overflow: hidden;
    padding: 0 20px;
}

.testimonials-track {
    display: flex;
    gap: var(--spacing-lg);
    transition: transform var(--transition-slow);
    padding: 10px 0;
}

.testimonial-card {
    flex: 0 0 420px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    padding: 32px;
    transition: all var(--transition-normal);
}

.testimonial-card:hover {
    border-color: rgba(102, 126, 234, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
}

.testimonial-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
}

/* Avatar wrapper - contenedor cuadrado grande */
.testimonial-avatar-wrapper {
    width: 90px;
    height: 90px;
    min-width: 90px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3);
    position: relative;
}

/* Imagen del avatar */
.testimonial-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal);
}

.testimonial-card:hover .testimonial-avatar-img {
    transform: scale(1.05);
}

/* Fallback cuando no hay imagen */
.testimonial-avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.8rem;
    color: white;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    text-transform: uppercase;
}

.testimonial-info {
    flex: 1;
}

.testimonial-info h4 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 4px;
    color: var(--text-primary);
}

.testimonial-handle {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0.9;
}

.testimonial-stars {
    color: #ffc107;
    font-size: 1.3rem;
    margin-bottom: 16px;
    letter-spacing: 2px;
}

.testimonial-text {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 1rem;
    font-style: italic;
}

/* Slider Controls */
.slider-controls {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
}

.slider-btn {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-medium);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
}

.slider-btn:hover {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-color: transparent;
    transform: scale(1.1);
    box-shadow: var(--shadow-primary);
}

.slider-btn:active {
    transform: scale(0.95);
}

/* ==========================================================================
   TESTIMONIOS - RESPONSIVE
   ========================================================================== */

@media (max-width: 1024px) {
    .testimonial-card {
        flex: 0 0 380px;
        padding: 28px;
    }
    
    .testimonial-avatar-wrapper {
        width: 80px;
        height: 80px;
        min-width: 80px;
    }
    
    .testimonial-avatar-fallback {
        font-size: 1.6rem;
    }
}

@media (max-width: 768px) {
    .testimonials-container {
        padding: 0 16px;
    }
    
    .testimonial-card {
        flex: 0 0 320px;
        padding: 24px;
    }
    
    .testimonial-header {
        gap: 16px;
    }
    
    .testimonial-avatar-wrapper {
        width: 70px;
        height: 70px;
        min-width: 70px;
        border-radius: var(--radius-sm);
    }
    
    .testimonial-avatar-fallback {
        font-size: 1.4rem;
    }
    
    .testimonial-info h4 {
        font-size: 1.1rem;
    }
    
    .testimonial-handle {
        font-size: 0.85rem;
    }
    
    .testimonial-stars {
        font-size: 1.1rem;
    }
    
    .testimonial-text {
        font-size: 0.95rem;
    }
    
    .slider-controls {
        margin-top: 24px;
    }
    
    .slider-btn {
        width: 48px;
        height: 48px;
    }
}

@media (max-width: 480px) {
    .testimonials-container {
        padding: 0 12px;
    }
    
    .testimonial-card {
        flex: 0 0 280px;
        padding: 20px;
    }
    
    .testimonial-header {
        gap: 14px;
        margin-bottom: 16px;
    }
    
    .testimonial-avatar-wrapper {
        width: 60px;
        height: 60px;
        min-width: 60px;
    }
    
    .testimonial-avatar-fallback {
        font-size: 1.2rem;
    }
    
    .testimonial-info h4 {
        font-size: 1rem;
    }
    
    .testimonial-handle {
        font-size: 0.8rem;
    }
    
    .testimonial-stars {
        font-size: 1rem;
        margin-bottom: 12px;
    }
    
    .testimonial-text {
        font-size: 0.9rem;
        line-height: 1.7;
    }
    
    .slider-controls {
        gap: 12px;
        margin-top: 20px;
    }
    
    .slider-btn {
        width: 44px;
        height: 44px;
    }
}

/* ==========================================================================
   17. MODAL DE EVENTOS
   ========================================================================== */

.events-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.95);
    z-index: 2000;
    display: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    overflow-y: auto;
}

.events-modal.active {
    display: block;
    opacity: 1;
}

.events-modal-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
}

.events-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 20px;
}

.events-modal-header h2 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
}

.close-modal-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    font-family: 'Raleway', sans-serif;
}

.close-modal-btn:hover {
    background: rgba(255, 255, 255, 0.2);
}

.loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 400px;
}

.loading-spinner {
    width: 60px;
    height: 60px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 20px;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.loading-text {
    color: var(--text-muted);
    font-size: 1rem;
}

.all-events-grid {
    display: none;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
}

.all-events-grid.loaded {
    display: grid;
}

/* ==========================================================================
   18. MEDIA QUERIES (RESPONSIVO)
   ========================================================================== 
   
   Breakpoints:
   - Desktop grande: > 1200px (default)
   - Desktop: 1024px - 1200px
   - Tablet: 768px - 1024px
   - Tablet pequeña: 640px - 768px
   - Mobile: < 640px
   
   ========================================================================== */

/* ----- DESKTOP PEQUEÑO (max 1200px) ----- */
@media (max-width: 1200px) {
    .container {
        padding: 0 20px;
    }
    
    .events-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .all-events-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* ----- TABLET GRANDE (max 1024px) ----- */
@media (max-width: 1024px) {
    /* Bento Grid - 2 columnas */
    .bento-grid-first {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: auto auto auto;
        grid-template-areas:
            "quienes quienes"
            "soccer vip"
            "seguros seguros";
    }
    
    .bento-grid-second {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: auto auto auto;
        grid-template-areas:
            "copa fan"
            "media media"
            "opiniones opiniones";
    }
    
    .bento-item {
        min-height: 200px;
    }
    
    /* Galería Masonry - 2 columnas */
    .masonry-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .masonry-text-card {
        grid-column: span 2;
        grid-row: span 1;
    }
    
    /* Media articles apilados */
    .media-article-card {
        flex-direction: column;
    }
    
    .media-article-image {
        width: 100%;
        min-width: 100%;
        height: 200px;
    }
    
    .media-article-body {
        padding: var(--spacing-lg);
    }
    
    .media-article-arrow {
        display: none;
    }
    
    /* Copa 2026 */
    .copa-fullscreen-wrapper {
        grid-template-columns: 1fr;
        margin: 0;
        width: 100%;
    }
    
    .copa-text-section {
        padding: 40px 30px;
    }
    
    .copa-banner-section {
        min-height: 350px;
    }
    
    /* Testimonios más pequeños */
    .testimonial-card {
        flex: 0 0 320px;
    }
    
    /* Lightbox nav */
    .lightbox-prev { left: 10px; }
    .lightbox-next { right: 10px; }
    
    /* Footer */
    .footer-main {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .footer-brand {
        grid-column: span 2;
    }
}

/* ----- TABLET (max 768px) ----- */
@media (max-width: 768px) {
    .main-container {
        padding: 60px 16px;
    }
    
    .section-header {
        margin-bottom: 40px;
    }
    
    /* Eventos - 1 columna */
    .events-grid {
        grid-template-columns: 1fr;
    }
    
    .events-section {
        padding: 60px 16px;
    }
    
    /* Contacto */
    .contact-section {
        padding: 60px 16px;
    }
    
    .contact-card {
        padding: 40px 24px;
    }
    
    /* iPhone mockup más pequeño */
    .iphone-frame {
        width: 280px;
        height: 580px;
    }
    
    /* Footer */
    .footer-main {
        grid-template-columns: 1fr;
        gap: 30px;
    }
    
    .footer-brand {
        grid-column: span 1;
    }
    
    .footer {
        padding: 50px 16px 24px;
    }
    
    /* Modal de eventos */
    .all-events-grid {
        grid-template-columns: 1fr;
    }
    
    /* Hero */
    .hero-section {
        min-height: 500px;
    }
    
    .scroll-indicator {
        bottom: 30px;
    }
}

/* ----- TABLET PEQUEÑA (max 640px) ----- */
@media (max-width: 640px) {
    .main-container {
        padding: 50px 12px;
    }
    
    /* Bento Grid - 1 columna en móvil */
    .bento-grid-first,
    .bento-grid-second {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: var(--spacing-sm);
    }
    
    .bento-grid-first {
        grid-template-areas:
            "quienes"
            "soccer"
            "vip"
            "seguros";
    }
    
    .bento-grid-second {
        grid-template-areas:
            "copa"
            "fan"
            "media"
            "opiniones";
    }
    
    .bento-item {
        min-height: 160px;
    }
    
    /* Galería Masonry - 1 columna */
    .masonry-grid {
        grid-template-columns: 1fr;
    }
    
    .masonry-text-card {
        grid-column: span 1;
    }
    
    .masonry-item.tall {
        grid-row: span 1;
    }
    
    /* Panel de detalle */
    .panel-header {
        padding: 16px 16px;
    }
    
    .back-btn {
        padding: 10px 16px;
        font-size: 0.85rem;
    }
    
    .panel-tag {
        font-size: 0.7rem;
        padding: 6px 12px;
    }
    
    .panel-body {
        padding: 20px 16px;
    }
    
    /* Detail panel - slide from right en móvil */
    .detail-panel {
        transform: translateX(100%);
        opacity: 1;
    }
    
    .detail-panel.active {
        transform: translateX(0);
    }
    
    /* iPhone mockup */
    .iphone-frame {
        width: 260px;
        height: 540px;
    }
    
    /* Testimonios */
    .testimonial-card {
        flex: 0 0 280px;
        padding: 24px;
    }
    
    /* Copa 2026 */
    .copa-fullscreen-wrapper {
        margin: -20px -16px;
        width: calc(100% + 32px);
    }
    
    .copa-text-section {
        padding: 30px 20px;
    }
    
    .copa-banner-section {
        min-height: 280px;
    }
    
    .copa-banner-overlay {
        padding: 24px;
    }
    
    .copa-banner-overlay h3 {
        font-size: 1.4rem;
    }
    
    /* Lightbox */
    .lightbox-nav {
        width: 40px;
        height: 40px;
    }
    
    .lightbox-prev { left: 5px; }
    .lightbox-next { right: 5px; }
    .lightbox-close { 
        top: 10px; 
        right: 10px;
        position: fixed;
    }
    
    /* Footer */
    .footer {
        padding: 40px 12px 20px;
    }
    
    .footer-links {
        flex-direction: column;
        gap: 12px;
    }
    
    /* Preloader */
    .preloader-logo-container {
        width: 100px;
        height: 100px;
    }
    
    .preloader-spinner {
        width: 100px;
        height: 100px;
    }
    
    .preloader-logo {
        width: 50px;
        height: 50px;
    }
    
    .preloader-text {
        font-size: 1.5rem;
    }
    
    /* Botones más pequeños */
    .whatsapp-btn,
    .whatsapp-contact-btn,
    .cta-conoce-mas {
        padding: 14px 28px;
        font-size: 1rem;
    }
    
    .view-all-btn {
        padding: 14px 30px;
        font-size: 0.95rem;
    }
}

/* ----- MOBILE PEQUEÑO (max 480px) ----- */
@media (max-width: 480px) {
    .main-container {
        padding: 40px 10px;
    }
    
    .bento-item {
        min-height: 140px;
    }
    
    .bento-content {
        padding: 16px;
    }
    
    .bento-content h3 {
        font-size: 1rem;
    }
    
    .section-header {
        margin-bottom: 30px;
    }
    
    .section-header h2 {
        font-size: 1.8rem;
    }
    
    .events-section {
        padding: 40px 10px;
    }
    
    .event-body {
        padding: 16px;
    }
    
    .team-shield {
        width: 50px;
        height: 50px;
        font-size: 1.5rem;
    }
    
    .contact-section {
        padding: 40px 10px;
    }
    
    .contact-card {
        padding: 30px 16px;
        border-radius: 20px;
    }
    
    /* Panel */
    .panel-body {
        padding: 16px 12px;
    }
    
    .panel-title {
        font-size: 1.8rem;
    }
    
    .panel-description {
        font-size: 1rem;
        margin-bottom: 24px;
    }
    
    /* Testimonios más compactos */
    .testimonial-card {
        flex: 0 0 260px;
        padding: 20px;
    }
    
    .testimonial-avatar {
        width: 50px;
        height: 50px;
        font-size: 1.2rem;
    }
    
    /* iPhone mockup */
    .iphone-frame {
        width: 240px;
        height: 500px;
        border-radius: 40px;
    }
    
    .iphone-screen {
        border-radius: 35px;
    }
    
    /* Modal eventos */
    .events-modal-content {
        padding: 20px 10px;
    }
    
    .events-modal-header {
        margin-bottom: 24px;
    }
    
    .close-modal-btn {
        padding: 10px 16px;
        font-size: 0.85rem;
    }
}

/* ----- ALTURA PEQUEÑA (landscape móvil) ----- */
@media (max-height: 600px) and (orientation: landscape) {
    .hero-section {
        min-height: 100vh;
    }
    
    .scroll-indicator {
        display: none;
    }
    
    .preloader-logo-container {
        width: 80px;
        height: 80px;
    }
    
    .preloader-spinner {
        width: 80px;
        height: 80px;
    }
    
    .preloader-text {
        font-size: 1.2rem;
        margin-top: 20px;
    }
}

/* ----- PREFERENCIAS DE ACCESIBILIDAD ----- */

/* Reduce movimiento para usuarios que lo prefieren */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
    
    html {
        scroll-behavior: auto;
    }
    
    .bento-item:hover::before {
        transform: none;
    }
    
    .masonry-item:hover img {
        transform: none;
    }
}

/* Alto contraste */
@media (prefers-contrast: high) {
    :root {
        --border-light: rgba(255, 255, 255, 0.3);
        --border-medium: rgba(255, 255, 255, 0.5);
    }
    
    .bento-item,
    .event-card,
    .testimonial-card,
    .media-article-card {
        border-width: 2px;
    }
}

/* ==========================================================================
   19. MAGAZINE READER MODAL (Lector de Revista/Documentos)
   ========================================================================== */

/* ----- Modal Overlay ----- */
.magazine-reader-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    display: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.magazine-reader-modal.active {
    display: flex;
    flex-direction: column;
    opacity: 1;
    visibility: visible;
}

/* ----- Container ----- */
.magazine-reader-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    max-height: 100vh;
    overflow: hidden;
}

/* ----- Header ----- */
.magazine-reader-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 204px 16px 24px;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
    z-index: 10;
}

.magazine-reader-header h2 {
    font-size: 1.2rem;
    font-weight: 700;
    color: white;
    margin: 0;
}

.magazine-reader-close {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    margin-right: 200px;
}

.magazine-reader-close:hover {
    background: rgba(239, 68, 68, 0.4);
    transform: scale(1.1);
}

.magazine-reader-close svg {
    width: 20px;
    height: 20px;
}

/* ----- Content Area ----- */
.magazine-reader-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
}

/* ----- Controls ----- */
.magazine-reader-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 12px;
    background: rgba(0, 0, 0, 0.6);
    flex-shrink: 0;
}

.magazine-nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.magazine-nav-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
}

.magazine-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

.magazine-nav-btn svg {
    width: 20px;
    height: 20px;
}

.magazine-page-info {
    color: white;
    font-size: 1rem;
    font-weight: 600;
    min-width: 80px;
    text-align: center;
}

/* ----- Viewport ----- */
.magazine-reader-viewport {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 20px;
    position: relative;
    cursor: grab;
}

.magazine-reader-viewport.is-dragging {
    cursor: grabbing;
    user-select: none;
    -webkit-user-select: none;
}

.magazine-pages-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    position: relative;
}

/* ----- Páginas ----- */
.magazine-page {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
}

.magazine-page.active {
    display: flex;
    opacity: 1;
}

/* Contenedor interno para transformaciones de arrastre */
.magazine-page-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform, opacity;
}

/* Sin transición por defecto - se controla via JS */
.magazine-page-inner.animating {
    transition: transform 0.25s ease-out, opacity 0.25s ease-out;
}

.magazine-page img {
    max-width: 90vw;
    max-height: calc(100vh - 250px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    -webkit-user-drag: none;
    user-drag: none;
    -webkit-touch-callout: none;
    pointer-events: none;
}

.magazine-page-error {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 300px;
    height: 400px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.5);
}

/* ----- Animaciones de transición de página ----- */
.magazine-page.entering {
    display: flex;
}

.magazine-page.entering.from-right {
    animation: pageEnterFromRight 0.3s ease-out forwards;
}

.magazine-page.entering.from-left {
    animation: pageEnterFromLeft 0.3s ease-out forwards;
}

.magazine-page.exiting.to-left {
    animation: pageExitToLeft 0.3s ease-out forwards;
}

.magazine-page.exiting.to-right {
    animation: pageExitToRight 0.3s ease-out forwards;
}

@keyframes pageEnterFromRight {
    from {
        opacity: 0;
        transform: translateX(80px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes pageEnterFromLeft {
    from {
        opacity: 0;
        transform: translateX(-80px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes pageExitToLeft {
    from {
        opacity: 1;
        transform: translateX(0);
    }
    to {
        opacity: 0;
        transform: translateX(-80px);
    }
}

@keyframes pageExitToRight {
    from {
        opacity: 1;
        transform: translateX(0);
    }
    to {
        opacity: 0;
        transform: translateX(80px);
    }
}

/* Bounce al llegar a límites */
.magazine-page-inner.bounce-left {
    animation: bounceLeft 0.4s ease-out;
}

.magazine-page-inner.bounce-right {
    animation: bounceRight 0.4s ease-out;
}

@keyframes bounceLeft {
    0%, 100% { transform: translateX(0); }
    30% { transform: translateX(25px); }
    60% { transform: translateX(-8px); }
    80% { transform: translateX(3px); }
}

@keyframes bounceRight {
    0%, 100% { transform: translateX(0); }
    30% { transform: translateX(-25px); }
    60% { transform: translateX(8px); }
    80% { transform: translateX(-3px); }
}

/* ----- Thumbnails ----- */
.magazine-thumbnails {
    display: flex;
    gap: 12px;
    padding: 16px 24px;
    background: rgba(0, 0, 0, 0.8);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    overflow-x: auto;
    flex-shrink: 0;
    scroll-behavior: smooth;
}

.magazine-thumbnails::-webkit-scrollbar {
    height: 6px;
}

.magazine-thumbnails::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
}

.magazine-thumbnails::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 3px;
}

.magazine-thumbnail {
    flex-shrink: 0;
    width: 80px;
    height: 60px;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    opacity: 0.6;
    position: relative;
}

.magazine-thumbnail:hover {
    opacity: 1;
    transform: translateY(-4px);
}

.magazine-thumbnail.active {
    border-color: #667eea;
    opacity: 1;
    box-shadow: 0 0 20px rgba(102, 126, 234, 0.4);
}

.magazine-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
}

.thumbnail-number {
    position: absolute;
    bottom: 2px;
    right: 2px;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
}

.thumbnail-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-weight: 700;
}

/* ----- Indicadores de swipe ----- */
.swipe-indicator {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(102, 126, 234, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    z-index: 20;
    transition: opacity 0.15s ease, background 0.15s ease;
}

.swipe-indicator svg {
    color: white;
    opacity: 0.8;
}

.swipe-indicator-left {
    left: 20px;
}

.swipe-indicator-right {
    right: 20px;
}

.swipe-indicator.visible {
    opacity: 1;
}

.swipe-indicator.triggered {
    background: rgba(102, 126, 234, 0.8);
}

.swipe-indicator.triggered svg {
    opacity: 1;
}

/* ----- Hint de swipe ----- */
.magazine-swipe-hint {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.9rem;
    font-weight: 500;
    z-index: 25;
    pointer-events: none;
    animation: hintAppear 0.4s ease-out;
}

.magazine-swipe-hint.hiding {
    animation: hintDisappear 0.4s ease-out forwards;
}

.magazine-swipe-hint svg {
    animation: hintArrow 1s ease-in-out infinite;
}

@keyframes hintAppear {
    from {
        opacity: 0;
        transform: translateX(-50%) translateY(15px);
    }
    to {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }
}

@keyframes hintDisappear {
    from {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }
    to {
        opacity: 0;
        transform: translateX(-50%) translateY(-10px);
    }
}

@keyframes hintArrow {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(6px); }
}

/* ==========================================================================
   RESPONSIVE
   ========================================================================== */

@media (max-width: 768px) {
    .magazine-reader-header {
        padding: 12px 16px;
    }
    
    .magazine-reader-header h2 {
        font-size: 1rem;
        max-width: 200px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .magazine-reader-close {
        width: 40px;
        height: 40px;
        margin-right: 100px;
    }

    
    .magazine-reader-controls {
        padding: 10px;
        gap: 12px;
    }
    
    .magazine-nav-btn {
        width: 40px;
        height: 40px;
    }
    
    .magazine-reader-viewport {
        padding: 10px;
    }
    
    .magazine-page img {
        max-width: 95vw;
        max-height: calc(100vh - 220px);
    }
    
    .magazine-thumbnails {
        padding: 12px 16px;
        gap: 8px;
    }
    
    .magazine-thumbnail {
        width: 60px;
        height: 45px;
    }
    
    .swipe-indicator {
        width: 40px;
        height: 40px;
    }
    
    .swipe-indicator-left {
        left: 10px;
    }
    
    .swipe-indicator-right {
        right: 10px;
    }
}

@media (max-width: 480px) {
    .magazine-reader-header h2 {
        font-size: 0.9rem;
        max-width: 150px;
        margin-right: 100px;
    }
    
    .magazine-page img {
        max-height: calc(100vh - 200px);
    }
    
    .magazine-thumbnail {
        width: 50px;
        height: 38px;
    }
    
    .magazine-swipe-hint {
        padding: 10px 18px;
        font-size: 0.8rem;
        bottom: 20px;
    }
}

/* ----- Optimizaciones móvil ----- */
@media (hover: none) and (pointer: coarse) {
    .magazine-page-inner {
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }
    
    .magazine-reader-viewport {
        touch-action: pan-y pinch-zoom;
        overscroll-behavior: contain;
    }
}

/* ==========================================================================
   MAGAZINE READER - SOURCE BUTTON
   ========================================================================== */

/* ----- Header Actions Container ----- */
.magazine-header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* ----- Source Button ----- */
.magazine-source-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.2), rgba(118, 75, 162, 0.2));
    border: 1px solid rgba(102, 126, 234, 0.4);
    border-radius: 25px;
    color: white;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
}

.magazine-source-btn:hover {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.4), rgba(118, 75, 162, 0.4));
    border-color: rgba(102, 126, 234, 0.6);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    color: white;
    text-decoration: none;
}

.magazine-source-btn:active {
    transform: translateY(0);
}

.magazine-source-btn svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
}

.magazine-source-btn:hover svg {
    transform: translate(2px, -2px);
}

/* ----- Header con botón de fuente ----- */
.magazine-reader-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
    z-index: 10;
}

/* ==========================================================================
   RESPONSIVE - SOURCE BUTTON
   ========================================================================== */

@media (max-width: 768px) {
    .magazine-header-actions {
        gap: 8px;
    }
    
    .magazine-source-btn {
        padding: 8px 14px;
        font-size: 0.8rem;
        gap: 6px;
    }
    
    .magazine-source-btn svg {
        width: 14px;
        height: 14px;
    }
}

@media (max-width: 480px) {
    .magazine-source-btn {
        padding: 8px 12px;
        font-size: 0.75rem;
    }
    
    /* En móviles muy pequeños, ocultar texto y solo mostrar icono */
    .magazine-source-btn span {
        display: none;
    }
    
    .magazine-source-btn {
        padding: 10px;
        border-radius: 50%;
    }
    
    .magazine-source-btn svg {
        width: 18px;
        height: 18px;
    }
}

/* ==========================================================================
   FIN MAGAZINE READER - SOURCE BUTTON
   ========================================================================== */

/* ==========================================================================
   FIN MAGAZINE READER
   ========================================================================== */

/* ==========================================================================
   FIN DEL ARCHIVO
   ========================================================================== */


/* Variables del Widget */
.soccer-id-widget {
    --color-primary: #667eea;
    --color-secondary: #764ba2;
    --color-accent: #f093fb;
    --bg-dark-1: #0f0f1a;
    --bg-dark-2: #1a1a2e;
    --bg-dark-3: #16213e;
    --bg-card: rgba(255, 255, 255, 0.05);
    --text-primary: #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.8);
    --text-muted: rgba(255, 255, 255, 0.5);
    --border-light: rgba(255, 255, 255, 0.08);
    --spacing-xs: 8px;
    --spacing-sm: 12px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 40px;
    --radius-sm: 12px;
    --radius-md: 16px;
    --radius-lg: 20px;
    --transition-fast: 0.2s ease;
    --transition-normal: 0.3s ease;
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.5);

    /* Configuración del contenedor del widget */
    width: 100%;
    max-width: 1200px; /* Ancho máximo */
    height: 550px; /* Alto fijo para el widget */
    margin: 0 auto;
    margin-top: 40px !important;
    display: flex;
    flex-direction: column;
    background: radial-gradient(circle at top right, var(--bg-dark-3), var(--bg-dark-1));
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    color: var(--text-primary);
    box-sizing: border-box;
}

.soccer-id-widget * {
    box-sizing: border-box;
}

/* Imagen de fondo con opacidad */
.soccer-id-widget::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-image: url('/assets/images/copa26.jpg?v=ms6q0ctq');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.15;
    z-index: 0;
    pointer-events: none;
}

/* Cabecera */
.widget-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg) var(--spacing-xl);
    height: 80px;
    position: relative;
    z-index: 1;
}

.widget-logo {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: 2px;
    background: linear-gradient(to right, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.widget-tabs {
    display: flex;
    gap: var(--spacing-sm);
    background: var(--bg-dark-2);
    padding: 6px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(10px);
}

.widget-tab-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 10px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: var(--transition-normal);
    display: flex;
    align-items: center;
    justify-content: center;
}

.widget-tab-btn svg { width: 20px; height: 20px; fill: currentColor; }
.widget-tab-btn:hover { color: var(--text-primary); background: var(--bg-card); }
.widget-tab-btn.active {
    color: var(--text-primary);
    background: var(--color-primary);
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

/* Contenido Principal */
.widget-main-content {
    display: flex;
    flex: 1;
    padding: 0 var(--spacing-xl) var(--spacing-xl);
    gap: var(--spacing-xl);
    overflow: hidden;
    position: relative;
    z-index: 1;
}

/* Columna Izquierda: Playlist */
.widget-playlist-section {
    flex: 0 0 35%;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding-right: var(--spacing-md);
    background: rgba(26, 26, 46, 0.6);
    border-radius: var(--radius-lg);
    padding: var(--spacing-sm);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-light);
}

.widget-playlist-section::-webkit-scrollbar { width: 6px; }
.widget-playlist-section::-webkit-scrollbar-track { background: transparent; }
.widget-playlist-section::-webkit-scrollbar-thumb { background: var(--border-light); border-radius: 10px; }

.widget-playlist-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--border-light);
}

.widget-section-subtitle {
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #b3b3b3;
    font-weight: 600;
}

.widget-mobile-toggle-btn {
    display: none;
    background: var(--bg-dark-2);
    border: 1px solid var(--border-light);
    color: var(--text-primary);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    transition: var(--transition-normal);
}

.widget-mobile-toggle-btn svg {
    width: 20px; height: 20px; stroke: currentColor; stroke-width: 2; fill: none; transition: transform 0.3s ease;
}
.widget-mobile-toggle-btn.open svg { transform: rotate(180deg); }

.widget-playlist-items-wrapper { display: flex; flex-direction: column; width: 100%; min-height: 0px !important;}
.widget-playlist-items { display: flex; flex-direction: column; }

.widget-playlist-item {
    display: flex;
    align-items: center;
    padding: var(--spacing-md) var(--spacing-sm);
    background: transparent;
    cursor: pointer;
    transition: var(--transition-fast);
    border-bottom: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
}
.widget-playlist-item:last-child { border-bottom: none; }
.widget-playlist-item:hover { background: rgba(255, 255, 255, 0.05); padding-left: var(--spacing-lg); }

.widget-item-thumb {
    width: 64px; height: 48px;
    border-radius: var(--radius-sm);
    background: var(--bg-dark-3);
    margin-right: var(--spacing-md);
    background-size: cover; background-position: center;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; position: relative; overflow: hidden;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}
.widget-item-thumb svg { width: 20px; height: 20px; fill: rgba(255,255,255,0.8); z-index: 2; }
.widget-item-thumb::after {
    content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4);
}

.widget-item-info { flex: 1; overflow: hidden; }
.widget-item-title {
    font-size: 15px; font-weight: 600; color: var(--text-primary);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 4px;
}
.widget-item-subtitle { font-size: 13px; color: var(--text-muted); }

.widget-play-icon {
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--text-primary); color: var(--bg-dark-1);
    opacity: 0; transform: scale(0.8); transition: all var(--transition-fast);
}
.widget-play-icon svg { width: 12px; height: 12px; fill: currentColor; margin-left: 2px; }
.widget-playlist-item:hover .widget-play-icon { opacity: 1; transform: scale(1); }

/* Columna Derecha: Reproductor Destacado */
.widget-featured-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: rgba(26, 26, 46, 0.7);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    position: relative;
    padding: var(--spacing-lg);
}

.widget-featured-container {
    width: 100%;
    max-width: 800px;
    aspect-ratio: 16/9;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: #000;
    transition: var(--transition-normal);
}

.widget-featured-container.audio-mode {
    aspect-ratio: auto;
    height: 352px;
    max-width: 500px;
}

.widget-featured-container iframe { width: 100%; height: 100%; border: none; display: block; }


/* =========================================
   CANALES SOCIALES (Adaptado al diseño)
========================================= */
.widget-social-channels {
    display: flex;
    gap: var(--spacing-sm);
    align-items: center;
    margin-top: var(--spacing-md);
    justify-content: end;
    margin-right: 4%;
}

/* Estilos base del botón usando variables del sistema */
.widget-social-channels .social-link-w {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--bg-dark-2); /* Fondo oscuro del widget */
    border: 1px solid var(--border-light); /* Borde sutil */
    transition: var(--transition-normal);
    text-decoration: none;
    backdrop-filter: blur(5px);
}

/* Estilos del icono SVG */
.widget-social-channels .social-link-w svg {
    width: 20px;
    height: 20px;
    fill: var(--text-muted); /* Color apagado por defecto */
    transition: var(--transition-normal);
}

/* Efectos Hover generales */
.widget-social-channels .social-link-w:hover {
    transform: translateY(-4px); /* Salto hacia arriba suave */
    border-color: transparent;
}

.widget-social-channels .social-link-w:hover svg {
    transform: scale(1.15); /* Crece un poco el icono */
    fill: var(--text-primary); /* Se ilumina el icono a blanco */
}

/* Colores específicos por marca al hacer hover (con resplandor) */
.widget-social-channels .social-link-w[title="YouTube"]:hover {
    background-color: #FF0000;
    box-shadow: 0 6px 15px rgba(255, 0, 0, 0.4);
}

.widget-social-channels .social-link-w[title="Spotify"]:hover {
    background-color: #1DB954;
    box-shadow: 0 6px 15px rgba(29, 185, 84, 0.4);
}




/* Responsividad */
@media (max-width: 900px) {
    .soccer-id-widget { height: auto; min-height: 400px; }
    .widget-main-content { flex-direction: column; padding: 0 var(--spacing-md) var(--spacing-xl); overflow: visible; }
    .widget-featured-section { flex: none; order: 1; padding: var(--spacing-sm); margin-bottom: var(--spacing-md); }
    .widget-playlist-section { flex: none; order: 2; padding-right: 0; overflow: visible; padding: var(--spacing-sm); }
    
    .widget-playlist-header { 
        align-items: center; 
        border-bottom: none; 
        margin-bottom: 0; 
        padding-bottom: 0; 
    }
    
    .widget-mobile-toggle-btn { display: flex; }
    .widget-playlist-items-wrapper { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease-out; }
    .widget-playlist-items-wrapper.open { grid-template-rows: 1fr; }
    .widget-playlist-items { overflow: hidden; }

    .widget-social-channels {
        margin-right: 9%;
    }
}


/* ==========================================================================
   VIDEO LIGHTBOX
   ========================================================================== */

.video-lightbox {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.video-lightbox.active {
  opacity: 1;
  visibility: visible;
}

.video-lightbox-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  cursor: pointer;
}

.video-lightbox-container {
  position: relative;
  width: 90%;
  max-width: 1200px;
  max-height: 90vh;
  background: #000;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.video-lightbox.active .video-lightbox-container {
  transform: scale(1);
}

.video-lightbox-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: linear-gradient(180deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.video-lightbox-title {
  color: #fff;
  font-size: 1.1rem;
  font-weight: 600;
  margin: 0;
  text-shadow: 0 2px 4px rgba(0,0,0,0.5);
}

.video-lightbox-close {
  background: rgba(255, 255, 255, 0.1);
  border: none;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
  color: #fff;
}

.video-lightbox-close:hover {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(1.1);
}

.video-lightbox-content {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000;
}

.video-lightbox-player {
  width: 100%;
  max-height: 80vh;
  outline: none;
}

.video-lightbox-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 12px 20px;
  background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.video-lightbox-fullscreen {
  background: rgba(255, 255, 255, 0.1);
  border: none;
  border-radius: 8px;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  transition: background 0.2s ease;
  color: #fff;
  font-size: 0.9rem;
}

.video-lightbox-fullscreen:hover {
  background: rgba(255, 255, 255, 0.2);
}

/* Video article card styles */
.media-article-card.video-article .media-article-image {
  position: relative;
}

.video-play-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64px;
  height: 64px;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease, background 0.3s ease;
}

.video-play-overlay svg {
  margin-left: 4px; /* Ajuste visual para centrar el triángulo */
}

.media-article-card.video-article:hover .video-play-overlay {
  transform: translate(-50%, -50%) scale(1.1);
  background: rgba(220, 38, 38, 0.9); /* Rojo para indicar play */
}

/* Video badge */
.article-type-badge.video-badge {
  background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
  color: white;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 5;
}

/* Responsive */
@media (max-width: 768px) {
  .video-lightbox-container {
    width: 95%;
    border-radius: 8px;
  }
  
  .video-lightbox-header {
    padding: 12px 16px;
  }
  
  .video-lightbox-title {
    font-size: 0.95rem;
  }
  
  .video-play-overlay {
    width: 48px;
    height: 48px;
  }
  
  .video-play-overlay svg {
    width: 32px;
    height: 32px;
  }
}
