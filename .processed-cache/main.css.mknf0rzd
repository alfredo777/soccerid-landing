/* ==========================================================================
   SOCCER iD - Estilos Principales
   ========================================================================== 
   
   ÍNDICE:
   1. Fuentes y Reset
   2. Variables y Base
   3. Preloader
   4. Hero Section
   5. Layout Principal
   6. Bento Grid (Servicios)
   7. Galería Masonry
   8. Lightbox
   9. Seguros iD
   10. Copa 2026
   11. Media Section
   12. Eventos
   13. Contacto
   14. Footer
   15. Panel de Detalle
   16. Testimonios
   17. Modal de Eventos
   18. Media Queries (Responsivo)
   
   ========================================================================== */

/* ==========================================================================
   1. FUENTES Y RESET
   ========================================================================== */

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVvaooCP.ttf?v=mknf0rzd') format('truetype');
    font-weight: 400;
    font-display: swap;
}

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVvoooCP.ttf?v=mknf0rzd') format('truetype');
    font-weight: 500;
    font-display: swap;
}

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVsEpYCP.ttf?v=mknf0rzd') format('truetype');
    font-weight: 600;
    font-display: swap;
}

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVs9pYCP.ttf?v=mknf0rzd') format('truetype');
    font-weight: 700;
    font-display: swap;
}

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVtapYCP.ttf?v=mknf0rzd') format('truetype');
    font-weight: 800;
    font-display: swap;
}

@font-face {
    font-family: 'Raleway';
    src: url('../fonts/1Ptxg8zYS_SKggPN4iEgvnHyvveLxVtzpYCP.ttf?v=mknf0rzd') format('truetype');
    font-weight: 900;
    font-display: swap;
}

/* Reset básico */
*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* ==========================================================================
   2. VARIABLES Y BASE
   ========================================================================== */

:root {
    /* Colores principales */
    --color-primary: #667eea;
    --color-secondary: #764ba2;
    --color-accent: #f093fb;
    --color-whatsapp: #25D366;
    --color-whatsapp-dark: #128C7E;
    
    /* Fondos */
    --bg-dark-1: #0f0f1a;
    --bg-dark-2: #1a1a2e;
    --bg-dark-3: #16213e;
    --bg-card: rgba(255, 255, 255, 0.05);
    
    /* Texto */
    --text-primary: #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.8);
    --text-muted: rgba(255, 255, 255, 0.6);
    --text-subtle: rgba(255, 255, 255, 0.5);
    
    /* Bordes */
    --border-light: rgba(255, 255, 255, 0.1);
    --border-medium: rgba(255, 255, 255, 0.2);
    
    /* Espaciado */
    --spacing-xs: 8px;
    --spacing-sm: 12px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 40px;
    --spacing-xxl: 60px;
    
    /* Bordes redondeados */
    --radius-sm: 12px;
    --radius-md: 16px;
    --radius-lg: 20px;
    --radius-xl: 24px;
    --radius-full: 50px;
    
    /* Transiciones */
    --transition-fast: 0.2s ease;
    --transition-normal: 0.3s ease;
    --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    
    /* Sombras */
    --shadow-sm: 0 4px 15px rgba(0, 0, 0, 0.2);
    --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.4);
    --shadow-primary: 0 15px 40px rgba(102, 126, 234, 0.3);
    --shadow-whatsapp: 0 15px 40px rgba(37, 211, 102, 0.4);
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Raleway', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: linear-gradient(135deg, var(--bg-dark-1) 0%, var(--bg-dark-2) 50%, var(--bg-dark-3) 100%);
    min-height: 100vh;
    color: var(--text-primary);
    overflow-x: hidden;
    line-height: 1.6;
}

/* ==========================================================================
   3. PRELOADER
   ========================================================================== */

.preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--bg-dark-1) 0%, var(--bg-dark-2) 50%, var(--bg-dark-3) 100%);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease, visibility 0.5s ease;
}

.preloader.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

.preloader-logo-container {
    position: relative;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.preloader-spinner {
    position: absolute;
    width: 120px;
    height: 120px;
    border: 3px solid transparent;
    border-top-color: var(--color-primary);
    border-right-color: var(--color-secondary);
    border-radius: 50%;
    animation: preloaderSpin 1.2s linear infinite;
}

.preloader-spinner::before {
    content: '';
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    bottom: 8px;
    border: 3px solid transparent;
    border-top-color: var(--color-accent);
    border-left-color: var(--color-primary);
    border-radius: 50%;
    animation: preloaderSpin 1.8s linear infinite reverse;
}

@keyframes preloaderSpin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.preloader-logo {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
}

.preloader-logo svg {
    width: 100%;
    height: 100%;
}

.preloader-text {
    margin-top: 30px;
    font-size: 1.8rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -1px;
    animation: preloaderPulse 1.5s ease-in-out infinite;
}

@keyframes preloaderPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
}

.preloader-subtext {
    margin-top: 10px;
    font-size: 0.85rem;
    color: var(--text-subtle);
    letter-spacing: 3px;
    text-transform: uppercase;
}

/* ==========================================================================
   4. HERO SECTION
   ========================================================================== */

.hero-section {
    position: relative;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.hero-video-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

/* Overlay gradiente sobre el video/imagen */
.hero-video-container::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        180deg, 
        rgba(15, 15, 26, 0.4) 0%, 
        rgba(15, 15, 26, 0.6) 50%, 
        rgba(15, 15, 26, 0.95) 100%
    );
    z-index: 2;
}

.hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 0 20px;
    max-width: 900px;
}

.hero-logo-text {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 50%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -2px;
    margin-bottom: 10px;
}

.hero-tagline {
    font-size: clamp(1.2rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 20px;
    line-height: 1.4;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
}

/* Indicador de scroll */
.scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-decoration: none;
}

.scroll-indicator:hover {
    transform: translateX(-50%) translateY(-5px);
}

.scroll-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    letter-spacing: 2px;
    text-transform: uppercase;
}

.scroll-arrow {
    width: 30px;
    height: 50px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 25px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
}

.scroll-arrow::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: scrollBounce 2s infinite;
}

@keyframes scrollBounce {
    0%, 100% { 
        transform: translateY(0); 
        opacity: 1; 
    }
    50% { 
        transform: translateY(20px); 
        opacity: 0.3; 
    }
}

/* ==========================================================================
   5. LAYOUT PRINCIPAL
   ========================================================================== */

.main-container {
    padding: 80px 20px;
    transition: 
        transform var(--transition-slow), 
        opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.main-container.slide-out {
    transform: scale(0.95);
    opacity: 0;
    pointer-events: none;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
}

/* Encabezados de sección */
.section-header {
    text-align: center;
    margin-bottom: 50px;
}

.section-header h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 10px;
}

.section-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
}

.bento-grid-section {
    margin-bottom: 40px;
}

/* ==========================================================================
   6. BENTO GRID (SERVICIOS) - SISTEMA RESPONSIVO CORREGIDO
   ========================================================================== */

/*
 * El Bento Grid usa CSS Grid con áreas nombradas para mejor control.
 * Desktop: 4 columnas
 * Tablet: 2 columnas
 * Mobile: 1 columna
 */

.bento-grid {
    display: grid;
    gap: var(--spacing-md);
    width: 100%;
}

/* ----- DESKTOP (> 1024px): Layout de 4 columnas ----- */
.bento-grid-first {
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 180px);
    grid-template-areas:
        "quienes quienes soccer vip"
        "quienes quienes seguros seguros";
}

.bento-grid-second {
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 180px);
    grid-template-areas:
        "copa fan media media"
        "opiniones opiniones opiniones opiniones";
}

/* Asignación de áreas - Grid 1 */
.bento-grid-first .item-quienes { grid-area: quienes; }
.bento-grid-first .item-soccer { grid-area: soccer; }
.bento-grid-first .item-vip { grid-area: vip; }
.bento-grid-first .item-seguros { grid-area: seguros; }

/* Asignación de áreas - Grid 2 */
.bento-grid-second .item-copa { grid-area: copa; }
.bento-grid-second .item-fan { grid-area: fan; }
.bento-grid-second .item-media { grid-area: media; }
.bento-grid-second .item-opiniones { grid-area: opiniones; }

/* Estilos base de cada item */
.bento-item {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
    transform: translateZ(0);
    will-change: transform;
    background: linear-gradient(135deg, #1e1e30 0%, #2a2a40 100%);
    border: 1px solid var(--border-light);
    min-height: 180px;
}

/* Imagen de fondo con pseudo-elemento */
.bento-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform var(--transition-slow);
    z-index: 1;
}

/* Overlay oscuro sobre la imagen */
.bento-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        180deg, 
        rgba(0, 0, 0, 0.2) 0%, 
        rgba(0, 0, 0, 0.4) 50%, 
        rgba(0, 0, 0, 0.8) 100%
    );
    z-index: 2;
}

/* Imágenes de fondo para cada item */
.item-quienes::before { background-image: url('/assets/images/somoss.jpg?v=mknf0rzd'); }
.item-soccer::before { background-image: url('/assets/images/idcup.jpg?v=mknf0rzd'); }
.item-seguros::before { background-image: url('/assets/images/seg.png?v=mknf0rzd'); }
.item-vip::before { background-image: url('/assets/images/vip2.jpg?v=mknf0rzd'); }
.item-copa::before { background-image: url('/assets/images/copa26.jpg?v=mknf0rzd'); }
.item-fan::before { background-image: url('/assets/images/fan.png?v=mknf0rzd'); }
.item-media::before { background-image: url('/assets/images/media.png?v=mknf0rzd'); }
.item-opiniones::before { background-image: url('/assets/images/opi2.jpg?v=mknf0rzd'); }

/* Contenido del bento item */
.bento-content {
    position: relative;
    z-index: 3;
    height: 100%;
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
}

.bento-content h3 {
    font-size: clamp(1rem, 1.5vw, 1.4rem);
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1.3;
}

/* Hover effects */
.bento-item:hover {
    transform: translateY(-4px);
    transition: transform var(--transition-normal);
}

.bento-item:hover::before {
    transform: scale(1.05);
}

/* Animaciones de entrada (staggered) */
.bento-grid-first .bento-item,
.bento-grid-second .bento-item {
    opacity: 0;
    transform: translateY(40px) scale(0.95);
}

.bento-grid-first .bento-item.animated,
.bento-grid-second .bento-item.animated {
    animation: staggeredSlideIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes staggeredSlideIn {
    0% { 
        opacity: 0; 
        transform: translateY(40px) scale(0.95); 
    }
    60% { 
        opacity: 1; 
        transform: translateY(-5px) scale(1.02); 
    }
    100% { 
        opacity: 1; 
        transform: translateY(0) scale(1); 
    }
}

/* ==========================================================================
   7. GALERÍA MASONRY
   ========================================================================== */

.masonry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-sm);
    width: 100%;
}

.masonry-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    transition: 
        transform var(--transition-normal), 
        box-shadow var(--transition-normal);
    min-height: 200px;
}

/* Items altos ocupan 2 filas */
.masonry-item.tall {
    grid-row: span 2;
}

.masonry-item:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-primary);
    z-index: 5;
}

.masonry-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow);
}

.masonry-item:hover img {
    transform: scale(1.05);
}

.masonry-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 40px 16px 16px;
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.85) 100%);
    color: white;
    font-size: 0.95rem;
    font-weight: 600;
}

/* Tarjeta de texto en la galería */
.masonry-text-card {
    background: linear-gradient(
        135deg, 
        rgba(102, 126, 234, 0.15) 0%, 
        rgba(118, 75, 162, 0.15) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 200px;
    grid-row: span 2;
}

.masonry-text-card h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 800;
    margin-bottom: 16px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
}

.masonry-text-card p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.7;
}

/* ==========================================================================
   8. LIGHTBOX
   ========================================================================== */

.lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-normal);
}

.lightbox.active {
    display: flex;
    opacity: 1;
}

.lightbox-content {
    position: relative;
    max-width: 90%;
    max-height: 90%;
}

.lightbox-content img {
    max-width: 100%;
    max-height: 85vh;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
}

.lightbox-close {
    position: absolute;
    top: -50px;
    right: 0;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    color: white;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
}

.lightbox-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
}

.lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    color: white;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
}

.lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.2);
}

.lightbox-prev { left: -70px; }
.lightbox-next { right: -70px; }

/* ==========================================================================
   9. SEGUROS iD
   ========================================================================== */

.seguros-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: calc(100vh - 140px);
    justify-content: center;
}

.seguros-header {
    text-align: center;
    max-width: 700px;
    margin-bottom: 40px;
}

.seguros-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 16px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.seguros-header p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
}

.iphone-video-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
}

/* Mockup de iPhone */
.iphone-frame {
    position: relative;
    width: 300px;
    height: 620px;
    background: linear-gradient(135deg, #1a1a2e 0%, #0a0a15 100%);
    border-radius: 50px;
    padding: 12px;
    box-shadow: 
        0 50px 100px rgba(0, 0, 0, 0.5), 
        0 0 0 3px #2a2a40, 
        inset 0 0 0 1px rgba(255, 255, 255, 0.1);
}

.iphone-notch {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 32px;
    background: #000;
    border-radius: 0 0 20px 20px;
    z-index: 10;
}

.iphone-notch::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    background: #1a1a2e;
    border-radius: 50%;
}

.iphone-screen {
    width: 100%;
    height: 100%;
    background: #000;
    border-radius: 40px;
    overflow: hidden;
    position: relative;
}

.iphone-screen video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.iphone-home-indicator {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 4px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
}

/* Botón CTA */
.cta-conoce-mas {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border: none;
    border-radius: 14px;
    color: white;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-decoration: none;
}

.cta-conoce-mas:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-primary);
}

/* ==========================================================================
   10. COPA 2026
   ========================================================================== */

.copa-fullscreen-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - 70px);
    margin: -30px;
    width: calc(100% + 60px);
}

.copa-text-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 60px 50px;
    text-align: center;
}

.copa-text-content {
    max-width: 480px;
}

.copa-text-section h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 24px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
}

.copa-text-section p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 36px;
}

/* Botón WhatsApp */
.whatsapp-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 36px;
    background: linear-gradient(135deg, var(--color-whatsapp), var(--color-whatsapp-dark));
    border: none;
    border-radius: var(--radius-full);
    color: white;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-decoration: none;
}

.whatsapp-contact-btn:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-whatsapp);
}

.whatsapp-contact-btn svg {
    width: 24px;
    height: 24px;
    fill: white;
}

/* Banner de la Copa */
.copa-banner-section {
    position: relative;
    overflow: hidden;
}

.copa-banner-section img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.copa-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        135deg, 
        rgba(102, 126, 234, 0.4) 0%, 
        rgba(118, 75, 162, 0.4) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
}

.copa-banner-overlay .banner-tag {
    display: inline-block;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    padding: 8px 20px;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
    width: fit-content;
}

.copa-banner-overlay h3 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 12px;
}

.copa-banner-overlay p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1rem;
    max-width: 350px;
}

/* ==========================================================================
   11. MEDIA SECTION
   ========================================================================== */

.media-articles-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
}

.media-article-card {
    display: flex;
    gap: 24px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-normal);
    text-decoration: none;
    color: inherit;
}

.media-article-card:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateX(8px);
    border-color: rgba(102, 126, 234, 0.3);
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.15);
}

.media-article-image {
    width: 240px;
    min-width: 240px;
    height: 160px;
    overflow: hidden;
}

.media-article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
}

.media-article-card:hover .media-article-image img {
    transform: scale(1.05);
}

.media-article-body {
    padding: 24px 24px 24px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
}

.media-article-source {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--text-subtle);
    font-weight: 600;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.media-article-source::before {
    content: '';
    width: 8px;
    height: 8px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 50%;
}

.media-article-card h4 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 10px;
    line-height: 1.4;
    color: var(--text-primary);
}

.media-article-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
}

.media-article-arrow {
    margin-left: auto;
    padding-right: 24px;
    display: flex;
    align-items: center;
    opacity: 0;
    transform: translateX(-10px);
    transition: all var(--transition-normal);
}

.media-article-card:hover .media-article-arrow {
    opacity: 1;
    transform: translateX(0);
}

/* Video Section */
.video-section-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.video-section-title::before {
    content: '';
    width: 4px;
    height: 24px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border-radius: 2px;
}

.video-embed-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* Aspect ratio 16:9 */
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow-md);
}

.video-embed-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
}

/* ==========================================================================
   12. EVENTOS
   ========================================================================== */

.events-section {
    padding: 80px 20px;
    background: linear-gradient(
        180deg, 
        transparent 0%, 
        rgba(102, 126, 234, 0.05) 50%, 
        transparent 100%
    );
}

.events-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: 40px;
}

.event-card {
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-xl);
    overflow: hidden;
    cursor: pointer;
    transition: all var(--transition-normal);
}

.event-card:hover {
    transform: translateY(-8px);
    border-color: rgba(102, 126, 234, 0.5);
    box-shadow: 0 20px 40px rgba(102, 126, 234, 0.2);
}

.event-image {
    position: relative;
    height: 180px;
    overflow: hidden;
}

.event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
}

.event-card:hover .event-image img {
    transform: scale(1.1);
}

.event-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: white;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
}

.event-body {
    padding: var(--spacing-lg);
}

.event-date {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 16px;
}

.event-teams {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 20px;
}

.event-team {
    text-align: center;
    flex: 1;
}

.team-shield {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1a1a2e, #2a2a40);
    margin: 0 auto 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    border: 2px solid var(--border-light);
}

.team-name {
    font-weight: 600;
    font-size: 0.95rem;
}

.event-vs {
    font-size: 1.2rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.3);
}

.event-venue {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 20px;
}

.event-cta {
    width: 100%;
    padding: 14px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    border: none;
    border-radius: var(--radius-sm);
    color: white;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all var(--transition-normal);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: 'Raleway', sans-serif;
}

.event-cta:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-primary);
}

/* Botón ver todos los eventos */
.view-all-events {
    display: flex;
    justify-content: center;
}

.view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 40px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    color: white;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    font-family: 'Raleway', sans-serif;
}

.view-all-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

/* ==========================================================================
   13. CONTACTO
   ========================================================================== */

.contact-section {
    padding: 80px 20px;
    text-align: center;
}

.contact-card {
    max-width: 700px;
    margin: 0 auto;
    background: linear-gradient(
        135deg, 
        rgba(37, 211, 102, 0.1) 0%, 
        rgba(37, 211, 102, 0.05) 100%
    );
    border: 1px solid rgba(37, 211, 102, 0.3);
    border-radius: 30px;
    padding: 60px 40px;
}

.contact-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-whatsapp), var(--color-whatsapp-dark));
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.contact-icon svg {
    width: 40px;
    height: 40px;
    fill: white;
}

.contact-card h2 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 800;
    margin-bottom: 16px;
}

.contact-card p {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 30px;
    line-height: 1.6;
}

.whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 40px;
    background: linear-gradient(135deg, var(--color-whatsapp), var(--color-whatsapp-dark));
    border: none;
    border-radius: var(--radius-full);
    color: white;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-decoration: none;
    font-family: 'Raleway', sans-serif;
}

.whatsapp-btn:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-whatsapp);
}

.whatsapp-btn svg {
    width: 24px;
    height: 24px;
    fill: white;
}

/* ==========================================================================
   14. FOOTER
   ========================================================================== */

.footer {
    background: rgba(0, 0, 0, 0.3);
    border-top: 1px solid var(--border-light);
    padding: 60px 20px 30px;
}

.footer-content {
    max-width: 1200px;
    margin: 0 auto;
}

.footer-main {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-bottom: 40px;
}

.footer-brand,
.footer-social,
.footer-actions {
    text-align: center;
}

.footer-logo {
    font-size: 2rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 16px;
}

.footer-tagline {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
}

.footer-social h4,
.footer-actions h4 {
    font-size: 1rem;
    margin-bottom: 20px;
    color: var(--text-secondary);
}

.social-links {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
}

.social-link {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
    text-decoration: none;
}

.social-link:hover {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    transform: translateY(-3px);
}

.social-link.email-link:hover {
    background: linear-gradient(135deg, #EA4335, #FBBC05);
}

.social-link svg {
    width: 22px;
    height: 22px;
    fill: white;
}

.back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    text-decoration: none;
}

.back-to-top:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

.footer-bottom {
    border-top: 1px solid var(--border-light);
    padding-top: 30px;
    text-align: center;
}

.footer-copyright {
    color: var(--text-subtle);
    font-size: 0.9rem;
    margin-bottom: 16px;
}

.footer-links {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.footer-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--transition-normal);
}

.footer-link:hover {
    color: var(--color-primary);
}

.footer-website {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--transition-normal);
}

.footer-website:hover {
    color: var(--color-secondary);
}

/* ==========================================================================
   15. PANEL DE DETALLE
   ========================================================================== */

.detail-panel {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 1000;
    overflow: hidden;
    transform: scale(0.8);
    opacity: 0;
    visibility: hidden;
    transition: 
        transform var(--transition-slow), 
        opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), 
        visibility 0.5s;
    pointer-events: none;
}

.detail-panel.active {
    transform: scale(1);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.detail-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow-y: auto;
    padding: 0;
}

.panel-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 20px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-light);
}

.back-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    font-family: 'Raleway', sans-serif;
}

.back-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateX(-5px);
}

.panel-tag {
    background: rgba(255, 255, 255, 0.15);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: none;
}

.panel-body {
    padding: 30px;
    max-width: 1400px;
    margin: 0 auto;
}

.panel-body.no-padding {
    padding: 0;
    max-width: 100%;
}

.panel-body.fx-padding {
    max-width: 100%;
}

.panel-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 20px;
    line-height: 1.1;
}

.panel-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 40px;
    max-width: 800px;
}

/* Colores de fondo para cada panel */
.panel-quienes { background: linear-gradient(135deg, #1a1025 0%, #2d1a4e 50%, #1e1535 100%); }
.panel-soccer { background: linear-gradient(135deg, #1a1530 0%, #2a1f50 50%, #1c1235 100%); }
.panel-seguros { background: linear-gradient(135deg, #201530 0%, #351a55 50%, #251040 100%); }
.panel-vip { background: linear-gradient(135deg, #1a1035 0%, #301a60 50%, #1f1040 100%); }
.panel-copa { background: linear-gradient(135deg, #251540 0%, #3a1a65 50%, #2a1050 100%); }
.panel-fan { background: linear-gradient(135deg, #1e1540 0%, #2f1a55 50%, #221045 100%); }
.panel-media { background: linear-gradient(135deg, #201035 0%, #351555 50%, #251040 100%); }
.panel-opiniones { background: linear-gradient(135deg, #1c1530 0%, #2c1a4a 50%, #1e1235 100%); }

/* ==========================================================================
   16. TESTIMONIOS
   ========================================================================== */

.testimonials-container {
    position: relative;
    overflow: hidden;
}

.testimonials-track {
    display: flex;
    gap: var(--spacing-lg);
    transition: transform var(--transition-slow);
}

.testimonial-card {
    flex: 0 0 400px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 30px;
}

.testimonial-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
}

.testimonial-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.5rem;
}

.testimonial-info h4 {
    font-size: 1.1rem;
    margin-bottom: 4px;
}

.testimonial-info p {
    color: var(--text-muted);
    font-size: 0.85rem;
}

.testimonial-stars {
    color: #ffc107;
    font-size: 1.2rem;
    margin-bottom: 16px;
}

.testimonial-text {
    color: var(--text-secondary);
    line-height: 1.7;
    font-style: italic;
}

.slider-controls {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
}

.slider-btn {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
}

.slider-btn:hover {
    background: rgba(255, 255, 255, 0.2);
}

/* ==========================================================================
   17. MODAL DE EVENTOS
   ========================================================================== */

.events-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.95);
    z-index: 2000;
    display: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    overflow-y: auto;
}

.events-modal.active {
    display: block;
    opacity: 1;
}

.events-modal-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
}

.events-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 20px;
}

.events-modal-header h2 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
}

.close-modal-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
    padding: 12px 24px;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-normal);
    font-family: 'Raleway', sans-serif;
}

.close-modal-btn:hover {
    background: rgba(255, 255, 255, 0.2);
}

.loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 400px;
}

.loading-spinner {
    width: 60px;
    height: 60px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 20px;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.loading-text {
    color: var(--text-muted);
    font-size: 1rem;
}

.all-events-grid {
    display: none;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
}

.all-events-grid.loaded {
    display: grid;
}

/* ==========================================================================
   18. MEDIA QUERIES (RESPONSIVO)
   ========================================================================== 
   
   Breakpoints:
   - Desktop grande: > 1200px (default)
   - Desktop: 1024px - 1200px
   - Tablet: 768px - 1024px
   - Tablet pequeña: 640px - 768px
   - Mobile: < 640px
   
   ========================================================================== */

/* ----- DESKTOP PEQUEÑO (max 1200px) ----- */
@media (max-width: 1200px) {
    .container {
        padding: 0 20px;
    }
    
    .events-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .all-events-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* ----- TABLET GRANDE (max 1024px) ----- */
@media (max-width: 1024px) {
    /* Bento Grid - 2 columnas */
    .bento-grid-first {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: auto auto auto;
        grid-template-areas:
            "quienes quienes"
            "soccer vip"
            "seguros seguros";
    }
    
    .bento-grid-second {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: auto auto auto;
        grid-template-areas:
            "copa fan"
            "media media"
            "opiniones opiniones";
    }
    
    .bento-item {
        min-height: 200px;
    }
    
    /* Galería Masonry - 2 columnas */
    .masonry-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .masonry-text-card {
        grid-column: span 2;
        grid-row: span 1;
    }
    
    /* Media articles apilados */
    .media-article-card {
        flex-direction: column;
    }
    
    .media-article-image {
        width: 100%;
        min-width: 100%;
        height: 200px;
    }
    
    .media-article-body {
        padding: var(--spacing-lg);
    }
    
    .media-article-arrow {
        display: none;
    }
    
    /* Copa 2026 */
    .copa-fullscreen-wrapper {
        grid-template-columns: 1fr;
        margin: 0;
        width: 100%;
    }
    
    .copa-text-section {
        padding: 40px 30px;
    }
    
    .copa-banner-section {
        min-height: 350px;
    }
    
    /* Testimonios más pequeños */
    .testimonial-card {
        flex: 0 0 320px;
    }
    
    /* Lightbox nav */
    .lightbox-prev { left: 10px; }
    .lightbox-next { right: 10px; }
    
    /* Footer */
    .footer-main {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .footer-brand {
        grid-column: span 2;
    }
}

/* ----- TABLET (max 768px) ----- */
@media (max-width: 768px) {
    .main-container {
        padding: 60px 16px;
    }
    
    .section-header {
        margin-bottom: 40px;
    }
    
    /* Eventos - 1 columna */
    .events-grid {
        grid-template-columns: 1fr;
    }
    
    .events-section {
        padding: 60px 16px;
    }
    
    /* Contacto */
    .contact-section {
        padding: 60px 16px;
    }
    
    .contact-card {
        padding: 40px 24px;
    }
    
    /* iPhone mockup más pequeño */
    .iphone-frame {
        width: 280px;
        height: 580px;
    }
    
    /* Footer */
    .footer-main {
        grid-template-columns: 1fr;
        gap: 30px;
    }
    
    .footer-brand {
        grid-column: span 1;
    }
    
    .footer {
        padding: 50px 16px 24px;
    }
    
    /* Modal de eventos */
    .all-events-grid {
        grid-template-columns: 1fr;
    }
    
    /* Hero */
    .hero-section {
        min-height: 500px;
    }
    
    .scroll-indicator {
        bottom: 30px;
    }
}

/* ----- TABLET PEQUEÑA (max 640px) ----- */
@media (max-width: 640px) {
    .main-container {
        padding: 50px 12px;
    }
    
    /* Bento Grid - 1 columna en móvil */
    .bento-grid-first,
    .bento-grid-second {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: var(--spacing-sm);
    }
    
    .bento-grid-first {
        grid-template-areas:
            "quienes"
            "soccer"
            "vip"
            "seguros";
    }
    
    .bento-grid-second {
        grid-template-areas:
            "copa"
            "fan"
            "media"
            "opiniones";
    }
    
    .bento-item {
        min-height: 160px;
    }
    
    /* Galería Masonry - 1 columna */
    .masonry-grid {
        grid-template-columns: 1fr;
    }
    
    .masonry-text-card {
        grid-column: span 1;
    }
    
    .masonry-item.tall {
        grid-row: span 1;
    }
    
    /* Panel de detalle */
    .panel-header {
        padding: 16px 16px;
    }
    
    .back-btn {
        padding: 10px 16px;
        font-size: 0.85rem;
    }
    
    .panel-tag {
        font-size: 0.7rem;
        padding: 6px 12px;
    }
    
    .panel-body {
        padding: 20px 16px;
    }
    
    /* Detail panel - slide from right en móvil */
    .detail-panel {
        transform: translateX(100%);
        opacity: 1;
    }
    
    .detail-panel.active {
        transform: translateX(0);
    }
    
    /* iPhone mockup */
    .iphone-frame {
        width: 260px;
        height: 540px;
    }
    
    /* Testimonios */
    .testimonial-card {
        flex: 0 0 280px;
        padding: 24px;
    }
    
    /* Copa 2026 */
    .copa-fullscreen-wrapper {
        margin: -20px -16px;
        width: calc(100% + 32px);
    }
    
    .copa-text-section {
        padding: 30px 20px;
    }
    
    .copa-banner-section {
        min-height: 280px;
    }
    
    .copa-banner-overlay {
        padding: 24px;
    }
    
    .copa-banner-overlay h3 {
        font-size: 1.4rem;
    }
    
    /* Lightbox */
    .lightbox-nav {
        width: 40px;
        height: 40px;
    }
    
    .lightbox-prev { left: 5px; }
    .lightbox-next { right: 5px; }
    .lightbox-close { 
        top: 10px; 
        right: 10px;
        position: fixed;
    }
    
    /* Footer */
    .footer {
        padding: 40px 12px 20px;
    }
    
    .footer-links {
        flex-direction: column;
        gap: 12px;
    }
    
    /* Preloader */
    .preloader-logo-container {
        width: 100px;
        height: 100px;
    }
    
    .preloader-spinner {
        width: 100px;
        height: 100px;
    }
    
    .preloader-logo {
        width: 50px;
        height: 50px;
    }
    
    .preloader-text {
        font-size: 1.5rem;
    }
    
    /* Botones más pequeños */
    .whatsapp-btn,
    .whatsapp-contact-btn,
    .cta-conoce-mas {
        padding: 14px 28px;
        font-size: 1rem;
    }
    
    .view-all-btn {
        padding: 14px 30px;
        font-size: 0.95rem;
    }
}

/* ----- MOBILE PEQUEÑO (max 480px) ----- */
@media (max-width: 480px) {
    .main-container {
        padding: 40px 10px;
    }
    
    .bento-item {
        min-height: 140px;
    }
    
    .bento-content {
        padding: 16px;
    }
    
    .bento-content h3 {
        font-size: 1rem;
    }
    
    .section-header {
        margin-bottom: 30px;
    }
    
    .section-header h2 {
        font-size: 1.8rem;
    }
    
    .events-section {
        padding: 40px 10px;
    }
    
    .event-body {
        padding: 16px;
    }
    
    .team-shield {
        width: 50px;
        height: 50px;
        font-size: 1.5rem;
    }
    
    .contact-section {
        padding: 40px 10px;
    }
    
    .contact-card {
        padding: 30px 16px;
        border-radius: 20px;
    }
    
    /* Panel */
    .panel-body {
        padding: 16px 12px;
    }
    
    .panel-title {
        font-size: 1.8rem;
    }
    
    .panel-description {
        font-size: 1rem;
        margin-bottom: 24px;
    }
    
    /* Testimonios más compactos */
    .testimonial-card {
        flex: 0 0 260px;
        padding: 20px;
    }
    
    .testimonial-avatar {
        width: 50px;
        height: 50px;
        font-size: 1.2rem;
    }
    
    /* iPhone mockup */
    .iphone-frame {
        width: 240px;
        height: 500px;
        border-radius: 40px;
    }
    
    .iphone-screen {
        border-radius: 35px;
    }
    
    /* Modal eventos */
    .events-modal-content {
        padding: 20px 10px;
    }
    
    .events-modal-header {
        margin-bottom: 24px;
    }
    
    .close-modal-btn {
        padding: 10px 16px;
        font-size: 0.85rem;
    }
}

/* ----- ALTURA PEQUEÑA (landscape móvil) ----- */
@media (max-height: 600px) and (orientation: landscape) {
    .hero-section {
        min-height: 100vh;
    }
    
    .scroll-indicator {
        display: none;
    }
    
    .preloader-logo-container {
        width: 80px;
        height: 80px;
    }
    
    .preloader-spinner {
        width: 80px;
        height: 80px;
    }
    
    .preloader-text {
        font-size: 1.2rem;
        margin-top: 20px;
    }
}

/* ----- PREFERENCIAS DE ACCESIBILIDAD ----- */

/* Reduce movimiento para usuarios que lo prefieren */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
    
    html {
        scroll-behavior: auto;
    }
    
    .bento-item:hover::before {
        transform: none;
    }
    
    .masonry-item:hover img {
        transform: none;
    }
}

/* Alto contraste */
@media (prefers-contrast: high) {
    :root {
        --border-light: rgba(255, 255, 255, 0.3);
        --border-medium: rgba(255, 255, 255, 0.5);
    }
    
    .bento-item,
    .event-card,
    .testimonial-card,
    .media-article-card {
        border-width: 2px;
    }
}

/* ==========================================================================
   FIN DEL ARCHIVO
   ========================================================================== */