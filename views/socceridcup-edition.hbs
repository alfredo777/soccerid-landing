  .gl-lightbox__close:hover { background: rgba(255,255,255,0.15); }
  .gl-lightbox__img-wrap { position: relative; z-index: 1; max-width: 92vw; max-height: 85vh; display: flex; align-items: center; justify-content: center; }
  .gl-lightbox__img-wrap img { max-width: 92vw; max-height: 85vh; object-fit: contain; border-radius: 6px; user-select: none; box-shadow: 0 8px 60px rgba(0,0,0,0.6); }
  .gl-lightbox__nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: #fff; width: 52px; height: 52px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
