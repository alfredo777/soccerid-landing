</style>

<script>
(function() {
  var images = [{{#each edition.images}}{ src: "{{this.src}}", alt: "{{this.alt}}" }{{#unless @last}},{{/unless}}{{/each}}];
  var total = images.length;
  var currentSlide = 0;
  var track = document.getElementById('ceSliderTrack');
  var dotsWrap = document.getElementById('ceSliderDots');

  for (var i = 0; i < total; i++) {
    var dot = document.createElement('button');
    dot.className = 'ce-slider__dot' + (i === 0 ? ' active' : '');
    dot.type = 'button';
    dot.setAttribute('data-idx', i);
    dot.onclick = function() { goToSlide(parseInt(this.getAttribute('data-idx'))); };
    dotsWrap.appendChild(dot);
  }

  function goToSlide(idx) {
    currentSlide = ((idx % total) + total) % total;
    track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
    var dots = dotsWrap.querySelectorAll('.ce-slider__dot');
    for (var i = 0; i < dots.length; i++) dots[i].classList.toggle('active', i === currentSlide);
  }

  window.slideEdition = function(dir) { goToSlide(currentSlide + dir); };

  var startX = 0;
  var slider = document.getElementById('ceSlider');
  slider.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive: true });
  slider.addEventListener('touchend', function(e) {
    var diff = e.changedTouches[0].clientX - startX;
    if (Math.abs(diff) > 50) slideEdition(diff > 0 ? -1 : 1);
  }, { passive: true });

  var lightbox = document.getElementById('glLightbox');
  var imgEl = document.getElementById('glImage');
  var counterEl = document.getElementById('glCounter');
  var lbIdx = 0;

  window.openEditionLightbox = function(idx) {
    lbIdx = idx;
    showLbImage();
    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
  };
  window.closeEditionLightbox = function() {
    lightbox.classList.remove('active');
    document.body.style.overflow = '';
  };
  window.navigateEdition = function(dir) {
    lbIdx = (lbIdx + dir + total) % total;
    showLbImage();
  };
  function showLbImage() {
    imgEl.src = images[lbIdx].src;
    imgEl.alt = images[lbIdx].alt;
    counterEl.textContent = (lbIdx + 1) + ' / ' + total;
  }
  document.addEventListener('keydown', function(e) {
    if (!lightbox.classList.contains('active')) return;
    if (e.key === 'Escape') closeEditionLightbox();
    if (e.key === 'ArrowLeft') navigateEdition(-1);
    if (e.key === 'ArrowRight') navigateEdition(1);
  });
  lightbox.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, { passive: true });
  lightbox.addEventListener('touchend', function(e) {
    var diff = e.changedTouches[0].clientX - startX;
    if (Math.abs(diff) > 50) navigateEdition(diff > 0 ? -1 : 1);
  }, { passive: true });
})();

(function() {
  var btn = document.getElementById('gpGoTop');
  if (!btn) return;
  window.addEventListener('scroll', function() {
    btn.classList.toggle('visible', window.scrollY > 400);
  }, { passive: true });
})();
</script>
