  .gl-lightbox__counter { position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 2; background: rgba(0,0,0,0.5); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); color: #fff; font-size: 14px; font-weight: 700; padding: 8px 20px; border-radius: 24px; letter-spacing: 2px; border: 1px solid rgba(255,255,255,0.06); }

  @media (max-width: 600px) {
    .gl-lightbox__nav { width: 42px; height: 42px; }
    .gl-lightbox__nav--prev { left: 8px; }
    .gl-lightbox__nav--next { right: 8px; }
    .gl-lightbox__img-wrap img { max-width: 96vw; border-radius: 4px; }
