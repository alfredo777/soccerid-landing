<div class="promo-page gallery-page">

  <!-- ═══ HERO ═══ -->
  <section class="gp-hero gp-hero--edition">
    <img class="gp-hero__bg" src="{{edition.banner}}" alt="{{edition.title}}">
    <div class="gp-hero__dim"></div>
    <div class="gp-hero__grain"></div>

    <a href="/{{lang}}/socceridcup" class="gp-nav-back">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    </a>


    <div class="gp-hero__body">
      <div class="gp-hero__logo">
        <img src="/assets/images/iconsoccerid.png" alt="SOCCER iD" height="36">
      </div>
      <h1 class="gp-hero__title">
        <span class="gp-hero__title-main">SOCCER iD CUP</span>
        <span class="gp-hero__title-year">{{edition.year}}</span>
      </h1>
      <p class="gp-hero__sub">{{edition.match}}</p>
      <div class="gp-hero__pills">
        <span class="gp-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          {{edition.city}}
        </span>
        <span class="gp-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 7v4a9 9 0 0018 0V7M3 7c0-1.1 4.03-2 9-2s9 .9 9 2"/></svg>
          {{edition.venue}}
        </span>
      </div>
      <button class="gp-hero__cta" onclick="document.getElementById('editionStats').scrollIntoView({behavior:'smooth'})" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
      </button>
    </div>
  </section>

  <!-- ═══ STATS ═══ -->
  <section class="ce-stats" id="editionStats">
    <div class="ce-stats__inner">
      <div class="ce-stats__text">
        <span class="gp-label">{{#if isEs}}LA EDICIÓN{{else}}THE EDITION{{/if}}</span>
        <h2 class="ce-stats__heading">{{edition.description}}</h2>
      </div>
      <div class="ce-stats__cards">
        {{#each edition.stats}}
        <div class="gp-stat-card">
          <span class="gp-stat-card__value">{{this.value}}</span>
          <span class="gp-stat-card__label">{{this.label}}</span>
          <span class="gp-stat-card__sub">{{this.sub}}</span>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ═══ PHOTO GALLERY SLIDER ═══ -->
  <section class="ce-gallery">
    <div class="ce-gallery__inner">
      <span class="gp-label">{{#if isEs}}MOMENTOS{{else}}MOMENTS{{/if}}</span>
      {{#if edition.galleryNote}}
      <p class="ce-gallery__note">{{edition.galleryNote}}</p>
      {{/if}}
    </div>
    <div class="ce-slider" id="ceSlider">
      <div class="ce-slider__track" id="ceSliderTrack">
        {{#each edition.images}}
        <div class="ce-slider__slide" onclick="openEditionLightbox({{@index}})">
          <img src="{{this.src}}" alt="{{this.alt}}" loading="lazy" draggable="false">
        </div>
        {{/each}}
      </div>
      <button class="ce-slider__btn ce-slider__btn--prev" onclick="slideEdition(-1)" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="ce-slider__btn ce-slider__btn--next" onclick="slideEdition(1)" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
      </button>
      <div class="ce-slider__dots" id="ceSliderDots"></div>
    </div>
  </section>

  <!-- ═══ VIDEOS ═══ -->
  {{#gt edition.videos.length 0}}
  <section class="ce-videos">
    <div class="ce-videos__inner">
      <span class="gp-label">{{#if isEs}}VIDEOS{{else}}VIDEOS{{/if}}</span>
      <div class="ce-videos__grid">
        {{#each edition.videos}}
        <div class="ce-videos__item">
          <div class="ce-videos__embed">
            <iframe src="https://www.youtube.com/embed/{{this.id}}?mute=1" title="{{this.title}}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
          </div>
          <span class="ce-videos__title">{{this.title}}</span>
        </div>
        {{/each}}
      </div>
    </div>
  </section>
  {{/gt}}

  <!-- ═══ SPONSORS ═══ -->
  <section class="ce-sponsors">
    <div class="ce-sponsors__inner">
      <span class="gp-label">{{#if isEs}}PATROCINADORES{{else}}SPONSORS{{/if}}</span>
      <div class="ce-sponsors__grid">
        {{#each edition.sponsors}}
        <div class="ce-sponsors__item">
          <img src="{{this.src}}" alt="{{this.alt}}">
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ═══ MEDIA / PRESS ═══ -->
  <section class="ce-media">
    <div class="ce-media__inner">
      <span class="gp-label">{{#if isEs}}NOTAS EN MEDIOS{{else}}MEDIA COVERAGE{{/if}}</span>
      {{#gt edition.mediaLinks.length 0}}
      <div class="ce-media__list">
        {{#each edition.mediaLinks}}
        <a class="ce-media__item" href="{{this.url}}" target="_blank" rel="noopener">
          {{#if this.image}}
          <div class="ce-media__thumb">
            <img src="{{this.image}}" alt="" loading="lazy">
          </div>
          {{else}}
          <div class="ce-media__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 22h16a2 2 0 002-2V4a2 2 0 00-2-2H8a2 2 0 00-2 2v16a2 2 0 01-2 2zm0 0a2 2 0 01-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M18 18h-8M18 10h-8"/></svg>
          </div>
          {{/if}}
          <div class="ce-media__text">
            <span class="ce-media__title">{{this.title}}</span>
            <span class="ce-media__source">{{this.source}}</span>
          </div>
          <svg class="ce-media__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
        </a>
        {{/each}}
      </div>
      {{else}}
      <div class="ce-placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 22h16a2 2 0 002-2V4a2 2 0 00-2-2H8a2 2 0 00-2 2v16a2 2 0 01-2 2zm0 0a2 2 0 01-2-2v-9c0-1.1.9-2 2-2h2"/></svg>
        <p>{{#if isEs}}Próximamente{{else}}Coming soon{{/if}}</p>
      </div>
      {{/gt}}
    </div>
  </section>

  <!-- ═══ PUBLICACIONES DE LOS CLUBES ═══ -->
  <section class="bts-section">
    <div class="bts">
      <div class="bts-head">
        <div>
          <span class="gp-label">{{#if isEs}}REDES SOCIALES{{else}}SOCIAL MEDIA{{/if}}</span>
          <h2 class="bts-section__title">{{#if isEs}}Publicaciones de los clubes{{else}}Club posts{{/if}}</h2>
          <p class="bts-sub">{{#if isEs}}Los clubes en redes sociales · desliza para ver más{{else}}The clubs on social media · swipe to see more{{/if}}</p>
        </div>
        <div class="bts-nav">
          <button class="bts-arrow bts-prev" type="button" aria-label="{{#if isEs}}Anterior{{else}}Previous{{/if}}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg></button>
          <button class="bts-arrow bts-next" type="button" aria-label="{{#if isEs}}Siguiente{{else}}Next{{/if}}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg></button>
        </div>
      </div>
      <div class="bts-track">
        {{#eq edition.year '2023'}}
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#c8a24a"></span>Pumas · 2023</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/C3rNzPHMSoT/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#c8a24a"></span>Pumas · 2023</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/C45zMSiLAal/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#e8e8e8"></span>Comunicaciones · 2023</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/C3ql6KWx0eR/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#e8e8e8"></span>Comunicaciones · 2023</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/C44uMApuSf7/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        {{/eq}}
        {{#eq edition.year '2024'}}
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#ffe600"></span>América · 2024</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/C_MIUMKy4KW/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#ffe600"></span>América · 2024</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/C-ibrhTxVFY/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#009639"></span>Atlético Nacional · 2024</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/C_nUjsJROIO/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#009639"></span>Atlético Nacional · 2024</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/C_eW4TIqzlG/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        {{/eq}}
        {{#eq edition.year '2025'}}
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#c8a24a"></span>Pumas · 2025</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/DHMbo_-uwxz/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#c8a24a"></span>Pumas · 2025</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/DHgc8InsfGf/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#ff8a00"></span>Tigres · 2025</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/DXYZnyvjSx4/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        <div class="bts-card"><div class="bts-card__tag"><span class="bts-dot" style="background:#ff8a00"></span>Tigres · 2025</div><div class="bts-embed"><iframe src="https://www.instagram.com/p/DXYZdVQDU3q/embed" loading="lazy" scrolling="no" frameborder="0" allowtransparency="true" allowfullscreen></iframe></div></div>
        {{/eq}}
      </div>
      <div class="bts-dots" aria-hidden="true"></div>
    </div>
  </section>

  {{#eq edition.year '2024'}}
  {{!-- ═══ DETRÁS DE CÁMARAS (Orlando 2024) ═══ --}}
  <section class="bts-section">
    <span class="gp-label">SOCCER iD CUP</span>
    <h2 class="bts-section__title">{{#if isEs}}Detrás de cámaras{{else}}Behind the scenes{{/if}}</h2>
    <div class="bts-videowrap">
      <a class="bts-card bts-video" href="https://www.facebook.com/soccerid7/videos/907822141540511/" target="_blank" rel="noopener"><div class="bts-card__tag"><span class="bts-dot" style="background:#6c3ce0"></span>{{edition.city}}</div><div class="bts-embed bts-poster" style="background-image:url('{{edition.banner}}')"><span class="bts-play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="bts-watch">{{#if isEs}}Ver en Facebook{{else}}Watch on Facebook{{/if}}</span></div></a>
    </div>
  </section>
  {{/eq}}
  {{#eq edition.year '2025'}}
  {{!-- ═══ DETRÁS DE CÁMARAS (Austin 2025) ═══ --}}
  <section class="bts-section">
    <span class="gp-label">SOCCER iD CUP</span>
    <h2 class="bts-section__title">{{#if isEs}}Detrás de cámaras{{else}}Behind the scenes{{/if}}</h2>
    <div class="bts-videowrap">
      <a class="bts-card bts-video" href="https://www.facebook.com/reel/1372392885003887" target="_blank" rel="noopener"><div class="bts-card__tag"><span class="bts-dot" style="background:#6c3ce0"></span>{{edition.city}}</div><div class="bts-embed bts-poster" style="background-image:url('{{edition.banner}}')"><span class="bts-play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="bts-watch">{{#if isEs}}Ver en Facebook{{else}}Watch on Facebook{{/if}}</span></div></a>
    </div>
  </section>
  {{/eq}}

  {{> bts-assets}}

  <!-- ═══ EDITION NAV ═══ -->
  <nav class="ce-nav">
    <div class="ce-nav__inner">
      {{#if prevEdition}}
      <a class="ce-nav__link ce-nav__link--prev" href="/{{lang}}/socceridcup/{{prevEdition.year}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        <div class="ce-nav__text">
          <span class="ce-nav__label">{{prevEdition.year}}</span>
          <span class="ce-nav__match">{{prevEdition.match}}</span>
        </div>
      </a>
      {{else}}
      <span></span>
      {{/if}}
      <a class="ce-nav__all" href="/{{lang}}/socceridcup">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      </a>
      {{#if nextEdition}}
      <a class="ce-nav__link ce-nav__link--next" href="/{{lang}}/socceridcup/{{nextEdition.year}}">
        <div class="ce-nav__text" style="text-align:right">
          <span class="ce-nav__label">{{nextEdition.year}}</span>
          <span class="ce-nav__match">{{nextEdition.match}}</span>
        </div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      {{else}}
      <span></span>
      {{/if}}
    </div>
  </nav>

  <!-- ═══ CTA ═══ -->
  <section class="gp-cta-section">
    <img class="gp-cta-section__bg" src="{{edition.banner}}" alt="">
    <div class="gp-cta-section__dim"></div>
    <div class="gp-cta-section__body">
      <span class="gp-label" style="color:rgba(255,255,255,0.7)">SOCCER iD CUP 2027</span>
      <h2 class="gp-cta-section__title">{{#if isEs}}Sé parte de la experiencia{{else}}Be part of the experience{{/if}}</h2>
      <a class="gp-cta-btn" href="https://wa.me/17867844303?text=Hola!%20Quiero%20ser%20socio%20estrat%C3%A9gico%20de%20SOCCER%20iD%20CUP%202027" target="_blank">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        {{#if isEs}}Quiero ser parte / Socios estratégicos{{else}}Become a partner / Strategic allies{{/if}}
      </a>
    </div>
  </section>

  <!-- ═══ FOOTER ═══ -->
  <footer class="gp-footer">
    <a href="/{{lang}}/socceridcup" class="gp-footer__back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      {{#if isEs}}SOCCER iD CUP{{else}}SOCCER iD CUP{{/if}}
    </a>
    <img src="/assets/images/iconsoccerid.png" alt="SOCCER iD" height="28">
    <span>SOCCER iD &copy; {{year}}</span>
  </footer>

  <!-- ═══ GO TO TOP ═══ -->
  <button class="gp-go-top" id="gpGoTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" type="button" aria-label="Go to top">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 15l-6-6-6 6"/></svg>
  </button>
</div>

<!-- ═══ LIGHTBOX ═══ -->
<div class="gl-lightbox" id="glLightbox">
  <div class="gl-lightbox__backdrop" onclick="closeEditionLightbox()"></div>
  <button class="gl-lightbox__close" onclick="closeEditionLightbox()" type="button">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <button class="gl-lightbox__nav gl-lightbox__nav--prev" onclick="navigateEdition(-1)" type="button">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <div class="gl-lightbox__img-wrap">
    <img id="glImage" src="" alt="" draggable="false">
  </div>
  <button class="gl-lightbox__nav gl-lightbox__nav--next" onclick="navigateEdition(1)" type="button">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
  </button>
  <div class="gl-lightbox__counter" id="glCounter"></div>
</div>

<style>
  .gallery-page.promo-page { max-width: 100%; }
  .gallery-page .promo-back { display: none; }

  .gp-label {
    display: inline-block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #9b59f0;
    margin-bottom: 10px;
  }
  .gp-section-title {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -0.5px;
    color: #fff;
    margin-bottom: 8px;
  }

  /* ═══ HERO ═══ */
  .gp-hero { position: relative; width: 100%; height: 75vh; height: 75svh; min-height: 480px; overflow: hidden; display: flex; align-items: flex-end; }
  .gp-hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .gp-hero__dim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,26,0.5) 0%, rgba(10,10,26,0) 25%, rgba(10,10,26,0.15) 50%, rgba(10,10,26,0.85) 78%, #0a0a1a 100%); }
  .gp-hero__grain { position: absolute; inset: 0; opacity: 0.04; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); pointer-events: none; }

  .gp-nav-back { position: absolute; top: 16px; left: 16px; z-index: 20; width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.5); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-radius: 50%; border: 1px solid rgba(255,255,255,0.12); color: #fff; text-decoration: none; transition: background 0.2s; }
  .gp-nav-back:hover { background: rgba(108,60,224,0.6); }


