  /* ═══ GO TO TOP ═══ */
  .gp-go-top { position: fixed; bottom: 28px; right: 28px; z-index: 900; width: 46px; height: 46px; border: none; border-radius: 50%; background: rgba(108,60,224,0.85); color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(0,0,0,0.4); opacity: 0; visibility: hidden; transform: translateY(12px); transition: opacity 0.3s, visibility 0.3s, transform 0.3s; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .gp-go-top.visible { opacity: 1; visibility: visible; transform: translateY(0); }
