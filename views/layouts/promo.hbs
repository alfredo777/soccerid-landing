<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <meta name="description" content="{{description}}">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{baseUrl}}/{{lang}}{{currentPath}}">
  <meta property="og:title" content="{{ogTitle}}">
  <meta property="og:description" content="{{ogDescription}}">
  <meta property="og:image" content="{{baseUrl}}{{ogImage}}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="SOCCER iD">
  <meta property="og:locale" content="{{ogLocale}}">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="{{baseUrl}}/{{lang}}{{currentPath}}">
  <meta name="twitter:title" content="{{ogTitle}}">
  <meta name="twitter:description" content="{{ogDescription}}">
  <meta name="twitter:image" content="{{baseUrl}}{{ogImage}}">

  <link rel="canonical" href="{{baseUrl}}/{{lang}}{{currentPath}}">
  <link rel="icon" href="/assets/images/iconsoccerid.png" type="image/png">
  <link rel="apple-touch-icon" href="/assets/images/iconsoccerid.png">

  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0a0a1a;
      color: #fff;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .promo-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      max-width: 780px;
      margin: 0 auto;
      position: relative;
    }

    .promo-back {
      position: absolute;
      top: 16px;
      left: 16px;
      z-index: 10;
      display: flex;
      align-items: center;
      gap: 6px;
      color: #fff;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      background: rgba(0,0,0,0.45);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      padding: 8px 14px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.1);
      transition: background 0.2s;
    }
    .promo-back:hover { background: rgba(108,60,224,0.5); }

    .promo-banner {
      width: 100%;
      position: relative;
    }

    .promo-banner img {
      width: 100%;
      height: auto;
      display: block;
    }

    .promo-banner img {
      max-height: 440px;
      object-fit: cover;
    }

    .promo-content {
      flex: 1;
      padding: 28px 32px 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
      background: linear-gradient(180deg, #0f0f2e 0%, #0a0a1a 100%);
    }

    @media (min-width: 781px) {
      body {
        background: linear-gradient(180deg, #0f0f2e 0%, #0a0a1a 100%);
      }
      .promo-page {
        box-shadow: 0 0 60px rgba(108,60,224,0.15);
        border-left: 1px solid rgba(255,255,255,0.06);
        border-right: 1px solid rgba(255,255,255,0.06);
      }
    }

    .promo-badge {
      display: inline-block;
      background: linear-gradient(135deg, #6c3ce0, #9b59f0);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 20px;
      margin-bottom: 16px;
    }

    .promo-teams {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
      width: 100%;
      justify-content: center;
    }

    .promo-team {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      flex: 1;
      max-width: 120px;
    }

    .promo-team img {
      width: 64px;
      height: 64px;
      object-fit: contain;
    }

    .promo-team span {
      font-size: 14px;
      font-weight: 600;
      text-align: center;
      line-height: 1.2;
    }

    .promo-vs {
      font-size: 20px;
      font-weight: 800;
      color: #9b59f0;
      text-transform: uppercase;
    }

    .promo-details {
      width: 100%;
      max-width: 400px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 24px;
    }

    .promo-detail-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
    }

    .promo-detail-row + .promo-detail-row {
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .promo-detail-row svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      fill: #9b59f0;
    }

    .promo-detail-row .detail-label {
      font-size: 11px;
      color: rgba(255,255,255,0.5);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .promo-detail-row .detail-value {
      font-size: 15px;
      font-weight: 600;
    }

    .promo-detail-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .promo-cta {
      width: 100%;
      max-width: 400px;
      margin-bottom: 16px;
    }

    .promo-cta a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 16px 24px;
      background: linear-gradient(135deg, #6c3ce0, #9b59f0);
      color: #fff;
      text-decoration: none;
      font-size: 16px;
      font-weight: 700;
      border-radius: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .promo-cta a:active {
      transform: scale(0.97);
    }

    .promo-cta a svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }

    .promo-share {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
    }

    .promo-share a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      transition: background 0.2s;
    }

    .promo-share a:active {
      background: rgba(255,255,255,0.15);
    }

    .promo-share a svg {
      width: 20px;
      height: 20px;
      fill: #fff;
    }

    .promo-logo {
      margin-top: auto;
      padding-top: 16px;
      opacity: 0.6;
    }

    .promo-logo img {
      height: 32px;
    }

    .promo-powered {
      font-size: 11px;
      color: rgba(255,255,255,0.3);
      margin-top: 8px;
      text-align: center;
    }
  </style>
</head>
<body>
  {{{body}}}
</body>
</html>
