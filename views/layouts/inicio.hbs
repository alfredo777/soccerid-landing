<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SOCCER iD</title>
  <meta name="description" content="{{description}}">
  <link rel="canonical" href="{{baseUrl}}/{{lang}}">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/css/inicio.css?v={{version}}">
</head>
<body class="inicio">
  {{!-- Cabecera de texto: logo y enlaces, nada más. El menú completo para
        celular es un ancla (#menu) pintada con :target, sin JavaScript. --}}
  <header class="cab">
    <a class="cab__logo" href="/{{lang}}" aria-label="SOCCER iD, inicio">
      <img src="/assets/images/logo-horizontal-blanco.png" alt="SOCCER iD" width="132" height="30">
    </a>
    <nav class="cab__nav" aria-label="Secciones">
      {{#each secciones}}<a href="{{this.url}}">{{this.nombre}}</a>{{/each}}
    </nav>
    <a class="cab__menu" href="#menu">{{#if isEs}}Menú{{else}}Menu{{/if}}</a>
  </header>

  <div class="menu" id="menu" role="dialog" aria-label="{{#if isEs}}Menú{{else}}Menu{{/if}}">
    <a class="menu__x" href="#">{{#if isEs}}Cerrar{{else}}Close{{/if}}</a>
    <ol class="menu__lista">
      {{#each secciones}}<li><a href="{{this.url}}"><small>{{this.num}}</small>{{this.nombre}}</a></li>{{/each}}
    </ol>
    <div class="menu__redes">{{#each redes}}<a href="{{this.url}}" target="_blank" rel="noopener">{{this.nombre}}</a>{{/each}}</div>
  </div>

  <main>
    {{{body}}}
  </main>

  <footer class="pie">
    <div class="pie__fila">
      <span class="pie__marca">SOCCER iD</span>
      <span class="pie__legal">© {{year}} · <a href="/{{lang}}/privacy">{{#if isEs}}Privacidad{{else}}Privacy{{/if}}</a> · <a href="/{{lang}}/terms">{{#if isEs}}Términos{{else}}Terms{{/if}}</a></span>
    </div>
  </footer>
</body>
</html>
