  <script>
  (function() {
    var overlay = document.getElementById('matchNotifOverlay');
    var notif = document.getElementById('matchNotif');
    var dismiss = document.getElementById('matchNotifDismiss');
    var countdown = document.getElementById('matchNotifCountdown');
    var remaining = 10;
    var timer = null;

    function show() {
      overlay.classList.add('active');
      setTimeout(function() { notif.classList.add('active'); }, 50);
      timer = setInterval(function() {
        remaining--;
        if (countdown) countdown.textContent = remaining + 's';
        if (remaining <= 0) hide();
      }, 1000);
    }

    function hide() {
      if (timer) { clearInterval(timer); timer = null; }
      notif.classList.remove('active');
      setTimeout(function() { overlay.classList.remove('active'); }, 300);
    }

    dismiss.addEventListener('click', hide);
    overlay.addEventListener('click', hide);

    setTimeout(show, 3000);
  })();
  </script>
  {{/if}}

  <script>
  (function() {
    var track = document.getElementById('matchCarouselTrack');
    var progressEl = document.getElementById('matchCarouselProgress');
    if (!track || !progressEl) return;
    var cards = track.querySelectorAll('.mc-card');
    if (!cards.length) return;
    var wrapper = track.parentElement;
    var bar = document.getElementById('matchCarouselBar');
    var counter = document.getElementById('matchCarouselCounter');
    var total = cards.length;
    var current = 0;
    var autoTimer = null;
    var AUTO_INTERVAL = 4000;
    var userInteracting = false;

    function updateUI(idx) {
      current = idx;
      counter.textContent = (idx + 1) + ' / ' + total;
    }

    function scrollTo(idx) {
      var cardLeft = cards[idx].offsetLeft;
      var cardW = cards[idx].offsetWidth;
      var wrapperW = wrapper.offsetWidth;
      wrapper.scrollTo({ left: cardLeft - (wrapperW - cardW) / 2, behavior: 'smooth' });
    }

    function startBar() {
      bar.classList.remove('animating');
      bar.style.width = '0%';
      bar.offsetWidth;
      bar.classList.add('animating');
      bar.style.transitionDuration = AUTO_INTERVAL + 'ms';
      bar.style.width = '100%';
    }

    function stopBar() {
      var w = bar.getBoundingClientRect().width;
      var parentW = bar.parentElement.getBoundingClientRect().width;
      bar.classList.remove('animating');
      bar.style.width = (parentW > 0 ? (w / parentW * 100) : 0) + '%';
    }

    function advance() {
      if (userInteracting) return;
      var next = (current + 1) % total;
      scrollTo(next);
      updateUI(next);
      startBar();
    }

    function startAuto() {
      stopAuto();
      startBar();
      autoTimer = setInterval(advance, AUTO_INTERVAL);
    }

    function stopAuto() {
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    }

    function resetAuto() {
      userInteracting = false;
      startAuto();
    }

    function getClosest() {
      var wc = wrapper.scrollLeft + wrapper.offsetWidth / 2;
      var closest = 0, minD = Infinity;
      cards.forEach(function(c, i) {
        var d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - wc);
        if (d < minD) { minD = d; closest = i; }
      });
      return closest;
    }

    var scrollTimeout;
    wrapper.addEventListener('scroll', function() {
      var c = getClosest();
      if (c !== current) updateUI(c);
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function() { updateUI(getClosest()); }, 80);
    }, { passive: true });

    wrapper.addEventListener('touchstart', function() {
      userInteracting = true;
      stopAuto();
      stopBar();
    }, { passive: true });

    wrapper.addEventListener('touchend', function() {
      setTimeout(resetAuto, 3000);
    }, { passive: true });

    wrapper.addEventListener('mouseenter', function() {
      userInteracting = true;
      stopAuto();
      stopBar();
    });

    wrapper.addEventListener('mouseleave', function() { resetAuto(); });

    updateUI(0);
    startAuto();
  })();
  </script>

