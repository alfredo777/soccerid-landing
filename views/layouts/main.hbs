<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if title}}{{title}}{{else}}landing-soccerid-v2_0{{/if}}</title>
  
  <meta name="description" content="{{#if description}}{{description}}{{else}}Sitio web generado con Handlebars{{/if}}">
  
  {{#each externalCSS}}
  <link rel="stylesheet" href="{{this}}">
  {{/each}}
  
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="icon" href="/assets/images/iconsoccerid.png" type="image/x-icon">

  {{#each additionalCSS}}
  <link rel="stylesheet" href="{{this}}">
  {{/each}}
</head>
<body>
  {{{body}}}
  
  <script src="https://cdn.jsdelivr.net/npm/handlebars@4.7.8/dist/handlebars.min.js"></script>
  <script src="/assets/js/hbs-utils.js"></script>
  
  {{#each externalScripts}}
  <script src="{{this}}"></script>
  {{/each}}
  
  <script src="/assets/js/main3.js"></script>
  
  {{#each additionalScripts}}
  <script src="{{this}}"></script>
  {{/each}}
</body>
</html>
