  <div class="mn-sheet" id="matchNotif">
    <div class="mn-handle"></div>

    <div class="mn-header">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="#a78bfa"/></svg>
      <span>{{#if isEs}}Pr&oacute;ximo Partido{{else}}Upcoming Match{{/if}}</span>
    </div>

    <div class="mn-card">
      <div class="mn-badge-row">
        <span class="mn-live-badge">{{upcoming_events.[0].badge}}</span>
      </div>

      <div class="mn-matchup">
        <div class="mn-team">
          <img src="{{upcoming_events.[0].team1Icon}}" alt="{{upcoming_events.[0].team1}}">
          <span class="mn-team-name">{{upcoming_events.[0].team1}}</span>
        </div>
        <div class="mn-vs-center">
