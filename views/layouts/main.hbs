<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if title}}{{title}}{{else}}SOCCER iD{{/if}}</title>
  
  <!-- Meta descripción -->
  <meta name="description" content="{{description}}">
  
  <!-- Keywords -->
  <meta name="keywords" content="{{#if keywords}}{{keywords}}{{else}}soccer id, soccerid, soccer id cup, experiencias vip, seguros id, copa 2026, deportes, fútbol{{/if}}">
  
  <!-- Robots -->
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  
  <!-- Canonical y alternate para SEO multiidioma -->
  <link rel="canonical" href="{{baseUrl}}/{{lang}}{{currentPath}}">
  <link rel="alternate" hreflang="es" href="{{baseUrl}}/es{{currentPath}}">
  <link rel="alternate" hreflang="en" href="{{baseUrl}}/en{{currentPath}}">
  <link rel="alternate" hreflang="x-default" href="{{baseUrl}}/es{{currentPath}}">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{baseUrl}}/{{lang}}{{currentPath}}">
  <meta property="og:title" content="{{ogTitle}}">
  <meta property="og:description" content="{{ogDescription}}">
  <meta property="og:image" content="{{baseUrl}}{{img '/assets/images/share.jpg'}}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="SOCCER iD">
  <meta property="og:locale" content="{{ogLocale}}">
  {{#if isEs}}
  <meta property="og:locale:alternate" content="en_US">
  {{else}}
  <meta property="og:locale:alternate" content="es_ES">
  {{/if}}
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="{{baseUrl}}/{{lang}}{{currentPath}}">
  <meta name="twitter:title" content="{{twitterTitle}}">
  <meta name="twitter:description" content="{{twitterDescription}}">
  <meta name="twitter:image" content="{{baseUrl}}{{img '/assets/images/share.jpg'}}">
  
  <!-- Schema.org JSON-LD: Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "SOCCER iD",
    "alternateName": ["SocceriD", "Soccer iD", "Soccer ID", "soccer id"],
    "url": "{{baseUrl}}",
    "logo": "{{baseUrl}}/assets/images/iconsoccerid.png",
    "description": "{{description}}",
    "sameAs": [
      "https://www.instagram.com/soccerid7",
      "https://www.facebook.com/soccerid7",
      "https://www.tiktok.com/@soccerid7"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "availableLanguage": ["Spanish", "English"]
    }
  }
  </script>

  <!-- Schema.org JSON-LD: WebSite -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "SOCCER iD",
    "alternateName": ["SocceriD", "Soccer iD", "Soccer ID"],
    "url": "{{baseUrl}}",
    "description": "{{description}}",
    "inLanguage": ["es", "en"],
    "potentialAction": {
      "@type": "SearchAction",
      "target": "{{baseUrl}}/{{lang}}?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  
  <!-- CSS -->
  <link href="/assets/css/main.css?v={{version}}" rel="stylesheet">
  <link href="/assets/css/embedvideo.css?v={{version}}" rel="stylesheet">
  <!-- Favicon -->
  <link rel="icon" href="/assets/images/iconsoccerid.png" type="image/x-icon">
  
  <!-- Datos para JavaScript -->
  <script>
    window.__GKRAKEN_CONFIG__ = {
      lang: '{{lang}}',
      supportedLangs: {{{json supportedLangs}}},
      baseUrl: '{{baseUrl}}',
      currentPath: '{{currentPath}}',
      version: '{{version}}'
    };
  </script>
  
  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=UA-90272633-2"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'UA-90272633-2');
  </script>
</head>
<body data-lang="{{lang}}">
  {{{body}}}

  <!-- Magazine Reader Modal -->
  <div id="magazineReaderModal" class="magazine-reader-modal">
    <div class="magazine-reader-container">
      <div class="magazine-reader-header">
        <h2 id="magazineReaderTitle">{{t "panel.magazine"}}</h2>
        <a id="magazineSourceBtn" 
           class="magazine-source-btn" 
           href="#" 
           target="_blank" 
           rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            <span>Ver fuente</span>
        </a>
        <button class="magazine-reader-close" onclick="MagazineReader.close()">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="magazine-reader-content">
        <div class="magazine-reader-controls">
          <button class="magazine-nav-btn" id="magazinePrevBtn" onclick="MagazineReader.prevPage()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          <span class="magazine-page-info">
            <span id="magazineCurrentPage">1</span> / <span id="magazineTotalPages">1</span>
          </span>
          <button class="magazine-nav-btn" id="magazineNextBtn" onclick="MagazineReader.nextPage()">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>
        <div class="magazine-reader-viewport" id="magazineViewport">
          <div class="magazine-pages-wrapper" id="magazinePagesWrapper">
          </div>
        </div>
        <div class="magazine-thumbnails" id="magazineThumbnails">
        </div>
      </div>
    </div>
  </div>

  {{#if upcoming_events.[0]}}
  <!-- Upcoming Match Notification -->
  <div class="match-notif-overlay" id="matchNotifOverlay"></div>
  <div class="match-notif" id="matchNotif">
    <div class="match-notif-handle"></div>
    <div class="match-notif-card">
      <div class="match-notif-preview">
        <img src="{{upcoming_events.[0].team1Icon}}" alt="{{upcoming_events.[0].team1}}" class="match-notif-icon">
        <div class="match-notif-vs-badge">VS</div>
        <img src="{{upcoming_events.[0].team2Icon}}" alt="{{upcoming_events.[0].team2}}" class="match-notif-icon">
      </div>
      <h3 class="match-notif-title">{{#if isEs}}Próximo Partido{{else}}Upcoming Match{{/if}}</h3>
      <p class="match-notif-desc">
        <strong>{{upcoming_events.[0].team1}} vs {{upcoming_events.[0].team2}}</strong><br>
        {{upcoming_events.[0].date}} &middot; {{upcoming_events.[0].time}}<br>
        <span class="match-notif-venue">{{upcoming_events.[0].venue}}</span>
      </p>
    </div>
    <a href="/{{lang}}/evento/{{upcoming_events.[0].id}}" class="match-notif-btn">
      {{#if isEs}}Ver Boletos VIP{{else}}View VIP Tickets{{/if}}
    </a>
    <button class="match-notif-dismiss" id="matchNotifDismiss">
      {{#if isEs}}Ahora no{{else}}Maybe later{{/if}}
    </button>
  </div>

  <style>
    .match-notif-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.5);
      z-index: 9998;
      opacity: 0;
      transition: opacity 0.3s ease;
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
    }
    .match-notif-overlay.active { display: block; opacity: 1; }

    .match-notif {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 9999;
      background: #fff;
      border-radius: 20px 20px 0 0;
      padding: 12px 20px max(20px, env(safe-area-inset-bottom));
      transform: translateY(100%);
      transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
      max-width: 500px;
      margin: 0 auto;
      box-shadow: 0 -4px 32px rgba(0,0,0,0.2);
    }
    .match-notif.active { transform: translateY(0); }

    .match-notif-handle {
      width: 36px;
      height: 5px;
      background: #d1d5db;
      border-radius: 3px;
      margin: 0 auto 16px;
    }

    .match-notif-card {
      background: #f3f4f6;
      border-radius: 14px;
      padding: 20px;
      text-align: center;
      margin-bottom: 16px;
    }

    .match-notif-preview {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 14px;
    }

    .match-notif-icon {
      width: 52px;
      height: 52px;
      object-fit: contain;
      border-radius: 12px;
      background: #fff;
      padding: 6px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .match-notif-vs-badge {
      font-size: 13px;
      font-weight: 800;
      color: #fff;
      background: linear-gradient(135deg, #6c3ce0, #9b59f0);
      border-radius: 8px;
      padding: 4px 10px;
      letter-spacing: 1px;
    }

    .match-notif-title {
      font-size: 18px;
      font-weight: 700;
      color: #111;
      margin-bottom: 6px;
    }

    .match-notif-desc {
      font-size: 14px;
      color: #444;
      line-height: 1.5;
    }

    .match-notif-venue {
      color: #888;
      font-size: 13px;
    }

    .match-notif-btn {
      display: block;
      width: 100%;
      padding: 16px;
      background: #111;
      color: #fff;
      text-align: center;
      text-decoration: none;
      font-size: 16px;
      font-weight: 700;
      border-radius: 14px;
      border: none;
      cursor: pointer;
      margin-bottom: 8px;
      transition: background 0.2s;
    }
    .match-notif-btn:active { background: #333; }

    .match-notif-dismiss {
      display: block;
      width: 100%;
      padding: 10px;
      background: none;
      border: none;
      color: #888;
      font-size: 14px;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  </style>

  <script>
  (function() {
    var NOTIF_KEY = 'matchNotifDismissed_{{upcoming_events.[0].id}}';
    if (sessionStorage.getItem(NOTIF_KEY)) return;

    var overlay = document.getElementById('matchNotifOverlay');
    var notif = document.getElementById('matchNotif');
    var dismiss = document.getElementById('matchNotifDismiss');

    function show() {
      overlay.classList.add('active');
      setTimeout(function() { notif.classList.add('active'); }, 50);
    }

    function hide() {
      notif.classList.remove('active');
      setTimeout(function() { overlay.classList.remove('active'); }, 300);
      sessionStorage.setItem(NOTIF_KEY, '1');
    }

    dismiss.addEventListener('click', hide);
    overlay.addEventListener('click', hide);

    setTimeout(show, 3000);
  })();
  </script>
  {{/if}}

  <script src="{{js '/assets/js/mreader.js'}}"></script>
  <script src="{{js '/assets/js/main.js'}}"></script>
  <!--<script src="{{js '/assets/js/externvideoytembed.js'}}"></script>-->
  <script src="{{js '/assets/js/cast.js'}}"></script>

</body>
</html>