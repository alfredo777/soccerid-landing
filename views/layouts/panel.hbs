<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --pn-bg: #F5F4F8;
      --pn-card: #FFFFFF;
      --pn-border: #ECEAF2;
      --pn-ink: #14141B;
      --pn-ink-2: #6A6675;
      --pn-muted: #A6A2B3;
      --pn-purple: #6C3CE0;
      --pn-purple-dark: #4E2BA6;
      --pn-purple-soft: #F1ECFC;
      --pn-radius: 18px;
      --pn-shadow: 0 1px 2px rgba(20,20,27,0.03), 0 8px 24px rgba(76,43,166,0.05);
      --pn-sidebar-w: 268px;
      --pn-sidebar-collapsed: 78px;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--pn-bg);
      color: var(--pn-ink);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }

    .pn-shell { display: flex; min-height: 100vh; }

    /* ── Sidebar ── */
    .pn-side {
      width: var(--pn-sidebar-w);
      background: var(--pn-card);
      border-right: 1px solid var(--pn-border);
      display: flex; flex-direction: column;
      position: fixed; top: 0; left: 0; height: 100vh;
      z-index: 40;
      transition: width .22s ease, transform .25s ease;
    }
    .pn-side__brand {
      display: flex; align-items: center; gap: 11px;
      padding: 22px 20px 18px; min-height: 74px;
    }
    .pn-side__logo {
      width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0;
      background: var(--pn-purple); display:flex; align-items:center; justify-content:center;
    }
    .pn-side__logo img { width: 24px; height: 24px; }
    .pn-side__brandtext { line-height: 1.1; overflow: hidden; white-space: nowrap; }
    .pn-side__brandtext strong { display:block; font-weight: 800; font-size: 15px; letter-spacing: .2px; }
    .pn-side__brandtext small { font-size: 10px; font-weight: 700; color: var(--pn-muted); letter-spacing: 1.5px; text-transform: uppercase; }
    .pn-collapse-btn {
      margin-left: auto; width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
      border: 1px solid var(--pn-border); background: #fff; cursor: pointer;
      display:flex; align-items:center; justify-content:center;
    }
    .pn-collapse-btn svg { width: 15px; height: 15px; stroke: var(--pn-ink-2); transition: transform .2s; }

    .pn-nav { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 6px 14px 12px; }
    .pn-nav::-webkit-scrollbar { width: 0; }
    .pn-group { margin-bottom: 2px; }
    .pn-group__head {
      display: flex; align-items: center; justify-content: space-between;
      width: 100%; background: none; border: none; cursor: pointer;
      padding: 14px 12px 6px; font-family: inherit;
      font-size: 10.5px; font-weight: 800; letter-spacing: 1.3px; text-transform: uppercase;
      color: var(--pn-muted); white-space: nowrap; overflow: hidden;
    }
    .pn-group__head .pn-chevron { transition: transform .2s ease; flex-shrink: 0; }
    .pn-group.is-collapsed .pn-group__head .pn-chevron { transform: rotate(-90deg); }
    .pn-group__body { display: flex; flex-direction: column; gap: 3px; overflow: hidden; }
    .pn-group.is-collapsed .pn-group__body { display: none; }

    .pn-link {
      display: flex; align-items: center; gap: 13px;
      padding: 11px 12px; border-radius: 13px;
      color: var(--pn-ink-2); font-size: 14px; font-weight: 600;
      white-space: nowrap; position: relative;
      transition: background .15s, color .15s;
    }
    .pn-link svg.pn-ico { width: 20px; height: 20px; flex-shrink: 0; stroke: currentColor; }
    .pn-link:hover { background: var(--pn-purple-soft); color: var(--pn-purple); }
    .pn-link.is-active { background: var(--pn-purple); color: #fff; box-shadow: 0 8px 18px rgba(108,60,224,.28); }
    .pn-link.is-active svg.pn-ico { stroke: #fff; }
    .pn-link__badge { margin-left: auto; font-size: 11px; font-weight: 800; background:#F1F0F5; color: var(--pn-ink-2); padding: 2px 9px; border-radius: 20px; }
    .pn-link.is-active .pn-link__badge { background: rgba(255,255,255,.22); color:#fff; }

    /* Sidebar event mini-card */
    .pn-side__event {
      margin: 8px 16px 4px; padding: 16px; border-radius: 15px;
      background: var(--pn-ink); color: #fff; overflow: hidden;
    }
    .pn-side__event small { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: rgba(255,255,255,.55); }
    .pn-side__event strong { display:block; font-size: 22px; font-weight: 900; margin: 4px 0 2px; }
    .pn-side__event span { font-size: 12px; color: rgba(255,255,255,.7); font-weight: 600; }

    .pn-side__foot { border-top: 1px solid var(--pn-border); padding: 12px; }
    .pn-owner {
      display: flex; align-items: center; gap: 11px;
      padding: 10px; border-radius: 13px; background: var(--pn-purple-soft);
      overflow: hidden; white-space: nowrap;
    }
    .pn-owner__logo { width: 36px; height: 36px; border-radius: 10px; background: var(--pn-purple); display:flex; align-items:center; justify-content:center; flex-shrink: 0; }
    .pn-owner__logo img { width: 21px; height: 21px; }
    .pn-owner__info strong { display:block; font-size: 13px; font-weight: 800; }
    .pn-owner__info small { font-size: 11px; color: var(--pn-ink-2); }
    .pn-logout {
      display:flex; align-items:center; gap: 13px; width: 100%;
      margin-top: 6px; padding: 11px 12px; border-radius: 13px;
      background: none; border: none; cursor: pointer; font-family: inherit;
      font-size: 13px; font-weight: 600; color: var(--pn-ink-2); white-space: nowrap;
    }
    .pn-logout:hover { background: #F6F5F9; color: var(--pn-ink); }
    .pn-logout svg { width: 19px; height: 19px; stroke: currentColor; flex-shrink: 0; }

    /* ── Collapsed state (desktop rail) ── */
    .pn-shell.is-rail .pn-side { width: var(--pn-sidebar-collapsed); }
    .pn-shell.is-rail .pn-main { margin-left: var(--pn-sidebar-collapsed); }
    .pn-shell.is-rail .pn-side__brandtext,
    .pn-shell.is-rail .pn-group__head,
    .pn-shell.is-rail .pn-link .pn-label,
    .pn-shell.is-rail .pn-link__badge,
    .pn-shell.is-rail .pn-side__event,
    .pn-shell.is-rail .pn-owner__info,
    .pn-shell.is-rail .pn-logout span { display: none; }
    .pn-shell.is-rail .pn-side__brand { justify-content: center; padding: 22px 0 18px; }
    .pn-shell.is-rail .pn-collapse-btn { position: absolute; top: 26px; right: -13px; background: var(--pn-card); box-shadow: var(--pn-shadow); z-index: 2; }
    .pn-shell.is-rail .pn-collapse-btn svg { transform: rotate(180deg); }
    .pn-shell.is-rail .pn-link { justify-content: center; padding: 12px; }
    .pn-shell.is-rail .pn-logout { justify-content: center; }
    .pn-shell.is-rail .pn-owner { justify-content: center; padding: 8px; }

    /* ── Main ── */
    .pn-main { flex: 1; margin-left: var(--pn-sidebar-w); min-width: 0; transition: margin .22s ease; }
    .pn-top {
      display: flex; align-items: center; gap: 16px;
      padding: 22px 32px 14px;
      position: sticky; top: 0; z-index: 30; background: var(--pn-bg);
    }
    .pn-burger { display:none; background:none; border:none; cursor:pointer; padding: 4px; }
    .pn-burger svg { width: 24px; height: 24px; stroke: var(--pn-ink); }
    .pn-top__title h1 { font-size: 24px; font-weight: 800; letter-spacing: -.4px; }
    .pn-top__title p { font-size: 13px; color: var(--pn-ink-2); margin-top: 3px; }
    .pn-search {
      margin-left: auto; display: flex; align-items: center; gap: 8px;
      background: var(--pn-card); border: 1px solid var(--pn-border);
      border-radius: 13px; padding: 10px 15px; width: 250px; max-width: 28vw;
    }
    .pn-search svg { width: 16px; height: 16px; stroke: var(--pn-muted); }
    .pn-search input { border: none; outline: none; background: none; font-family: inherit; font-size: 13px; width: 100%; color: var(--pn-ink); }
    .pn-iconbtn {
      width: 44px; height: 44px; border-radius: 13px; background: var(--pn-card);
      border: 1px solid var(--pn-border); display:flex; align-items:center; justify-content:center;
      cursor: pointer; position: relative; flex-shrink: 0;
    }
    .pn-iconbtn svg { width: 19px; height: 19px; stroke: var(--pn-ink); }
    .pn-iconbtn .dot { position:absolute; top: 10px; right: 11px; width: 7px; height: 7px; border-radius: 50%; background: var(--pn-purple); border: 2px solid var(--pn-card); }
    .pn-userchip {
      display:flex; align-items:center; gap: 11px; padding: 5px 14px 5px 5px;
      background: var(--pn-card); border: 1px solid var(--pn-border); border-radius: 40px; flex-shrink: 0;
    }
    .pn-avatar {
      width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
      display:flex; align-items:center; justify-content:center;
      font-size: 13px; font-weight: 800; color: #fff;
    }
    .pn-userchip__info { line-height: 1.15; }
    .pn-userchip__info strong { display:block; font-size: 13px; font-weight: 800; }
    .pn-userchip__info small { font-size: 10.5px; font-weight: 800; letter-spacing: .5px; }

    .pn-content { padding: 8px 32px 44px; }

    /* ── Shared card / helpers ── */
    .pn-card { background: var(--pn-card); border: 1px solid var(--pn-border); border-radius: var(--pn-radius); box-shadow: var(--pn-shadow); }
    .pn-card__head { display:flex; align-items:center; justify-content:space-between; padding: 18px 20px; }
    .pn-card__head h3 { font-size: 15px; font-weight: 800; letter-spacing: -.2px; }
    .pn-card__link { font-size: 12px; font-weight: 800; color: var(--pn-purple); display:flex; align-items:center; gap: 4px; }
    .pn-badge { display:inline-flex; align-items:center; gap:6px; font-size: 11px; font-weight:800; letter-spacing:.4px; text-transform:uppercase; padding: 5px 12px; border-radius: 20px; }
    .pn-badge .dotc { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }

    .pn-collapse.is-closed .pn-collapse__body { display: none; }
    .pn-collapse__head { cursor: pointer; }
    .pn-collapse__head .pn-chevron { transition: transform .2s; }
    .pn-collapse.is-closed .pn-collapse__head .pn-chevron { transform: rotate(-90deg); }

    @media (max-width: 1024px) {
      .pn-content { padding: 8px 18px 40px; }
      .pn-top { padding: 18px 18px 12px; }
    }
    @media (max-width: 860px) {
      .pn-side { transform: translateX(-100%); width: var(--pn-sidebar-w); box-shadow: 0 0 50px rgba(0,0,0,.18); }
      .pn-side.is-open { transform: translateX(0); }
      .pn-shell.is-rail .pn-side { width: var(--pn-sidebar-w); }
      .pn-main, .pn-shell.is-rail .pn-main { margin-left: 0; }
      .pn-collapse-btn { display: none; }
      .pn-burger { display: inline-flex; }
      .pn-search { display: none; }
      .pn-overlay { position: fixed; inset: 0; background: rgba(20,20,27,.4); z-index: 39; display: none; }
      .pn-overlay.is-open { display: block; }
      .pn-userchip__info { display: none; }
    }
  </style>
</head>
<body>
  <div class="pn-shell" id="pnShell">
    <div class="pn-overlay" id="pnOverlay"></div>

    <!-- Sidebar -->
    <aside class="pn-side" id="pnSide">
      <div class="pn-side__brand">
        <div class="pn-side__logo"><img src="/assets/images/iconsoccerid.png" alt="SOCCER iD"></div>
        <div class="pn-side__brandtext">
          <strong>SOCCER iD</strong>
          <small>Investor Portal</small>
        </div>
        <button class="pn-collapse-btn" id="pnRailToggle" aria-label="Colapsar menú">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
      </div>

      <nav class="pn-nav">
        <div class="pn-group">
          <button class="pn-group__head" data-group>
            Panel
            <svg class="pn-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pn-group__body">
            <a href="/panel" class="pn-link {{#eq active 'dashboard'}}is-active{{/eq}}" title="Dashboard">
              <svg class="pn-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
              <span class="pn-label">Dashboard</span>
            </a>
          </div>
        </div>

        <div class="pn-group">
          <button class="pn-group__head" data-group>
            Comunicación
            <svg class="pn-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pn-group__body">
            <a href="/panel/noticias" class="pn-link {{#eq active 'noticias'}}is-active{{/eq}}" title="Noticias">
              <svg class="pn-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h13v14H6a2 2 0 0 1-2-2V5z"/><path d="M17 8h2a1 1 0 0 1 1 1v8a2 2 0 0 1-2 2"/><line x1="7" y1="9" x2="14" y2="9"/><line x1="7" y1="13" x2="14" y2="13"/></svg>
              <span class="pn-label">Noticias</span>
              <span class="pn-link__badge">6</span>
            </a>
            <a href="/panel/noticias" class="pn-link" title="Actualizaciones">
              <svg class="pn-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span class="pn-label">Actualizaciones</span>
            </a>
          </div>
        </div>

        <div class="pn-group">
          <button class="pn-group__head" data-group>
            Evento
            <svg class="pn-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pn-group__body">
            <a href="/panel/calendario" class="pn-link {{#eq active 'calendario'}}is-active{{/eq}}" title="Calendario">
              <svg class="pn-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
              <span class="pn-label">Calendario</span>
            </a>
            <a href="/panel/calendario" class="pn-link" title="Cronograma">
              <svg class="pn-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="14" y2="18"/></svg>
              <span class="pn-label">Cronograma</span>
            </a>
          </div>
        </div>

        <div class="pn-group">
          <button class="pn-group__head" data-group>
            Inversión
            <svg class="pn-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pn-group__body">
            <a href="/panel" class="pn-link" title="Mis beneficios">
              <svg class="pn-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18"/><path d="M9 3 6 9l6 12 6-12-3-6"/></svg>
              <span class="pn-label">Mis beneficios</span>
            </a>
            <a href="/panel" class="pn-link" title="Documentos">
              <svg class="pn-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><polyline points="14 3 14 8 19 8"/></svg>
              <span class="pn-label">Documentos</span>
            </a>
          </div>
        </div>

        {{#eq panel.user.role 'admin'}}
        <div class="pn-group">
          <button class="pn-group__head" data-group>
            Administración
            <svg class="pn-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pn-group__body">
            <a href="/panel/admin" class="pn-link {{#eq active 'admin'}}is-active{{/eq}}" title="Panel del organizador">
              <svg class="pn-ico" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V5z"/><polyline points="9 12 11 14 15 10"/></svg>
              <span class="pn-label">Organizador</span>
            </a>
          </div>
        </div>
        {{/eq}}
      </nav>

      <div class="pn-side__event">
        <small>Cuenta regresiva</small>
        <strong id="pnSideCountdown">— días</strong>
        <span>{{panel.eventLabel}}</span>
      </div>

      <div class="pn-side__foot">
        <div class="pn-owner">
          <div class="pn-owner__logo"><img src="/assets/images/iconsoccerid.png" alt="SOCCER iD"></div>
          <div class="pn-owner__info">
            <strong>{{panel.org.name}}</strong>
            <small>{{panel.org.role}}</small>
          </div>
        </div>
        <button class="pn-logout" onclick="window.location.href='/panel/logout'">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </aside>

    <!-- Main -->
    <div class="pn-main">
      <header class="pn-top">
        <button class="pn-burger" id="pnBurger" aria-label="Menú">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="pn-top__title">
          <h1>{{pageHeading}}</h1>
          <p>{{pageSub}}</p>
        </div>
        <div class="pn-search">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
          <input type="text" placeholder="Buscar...">
        </div>
        <button class="pn-iconbtn"><span class="dot"></span>
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        </button>
        <div class="pn-userchip">
          <div class="pn-avatar" style="background: {{panel.user.color}}">{{panel.user.initials}}</div>
          <div class="pn-userchip__info">
            <strong>{{panel.user.firstName}}</strong>
            <small style="color: {{panel.user.color}}">{{panel.user.categoryLabel}}</small>
          </div>
        </div>
      </header>

      <main class="pn-content">
        {{{body}}}
      </main>
    </div>
  </div>

  <script>
    // Sidebar group collapsibles
    document.querySelectorAll('[data-group]').forEach(function(btn){
      btn.addEventListener('click', function(){ btn.closest('.pn-group').classList.toggle('is-collapsed'); });
    });
    // Card collapsibles
    document.querySelectorAll('[data-collapse]').forEach(function(btn){
      btn.addEventListener('click', function(){ btn.closest('.pn-collapse').classList.toggle('is-closed'); });
    });
    // Desktop rail collapse (persisted)
    var shell = document.getElementById('pnShell');
    var railToggle = document.getElementById('pnRailToggle');
    if (localStorage.getItem('pnRail') === '1') shell.classList.add('is-rail');
    if (railToggle) railToggle.addEventListener('click', function(){
      shell.classList.toggle('is-rail');
      localStorage.setItem('pnRail', shell.classList.contains('is-rail') ? '1' : '0');
    });
    // Mobile off-canvas
    var side = document.getElementById('pnSide');
    var ov = document.getElementById('pnOverlay');
    var bg = document.getElementById('pnBurger');
    if (bg) bg.addEventListener('click', function(){ side.classList.add('is-open'); ov.classList.add('is-open'); });
    if (ov) ov.addEventListener('click', function(){ side.classList.remove('is-open'); ov.classList.remove('is-open'); });
    // Countdown (sidebar)
    (function(){
      var el = document.getElementById('pnSideCountdown');
      if (!el) return;
      var days = Math.floor((new Date('2027-03-27T19:00:00-05:00').getTime() - Date.now()) / 86400000);
      el.textContent = (days > 0 ? days : 0) + ' días';
    })();
  </script>
</body>
</html>
