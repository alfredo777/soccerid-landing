<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --pn-bg: #F4F5F7;
      --pn-card: #FFFFFF;
      --pn-border: #E9EBEF;
      --pn-ink: #171A21;
      --pn-ink-2: #6B7280;
      --pn-muted: #9AA1AC;
      --pn-accent: #171A21;
      --pn-gold: #C79A2E;
      --pn-radius: 16px;
      --pn-shadow: 0 1px 2px rgba(23,26,33,0.04), 0 6px 20px rgba(23,26,33,0.04);
      --pn-sidebar-w: 264px;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--pn-bg);
      color: var(--pn-ink);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }

    .pn-shell { display: flex; min-height: 100vh; }

    /* ── Sidebar ── */
    .pn-side {
      width: var(--pn-sidebar-w);
      background: var(--pn-card);
      border-right: 1px solid var(--pn-border);
      display: flex; flex-direction: column;
      position: fixed; top: 0; left: 0; bottom: 0;
      z-index: 40;
      transition: transform .25s ease;
    }
    .pn-side__brand {
      display: flex; align-items: center; gap: 10px;
      padding: 20px 22px 18px;
    }
    .pn-side__brand img { height: 26px; width: auto; }
    .pn-side__brand span { font-weight: 800; font-size: 15px; letter-spacing: .3px; }
    .pn-side__brand small { display:block; font-size: 10px; font-weight: 600; color: var(--pn-muted); letter-spacing: 1.5px; text-transform: uppercase; }

    .pn-nav { flex: 1; overflow-y: auto; padding: 6px 12px 12px; }
    .pn-group { margin-bottom: 4px; }
    .pn-group__head {
      display: flex; align-items: center; justify-content: space-between;
      width: 100%; background: none; border: none; cursor: pointer;
      padding: 12px 12px 6px; font-family: inherit;
      font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;
      color: var(--pn-muted);
    }
    .pn-group__head .pn-chevron { transition: transform .2s ease; }
    .pn-group.is-collapsed .pn-group__head .pn-chevron { transform: rotate(-90deg); }
    .pn-group__body { display: flex; flex-direction: column; gap: 2px; overflow: hidden; }
    .pn-group.is-collapsed .pn-group__body { display: none; }

    .pn-link {
      display: flex; align-items: center; gap: 12px;
      padding: 10px 12px; border-radius: 12px;
      color: var(--pn-ink-2); font-size: 14px; font-weight: 600;
      transition: background .15s, color .15s;
    }
    .pn-link svg { width: 19px; height: 19px; flex-shrink: 0; stroke: currentColor; }
    .pn-link:hover { background: #F3F4F6; color: var(--pn-ink); }
    .pn-link.is-active { background: var(--pn-ink); color: #fff; }
    .pn-link.is-active svg { stroke: #fff; }
    .pn-link__badge { margin-left: auto; font-size: 11px; font-weight: 700; background:#F0F1F4; color: var(--pn-ink-2); padding: 2px 8px; border-radius: 20px; }
    .pn-link.is-active .pn-link__badge { background: rgba(255,255,255,.18); color:#fff; }

    .pn-side__foot { border-top: 1px solid var(--pn-border); padding: 12px; }
    .pn-owner {
      display: flex; align-items: center; gap: 10px;
      padding: 10px; border-radius: 12px; background: #F7F8FA;
    }
    .pn-owner__logo { width: 34px; height: 34px; border-radius: 9px; background: var(--pn-ink); display:flex; align-items:center; justify-content:center; }
    .pn-owner__logo img { width: 20px; height: 20px; }
    .pn-owner__info strong { display:block; font-size: 13px; font-weight: 700; }
    .pn-owner__info small { font-size: 11px; color: var(--pn-muted); }
    .pn-logout {
      display:flex; align-items:center; gap: 10px; width: 100%;
      margin-top: 8px; padding: 10px 12px; border-radius: 12px;
      background: none; border: none; cursor: pointer; font-family: inherit;
      font-size: 13px; font-weight: 600; color: var(--pn-ink-2);
    }
    .pn-logout:hover { background: #F3F4F6; color: #C0392B; }
    .pn-logout svg { width: 18px; height: 18px; stroke: currentColor; }

    /* ── Main ── */
    .pn-main { flex: 1; margin-left: var(--pn-sidebar-w); min-width: 0; }
    .pn-top {
      display: flex; align-items: center; gap: 16px;
      padding: 18px 30px; background: var(--pn-bg);
      position: sticky; top: 0; z-index: 30;
      border-bottom: 1px solid transparent;
    }
    .pn-burger { display:none; background:none; border:none; cursor:pointer; padding: 4px; }
    .pn-burger svg { width: 24px; height: 24px; stroke: var(--pn-ink); }
    .pn-top__title h1 { font-size: 22px; font-weight: 800; letter-spacing: -.2px; }
    .pn-top__title p { font-size: 13px; color: var(--pn-ink-2); margin-top: 2px; }
    .pn-search {
      margin-left: auto; display: flex; align-items: center; gap: 8px;
      background: var(--pn-card); border: 1px solid var(--pn-border);
      border-radius: 12px; padding: 9px 14px; width: 260px; max-width: 30vw;
    }
    .pn-search svg { width: 16px; height: 16px; stroke: var(--pn-muted); }
    .pn-search input { border: none; outline: none; background: none; font-family: inherit; font-size: 13px; width: 100%; color: var(--pn-ink); }
    .pn-iconbtn {
      width: 42px; height: 42px; border-radius: 12px; background: var(--pn-card);
      border: 1px solid var(--pn-border); display:flex; align-items:center; justify-content:center;
      cursor: pointer; position: relative; flex-shrink: 0;
    }
    .pn-iconbtn svg { width: 19px; height: 19px; stroke: var(--pn-ink); }
    .pn-iconbtn .dot { position:absolute; top: 9px; right: 10px; width: 7px; height: 7px; border-radius: 50%; background: #C0392B; border: 2px solid var(--pn-card); }
    .pn-userchip {
      display:flex; align-items:center; gap: 10px; padding: 5px 12px 5px 5px;
      background: var(--pn-card); border: 1px solid var(--pn-border); border-radius: 40px; flex-shrink: 0;
    }
    .pn-avatar {
      width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
      display:flex; align-items:center; justify-content:center;
      font-size: 13px; font-weight: 800; color: #fff;
    }
    .pn-userchip__info { line-height: 1.15; }
    .pn-userchip__info strong { display:block; font-size: 13px; font-weight: 700; }
    .pn-userchip__info small { font-size: 11px; font-weight: 700; letter-spacing: .5px; }

    .pn-content { padding: 8px 30px 40px; }

    /* ── Shared card / helpers ── */
    .pn-card { background: var(--pn-card); border: 1px solid var(--pn-border); border-radius: var(--pn-radius); box-shadow: var(--pn-shadow); }
    .pn-card__head { display:flex; align-items:center; justify-content:space-between; padding: 18px 20px; border-bottom: 1px solid var(--pn-border); }
    .pn-card__head h3 { font-size: 15px; font-weight: 700; }
    .pn-card__link { font-size: 12px; font-weight: 700; color: var(--pn-ink-2); display:flex; align-items:center; gap: 4px; }
    .pn-badge { display:inline-flex; align-items:center; gap:6px; font-size: 11px; font-weight:800; letter-spacing:.4px; text-transform:uppercase; padding: 5px 12px; border-radius: 20px; }
    .pn-badge .dotc { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .pn-mobile-only { display: none; }

    /* Collapsible card body */
    .pn-collapse__head { cursor: pointer; }
    .pn-collapse.is-closed .pn-collapse__body { display: none; }
    .pn-collapse__head .pn-chevron { transition: transform .2s; }
    .pn-collapse.is-closed .pn-collapse__head .pn-chevron { transform: rotate(-90deg); }

    @media (max-width: 1024px) {
      .pn-content { padding: 8px 18px 40px; }
      .pn-top { padding: 16px 18px; }
    }
    @media (max-width: 860px) {
      .pn-side { transform: translateX(-100%); box-shadow: 0 0 40px rgba(0,0,0,.15); }
      .pn-side.is-open { transform: translateX(0); }
      .pn-main { margin-left: 0; }
      .pn-burger { display: inline-flex; }
      .pn-search { display: none; }
      .pn-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.35); z-index: 39; display: none; }
      .pn-overlay.is-open { display: block; }
      .pn-userchip__info { display: none; }
    }
  </style>
</head>
<body>
  <div class="pn-shell">
    <div class="pn-overlay" id="pnOverlay"></div>

    <!-- Sidebar -->
    <aside class="pn-side" id="pnSide">
      <div class="pn-side__brand">
        <span>
          SOCCER iD
          <small>Investor Portal</small>
        </span>
      </div>

      <nav class="pn-nav">
        <div class="pn-group">
          <button class="pn-group__head" data-group>
            Panel
            <svg class="pn-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pn-group__body">
            <a href="/panel" class="pn-link {{#eq active 'dashboard'}}is-active{{/eq}}">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
              Dashboard
            </a>
          </div>
        </div>

        <div class="pn-group">
          <button class="pn-group__head" data-group>
            Comunicación
            <svg class="pn-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pn-group__body">
            <a href="/panel/noticias" class="pn-link {{#eq active 'noticias'}}is-active{{/eq}}">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h13v14H6a2 2 0 0 1-2-2V5z"/><path d="M17 8h2a1 1 0 0 1 1 1v8a2 2 0 0 1-2 2"/><line x1="7" y1="9" x2="14" y2="9"/><line x1="7" y1="13" x2="14" y2="13"/></svg>
              Noticias
              <span class="pn-link__badge">6</span>
            </a>
            <a href="/panel/noticias" class="pn-link">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><polyline points="12 6 12 12 16 14"/></svg>
              Actualizaciones
            </a>
          </div>
        </div>

        <div class="pn-group">
          <button class="pn-group__head" data-group>
            Evento
            <svg class="pn-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pn-group__body">
            <a href="/panel/calendario" class="pn-link {{#eq active 'calendario'}}is-active{{/eq}}">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
              Calendario
            </a>
            <a href="/panel/calendario" class="pn-link">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="14" y2="18"/></svg>
              Cronograma
            </a>
          </div>
        </div>

        <div class="pn-group">
          <button class="pn-group__head" data-group>
            Inversión
            <svg class="pn-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="pn-group__body">
            <a href="/panel" class="pn-link">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18"/><path d="M9 3 6 9l6 12 6-12-3-6"/></svg>
              Mis beneficios
            </a>
            <a href="/panel" class="pn-link">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M8 3v3M16 3v3"/></svg>
              Mi inversión
            </a>
          </div>
        </div>
      </nav>

      <div class="pn-side__foot">
        <div class="pn-owner">
          <div class="pn-owner__logo"><img src="/assets/images/iconsoccerid.png" alt="SOCCER iD"></div>
          <div class="pn-owner__info">
            <strong>{{panel.org.name}}</strong>
            <small>{{panel.org.role}}</small>
          </div>
        </div>
        <button class="pn-logout" onclick="window.location.href='/panel'">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Cerrar sesión
        </button>
      </div>
    </aside>

    <!-- Main -->
    <div class="pn-main">
      <header class="pn-top">
        <button class="pn-burger" id="pnBurger" aria-label="Menú">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="pn-top__title">
          <h1>{{pageHeading}}</h1>
          <p>{{pageSub}}</p>
        </div>
        <div class="pn-search">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
          <input type="text" placeholder="Buscar...">
        </div>
        <button class="pn-iconbtn"><span class="dot"></span>
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        </button>
        <div class="pn-userchip">
          <div class="pn-avatar" style="background: {{panel.user.color}}">{{panel.user.initials}}</div>
          <div class="pn-userchip__info">
            <strong>{{panel.user.firstName}}</strong>
            <small style="color: {{panel.user.color}}">{{panel.user.categoryLabel}}</small>
          </div>
        </div>
      </header>

      <main class="pn-content">
        {{{body}}}
      </main>
    </div>
  </div>

  <script>
    // Sidebar collapsibles
    document.querySelectorAll('[data-group]').forEach(function(btn){
      btn.addEventListener('click', function(){ btn.closest('.pn-group').classList.toggle('is-collapsed'); });
    });
    // Card collapsibles
    document.querySelectorAll('[data-collapse]').forEach(function(btn){
      btn.addEventListener('click', function(){ btn.closest('.pn-collapse').classList.toggle('is-closed'); });
    });
    // Mobile sidebar
    var side = document.getElementById('pnSide');
    var ov = document.getElementById('pnOverlay');
    var bg = document.getElementById('pnBurger');
    function openSide(){ side.classList.add('is-open'); ov.classList.add('is-open'); }
    function closeSide(){ side.classList.remove('is-open'); ov.classList.remove('is-open'); }
    if (bg) bg.addEventListener('click', openSide);
    if (ov) ov.addEventListener('click', closeSide);
  </script>
</body>
</html>
