<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{!-- Por defecto el título y la canónica salen de la sección. Una página
        que vive dentro de una sección pero tiene entidad propia —la ficha
        de una edición— los manda con `tituloPagina` y `rutaCanonica`, para
        no salir las tres ediciones como «Tour · SOCCER iD». --}}
  <title>{{#if tituloPagina}}{{tituloPagina}}{{else}}{{#if actual}}{{actual.nombre}} · SOCCER iD{{else}}SOCCER iD{{/if}}{{/if}}</title>
  <meta name="description" content="{{#if descripcionPagina}}{{descripcionPagina}}{{else}}{{#if actual}}{{actual.linea}}{{else}}{{description}}{{/if}}{{/if}}">
  {{!-- Fichas con texto de relleno: que los buscadores no las guarden. --}}
  {{#if noIndexar}}<meta name="robots" content="noindex">{{/if}}
  <link rel="canonical" href="{{baseUrl}}{{#if rutaCanonica}}{{rutaCanonica}}{{else}}/{{lang}}{{#if actual}}/{{actual.slug}}{{/if}}{{/if}}">
  {{!-- Vista previa al compartir. Sólo la piden las páginas que se mandan
        por WhatsApp con su propia foto (un partido, un reportaje). --}}
  {{#if ogImage}}
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{baseUrl}}{{rutaCanonica}}">
  <meta property="og:title" content="{{ogTitle}}">
  <meta property="og:description" content="{{ogDescription}}">
  <meta property="og:image" content="{{baseUrl}}{{ogImage}}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="SOCCER iD">
  <meta property="og:locale" content="{{ogLocale}}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ogTitle}}">
  <meta name="twitter:description" content="{{ogDescription}}">
  <meta name="twitter:image" content="{{baseUrl}}{{ogImage}}">
  {{/if}}
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/css/v2.css?v={{version}}">
  <link rel="stylesheet" href="/assets/css/toque.css?v={{version}}">
  <link rel="stylesheet" href="/assets/css/aniversario.css?v={{version}}">
  <link rel="stylesheet" href="/assets/css/carga.css?v={{version}}">
  {{!-- Precarga de fotos: la marca va antes de pintar para que ninguna asome
        a medio dibujar; a los 8 s, `carga-lista` lo muestra todo por si
        carga.js no llegara. --}}
  <script>document.documentElement.classList.add('js-carga');window.__cargaSeguro=setTimeout(function(){document.documentElement.classList.add('carga-lista')},8000);</script>
  {{!-- Lo propio de esta sección, después de la base para poder
        afinarla sin pelear con la especificidad. --}}
  {{#if hojaSeccion}}<link rel="stylesheet" href="/assets/css/seccion-{{hojaSeccion}}.css?v={{version}}">{{/if}}
</head>
{{!-- El acento de la página es el color de la barra que esa sección ya lleva
      bajo su nombre en el index. Viene del dato (`barra`), no de una clase
      por sección, así que cambiar un color en index.js lo cambia aquí sin
      tocar CSS. `barraTexto` es el mismo color aclarado lo justo para que el
      texto chico cumpla la regla de contraste; en cuatro de las seis
      secciones es idéntico. --}}
<body class="v2 {{#if actual}}v2--{{actual.color}}{{else}}v2--inicio{{/if}}"
      {{#if actual.barra}}style="--acento: {{actual.barra}}; --acento-chico: {{actual.barraTexto}}"{{/if}}>

  {{!-- Menú en píldora. En escritorio enseña las cuatro marcas; las dos
        secciones de apoyo y las redes viven en el menú completo, que se abre
        con el botón de tres rayas. Funciona sin JavaScript: el menú completo es un ancla
        (#menu) que se pinta con :target. --}}
  <header class="nav">
    <div class="nav__pildora">
      <a class="nav__logo" href="/{{lang}}" aria-label="SOCCER iD, inicio">
        <img src="/assets/images/logo-horizontal-blanco.png" alt="SOCCER iD" width="132" height="30">
      </a>
      <nav class="nav__marcas" aria-label="Marcas">
        {{#each marcas}}
        <a class="nav__link {{#eq ../actual.slug this.slug}}is-activo{{/eq}}" href="{{this.url}}">{{this.nombre}}</a>
        {{/each}}
      </nav>
      <a class="nav__menu" href="#menu" aria-label="{{#if isEs}}Abrir el menú{{else}}Open menu{{/if}}">
        <svg class="nav__menu-icono" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </a>
    </div>
  </header>

  {{!-- Menú completo: las seis secciones como lista y las redes. --}}
  <div class="menu" id="menu" role="dialog" aria-label="{{#if isEs}}Menú{{else}}Menu{{/if}}">
    <div class="menu__cab">
      <a class="menu__logo" href="/{{lang}}" aria-label="{{#if isEs}}SOCCER iD, inicio{{else}}SOCCER iD, home{{/if}}">
        <img src="/assets/images/logo-horizontal-blanco.png" alt="SOCCER iD" width="132" height="30">
      </a>
      {{!-- La misma página en el otro idioma (`currentPath`). En un
            reportaje lleva a Media: los reportajes no son los mismos en
            los dos idiomas. --}}
      <a class="menu__idioma" href="{{#if isEs}}{{langUrl "en"}}{{else}}{{langUrl "es"}}{{/if}}" hreflang="{{#if isEs}}en{{else}}es{{/if}}"
         aria-label="{{#if isEs}}Ver en inglés{{else}}View in Spanish{{/if}}">{{#if isEs}}EN{{else}}ES{{/if}}</a>
      <a class="menu__x" href="#" aria-label="{{#if isEs}}Cerrar el menú{{else}}Close menu{{/if}}">{{#if isEs}}Cerrar{{else}}Close{{/if}}</a>
    </div>
    <ol class="menu__lista">
      {{!-- El inicio va primero: en el teléfono la píldora queda tapada por
            el menú y el logo solo no se lee como botón. --}}
      <li><a href="/{{lang}}" class="menu__item"><span class="menu__num" aria-hidden="true">←</span><span class="menu__nombre">{{#if isEs}}Inicio{{else}}Home{{/if}}</span></a></li>
      {{#each secciones}}
      <li><a href="{{this.url}}" class="menu__item"><span class="menu__num">{{this.num}}</span><span class="menu__nombre">{{this.nombre}}</span><span class="menu__flecha" aria-hidden="true">↗</span></a></li>
      {{/each}}
    </ol>
    <div class="menu__redes">
      {{#each redes}}<a class="red-icono" href="{{this.url}}" target="_blank" rel="noopener" aria-label="{{this.nombre}}" title="{{this.nombre}}">{{> icono-red id=this.id}}</a>{{/each}}
    </div>
  </div>

  <main class="pagina">
    {{{body}}}
  </main>

  {{!-- Pie: todo centrado y en columna, igual que el home. El logo es el
        lockup completo en blanco, medido por ancho con la altura en auto
        (1200×271) para que no se deforme. Sin lista de secciones: el menú
        de arriba siempre está a la mano y repetirlo aquí abajo sobraba. --}}
  <footer class="pie">
    <img class="pie__marca" src="/assets/images/logo-horizontal-blanco.png" alt="SOCCER iD" width="1200" height="271">
    {{> aniversario chico=true}}
    <div class="pie__redes">
      {{#each redes}}<a class="red-icono" href="{{this.url}}" target="_blank" rel="noopener" aria-label="{{this.nombre}}" title="{{this.nombre}}">{{> icono-red id=this.id}}</a>{{/each}}
    </div>
    <nav class="pie__legales" aria-label="{{#if isEs}}Avisos{{else}}Legal{{/if}}">
      <a href="/{{lang}}/privacy">{{#if isEs}}Privacidad{{else}}Privacy{{/if}}</a>
      <a href="/{{lang}}/terms">{{#if isEs}}Términos{{else}}Terms{{/if}}</a>
    </nav>
    <span class="pie__legal">© {{year}} SOCCER iD</span>
  </footer>

  {{!-- Cuánto llevas leído. El marcado lo pone el script, no la plantilla:
        sin JavaScript no hay barra que se quede en cero mintiendo. --}}

  {{!-- Volver arriba. Las secciones son largas —Tour mide más de cinco mil
        píxeles— y en un teléfono volver al menú es un viaje. Aparece al
        pasar la primera pantalla y se esconde solo si no hay nada que
        subir. Es un ancla de verdad: sin JavaScript sigue llevando al
        principio de la página. --}}
  <a class="arriba" id="volverArriba" href="#" aria-label="{{#if isEs}}Volver arriba{{else}}Back to top{{/if}}" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </a>

  <script>
    // ── Menú completo ──────────────────────────────────────────────────
    // Sin JavaScript abre y cierra por el ancla (#menu y #). Con él, se
    // conmuta una clase: cerrar con `href="#"` subía la página al principio
    // y cada apertura dejaba una entrada en el historial. Aquí se empuja
    // UNA entrada al abrir, para que el «atrás» del teléfono lo cierre.
    (function () {
      var menu = document.getElementById('menu');
      var abrir = document.querySelector('.nav__menu');
      var cerrarBtn = menu && menu.querySelector('.menu__x');
      if (!menu || !abrir || !cerrarBtn) return;

      function pintar(abierto) {
        menu.classList.toggle('is-abierta', abierto);
        document.documentElement.classList.toggle('con-menu', abierto);
      }

      abrir.addEventListener('click', function (e) {
        e.preventDefault();
        history.pushState({ menu: 1 }, '');
        pintar(true);
      });
      cerrarBtn.addEventListener('click', function (e) {
        e.preventDefault();
        if (history.state && history.state.menu) history.back();
        else pintar(false);
      });
      window.addEventListener('popstate', function () {
        if (menu.classList.contains('is-abierta')) pintar(false);
      });
      // Al elegir una sección, la página nueva ocupa el lugar de la entrada
      // del menú: si no, «atrás» caería en esta misma página con el menú
      // cerrado y habría que pulsarlo dos veces.
      menu.addEventListener('click', function (e) {
        var a = e.target.closest('a[href]');
        if (!a || a === cerrarBtn || a.target === '_blank') return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (!(history.state && history.state.menu)) return;
        e.preventDefault();
        location.replace(a.href);
      });
      // Volver desde otra página con la caché de atrás restaura el menú
      // abierto; se cierra para que se vea la página donde se estaba.
      window.addEventListener('pageshow', function (e) {
        if (e.persisted) pintar(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && menu.classList.contains('is-abierta')) cerrarBtn.click();
      });
    })();

    (function () {
      var boton = document.getElementById('volverArriba');
      if (!boton) return;

      function revisar() {
        // Una pantalla de margen: antes de eso, el menú está a la vista.
        boton.hidden = window.scrollY < window.innerHeight * 0.9;
      }

      boton.addEventListener('click', function (e) {
        e.preventDefault();
        // `scroll-behavior: smooth` está en la hoja; quien pida menos
        // movimiento sube de golpe, que es lo correcto.
        var suave = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: suave ? 'smooth' : 'auto' });
      });

      window.addEventListener('scroll', revisar, { passive: true });
      window.addEventListener('resize', revisar);
      revisar();
    })();

    // ── Cuánto llevas leído ────────────────────────────────────────────
    (function () {
      var barra = document.createElement('div');
      barra.className = 'progreso__barra';
      var caja = document.createElement('div');
      caja.className = 'progreso';
      caja.setAttribute('aria-hidden', 'true');   // decorativo: no se anuncia
      caja.appendChild(barra);
      document.body.appendChild(caja);

      function pintar() {
        var recorrido = document.documentElement.scrollHeight - window.innerHeight;
        // Una página que cabe entera no tiene progreso que mostrar.
        caja.hidden = recorrido < 200;
        barra.style.transform = 'scaleX(' + (recorrido > 0 ? Math.min(1, window.scrollY / recorrido) : 0) + ')';
      }

      window.addEventListener('scroll', pintar, { passive: true });
      window.addEventListener('resize', pintar);
      pintar();
    })();

    // ── Dónde vas dentro de cada carrusel ──────────────────────────────
    // El indicador lo crea el script, así que las vistas no cargan con
    // marcado que sólo sirve si hay JavaScript.
    (function () {
      // El riel se crea siempre y se esconde mientras no haya desborde: al
      // girar el teléfono o achicar la ventana, un carrusel que cabía pasa a
      // desplazarse y tiene que aparecer su indicador.
      var pistas = document.querySelectorAll('.mosaico, .opiniones, .publicaciones, .invitados');
      Array.prototype.forEach.call(pistas, function (pista) {
        var pulgar = document.createElement('div');
        pulgar.className = 'deslizador__pulgar';
        var riel = document.createElement('div');
        riel.className = 'deslizador';
        riel.setAttribute('aria-hidden', 'true');
        riel.appendChild(pulgar);
        pista.parentNode.insertBefore(riel, pista.nextSibling);

        function pintar() {
          var total = pista.scrollWidth;
          riel.hidden = total - pista.clientWidth < 20;   // no se desplaza: nada que indicar
          if (riel.hidden) return;
          // El pulgar ocupa la parte visible y se coloca donde empieza.
          pulgar.style.width = (pista.clientWidth / total * 100) + '%';
          pulgar.style.left = (pista.scrollLeft / total * 100) + '%';
        }

        pista.addEventListener('scroll', pintar, { passive: true });
        window.addEventListener('resize', pintar);
        pintar();
      });
    })();
  </script>
  <script src="/assets/js/v2-lightbox.js?v={{version}}" defer></script>
  <script src="/assets/js/toque.js?v={{version}}" defer></script>
  <script src="/assets/js/carga.js?v={{version}}" defer></script>
</body>
</html>
