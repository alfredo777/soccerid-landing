{{!-- Travel Club · la misma anatomía que Tour y Legends: portada, lo que
      la marca ofrece, el calendario de lo que viene, contacto y cierre.

      El calendario de Travel son los partidos: sólo los de hoy en
      adelante, que es lo que se puede vender. --}}

<section class="portada">
  <img class="portada__foto" src="/assets/images/vip2.jpg" alt="SOCCER iD Travel Club">
  <div class="portada__velo"></div>
  <div class="portada__cuerpo">
    <p class="cabecera__miga"><a href="/{{lang}}">SOCCER iD</a> / Travel</p>
    <div class="cabecera__marca">SOCCER iD Travel Club</div>
    <h1 class="portada__titulo">Travel</h1>
    <p class="portada__bajada">{{#if isEs}}Te llevamos a cualquier estadio. Palcos en la Liga MX, viajes con vuelo y hospedaje, y experiencias para vivir el partido de cerca.{{else}}We take you to any stadium. Liga MX suites, trips with flights and lodging, and experiences to live the match up close.{{/if}}</p>
    <div class="portada__pastillas">
      <span class="pastilla">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
        {{#if partidos.length}}{{partidos.length}} {{#if isEs}}fechas abiertas{{else}}open dates{{/if}}{{else}}{{#if isEs}}Calendario por publicar{{else}}Calendar to be published{{/if}}{{/if}}
      </span>
      <span class="pastilla">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        {{#if isEs}}Cualquier estadio{{else}}Any stadium{{/if}}
      </span>
    </div>
    <div class="portada__acciones">
      <a class="boton boton--lleno" href="#calendario">{{#if isEs}}Ver el calendario{{else}}See the calendar{{/if}}</a>
      <a class="boton" href="https://wa.me/{{@root.contacto.whatsapp}}?text={{#if isEs}}Hola!%20Quiero%20informaci%C3%B3n%20del%20Travel%20Club{{else}}Hi!%20I%27d%20like%20info%20about%20the%20Travel%20Club{{/if}}" target="_blank" rel="noopener">{{#if isEs}}Escríbenos{{else}}Write to us{{/if}} <span class="flecha">↗</span></a>
    </div>
  </div>
</section>

{{!-- Experiencias: lo que la marca ofrece, antes del calendario. Asientos
      VIP y Fan Experience salen de panel_templates; Vuelo y hospedaje es
      fijo porque no depende de un partido. --}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if isEs}}Experiencias{{else}}Experiences{{/if}}</p>
  <div class="experiencias">
    {{#if vip}}
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/gallery/vip/1.jpg')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">{{vip.tag}}</span>
        <h3>{{#if isEs}}Asientos VIP{{else}}VIP seats{{/if}}</h3>
        {{{vip.description}}}
      </div>
    </article>
    {{/if}}
    {{#if fan}}
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/gallery/fan/1@2x.png')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">{{fan.tag}}</span>
        <h3>Fan Experience</h3>
        {{{fan.description}}}
      </div>
    </article>
    {{/if}}
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/gallery/cup2025/4.jpg')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">{{#if isEs}}Viaje completo{{else}}Full trip{{/if}}</span>
        <h3>{{#if isEs}}Vuelo y hospedaje{{else}}Flight and lodging{{/if}}</h3>
        <p>{{#if isEs}}Te llevamos al partido desde tu ciudad: vuelo, hotel cerca del estadio, traslados y tu lugar en la grada o en el palco. Tú sólo llegas a disfrutar.{{else}}We take you to the match from your city: flight, a hotel near the stadium, transfers and your seat in the stands or the suite. You just show up and enjoy.{{/if}}</p>
      </div>
    </article>
  </div>
</section>

{{!-- El calendario. --}}
<section class="seccion envoltura" id="calendario">
  <p class="rotulo">{{#if isEs}}Próximos partidos{{else}}Upcoming matches{{/if}}</p>
  <div class="partidos">
    {{#each partidos}}
    <article class="partido">
      <div class="partido__fecha"><div class="partido__dia">{{this.dia}}</div><div class="partido__mes">{{this.mes}}</div></div>
      <div>
        <a class="partido__equipos" href="/{{../lang}}/evento/{{this.id}}">
          <img class="partido__escudo" src="{{this.team1Icon}}" alt="">{{this.team1}}
          <span class="partido__vs">vs</span>
          <img class="partido__escudo" src="{{this.team2Icon}}" alt="">{{this.team2}}
        </a>
        <div class="partido__meta">{{this.venue}} · {{this.time}}</div>
      </div>
      <div class="partido__torneo"><b>{{this.badge}}</b>{{this.torneo}}{{#if this.jornada}} · {{this.jornada}}{{/if}}</div>
      <a class="boton" href="https://wa.me/{{@root.contacto.whatsapp}}?text={{#if ../isEs}}Hola!%20Quiero%20accesos%20para%20{{else}}Hi!%20I%20want%20access%20for%20{{/if}}{{this.team1}}%20vs%20{{this.team2}}" target="_blank" rel="noopener">{{#if ../isEs}}Reservar{{else}}Book{{/if}} <span class="flecha">↗</span></a>
    </article>
    {{else}}
    <p class="vacio">{{#if isEs}}No hay partidos publicados por ahora. Escríbenos y te avisamos en cuanto se abra el calendario.{{else}}No matches published yet. Write to us and we'll let you know as soon as the calendar opens.{{/if}}</p>
    {{/each}}
  </div>
</section>

{{!-- Viajes pasados: lo que ya hicimos. Sale de contents/travel.json; los
      que llevan `muestra` son de ejemplo y lo dicen en pantalla. --}}
{{#if travel.pasados.length}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if isEs}}Viajes pasados{{else}}Past trips{{/if}}</p>
  <div class="recuerdos">
    {{#each travel.pasados}}{{> recuerdo}}{{/each}}
  </div>
</section>
{{/if}}

{{> contacto asunto='Hola!%20Quiero%20informaci%C3%B3n%20del%20Travel%20Club'}}

<section class="cierre">
  <img class="cierre__foto" src="/assets/images/gallery/vip/2.jpg" alt="">
  <div class="cierre__velo"></div>
  <div class="cierre__cuerpo">
    <h2 class="cierre__t">{{#if isEs}}Dinos a qué estadio quieres ir{{else}}Tell us which stadium you want{{/if}}</h2>
    <p class="cierre__d">{{#if isEs}}Palcos, boletos y viaje. Nosotros armamos el resto.{{else}}Suites, tickets and travel. We handle the rest.{{/if}}</p>
    <a class="boton boton--lleno" href="https://wa.me/{{@root.contacto.whatsapp}}?text={{#if isEs}}Hola!%20Quiero%20informaci%C3%B3n%20del%20Travel%20Club{{else}}Hi!%20I%27d%20like%20info%20about%20the%20Travel%20Club{{/if}}" target="_blank" rel="noopener">{{#if isEs}}Escríbenos{{else}}Write to us{{/if}} <span class="flecha">↗</span></a>
  </div>
</section>
