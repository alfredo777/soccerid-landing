{{!-- Travel Club · la misma anatomía que Tour y Legends: portada, lo que
      la marca ofrece, lo que viene, lo que ya pasó, contacto y cierre.

      Español: los textos y los cuatro viajes del documento «Textos y cambios
      del sitio web» (27/10/2026), de contents/viajes.json (`viajes`).
      Inglés: sin traducción aprobada, sigue como estaba: el calendario de
      partidos de upcoming_events.json (`partidos`). --}}

<section class="portada">
  <img class="portada__foto" src="/assets/images/secciones/travel/portada.jpg" alt="SOCCER iD Travel Club">
  <div class="portada__velo"></div>
  <div class="portada__cuerpo">
    <p class="cabecera__miga"><a href="/{{lang}}">SOCCER iD</a> / Travel</p>
    <div class="cabecera__marca">SOCCER iD Travel Club</div>
    <h1 class="portada__titulo">Travel</h1>
    {{#if conViajes}}
    <p class="portada__bajada">Viaja a los grandes eventos del fútbol mundial con acceso VIP, hotel, traslados y experiencias exclusivas.</p>
    {{#if viajes.length}}
    <div class="portada__pastillas">
      <span class="pastilla">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
        {{viajes.length}} {{#eq viajes.length 1}}fecha abierta{{else}}fechas abiertas{{/eq}}
      </span>
    </div>
    {{/if}}
    <div class="portada__acciones">
      <a class="boton boton--lleno" href="#viajes">Ver próximos viajes</a>
      <a class="boton" href="https://wa.me/{{@root.contacto.whatsapp}}?text=Hola!%20Quiero%20informaci%C3%B3n%20del%20Travel%20Club" target="_blank" rel="noopener">Escríbenos <span class="flecha">↗</span></a>
    </div>
    {{else}}
    <p class="portada__bajada">We take you to any stadium. Liga MX suites, trips with flights and lodging, and experiences to live the match up close.</p>
    <div class="portada__pastillas">
      <span class="pastilla">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
        {{#if partidos.length}}{{partidos.length}} open dates{{else}}Calendar to be published{{/if}}
      </span>
      <span class="pastilla">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        Any stadium
      </span>
    </div>
    <div class="portada__acciones">
      <a class="boton boton--lleno" href="#calendario">See the calendar</a>
      <a class="boton" href="https://wa.me/{{@root.contacto.whatsapp}}?text=Hi!%20I%27d%20like%20info%20about%20the%20Travel%20Club" target="_blank" rel="noopener">Write to us <span class="flecha">↗</span></a>
    </div>
    {{/if}}
  </div>
</section>

{{!-- Experiencias: lo que la marca ofrece, antes de las fechas. --}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if conViajes}}Experiencias{{else}}Experiences{{/if}}</p>
  <div class="experiencias">
    {{#if conViajes}}
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/secciones/travel/experiencia-acceso.jpg')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">VIP</span>
        <h3>Acceso al estadio</h3>
        <p>Vive el partido desde zonas VIP en los grandes escenarios del fútbol mundial.</p>
      </div>
    </article>
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/secciones/travel/experiencia-convivencia.jpg')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">Exclusivo</span>
        <h3>Convivencias con leyendas</h3>
        <p>Comparte cenas y encuentros con figuras del fútbol como parte de tu viaje.</p>
      </div>
    </article>
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/secciones/travel/experiencia-hotel-traslados.jpg')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">Tu viaje</span>
        <h3>Hotel y traslados</h3>
        <p>Disfruta la experiencia con hospedaje y traslados incluidos en tu paquete.</p>
      </div>
    </article>
    {{else}}
    {{#if vip}}
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/secciones/travel/experiencia-acceso.jpg')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">{{vip.tag}}</span>
        <h3>VIP seats</h3>
        {{{vip.description}}}
      </div>
    </article>
    {{/if}}
    {{#if fan}}
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/gallery/fan/1@2x.png')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">{{fan.tag}}</span>
        <h3>Fan Experience</h3>
        {{{fan.description}}}
      </div>
    </article>
    {{/if}}
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/secciones/travel/experiencia-hotel-traslados.jpg')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">Full trip</span>
        <h3>Flight and lodging</h3>
        <p>We take you to the match from your city: flight, a hotel near the stadium, transfers and your seat in the stands or the suite. You just show up and enjoy.</p>
      </div>
    </article>
    {{/if}}
  </div>
  {{#if conViajes}}<p class="travel__aclaracion">Las experiencias y servicios incluidos varían según el paquete.</p>{{/if}}
</section>

{{#if conViajes}}
{{!-- Próximos viajes: cada tarjeta lleva a su ficha. --}}
<section class="seccion envoltura" id="viajes">
  <p class="rotulo">Próximos viajes</p>
  <div class="eventos">
    {{#each viajes}}
    <article class="evento">
      <div class="evento__fecha"><div class="evento__dia">{{this.dia}}</div><div class="evento__mes">{{this.mes}}</div></div>
      <div>
        <a class="evento__nombre" href="/{{../lang}}/viaje/{{this.slug}}">{{this.nombre}}</a>
        <div class="evento__meta">{{this.fechaTexto}}</div>
      </div>
      <a class="boton" href="/{{../lang}}/viaje/{{this.slug}}">Ver viaje <span class="flecha">→</span></a>
    </article>
    {{else}}
    <p class="vacio">No hay viajes publicados por ahora. Escríbenos y te avisamos en cuanto se abra una fecha.</p>
    {{/each}}
  </div>
</section>

{{#if viajesPasados.length}}
<section class="seccion envoltura">
  <p class="rotulo">Viajes pasados</p>
  <div class="recuerdos">
    {{#each viajesPasados}}{{> recuerdo}}{{/each}}
  </div>
  <div class="portada__acciones travel__todos">
    <a class="boton" href="/{{lang}}/travel/viajes-pasados">Ver todos los viajes <span class="flecha">→</span></a>
  </div>
</section>
{{/if}}

{{> contacto asunto='Hola!%20Quiero%20informaci%C3%B3n%20del%20Travel%20Club' tituloEs='¿Planeamos tu próximo viaje?' textoEs='Escríbenos para conocer paquetes, precios y disponibilidad.'}}

{{!-- Cierre: viajes a la medida, para lo que no está en el calendario. --}}
<section class="cierre">
  <img class="cierre__foto" src="/assets/images/secciones/travel/cierre.jpg" alt="">
  <div class="cierre__velo"></div>
  <div class="cierre__cuerpo">
    <h2 class="cierre__t">¿Qué partido sueñas vivir?</h2>
    <p class="cierre__d">Cuéntanos a dónde quieres ir y diseñamos una experiencia para ti.</p>
    <a class="boton boton--lleno" href="https://wa.me/{{@root.contacto.whatsapp}}?text=Hola!%20Quiero%20solicitar%20un%20viaje%20personalizado" target="_blank" rel="noopener">Solicitar viaje personalizado <span class="flecha">↗</span></a>
  </div>
</section>

{{else}}
{{!-- Inglés: el calendario de partidos, como estaba. --}}
<section class="seccion envoltura" id="calendario">
  <p class="rotulo">Upcoming matches</p>
  <div class="partidos">
    {{#each partidos}}
    <article class="partido">
      <div class="partido__fecha"><div class="partido__dia">{{this.dia}}</div><div class="partido__mes">{{this.mes}}</div></div>
      <div>
        <a class="partido__equipos" href="/{{../lang}}/evento/{{this.id}}">
          <img class="partido__escudo" src="{{this.team1Icon}}" alt="">{{this.team1}}
          <span class="partido__vs">vs</span>
          <img class="partido__escudo" src="{{this.team2Icon}}" alt="">{{this.team2}}
        </a>
        <div class="partido__meta">{{this.venue}} · {{this.time}}</div>
      </div>
      <div class="partido__torneo"><b>{{this.badge}}</b>{{this.torneo}}{{#if this.jornada}} · {{this.jornada}}{{/if}}</div>
      <a class="boton" href="https://wa.me/{{@root.contacto.whatsapp}}?text=Hi!%20I%20want%20access%20for%20{{this.team1}}%20vs%20{{this.team2}}" target="_blank" rel="noopener">Book <span class="flecha">↗</span></a>
    </article>
    {{else}}
    <p class="vacio">No matches published yet. Write to us and we'll let you know as soon as the calendar opens.</p>
    {{/each}}
  </div>
</section>

{{#if travel.pasados.length}}
<section class="seccion envoltura">
  <p class="rotulo">Past trips</p>
  <div class="recuerdos">
    {{#each travel.pasados}}{{> recuerdo}}{{/each}}
  </div>
</section>
{{/if}}

{{> contacto asunto='Hola!%20Quiero%20informaci%C3%B3n%20del%20Travel%20Club'}}

<section class="cierre">
  <img class="cierre__foto" src="/assets/images/secciones/travel/cierre.jpg" alt="">
  <div class="cierre__velo"></div>
  <div class="cierre__cuerpo">
    <h2 class="cierre__t">Tell us which stadium you want</h2>
    <p class="cierre__d">Suites, tickets and travel. We handle the rest.</p>
    <a class="boton boton--lleno" href="https://wa.me/{{@root.contacto.whatsapp}}?text=Hi!%20I%27d%20like%20info%20about%20the%20Travel%20Club" target="_blank" rel="noopener">Write to us <span class="flecha">↗</span></a>
  </div>
</section>
{{/if}}
