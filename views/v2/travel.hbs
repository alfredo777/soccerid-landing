{{!-- Travel Club · la misma anatomía que Tour y Legends: portada, lo que
      la marca ofrece, lo que viene, lo que ya pasó, contacto y cierre.

      Los textos y los viajes son los del documento «Textos y cambios del
      sitio web» (27/10/2026) con los cambios del 30/10/2026, de
      contents/viajes.json (`viajes`, `viajesPasados`). El inglés es su
      traducción, con la misma estructura. --}}

<section class="portada">
  <img class="portada__foto" src="/assets/images/secciones/travel/portada.jpg" alt="SOCCER iD Travel Club">
  <div class="portada__velo"></div>
  <div class="portada__cuerpo">
    <div class="cabecera__marca">SOCCER iD Travel Club</div>
    <h1 class="portada__titulo">Travel</h1>
    <p class="portada__bajada">{{#if isEs}}Viaja a los <strong>grandes eventos del fútbol mundial</strong> con acceso VIP, hotel, traslados y experiencias exclusivas.{{else}}Travel to the <strong>biggest events in world football</strong> with VIP access, hotel, transfers and exclusive experiences.{{/if}}</p>
    {{#if viajes.length}}
    <div class="portada__pastillas">
      <span class="pastilla">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
        {{viajes.length}} {{#if isEs}}{{#eq viajes.length 1}}fecha abierta{{else}}fechas abiertas{{/eq}}{{else}}{{#eq viajes.length 1}}open date{{else}}open dates{{/eq}}{{/if}}
      </span>
    </div>
    {{/if}}
    <div class="portada__acciones">
      <a class="boton boton--lleno" href="#viajes">{{#if isEs}}Ver próximos viajes{{else}}See upcoming trips{{/if}}</a>
      <a class="boton" href="https://wa.me/{{@root.contacto.whatsapp}}?text={{#if isEs}}Hola!%20Quiero%20informaci%C3%B3n%20del%20Travel%20Club{{else}}Hi!%20I%27d%20like%20info%20about%20the%20Travel%20Club{{/if}}" target="_blank" rel="noopener">{{#if isEs}}Escríbenos{{else}}Write to us{{/if}} <span class="flecha">↗</span></a>
    </div>
  </div>
</section>

{{!-- Experiencias: lo que la marca ofrece, antes de las fechas. --}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if isEs}}Experiencias{{else}}Experiences{{/if}}</p>
  <div class="experiencias">
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/secciones/travel/experiencia-acceso.jpg')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">VIP</span>
        <h3>{{#if isEs}}Acceso al estadio{{else}}Stadium access{{/if}}</h3>
        <p>{{#if isEs}}Vive el partido desde <strong>zonas VIP</strong> en los grandes escenarios del fútbol mundial.{{else}}Watch the match from <strong>VIP areas</strong> at the great stages of world football.{{/if}}</p>
      </div>
    </article>
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/secciones/travel/experiencia-convivencia.jpg')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">{{#if isEs}}Exclusivo{{else}}Exclusive{{/if}}</span>
        <h3>{{#if isEs}}Convivencias con leyendas{{else}}Meet-ups with legends{{/if}}</h3>
        <p>{{#if isEs}}Comparte <strong>cenas y encuentros con figuras del fútbol</strong> como parte de tu viaje.{{else}}Share <strong>dinners and get-togethers with football greats</strong> as part of your trip.{{/if}}</p>
      </div>
    </article>
    <article class="experiencia">
      <div class="experiencia__foto" style="background-image:url('/assets/images/secciones/travel/experiencia-hotel-traslados.jpg')"></div>
      <div class="experiencia__cuerpo">
        <span class="pastilla">{{#if isEs}}Tu viaje{{else}}Your trip{{/if}}</span>
        <h3>{{#if isEs}}Hotel y traslados{{else}}Hotel and transfers{{/if}}</h3>
        <p>{{#if isEs}}Disfruta la experiencia con <strong>hospedaje y traslados incluidos</strong> en tu paquete.{{else}}Enjoy the experience with <strong>accommodation and transfers included</strong> in your package.{{/if}}</p>
      </div>
    </article>
  </div>
  <p class="travel__aclaracion">{{#if isEs}}Las experiencias y servicios incluidos <strong>varían según el paquete</strong>.{{else}}Included experiences and services <strong>vary by package</strong>.{{/if}}</p>
</section>

{{!-- Próximos viajes: cada tarjeta lleva a su ficha. --}}
<section class="seccion envoltura" id="viajes">
  <p class="rotulo">{{#if isEs}}Próximos viajes{{else}}Upcoming trips{{/if}}</p>
  <div class="eventos">
    {{#each viajes}}
    <article class="evento">
      <div class="evento__fecha"><div class="evento__dia">{{this.dia}}</div><div class="evento__mes">{{this.mes}}</div></div>
      <div>
        <a class="evento__nombre" href="/{{../lang}}/viaje/{{this.slug}}">{{this.nombre}}</a>
        <div class="evento__meta">{{this.fechaTexto}}</div>
      </div>
      <a class="boton" href="/{{../lang}}/viaje/{{this.slug}}">{{#if ../isEs}}Ver viaje{{else}}View trip{{/if}} <span class="flecha">→</span></a>
    </article>
    {{else}}
    <p class="vacio">{{#if isEs}}No hay viajes publicados por ahora. Escríbenos y te avisamos en cuanto se abra una fecha.{{else}}No trips published right now. Write to us and we'll let you know as soon as a date opens.{{/if}}</p>
    {{/each}}
  </div>
</section>

{{#if viajesPasados.length}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if isEs}}Viajes pasados{{else}}Past trips{{/if}}</p>
  <div class="recuerdos">
    {{#each viajesPasados}}{{> recuerdo}}{{/each}}
  </div>
  <div class="portada__acciones travel__todos">
    <a class="boton" href="/{{lang}}/travel/viajes-pasados">{{#if isEs}}Ver todos los viajes{{else}}See all trips{{/if}} <span class="flecha">→</span></a>
  </div>
</section>
{{/if}}

{{> contacto asunto='Hola!%20Quiero%20informaci%C3%B3n%20del%20Travel%20Club' tituloEs='¿Planeamos tu próximo viaje?' textoEs='Escríbenos para conocer <strong>paquetes, precios y disponibilidad</strong>.' tituloEn='Shall we plan your next trip?' textoEn='Write to us to learn about <strong>packages, prices and availability</strong>.'}}

{{!-- Cierre: viajes a la medida, para lo que no está en el calendario. --}}
<section class="cierre">
  <img class="cierre__foto" src="/assets/images/secciones/travel/cierre.jpg" alt="">
  <div class="cierre__velo"></div>
  <div class="cierre__cuerpo">
    <h2 class="cierre__t">{{#if isEs}}¿Qué partido sueñas vivir?{{else}}Which match do you dream of seeing?{{/if}}</h2>
    <p class="cierre__d">{{#if isEs}}Cuéntanos a dónde quieres ir y <strong>diseñamos una experiencia para ti</strong>.{{else}}Tell us where you want to go and <strong>we'll design an experience for you</strong>.{{/if}}</p>
    <a class="boton boton--lleno" href="https://wa.me/{{@root.contacto.whatsapp}}?text={{#if isEs}}Hola!%20Quiero%20solicitar%20un%20viaje%20personalizado{{else}}Hi!%20I%27d%20like%20to%20request%20a%20custom%20trip{{/if}}" target="_blank" rel="noopener">{{#if isEs}}Solicitar viaje personalizado{{else}}Request a custom trip{{/if}} <span class="flecha">↗</span></a>
  </div>
</section>
