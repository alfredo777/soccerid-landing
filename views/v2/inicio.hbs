{{!-- Home de la nueva distribución, construido SOBRE la landing original:
      su hero con la foto del estadio y el isotipo (el círculo con el iD y la
      playera; nunca el lockup completo), su vidrio esmerilado y su dock
      flotante. Lo nuevo: en escritorio el home ES el menú (seis puertas en
      la primera pantalla); en celular, tarjetas. Sin menú lateral: las
      puertas son el único menú, en web y en celular. --}}
<link rel="stylesheet" href="/assets/css/inicio.css?v={{version}}">
<link rel="stylesheet" href="/assets/css/toque.css?v={{version}}">
<script src="/assets/js/toque.js?v={{version}}" defer></script>

<div class="preloader" id="preloader">
  <div class="preloader-logo-container">
    <div class="preloader-spinner"></div>
    <div class="preloader-logo"><img src="{{img '/assets/images/logo-iso-blanco.png'}}" alt="SOCCER iD"></div>
  </div>
  <div class="preloader-subtext">Cargando...</div>
</div>

{{!-- Sin barra de menú arriba: en el mockup sólo están el selector de
      idioma (del layout) y, al centro, el isotipo con el lema. Las puertas
      son el menú. --}}

<section class="hero-section" id="hero">
  <div class="hero-video-container">
    {{!-- Dos fondos: el vertical para celular y tableta en vertical, el
          horizontal para web. El navegador elige por el media query. --}}
    <picture>
      <source media="(max-width: 1024px)" srcset="{{img '/assets/images/fondo-estadio-movil.webp'}}" type="image/webp">
      <source media="(max-width: 1024px)" srcset="{{img '/assets/images/fondo-estadio-movil.jpg'}}">
      <source srcset="{{img '/assets/images/fondo-estadio.webp'}}" type="image/webp">
      <img src="{{img '/assets/images/fondo-estadio.jpg'}}" alt="Estadio de fútbol" class="hero-image" style="display:block;">
    </picture>
  </div>

  {{!-- Primera pantalla: UNA sola columna de alto completo con la marca, el
        lema, las seis puertas y las redes. El reparto lo hace flex, sin
        alturas fijas ni márgenes negativos: las puertas se estiran con la
        pantalla hasta su tope y lo que sobra se parte por igual arriba y
        abajo, así que en un monitor grande no se abre un hueco en medio. --}}
  <div class="hero-content">
    <div class="hero-cabecera">
      <div class="hero-logo-text"><img src="{{img '/assets/images/logo-iso-blanco.png'}}" width="100" height="100" alt="SOCCER iD"></div>
      <h1 class="hero-tagline">AMAMOS TANTO EL DEPORTE<br>QUE NOS ATREVIMOS <em>A REINVENTARLO</em></h1>
    </div>

    <nav class="puertas" id="secciones" aria-label="{{#if isEs}}Secciones{{else}}Sections{{/if}}">
      {{#each secciones}}
      <a class="puerta puerta--{{this.slug}}" id="sec-{{this.slug}}" href="{{this.url}}" style="--i:{{@index}}; --foto:url('{{this.foto}}'); --barra:{{this.barra}}">
        <span class="puerta__icono" aria-hidden="true">{{> icono-seccion slug=this.slug}}</span>
        <span class="puerta__cuerpo">
          {{!-- Sólo el nombre, en una línea, con su barra de color y el lema. --}}
          <span class="puerta__nombre">{{#if this.corto}}{{this.corto}}{{else}}{{this.nombre}}{{/if}}</span>
          <span class="puerta__barra" aria-hidden="true"></span>
          <span class="puerta__linea">{{this.lema}}</span>
        </span>
      </a>
      {{/each}}
    </nav>

    <section class="redes-v2">
      <div class="section-header"><h2>{{#if isEs}}Síguenos{{else}}Follow us{{/if}}</h2><p>@soccerid7</p></div>
      <div class="redes-v2__grid">
        {{#each redes}}<a class="redes-v2__chip" href="{{this.url}}" target="_blank" rel="noopener" aria-label="{{this.nombre}}" title="{{this.nombre}}">{{> icono-red id=this.id}}<span>{{this.nombre}}</span><small>{{this.usuario}}</small></a>{{/each}}
      </div>
    </section>
  </div>
</section>

{{!-- Pie: todo centrado y en columna. Primero el logo completo en blanco
      (el lockup, no el isotipo), luego los enlaces y al final el aviso.
      El logo se mide por ancho y la altura va en auto: el archivo es de
      1200×271, así que nunca se deforma. --}}
<footer class="footer">
  <div class="footer-content">
    <img class="footer-marca" src="{{img '/assets/images/logo-horizontal-blanco.png'}}" alt="SOCCER iD" width="1200" height="271">
    <nav class="footer-links" aria-label="{{#if isEs}}Enlaces{{else}}Links{{/if}}">
      <a class="footer-link" href="/{{lang}}/privacy">{{#if isEs}}Privacidad{{else}}Privacy{{/if}}</a>
      <a class="footer-link" href="/{{lang}}/terms">{{#if isEs}}Términos{{else}}Terms{{/if}}</a>
    </nav>
    <p class="footer-legal">© {{year}} SOCCER iD</p>
  </div>
</footer>
