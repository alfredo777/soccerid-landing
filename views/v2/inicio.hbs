{{!-- Home de la nueva distribución, construido SOBRE la landing original:
      su hero con la foto del estadio y el isotipo (el círculo con el iD y la
      playera; nunca el lockup completo), su vidrio esmerilado, su menú
      lateral y su dock flotante. Lo nuevo: en escritorio el home ES el
      menú (seis puertas en la primera pantalla); en celular, tarjetas. --}}
<link rel="stylesheet" href="/assets/css/inicio.css?v={{version}}">

<div class="preloader" id="preloader">
  <div class="preloader-logo-container">
    <div class="preloader-spinner"></div>
    <div class="preloader-logo"><img src="{{img '/assets/images/logo-iso-blanco.png'}}" alt="SOCCER iD"></div>
  </div>
  <div class="preloader-subtext">Cargando...</div>
</div>

{{!-- Menú en píldora, de vidrio. En escritorio: las cuatro marcas y el menú
      completo. En celular se queda sólo el isotipo: el menú es el lateral
      de la landing original (dot-nav), que vive abajo. --}}
<header class="pildora">
  <a class="pildora__iso" href="/{{lang}}" aria-label="SOCCER iD, inicio">
    <img src="{{img '/assets/images/logo-iso-blanco.png'}}" alt="" width="34" height="34">
  </a>
  <nav class="pildora__nav" aria-label="Marcas">
    {{#each marcas}}<a href="{{this.url}}">{{this.nombre}}</a>{{/each}}
  </nav>
  <a class="pildora__menu" href="#menu"><span class="pildora__punto"></span>{{#if isEs}}Menú{{else}}Menu{{/if}}</a>
</header>

<div class="menu" id="menu" role="dialog" aria-label="{{#if isEs}}Menú{{else}}Menu{{/if}}">
  <div class="menu__scrim"></div>
  <div class="menu__panel">
    <div class="menu__cab">
      <img src="{{img '/assets/images/logo-iso-blanco.png'}}" alt="SOCCER iD" width="40" height="40">
      <a class="menu__x" href="#" aria-label="{{#if isEs}}Cerrar{{else}}Close{{/if}}">×</a>
    </div>
    <ol class="menu__lista">
      {{#each secciones}}<li><a href="{{this.url}}"><small>{{this.num}}</small><span>{{this.nombre}}</span><em>{{this.linea}}</em></a></li>{{/each}}
    </ol>
    <div class="menu__redes">{{#each redes}}<a href="{{this.url}}" target="_blank" rel="noopener">{{this.nombre}}</a>{{/each}}</div>
  </div>
</div>

{{!-- Menú lateral de la landing original (dot-nav de main.css / main.js).
      En celular aparece al bajar, como en la original (en la primera
      pantalla las puertas ya son el menú); en escritorio no se pinta. Cada
      ícono lleva a su sección. --}}
<nav class="dot-nav dot-nav--inicio" id="dotNav" aria-label="{{#if isEs}}Secciones{{else}}Sections{{/if}}">
  <a href="#hero" class="dot-nav__item active" data-section="hero" data-tooltip="{{#if isEs}}Inicio{{else}}Home{{/if}}">
    <span class="dot-nav__icon"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg></span>
  </a>
  {{#each secciones}}
  <a href="{{this.url}}" class="dot-nav__item" data-section="sec-{{this.slug}}" data-tooltip="{{this.nombre}}">
    <span class="dot-nav__icon">{{> icono-seccion slug=this.slug}}</span>
  </a>
  {{/each}}
</nav>

<section class="hero-section" id="hero">
  <div class="hero-video-container">
    <picture>
      <source srcset="{{img '/assets/images/fondo-estadio.webp'}}" type="image/webp">
      <img src="{{img '/assets/images/fondo-estadio.jpg'}}" alt="Estadio de fútbol" class="hero-image" style="display:block;">
    </picture>
  </div>
  <div class="hero-content">
    <div class="hero-logo-text"><img src="{{img '/assets/images/logo-iso-blanco.png'}}" width="110" height="110" alt="SOCCER iD"></div>
    <h1 class="hero-tagline">AMAMOS TANTO EL DEPORTE<br>QUE NOS ATREVIMOS <em>A REINVENTARLO</em></h1>
  </div>
  {{!-- Sin indicador de scroll propio: la píldora del próximo partido que
        pone el layout ya trae su «desliza» en el mismo sitio. --}}
</section>

{{!-- Las seis puertas. En escritorio suben sobre el hero como seis paneles
      verticales de vidrio, uno junto a otro: el home ES el menú y no hay que
      bajar para elegir. En celular se apilan como tarjetas. --}}
<nav class="puertas" id="secciones" aria-label="{{#if isEs}}Secciones{{else}}Sections{{/if}}">
  {{#each secciones}}
  <a class="puerta puerta--{{this.slug}}" id="sec-{{this.slug}}" href="{{this.url}}" style="--i:{{@index}}; --foto:url('{{this.foto}}'); --barra:{{this.barra}}">
    <span class="puerta__icono" aria-hidden="true">{{> icono-seccion slug=this.slug}}</span>
    <span class="puerta__cuerpo">
      {{!-- Sólo el nombre, en una línea, con su barra de color y el lema. --}}
      <span class="puerta__nombre">{{#if this.corto}}{{this.corto}}{{else}}{{this.nombre}}{{/if}}</span>
      <span class="puerta__barra" aria-hidden="true"></span>
      <span class="puerta__linea">{{this.lema}}</span>
    </span>
  </a>
  {{/each}}
</nav>

{{!-- Redes: en escritorio es una línea bajo las puertas, dentro de la
      primera pantalla; en celular, la cuadrícula de chips. --}}
<section class="redes-v2">
  <div class="section-header"><h2>{{#if isEs}}Síguenos{{else}}Follow us{{/if}}</h2><p>@soccerid7</p></div>
  <div class="redes-v2__grid">
    {{#each redes}}<a class="redes-v2__chip" href="{{this.url}}" target="_blank" rel="noopener" aria-label="{{this.nombre}}" title="{{this.nombre}}">{{> icono-red id=this.id}}<span>{{this.nombre}}</span><small>{{this.usuario}}</small></a>{{/each}}
  </div>
</section>

<footer class="footer">
  <div class="footer-content">
    <img src="{{img '/assets/images/logo-iso-blanco.png'}}" alt="SOCCER iD" width="44" height="44">
    <p>© {{year}} SOCCER iD · <a href="/{{lang}}/privacy">{{#if isEs}}Privacidad{{else}}Privacy{{/if}}</a> · <a href="/{{lang}}/terms">{{#if isEs}}Términos{{else}}Terms{{/if}}</a></p>
  </div>
</footer>
