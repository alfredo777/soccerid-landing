{{!-- Home, cuarta vuelta: desde cero y SIN COLOR. Blanco y negro. Las fotos
      del sitio van en escala de grises y la tipografía manda. Las seis
      secciones son seis fotos con su nombre encima. --}}
<section class="portada">
  <picture class="portada__foto" aria-hidden="true">
    <source srcset="/assets/images/opi2-web.webp" type="image/webp">
    <img src="/assets/images/opi2-web.jpg" alt="">
  </picture>
  <div class="portada__texto">
    <p class="portada__lema">{{#if isEs}}Amamos tanto el deporte que nos atrevimos a reinventarlo{{else}}We love sport so much we dared to reinvent it{{/if}}</p>
    <h1 class="portada__marca">SOCCER <span>iD</span></h1>
  </div>
  <a class="portada__baja" href="#secciones" aria-label="{{#if isEs}}Bajar{{else}}Scroll{{/if}}">↓</a>
</section>

<section class="secciones" id="secciones" aria-label="{{#if isEs}}Secciones{{else}}Sections{{/if}}">
  {{#each secciones}}
  <a class="celda" href="{{this.url}}" style="--i:{{@index}}">
    <img class="celda__foto" src="{{this.foto}}" alt="">
    <span class="celda__velo" aria-hidden="true"></span>
    <span class="celda__num">{{this.num}}</span>
    <span class="celda__texto">
      <span class="celda__sub">{{#if this.submarca}}{{this.submarca}}{{else}}SOCCER iD{{/if}}</span>
      <span class="celda__nombre">{{this.nombre}}</span>
      <span class="celda__linea">{{this.linea}}</span>
    </span>
    <span class="celda__ir" aria-hidden="true">→</span>
  </a>
  {{/each}}
</section>

{{!-- Lo vivo, en una lista de texto. Datos reales; lo que no hay, no sale. --}}
<section class="ahora">
  <h2 class="ahora__t">{{#if isEs}}Ahora{{else}}Now{{/if}}</h2>
  <ol class="ahora__lista">
    {{#if ahora.tour}}
    <li><a href="{{ahora.tour.url}}"><span class="ahora__k">Tour</span><span class="ahora__v">{{ahora.tour.nombre}} · {{#if isEs}}tres partidos en Estados Unidos{{else}}three matches in the US{{/if}}</span><span class="ahora__ir">→</span></a></li>
    {{/if}}
    {{#if ahora.partido}}
    <li><a href="/{{lang}}/travel"><span class="ahora__k">Travel</span><span class="ahora__v">{{ahora.partido.team1}} vs {{ahora.partido.team2}} · {{ahora.partido.dia}} {{ahora.partido.mes}} · {{ahora.partido.venue}}</span><span class="ahora__ir">→</span></a></li>
    {{/if}}
    {{#if ahora.podcast}}
    <li><a href="/{{lang}}/podcast"><span class="ahora__k">Podcast</span><span class="ahora__v">{{ahora.podcast.total}} {{#if isEs}}episodios en YouTube{{else}}episodes on YouTube{{/if}}</span><span class="ahora__ir">→</span></a></li>
    {{/if}}
  </ol>
</section>

<section class="redes">
  <h2 class="redes__t">{{#if isEs}}Síguenos{{else}}Follow us{{/if}}</h2>
  <ul class="redes__lista">
    {{#each redes}}<li><a href="{{this.url}}" target="_blank" rel="noopener"><span>{{this.nombre}}</span><small>{{this.usuario}}</small></a></li>{{/each}}
  </ul>
</section>
