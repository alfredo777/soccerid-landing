{{!-- Podcast · reproductor con la lista al lado, como una playlist.

      Cada fila es un enlace de verdad al video en YouTube. El script lo
      intercepta para cambiar el reproductor sin salir de la página; si el
      script no corre, el enlace sigue llevando a YouTube. Nunca una fila
      muerta.

      Título, duración y fecha los publica el canal y los guarda
      `node scripts/podcast-titulos.js`. Aquí no se inventa ninguno. --}}

<section class="portada portada--podcast">
  {{!-- Sin foto: la portada llevaba la miniatura del último episodio y el
        reproductor, cuatro dedos más abajo, repetía el mismo fotograma con
        el mismo letrero. Aquí la portada sólo presenta el programa y el
        protagonismo se lo lleva el reproductor, que es a lo que se viene. --}}
  <img class="portada__foto" src="/assets/images/secciones/podcast/portada.jpg" alt="Estudio del SOCCER iD Podcast">
  <div class="portada__velo"></div>
  <div class="portada__cuerpo">
    <div class="cabecera__marca">SOCCER iD Podcast</div>
    <h1 class="portada__titulo">Podcast</h1>
    <p class="portada__bajada">{{#if isEs}}<strong>Charlas, entrevistas y análisis</strong> para entender y disfrutar el fútbol, con las voces de quienes lo viven <strong>dentro y fuera de la cancha</strong>.{{else}}Football conversations, no rush. Long talks with the people who live the game from the inside: players, executives, reporters and everyone who makes a match happen.{{/if}}</p>
    <div class="portada__pastillas">
      <span class="pastilla">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10-6.5z"/></svg>
        {{episodios.length}} {{#if isEs}}episodios{{else}}episodes{{/if}}
      </span>
    </div>
    {{!-- En el teléfono van en una fila: «YouTube», «Spotify» y el
          Instagram en círculo. La frase completa y el usuario se esconden
          con CSS (`.escucha`); el aria-label conserva el nombre entero. --}}
    <div class="portada__acciones escucha">
      {{#each plataformas}}
      <a class="boton boton--icono {{#if @first}}boton--lleno{{/if}}" href="{{this.url}}" target="_blank" rel="noopener">{{> icono-red id=this.id}}<span class="escucha__largo">{{#if ../isEs}}{{this.verboEs}}{{else}}Listen on{{/if}} </span>{{this.nombre}} <span class="flecha escucha__largo">↗</span></a>
      {{/each}}
      {{#if instagram}}<a class="boton boton--icono escucha__red" href="{{instagram}}" target="_blank" rel="noopener" aria-label="Instagram @soccerid_podcast">{{> icono-red id="instagram"}}<span class="escucha__largo">@soccerid_podcast</span></a>{{/if}}
    </div>
  </div>
</section>

{{#if ultimo}}
<section class="seccion envoltura">
  <div class="reproductor">

    <div class="reproductor__video">
      <div class="video">
        <iframe id="reproductorCaja"
                src="https://www.youtube-nocookie.com/embed/{{ultimo.videoId}}?rel=0"
                title="{{#if ultimo.titulo}}{{ultimo.titulo}}{{else}}SOCCER iD Podcast{{/if}}"
                allowfullscreen
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
      </div>
      <p class="video__pie">
        <span class="video__num" id="reproductorNum">{{#if isEs}}Episodio{{else}}Episode{{/if}} {{ultimo.num}}</span>
        <span id="reproductorTitulo">{{ultimo.titulo}}</span>
      </p>
    </div>

    <aside class="lista">
      <div class="lista__cab">
        <span>{{#if isEs}}Todos los episodios{{else}}All episodes{{/if}}</span>
        <span class="lista__cuenta">{{episodios.length}}</span>
      </div>
      <ol class="lista__pista" id="listaEpisodios">
        {{#each episodios}}
        <li>
          <a class="fila-ep{{#if @first}} is-activa{{/if}}" href="{{this.url}}" target="_blank" rel="noopener"
             data-video="{{this.videoId}}" data-num="{{this.num}}" data-titulo="{{this.titulo}}">
            <span class="fila-ep__mini">
              <img src="https://i.ytimg.com/vi/{{this.videoId}}/mqdefault.jpg" alt="" loading="lazy" width="120" height="68">
              {{#if this.reloj}}<span class="fila-ep__reloj">{{this.reloj}}</span>{{/if}}
            </span>
            <span class="fila-ep__texto">
              <span class="fila-ep__meta">{{#if ../isEs}}Episodio{{else}}Episode{{/if}} {{this.num}}{{#if this.fechaTexto}} · {{this.fechaTexto}}{{/if}}</span>
              <span class="fila-ep__titulo">{{#if this.titulo}}{{this.titulo}}{{else}}{{#if ../isEs}}Sin título{{else}}Untitled{{/if}}{{/if}}</span>
              <span class="fila-ep__canal">SOCCER iD</span>
            </span>
          </a>
        </li>
        {{/each}}
      </ol>
    </aside>

  </div>
</section>

<script>
  // Al tocar una fila de la lista o el «Ver episodio» de un invitado, el
  // reproductor cambia de episodio sin salir de la página. Si esto no
  // corre, cada uno sigue siendo su enlace a YouTube.
  (function () {
    var caja = document.getElementById('reproductorCaja');
    var lista = document.getElementById('listaEpisodios');
    var rotuloNum = document.getElementById('reproductorNum');
    var rotuloTit = document.getElementById('reproductorTitulo');
    if (!caja || !lista) return;

    var palabra = rotuloNum ? rotuloNum.textContent.replace(/\s*\d+\s*$/, '').trim() : 'Episodio';

    document.addEventListener('click', function (e) {
      var fuente = e.target.closest('[data-video]');
      if (!fuente || !fuente.dataset.video) return;
      // Con una tecla de por medio (abrir en otra pestaña), que mande el enlace.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();

      caja.src = 'https://www.youtube-nocookie.com/embed/' + fuente.dataset.video + '?rel=0&autoplay=1';
      caja.title = fuente.dataset.titulo || 'SOCCER iD Podcast';
      if (rotuloNum) rotuloNum.textContent = palabra + ' ' + fuente.dataset.num;
      if (rotuloTit) rotuloTit.textContent = fuente.dataset.titulo || '';

      // La fila de ese episodio queda marcada, venga de donde venga el toque.
      lista.querySelectorAll('.fila-ep').forEach(function (f) {
        f.classList.toggle('is-activa', f.dataset.video === fuente.dataset.video);
      });

      // En una columna el video queda arriba de la lista y el episodio
      // arrancaba fuera de la vista. Si no se ve entero, se sube hasta él;
      // el margen deja libre la píldora del menú.
      var r = caja.getBoundingClientRect();
      if (r.top < 80 || r.bottom > window.innerHeight) {
        var suave = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: window.scrollY + r.top - 88, behavior: suave ? 'smooth' : 'auto' });
      }
    });
  })();
</script>
{{/if}}

{{!-- Invitados destacados (sólo español). Cada tarjeta carga su entrevista
      en el reproductor de arriba; sin episodio relacionado, va sin botón.
      Carrusel como el de opiniones: se arrastra con el dedo. --}}
{{#if invitados.length}}
<section class="seccion envoltura">
  <p class="rotulo">Invitados destacados</p>
  <div class="carrusel">
    <div class="invitados" data-pista tabindex="0" role="region" aria-label="Invitados destacados, se arrastra para ver más">
      {{#each invitados}}
      <article class="invitado">
        <div class="invitado__foto"{{#if this.foto}} style="background-image:url('{{this.foto}}')"{{/if}}>{{#unless this.foto}}<span class="invitado__inicial" aria-hidden="true">{{this.inicial}}</span>{{/unless}}</div>
        <div class="invitado__cuerpo">
          <h3 class="invitado__nombre">{{this.nombre}}</h3>
          <p class="invitado__desc">{{this.descripcion}}</p>
          {{#if this.ep}}
          <a class="boton invitado__ver" href="{{this.ep.url}}" target="_blank" rel="noopener"
             data-video="{{this.ep.videoId}}" data-num="{{this.ep.num}}" data-titulo="{{this.ep.titulo}}">Ver episodio <span class="flecha">↑</span></a>
          {{/if}}
        </div>
      </article>
      {{/each}}
    </div>
    <div class="carrusel__mandos">
      <button type="button" class="carrusel__flecha" data-ir="-1" aria-label="Anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="carrusel__flecha" data-ir="1" aria-label="Siguiente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>
{{> carrusel-js}}
{{/if}}

{{!-- Patrocinadores actuales: de contents/podcast.json. Sin logo se pinta
      el nombre; los de muestra lo dicen con la pastilla punteada. --}}
{{#if patrocinadores.length}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if isEs}}Patrocinadores{{else}}Sponsors{{/if}}</p>
  <div class="aliados">
    {{#each patrocinadores}}
    <{{#if this.url}}a href="{{this.url}}" target="_blank" rel="noopener"{{else}}div{{/if}} class="aliado aliado--texto aliado--patrocinador">
      {{#if this.logo}}<img src="{{this.logo}}" alt="{{this.nombre}}">{{else}}<span class="aliado__nombre">{{this.nombre}}</span>{{/if}}
      {{#if this.muestra}}<span class="pastilla pastilla--muestra">{{#if ../isEs}}Muestra{{else}}Sample{{/if}}</span>{{/if}}
    </{{#if this.url}}a{{else}}div{{/if}}>
    {{/each}}
  </div>
</section>
{{/if}}

{{!-- Sé patrocinador: las cifras del canal y lo que una marca puede tener. --}}
<section class="seccion envoltura" id="patrocina">
  <p class="rotulo">{{#if isEs}}Sé patrocinador{{else}}Become a sponsor{{/if}}</p>
  <p class="bajada" style="max-width:760px;margin-bottom:26px">{{#if isEs}}<strong>Conecta tu marca con la afición</strong> a través de nuestras conversaciones, invitados y contenido de fútbol.{{else}}Your brand inside the football conversation fans actually listen to in full: long episodes, every week, with guests from the game.{{/if}}</p>
  <div class="cifras">
    {{#each cifras}}
    <div class="cifra">
      <div class="cifra__valor">{{this.valor}}</div>
      <div class="cifra__etiqueta">{{this.etiqueta}}</div>
    </div>
    {{/each}}
  </div>
  <div class="pilares" style="margin-top:14px">
    <div class="pilar">
      <div class="pilar__num">01</div>
      <h3>{{#if isEs}}Menciones de marca{{else}}In-episode mention{{/if}}</h3>
      <p>{{#if isEs}}Los conductores presentan tu marca <strong>de forma natural durante el episodio</strong>.{{else}}The hosts present your brand in their own words, at the start or mid-show.{{/if}}</p>
    </div>
    <div class="pilar">
      <div class="pilar__num">02</div>
      <h3>{{#if isEs}}Sección patrocinada{{else}}Sponsored segment{{/if}}</h3>
      <p>{{#if isEs}}<strong>Tu marca da nombre</strong> a un espacio de análisis, debate o entretenimiento.{{else}}A recurring segment named after your brand: the prediction, the ideal XI, the week's big debate.{{/if}}</p>
    </div>
    <div class="pilar">
      <div class="pilar__num">03</div>
      <h3>{{#if isEs}}Presencia en pantalla{{else}}On-screen presence{{/if}}</h3>
      <p>{{#if isEs}}Integramos tu <strong>logo o producto</strong> en el set y en el contenido del programa.{{else}}Your logo on set and on screen, and your product in the hosts' hands.{{/if}}</p>
    </div>
  </div>
  <div class="portada__acciones" style="margin-top:22px">
    <a class="boton boton--lleno" href="https://wa.me/{{@root.contacto.whatsapp}}?text={{#if isEs}}Hola!%20Quiero%20patrocinar%20el%20podcast%20de%20SOCCER%20iD{{else}}Hi!%20I%27d%20like%20to%20sponsor%20the%20SOCCER%20iD%20podcast{{/if}}" target="_blank" rel="noopener">{{#if isEs}}Quiero patrocinar{{else}}I want to sponsor{{/if}} <span class="flecha">↗</span></a>
    <a class="boton" href="mailto:{{@root.contacto.correo}}?subject={{#if isEs}}Patrocinio%20del%20podcast{{else}}Podcast%20sponsorship{{/if}}">{{@root.contacto.correo}} <span class="flecha">↗</span></a>
  </div>
</section>

<section class="cierre">
  <img class="cierre__foto" src="/assets/images/secciones/podcast/cierre.jpg" alt="">
  <div class="cierre__velo"></div>
  <div class="cierre__cuerpo">
    <h2 class="cierre__t">{{#if isEs}}Míralo o escúchalo donde quieras{{else}}Listen where you already listen{{/if}}</h2>
    <p class="cierre__d">{{#if isEs}}Disfruta los episodios en <strong>YouTube y Spotify</strong>, y los mejores momentos en <strong>Instagram</strong>.{{else}}Subscribe and every new episode reaches you.{{/if}}</p>
    <div class="portada__acciones escucha" style="justify-content:center">
      {{#each plataformas}}
      <a class="boton boton--icono {{#if @first}}boton--lleno{{/if}}" href="{{this.url}}" target="_blank" rel="noopener">{{> icono-red id=this.id}}{{this.nombre}} <span class="flecha escucha__largo">↗</span></a>
      {{/each}}
      {{#if instagram}}<a class="boton boton--icono escucha__red" href="{{instagram}}" target="_blank" rel="noopener" aria-label="Instagram">{{> icono-red id="instagram"}}<span class="escucha__largo">Instagram</span></a>{{/if}}
    </div>
  </div>
</section>
