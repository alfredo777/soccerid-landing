{{!-- Podcast · reproductor con la lista al lado, como una playlist.

      Cada fila es un enlace de verdad al video en YouTube. El script lo
      intercepta para cambiar el reproductor sin salir de la página; si el
      script no corre, el enlace sigue llevando a YouTube. Nunca una fila
      muerta.

      Título, duración y fecha los publica el canal y los guarda
      `node scripts/podcast-titulos.js`. Aquí no se inventa ninguno. --}}

<section class="portada portada--podcast">
  {{!-- Sin foto: la portada llevaba la miniatura del último episodio y el
        reproductor, cuatro dedos más abajo, repetía el mismo fotograma con
        el mismo letrero. Aquí la portada sólo presenta el programa y el
        protagonismo se lo lleva el reproductor, que es a lo que se viene. --}}
  <div class="portada__velo"></div>
  <div class="portada__cuerpo">
    <p class="cabecera__miga"><a href="/{{lang}}">SOCCER iD</a> / Podcast</p>
    <div class="cabecera__marca">SOCCER iD Podcast</div>
    <h1 class="portada__titulo">Podcast</h1>
    <p class="portada__bajada">{{#if isEs}}Conversaciones de fútbol, sin prisa. Charlas largas con quienes viven el juego por dentro: jugadores, directivos, periodistas y la gente que hace que un partido exista.{{else}}Football conversations, no rush. Long talks with the people who live the game from the inside: players, executives, reporters and everyone who makes a match happen.{{/if}}</p>
    <div class="portada__pastillas">
      <span class="pastilla">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10-6.5z"/></svg>
        {{episodios.length}} {{#if isEs}}episodios{{else}}episodes{{/if}}
      </span>
    </div>
    <div class="portada__acciones">
      {{#each plataformas}}
      <a class="boton {{#if @first}}boton--lleno{{/if}}" href="{{this.url}}" target="_blank" rel="noopener">{{#if ../isEs}}Escuchar en{{else}}Listen on{{/if}} {{this.nombre}} <span class="flecha">↗</span></a>
      {{/each}}
      {{#if instagram}}<a class="boton boton--icono" href="{{instagram}}" target="_blank" rel="noopener">{{> icono-red id="instagram"}} @soccerid_podcast</a>{{/if}}
    </div>
  </div>
</section>

{{#if ultimo}}
<section class="seccion envoltura">
  <div class="reproductor">

    <div class="reproductor__video">
      <div class="video">
        <iframe id="reproductorCaja"
                src="https://www.youtube-nocookie.com/embed/{{ultimo.videoId}}?rel=0"
                title="{{#if ultimo.titulo}}{{ultimo.titulo}}{{else}}SOCCER iD Podcast{{/if}}"
                allowfullscreen
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
      </div>
      <p class="video__pie">
        <span class="video__num" id="reproductorNum">{{#if isEs}}Episodio{{else}}Episode{{/if}} {{ultimo.num}}</span>
        <span id="reproductorTitulo">{{ultimo.titulo}}</span>
      </p>
    </div>

    <aside class="lista">
      <div class="lista__cab">
        <span>{{#if isEs}}Todos los episodios{{else}}All episodes{{/if}}</span>
        <span class="lista__cuenta">{{episodios.length}}</span>
      </div>
      <ol class="lista__pista" id="listaEpisodios">
        {{#each episodios}}
        <li>
          <a class="fila-ep{{#if @first}} is-activa{{/if}}" href="{{this.url}}" target="_blank" rel="noopener"
             data-video="{{this.videoId}}" data-num="{{this.num}}" data-titulo="{{this.titulo}}">
            <span class="fila-ep__mini">
              <img src="https://i.ytimg.com/vi/{{this.videoId}}/mqdefault.jpg" alt="" loading="lazy" width="120" height="68">
              {{#if this.reloj}}<span class="fila-ep__reloj">{{this.reloj}}</span>{{/if}}
            </span>
            <span class="fila-ep__texto">
              <span class="fila-ep__meta">{{#if ../isEs}}Episodio{{else}}Episode{{/if}} {{this.num}}{{#if this.fechaTexto}} · {{this.fechaTexto}}{{/if}}</span>
              <span class="fila-ep__titulo">{{#if this.titulo}}{{this.titulo}}{{else}}{{#if ../isEs}}Sin título{{else}}Untitled{{/if}}{{/if}}</span>
              <span class="fila-ep__canal">SOCCER iD</span>
            </span>
          </a>
        </li>
        {{/each}}
      </ol>
    </aside>

  </div>
</section>

<script>
  // Al tocar una fila, el reproductor cambia de episodio sin salir de la
  // página. Si esto no corre, cada fila sigue siendo su enlace a YouTube.
  (function () {
    var caja = document.getElementById('reproductorCaja');
    var lista = document.getElementById('listaEpisodios');
    var rotuloNum = document.getElementById('reproductorNum');
    var rotuloTit = document.getElementById('reproductorTitulo');
    if (!caja || !lista) return;

    var palabra = rotuloNum ? rotuloNum.textContent.replace(/\s*\d+\s*$/, '').trim() : 'Episodio';

    lista.addEventListener('click', function (e) {
      var fila = e.target.closest('.fila-ep');
      if (!fila || !fila.dataset.video) return;
      // Con una tecla de por medio (abrir en otra pestaña), que mande el enlace.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();

      caja.src = 'https://www.youtube-nocookie.com/embed/' + fila.dataset.video + '?rel=0&autoplay=1';
      caja.title = fila.dataset.titulo || 'SOCCER iD Podcast';
      if (rotuloNum) rotuloNum.textContent = palabra + ' ' + fila.dataset.num;
      if (rotuloTit) rotuloTit.textContent = fila.dataset.titulo || '';

      lista.querySelectorAll('.fila-ep').forEach(function (f) { f.classList.remove('is-activa'); });
      fila.classList.add('is-activa');

      // En una columna el video queda arriba de la lista y el episodio
      // arrancaba fuera de la vista. Si no se ve entero, se sube hasta él;
      // el margen deja libre la píldora del menú.
      var r = caja.getBoundingClientRect();
      if (r.top < 80 || r.bottom > window.innerHeight) {
        var suave = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: window.scrollY + r.top - 88, behavior: suave ? 'smooth' : 'auto' });
      }
    });
  })();
</script>
{{/if}}

{{!-- Patrocinadores actuales: de contents/podcast.json. Sin logo se pinta
      el nombre; los de muestra lo dicen con la pastilla punteada. --}}
{{#if patrocinadores.length}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if isEs}}Patrocinadores{{else}}Sponsors{{/if}}</p>
  <div class="aliados">
    {{#each patrocinadores}}
    <{{#if this.url}}a href="{{this.url}}" target="_blank" rel="noopener"{{else}}div{{/if}} class="aliado aliado--texto">
      {{#if this.logo}}<img src="{{this.logo}}" alt="{{this.nombre}}">{{else}}<span class="aliado__nombre">{{this.nombre}}</span>{{/if}}
      {{#if this.muestra}}<span class="pastilla pastilla--muestra">{{#if ../isEs}}Muestra{{else}}Sample{{/if}}</span>{{/if}}
    </{{#if this.url}}a{{else}}div{{/if}}>
    {{/each}}
  </div>
</section>
{{/if}}

{{!-- Sé patrocinador: las cifras del canal y lo que una marca puede tener. --}}
<section class="seccion envoltura" id="patrocina">
  <p class="rotulo">{{#if isEs}}Sé patrocinador{{else}}Become a sponsor{{/if}}</p>
  <p class="bajada" style="max-width:760px;margin-bottom:26px">{{#if isEs}}Tu marca en la conversación de fútbol que la afición sí escucha completa: episodios largos, cada semana, con invitados del medio.{{else}}Your brand inside the football conversation fans actually listen to in full: long episodes, every week, with guests from the game.{{/if}}</p>
  <div class="cifras">
    {{#each cifras}}
    <div class="cifra">
      <div class="cifra__valor">{{this.valor}}</div>
      <div class="cifra__etiqueta">{{this.etiqueta}}</div>
    </div>
    {{/each}}
  </div>
  <div class="pilares" style="margin-top:14px">
    <div class="pilar">
      <div class="pilar__num">01</div>
      <h3>{{#if isEs}}Mención en el episodio{{else}}In-episode mention{{/if}}</h3>
      <p>{{#if isEs}}Los conductores presentan tu marca con sus palabras, al inicio o a mitad del programa.{{else}}The hosts present your brand in their own words, at the start or mid-show.{{/if}}</p>
    </div>
    <div class="pilar">
      <div class="pilar__num">02</div>
      <h3>{{#if isEs}}Segmento patrocinado{{else}}Sponsored segment{{/if}}</h3>
      <p>{{#if isEs}}Una sección fija con el nombre de tu marca: la predicción, el once ideal, la polémica de la semana.{{else}}A recurring segment named after your brand: the prediction, the ideal XI, the week's big debate.{{/if}}</p>
    </div>
    <div class="pilar">
      <div class="pilar__num">03</div>
      <h3>{{#if isEs}}Presencia en video{{else}}On-screen presence{{/if}}</h3>
      <p>{{#if isEs}}Tu logo en el set y en pantalla, y tu producto en manos de los conductores.{{else}}Your logo on set and on screen, and your product in the hosts' hands.{{/if}}</p>
    </div>
  </div>
  <div class="portada__acciones" style="margin-top:22px">
    <a class="boton boton--lleno" href="https://wa.me/12315158991?text={{#if isEs}}Hola!%20Quiero%20patrocinar%20el%20podcast%20de%20SOCCER%20iD{{else}}Hi!%20I%27d%20like%20to%20sponsor%20the%20SOCCER%20iD%20podcast{{/if}}" target="_blank" rel="noopener">{{#if isEs}}Quiero patrocinar{{else}}I want to sponsor{{/if}} <span class="flecha">↗</span></a>
    <a class="boton" href="mailto:contacto@soccerid.co?subject={{#if isEs}}Patrocinio%20del%20podcast{{else}}Podcast%20sponsorship{{/if}}">contacto@soccerid.co <span class="flecha">↗</span></a>
  </div>
</section>

<section class="cierre">
  <div class="cierre__velo"></div>
  <div class="cierre__cuerpo">
    <h2 class="cierre__t">{{#if isEs}}Escúchalo donde ya escuchas{{else}}Listen where you already listen{{/if}}</h2>
    <p class="cierre__d">{{#if isEs}}Suscríbete y te llega cada episodio nuevo.{{else}}Subscribe and every new episode reaches you.{{/if}}</p>
    <div class="portada__acciones" style="justify-content:center">
      {{#each plataformas}}
      <a class="boton {{#if @first}}boton--lleno{{/if}}" href="{{this.url}}" target="_blank" rel="noopener">{{this.nombre}} <span class="flecha">↗</span></a>
      {{/each}}
      {{#if instagram}}<a class="boton boton--icono" href="{{instagram}}" target="_blank" rel="noopener">{{> icono-red id="instagram"}} Instagram</a>{{/if}}
    </div>
  </div>
</section>
