{{!-- Tour · SOCCER iD TOUR.
      Todo lo de esta página se edita en el admin (Panel › Sitio web › Tour):
      `t` son los textos del idioma, `c` las fotos y logos (iguales en los dos
      idiomas). Ver lib/sitioTour.js. Las ediciones jugadas salen de la base
      (`ediciones`), las mismas filas que pintan su ficha.

      Dos listas que NUNCA se mezclan: los próximos eventos (lo que viene) y
      las ediciones (lo que ya se jugó). Los botones de colaborar van al
      contacto global con el mensaje que fija el admin (`wa`). --}}

<section class="portada">
  <img class="portada__foto" src="{{c.fotoPortada}}" alt="">
  <div class="portada__velo"></div>
  <div class="portada__cuerpo">
    <p class="cabecera__miga"><a href="/{{lang}}">SOCCER iD</a> / {{t.portada.titulo}}</p>
    <div class="cabecera__marca">{{t.portada.marca}}</div>
    <h1 class="portada__titulo">{{t.portada.titulo}}</h1>
    <p class="portada__bajada">{{t.portada.descripcion}}</p>
    {{#if t.portada.etiquetas.length}}
    <div class="portada__pastillas">
      {{#each t.portada.etiquetas}}
      <span class="pastilla">
        {{#if @first}}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>{{/if}}
        {{#eq @index 1}}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>{{/eq}}
        {{this}}
      </span>
      {{/each}}
    </div>
    {{/if}}
    {{#if t.portada.boton}}
    <div class="portada__acciones">
      <a class="boton boton--lleno" href="{{wa}}" target="_blank" rel="noopener">{{t.portada.boton}} <span class="flecha">↗</span></a>
    </div>
    {{/if}}
  </div>
</section>

{{!-- Nuestros eventos, en números. --}}
<section class="seccion envoltura">
  <p class="rotulo">{{t.eventos.titulo}}</p>
  {{#if t.eventos.texto}}<p class="bajada tour__texto">{{t.eventos.texto}}</p>{{/if}}
  {{#if t.eventos.cifras.length}}
  <div class="cifras">
    {{#each t.eventos.cifras}}
    <div class="cifra">
      <div class="cifra__valor">{{this.valor}}</div>
      <div class="cifra__etiqueta">{{this.etiqueta}}</div>
      {{#if this.sub}}<div class="cifra__sub">{{this.sub}}</div>{{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}
</section>

{{!-- Nuestro alcance: cada cifra con el ícono que dice de dónde sale. --}}
{{#if t.alcance.cifras.length}}
<section class="seccion envoltura">
  <p class="rotulo">{{t.alcance.titulo}}</p>
  <div class="cifras">
    {{#each t.alcance.cifras}}
    <div class="cifra">
      <div class="cifra__icono">{{> icono-alcance icon=this.icono}}</div>
      <div class="cifra__valor">{{this.valor}}</div>
      <div class="cifra__etiqueta">{{this.etiqueta}}</div>
    </div>
    {{/each}}
  </div>
  {{#if t.alcance.nota}}<p class="tour__nota">{{t.alcance.nota}}</p>{{/if}}
</section>
{{/if}}

{{!-- Próximos eventos: el Tour '27. Los equipos se escriben a mano en el
      admin; aquí no se lee el registro de propuestas. --}}
<section class="seccion envoltura">
  <p class="rotulo">{{t.proximos.titulo}}</p>
  <article class="tour27" style="--tour-foto:url('{{c.fotoProximos}}')">
    <div>
      <img class="tour27__logo" src="/assets/images/logos/id-tour27-blanco.png" alt="">
      <h2>{{t.proximos.nombre}}</h2>
      <p>{{t.proximos.descripcion}}</p>
      {{#if t.proximos.boton}}<a class="boton boton--claro" href="{{wa}}" target="_blank" rel="noopener">{{t.proximos.boton}} <span class="flecha">↗</span></a>{{/if}}
    </div>
    <ol class="tour27__partidos">
      {{#each t.proximos.partidos}}
      <li class="tour27__partido">
        <span class="tour27__nombre">{{this.nombre}}</span>
        {{#if this.fecha}}<span class="tour27__ventana">{{this.fecha}}</span>{{/if}}
        {{#if this.estado}}<span class="pastilla pastilla--ok">{{this.estado}}</span>{{/if}}
      </li>
      {{/each}}
    </ol>
  </article>

  {{#if t.proximos.aviso}}
  <div class="aclaracion">
    <span class="pastilla">2027</span>
    <span>{{t.proximos.aviso}}</span>
  </div>
  {{/if}}
</section>

{{!-- Ediciones anteriores: las jugadas, con foto y asistencia (de la base);
      debajo, los años que no son una edición jugada (filas del admin). --}}
<section class="seccion envoltura">
  <p class="rotulo">{{t.ediciones.titulo}}</p>
  <div class="ediciones">
    {{#each ediciones}}
    <a class="edicion" href="{{this.url}}">
      <div class="edicion__foto" {{#if this.imagen}}style="background-image:url('{{this.imagen}}')"{{/if}}></div>
      <div class="edicion__cuerpo">
        <div class="edicion__anio">{{this.year}}</div>
        <div class="edicion__partido">{{this.match}}</div>
        <div class="edicion__lugar">{{this.venue}}{{#if this.city}} · {{this.city}}{{/if}}</div>
        <div class="edicion__pie">
          <span>{{#if this.asistencia}}{{this.asistencia}} {{@root.t.ediciones.asistentes}}{{/if}}</span>
          <span>{{@root.t.ediciones.boton}} ↗</span>
        </div>
      </div>
    </a>
    {{/each}}
  </div>

  {{#if t.ediciones.filas.length}}
  <div class="hitos tour__filas">
    {{#each t.ediciones.filas}}
    <div class="hito hito--pendiente">
      <span class="hito__anio">{{this.anio}}</span>
      <div>
        <div class="hito__partido">{{this.titulo}}</div>
        {{#if this.sub}}<div class="hito__lugar">{{this.sub}}</div>{{/if}}
      </div>
      <span></span>
    </div>
    {{/each}}
  </div>
  {{/if}}
</section>

{{#if c.momentos.length}}
<section class="seccion envoltura">
  <p class="rotulo">{{t.momentos.titulo}}</p>
  <div class="mosaico">
    {{#each c.momentos}}
    <button type="button" class="mosaico__foto" style="background-image:url('{{this.src}}')" data-ampliar="{{this.src}}" aria-label="{{this.alt}}"></button>
    {{/each}}
  </div>
</section>
{{/if}}

{{#if c.logos.length}}
<section class="seccion envoltura">
  <p class="rotulo">{{t.patrocinadores.titulo}}</p>
  <div class="aliados">
    {{#each c.logos}}
    <div class="aliado"><img src="{{this.src}}" alt="{{this.alt}}"></div>
    {{/each}}
  </div>
</section>
{{/if}}

{{#if t.medios.notas.length}}
<section class="seccion envoltura">
  <p class="rotulo">{{t.medios.titulo}}</p>
  <div class="prensa">
    {{#each t.medios.notas}}
    <a class="prensa__nota" href="{{this.url}}" target="_blank" rel="noopener">
      {{#if this.imagen}}<img class="prensa__img" src="{{this.imagen}}" alt="" loading="lazy">{{/if}}
      <span class="prensa__texto">
        <span class="prensa__fuente">{{this.fuente}}</span>
        <span class="prensa__titulo">{{this.titulo}}</span>
      </span>
      <span class="flecha">↗</span>
    </a>
    {{/each}}
  </div>
</section>
{{/if}}

<section class="cierre">
  <img class="cierre__foto" src="{{c.fotoCierre}}" alt="">
  <div class="cierre__velo"></div>
  <div class="cierre__cuerpo">
    <h2 class="cierre__t">{{t.cierre.titulo}}</h2>
    {{#if t.cierre.descripcion}}<p class="cierre__d">{{t.cierre.descripcion}}</p>{{/if}}
    {{#if t.cierre.boton}}<a class="boton boton--lleno" href="{{wa}}" target="_blank" rel="noopener">{{t.cierre.boton}} <span class="flecha">↗</span></a>{{/if}}
  </div>
</section>
