{{!-- Media · la combinación de las dos cosas que se dicen de SOCCER iD:
      lo que publica la prensa (reportajes) y lo que dice quien ya vivió la
      experiencia (influencers y clientes).

      Primero los reportajes, porque son de terceros y pesan más; después
      los comentarios, que son testimonio. Las dos listas salen del mismo
      almacén de contenido que administra el panel. --}}

<section class="portada">
  <img class="portada__foto" src="/assets/images/secciones/media/portada.jpg" alt="">
  <div class="portada__velo"></div>
  <div class="portada__cuerpo">
    <div class="cabecera__marca">SOCCER iD</div>
    <h1 class="portada__titulo">Media</h1>
    <p class="portada__bajada">{{#if isEs}}Nuestra historia <strong>en los medios</strong> y las <strong>opiniones de quienes han vivido nuestras experiencias</strong>.{{else}}Our story <strong>in the media</strong> and the <strong>reviews of people who have lived our experiences</strong>.{{/if}}</p>
  </div>
</section>

{{!-- Reportajes. --}}
{{#if articulos.length}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if isEs}}En los medios{{else}}In the media{{/if}}</p>
  <div class="notas">
    {{#each articulos}}
    <a class="nota" href="/{{../lang}}/articulo/{{this.id}}">
      <div class="nota__foto" style="background-image:url('{{this.image}}')"></div>
      <div class="nota__cuerpo">
        <div class="nota__fuente">{{this.source}}</div>
        <div class="nota__titulo">{{this.title}}</div>
      </div>
    </a>
    {{/each}}
  </div>
</section>
{{/if}}

{{!-- Comentarios de influencers y clientes. --}}
{{#if opiniones.length}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if isEs}}Opiniones{{else}}Reviews{{/if}}</p>
  {{!-- Carrusel: se arrastra con el dedo. El desplazamiento y la inercia los
        pone el navegador; el script de abajo sólo añade las flechas para
        quien usa ratón. Sin JavaScript sigue arrastrándose igual. --}}
  <div class="carrusel">
    <div class="opiniones" data-pista id="carruselOpiniones" tabindex="0" role="region"
         aria-label="{{#if isEs}}Opiniones, se arrastra para ver más{{else}}Reviews, drag to see more{{/if}}">
      {{#each opiniones}}
      <article class="opinion">
        <div class="opinion__estrellas" aria-label="{{this.stars}} / 5">★★★★★</div>
        <p class="opinion__texto">{{this.text}}</p>
        <div class="opinion__quien">
          <img class="opinion__foto" src="{{this.image}}" alt="" loading="lazy">
          <div><div class="opinion__nombre">{{this.name}}</div><div class="opinion__handle">{{this.handle}}</div></div>
        </div>
      </article>
      {{/each}}
    </div>
    <div class="carrusel__mandos">
      <button type="button" class="carrusel__flecha" data-ir="-1" aria-controls="carruselOpiniones" aria-label="{{#if isEs}}Anterior{{else}}Previous{{/if}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="carrusel__flecha" data-ir="1" aria-controls="carruselOpiniones" aria-label="{{#if isEs}}Siguiente{{else}}Next{{/if}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

{{> carrusel-js}}
{{/if}}

<section class="cierre">
  <img class="cierre__foto" src="/assets/images/secciones/media/cierre.jpg" alt="">
  <div class="cierre__velo"></div>
  <div class="cierre__cuerpo">
    <h2 class="cierre__t">{{#if isEs}}¿Eres prensa o creador?{{else}}Press or content creator?{{/if}}</h2>
    <p class="cierre__d">{{#if isEs}}Solicita <strong>acreditaciones, entrevistas o material de prensa</strong>.{{else}}Request <strong>accreditation, interviews or press materials</strong>.{{/if}}</p>
    <a class="boton boton--lleno" href="mailto:{{@root.contacto.correo}}?subject={{#if isEs}}Prensa{{else}}Press{{/if}}">{{#if isEs}}Contacto de prensa{{else}}Press contact{{/if}} <span class="flecha">↗</span></a>
  </div>
</section>
