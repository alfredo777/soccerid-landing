{{!-- Quiénes somos · nuestra historia.

      El texto es el que ya administra el panel (`quienes`), no una versión
      paralela que se quede vieja. Debajo, la historia contada por años:
      son las ediciones reales de la copa, la misma fuente que alimenta
      Tour, para que ningún año se cuente de dos maneras distintas. --}}

<section class="portada">
  <img class="portada__foto" src="/assets/images/somoss.jpg" alt="">
  <div class="portada__velo"></div>
  <div class="portada__cuerpo">
    <p class="cabecera__miga"><a href="/{{lang}}">SOCCER iD</a> / {{actual.nombre}}</p>
    <div class="cabecera__marca">SOCCER iD</div>
    <h1 class="portada__titulo">{{#if isEs}}Nuestra historia{{else}}Our story{{/if}}</h1>
    <p class="portada__bajada">{{#if isEs}}Una comunidad global de aficionados, clubes y ciudades que creen que el fútbol se vive mejor de cerca.{{else}}A global community of fans, clubs and cities who believe football is better lived up close.{{/if}}</p>
  </div>
</section>

{{#if quienes}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if isEs}}Quiénes somos{{else}}Who we are{{/if}}</p>
  <div class="somos">
    <div class="somos__texto">{{{quienes.description}}}</div>
    <div class="somos__fotos">
      {{#each quienes.gallery}}
      <div class="somos__foto" style="background-image:url('{{this.src}}')" role="img" aria-label="{{this.alt}}"></div>
      {{/each}}
    </div>
  </div>
</section>
{{/if}}

{{!-- Qué hacemos. Estaba en Tour, pero habla de la empresa y no de la
      copa: su sitio es aquí. Y aquí NO van las ediciones de la SOCCER iD
      CUP ni las cuatro marcas: las ediciones son de Tour y las marcas son
      el índice. Esta página cuenta quiénes somos, nada más. --}}
<section class="seccion envoltura">
  <p class="rotulo">{{#if isEs}}Qué hacemos{{else}}What we do{{/if}}</p>
  <div class="pilares">
    <div class="pilar">
      <div class="pilar__num">01</div>
      <h3>{{#if isEs}}Gestión de eventos{{else}}Event management{{/if}}</h3>
      <p>{{#if isEs}}Damos vida a partidos internacionales mediante una planeación y ejecución especializada.{{else}}We bring international soccer matches to life through expert planning and execution.{{/if}}</p>
    </div>
    <div class="pilar">
      <div class="pilar__num">02</div>
      <h3>{{#if isEs}}Clubes{{else}}Clubs{{/if}}</h3>
      <p>{{#if isEs}}Trabajamos con los principales clubes profesionales de Latinoamérica.{{else}}We work with leading professional soccer clubs across Latin America.{{/if}}</p>
    </div>
    <div class="pilar">
      <div class="pilar__num">03</div>
      <h3>{{#if isEs}}Estrategia comercial{{else}}Commercial strategy{{/if}}</h3>
      <p>{{#if isEs}}Desarrollamos estrategias de boletaje, patrocinios y experiencias premium.{{else}}We develop ticketing, sponsorship and premium hospitality strategies.{{/if}}</p>
    </div>
    <div class="pilar">
      <div class="pilar__num">04</div>
      <h3>{{#if isEs}}Medios{{else}}Media{{/if}}</h3>
      <p>{{#if isEs}}Gestionamos la producción de transmisiones y el contenido digital para maximizar el alcance de cada evento.{{else}}We manage broadcast production and digital content to maximize audience reach.{{/if}}</p>
    </div>
  </div>
</section>

<section class="cierre">
  <img class="cierre__foto" src="/assets/images/gallery/socceridcup/7.jpeg" alt="">
  <div class="cierre__velo"></div>
  <div class="cierre__cuerpo">
    <h2 class="cierre__t">{{#if isEs}}Trabajemos juntos{{else}}Let's work together{{/if}}</h2>
    <p class="cierre__d">{{#if isEs}}Clubes, marcas, ciudades y medios: aquí empieza la conversación.{{else}}Clubs, brands, cities and media: the conversation starts here.{{/if}}</p>
    <a class="boton boton--lleno" href="mailto:contacto@soccerid.co">contacto@soccerid.co <span class="flecha">↗</span></a>
  </div>
</section>
