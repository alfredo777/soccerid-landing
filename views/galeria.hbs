<div class="promo-page gallery-page">

  <!-- Hero full viewport -->
  <div class="gp-hero">
    <img class="gp-hero__img" src="{{galeria.banner}}" alt="{{galeria.title}}">
    <div class="gp-hero__overlay"></div>

    <a href="/{{lang}}" class="promo-back">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <span>SOCCER iD</span>
    </a>

    <!-- Share floating -->
    <div class="gp-hero__share">
      <a href="https://wa.me/?text={{ogTitle}}%20{{baseUrl}}/{{lang}}/galeria/{{galeria.id}}" target="_blank" title="WhatsApp">
        <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      </a>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{baseUrl}}/{{lang}}/galeria/{{galeria.id}}" target="_blank" title="Facebook">
        <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href="https://twitter.com/intent/tweet?text={{ogTitle}}&url={{baseUrl}}/{{lang}}/galeria/{{galeria.id}}" target="_blank" title="X / Twitter">
        <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </div>

    <div class="gp-hero__content">
      <span class="gp-hero__badge">{{galeria.badge}}</span>
      <h1 class="gp-hero__title">{{galeria.title}}</h1>
      <div class="gp-hero__meta">
        <span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/></svg>
          {{galeria.date}}
        </span>
        <span class="gp-hero__sep"></span>
        <span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          {{galeria.venue}}
        </span>
      </div>
      <button class="gp-hero__scroll" onclick="document.getElementById('gallerySection').scrollIntoView({behavior:'smooth'})" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
        {{#if isEs}}Ver galería{{else}}View gallery{{/if}}
      </button>
    </div>
  </div>

  <!-- Gallery -->
  <div class="gp-gallery" id="gallerySection">
    <div class="gp-gallery__header">
      <h2 class="gp-gallery__title">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
        {{#if isEs}}Galería{{else}}Gallery{{/if}}
      </h2>
      <span class="gp-gallery__count">{{galeria.imageCount}} {{#if isEs}}fotos{{else}}photos{{/if}}</span>
    </div>
    <p class="gp-gallery__desc">{{galeria.description}}</p>

    <div class="gp-mosaic">
      {{#each galeria.images}}
      <div class="gp-mosaic__item" onclick="openGalleryLightbox({{@index}})">
        <img src="{{this.src}}" alt="{{this.alt}}" loading="lazy" draggable="false">
        <div class="gp-mosaic__hover">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
        </div>
      </div>
      {{/each}}
    </div>
  </div>

  <!-- Footer CTA -->
  <div class="gp-footer">
    <a class="gp-footer__cta" href="https://wa.me/12315158991?text={{#if isEs}}Hola!%20Quiero%20información%20sobre%20SOCCER%20iD%20CUP%202027{{else}}Hi!%20I%20want%20info%20about%20SOCCER%20iD%20CUP%202027{{/if}}">
      <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      {{#if isEs}}Quiero información{{else}}I want info{{/if}}
    </a>
    <div class="gp-footer__brand">
      <img src="/assets/images/iconsoccerid.png" alt="SOCCER iD">
      <span>SOCCER iD &copy; {{year}}</span>
    </div>
  </div>
</div>

<!-- Lightbox -->
<div class="gl-lightbox" id="glLightbox">
  <div class="gl-lightbox__backdrop" onclick="closeGalleryLightbox()"></div>
  <button class="gl-lightbox__close" onclick="closeGalleryLightbox()" type="button">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <button class="gl-lightbox__nav gl-lightbox__nav--prev" onclick="navigateGallery(-1)" type="button">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <div class="gl-lightbox__img-wrap">
    <img id="glImage" src="" alt="" draggable="false">
  </div>
  <button class="gl-lightbox__nav gl-lightbox__nav--next" onclick="navigateGallery(1)" type="button">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
  </button>
  <div class="gl-lightbox__counter" id="glCounter"></div>
</div>

<style>
  /* Override promo layout constraints for full-window */
  .gallery-page.promo-page {
    max-width: 100%;
  }
  .gallery-page .promo-back {
    z-index: 20;
  }

  /* ── Hero ── */
  .gp-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 500px;
    overflow: hidden;
  }

  .gp-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .gp-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg,
        rgba(10,10,26,0.3) 0%,
        rgba(10,10,26,0.05) 30%,
        rgba(10,10,26,0.4) 65%,
        rgba(10,10,26,0.95) 100%
      );
  }

  .gp-hero__share {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 20;
    display: flex;
    gap: 8px;
  }
  .gp-hero__share a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(0,0,0,0.45);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.15);
    transition: background 0.2s, transform 0.2s;
  }
  .gp-hero__share a:active { transform: scale(0.92); }
  .gp-hero__share a:hover { background: rgba(108,60,224,0.6); }
  .gp-hero__share a svg { width: 18px; height: 18px; fill: #fff; }

  .gp-hero__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 24px 40px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .gp-hero__badge {
    display: inline-block;
    background: linear-gradient(135deg, #6c3ce0, #9b59f0);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 20px;
    border-radius: 20px;
    margin-bottom: 16px;
  }

  .gp-hero__title {
    font-size: 42px;
    font-weight: 900;
    letter-spacing: 2px;
    line-height: 1.1;
    margin-bottom: 12px;
    text-shadow: 0 4px 30px rgba(0,0,0,0.5);
  }

  .gp-hero__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    margin-bottom: 24px;
  }
  .gp-hero__meta span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .gp-hero__meta svg { opacity: 0.7; }
  .gp-hero__sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
  }

  .gp-hero__scroll {
    display: flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 1px solid rgba(255,255,255,0.25);
    color: rgba(255,255,255,0.8);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 10px 20px;
    border-radius: 24px;
    cursor: pointer;
    transition: all 0.2s;
    animation: gp-pulse 2s ease-in-out infinite;
  }
  .gp-hero__scroll:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.4);
    color: #fff;
  }
  @keyframes gp-pulse {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  /* ── Gallery section ── */
  .gp-gallery {
    padding: 40px 20px 24px;
    background: linear-gradient(180deg, #0a0a1a 0%, #0d0d24 100%);
  }

  .gp-gallery__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .gp-gallery__title {
    font-size: 20px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
  }
  .gp-gallery__title svg { color: #9b59f0; }

  .gp-gallery__count {
    font-size: 13px;
    font-weight: 600;
    color: rgba(255,255,255,0.4);
    background: rgba(255,255,255,0.06);
    padding: 4px 12px;
    border-radius: 12px;
  }

  .gp-gallery__desc {
    font-size: 14px;
    color: rgba(255,255,255,0.55);
    line-height: 1.6;
    max-width: 900px;
    margin: 0 auto 24px;
  }

  /* ── Mosaic ── */
  .gp-mosaic {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 200px;
    gap: 4px;
    max-width: 900px;
    margin: 0 auto;
  }

  .gp-mosaic__item:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gp-mosaic__item:nth-child(6) {
    grid-column: span 2;
  }

  .gp-mosaic__item {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    cursor: pointer;
    background: rgba(255,255,255,0.03);
  }

  .gp-mosaic__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .gp-mosaic__hover {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(108,60,224,0) 0%, rgba(108,60,224,0) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
  }
  .gp-mosaic__hover svg {
    color: #fff;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.3s;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.4));
  }

  .gp-mosaic__item:hover img { transform: scale(1.08); }
  .gp-mosaic__item:hover .gp-mosaic__hover {
    background: linear-gradient(135deg, rgba(108,60,224,0.35) 0%, rgba(155,89,240,0.2) 100%);
  }
  .gp-mosaic__item:hover .gp-mosaic__hover svg {
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 600px) {
    .gp-mosaic {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
      gap: 3px;
    }
    .gp-mosaic__item:nth-child(1) {
      grid-column: span 2;
      grid-row: span 1;
    }
    .gp-mosaic__item:nth-child(6) {
      grid-column: span 1;
    }
    .gp-mosaic__hover svg { opacity: 0.6; transform: scale(1); }
    .gp-hero__title { font-size: 30px; }
    .gp-hero__meta { font-size: 13px; gap: 8px; }
    .gp-gallery { padding: 28px 12px 20px; }
  }

  /* ── Footer ── */
  .gp-footer {
    padding: 20px 24px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    background: #0a0a1a;
  }

  .gp-footer__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: 400px;
    padding: 16px 24px;
    background: linear-gradient(135deg, #6c3ce0, #9b59f0);
    color: #fff;
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    border-radius: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 24px rgba(108,60,224,0.4);
  }
  .gp-footer__cta:active { transform: scale(0.97); }
  .gp-footer__cta:hover { box-shadow: 0 6px 32px rgba(108,60,224,0.6); }
  .gp-footer__cta svg { width: 22px; height: 22px; fill: currentColor; }

  .gp-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0.5;
  }
  .gp-footer__brand img { height: 28px; }
  .gp-footer__brand span { font-size: 11px; color: rgba(255,255,255,0.4); }

  /* ── Lightbox ── */
  .gl-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 10000;
    align-items: center;
    justify-content: center;
  }
  .gl-lightbox.active { display: flex; }

  .gl-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.95);
    -webkit-backdrop-filter: blur(30px);
    backdrop-filter: blur(30px);
  }

  .gl-lightbox__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    background: rgba(255,255,255,0.1);
    border: none;
    color: #fff;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .gl-lightbox__close:hover { background: rgba(255,255,255,0.2); }

  .gl-lightbox__img-wrap {
    position: relative;
    z-index: 1;
    max-width: 92vw;
    max-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gl-lightbox__img-wrap img {
    max-width: 92vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 6px;
    user-select: none;
    box-shadow: 0 8px 60px rgba(0,0,0,0.6);
  }

  .gl-lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);
    color: #fff;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .gl-lightbox__nav:hover { background: rgba(108,60,224,0.5); border-color: rgba(108,60,224,0.6); }
  .gl-lightbox__nav--prev { left: 16px; }
  .gl-lightbox__nav--next { right: 16px; }

  .gl-lightbox__counter {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    background: rgba(0,0,0,0.6);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    padding: 8px 20px;
    border-radius: 24px;
    letter-spacing: 2px;
    border: 1px solid rgba(255,255,255,0.08);
  }

  @media (max-width: 600px) {
    .gl-lightbox__nav { width: 42px; height: 42px; }
    .gl-lightbox__nav--prev { left: 8px; }
    .gl-lightbox__nav--next { right: 8px; }
    .gl-lightbox__img-wrap { max-width: 96vw; max-height: 80vh; }
    .gl-lightbox__img-wrap img { max-width: 96vw; max-height: 80vh; border-radius: 4px; }
  }
</style>

<script>
(function() {
  var images = [{{#each galeria.images}}{ src: "{{this.src}}", alt: "{{this.alt}}" }{{#unless @last}},{{/unless}}{{/each}}];
  var currentIdx = 0;
  var lightbox = document.getElementById('glLightbox');
  var imgEl = document.getElementById('glImage');
  var counterEl = document.getElementById('glCounter');
  var startX = 0;

  window.openGalleryLightbox = function(idx) {
    currentIdx = idx;
    showImage();
    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
  };

  window.closeGalleryLightbox = function() {
    lightbox.classList.remove('active');
    document.body.style.overflow = '';
  };

  window.navigateGallery = function(dir) {
    currentIdx = (currentIdx + dir + images.length) % images.length;
    showImage();
  };

  function showImage() {
    imgEl.src = images[currentIdx].src;
    imgEl.alt = images[currentIdx].alt;
    counterEl.textContent = (currentIdx + 1) + ' / ' + images.length;
  }

  document.addEventListener('keydown', function(e) {
    if (!lightbox.classList.contains('active')) return;
    if (e.key === 'Escape') closeGalleryLightbox();
    if (e.key === 'ArrowLeft') navigateGallery(-1);
    if (e.key === 'ArrowRight') navigateGallery(1);
  });

  lightbox.addEventListener('touchstart', function(e) {
    startX = e.touches[0].clientX;
  }, { passive: true });

  lightbox.addEventListener('touchend', function(e) {
    var diff = e.changedTouches[0].clientX - startX;
    if (Math.abs(diff) > 50) {
      navigateGallery(diff > 0 ? -1 : 1);
    }
  }, { passive: true });
})();
</script>
