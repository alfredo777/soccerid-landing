        @{{instagram_gallery.handle}}
      </span>
      <a class="ig-gal__profile" href="{{instagram_gallery.profileUrl}}" target="_blank" rel="noopener">{{instagram_gallery.profileCta}}</a>
      <button type="button" class="ig-gal__close" data-ig-close aria-label="{{instagram_gallery.closeLabel}}">&times;</button>
