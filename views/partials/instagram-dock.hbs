{{#if instagram_gallery.posts}}
<style>
  /* ==========================================================================
     DOCK FLOTANTE (Instagram apilado sobre WhatsApp) + SLIDE DE REELS
     ========================================================================== */
  .sid-dock { position:fixed; right:20px; bottom:22px; z-index:9990; display:flex; flex-direction:column; gap:12px; }
  .sid-dock__btn {
    width:56px; height:56px; border-radius:50%; border:0; padding:0; cursor:pointer;
    display:flex; align-items:center; justify-content:center; color:#fff;
    box-shadow:0 10px 28px rgba(0,0,0,0.45); transition:transform .2s ease, box-shadow .2s ease;
  }
  .sid-dock__btn svg { width:28px; height:28px; }
  .sid-dock__btn:hover { transform:translateY(-3px) scale(1.05); }
  .sid-dock__btn--ig {
    background:linear-gradient(45deg,#F58529 0%,#FEDA77 22%,#DD2A7B 52%,#8134AF 76%,#515BD4 100%);
  }
  .sid-dock__btn--ig:hover { box-shadow:0 14px 34px rgba(221,42,123,0.55); }
  .sid-dock__btn--wa { background:linear-gradient(135deg,var(--color-whatsapp,#25D366),var(--color-whatsapp-dark,#128C7E)); }
  .sid-dock__btn--wa:hover { box-shadow:0 14px 34px rgba(37,211,102,0.45); }

  /* Overlay: velo translúcido, no lightbox negra */
  .ig-gal { position:fixed; inset:0; z-index:10060; display:none; }
  .ig-gal.is-open { display:block; }
  .ig-gal__scrim {
    position:absolute; inset:0; background:rgba(8,5,20,0.72);
    backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
  }
  .ig-gal__panel {
    position:relative; z-index:1; margin:auto; height:100%;
    max-width:900px; padding:18px 20px; display:flex; flex-direction:column; gap:12px;
    animation:igGalIn .28s cubic-bezier(.2,.8,.3,1);
  }
  @keyframes igGalIn { from { opacity:0; transform:translateY(18px) scale(.98); } to { opacity:1; transform:none; } }

  .ig-gal__head { display:flex; align-items:center; gap:12px; flex-shrink:0; }
  .ig-gal__brand { display:flex; align-items:center; gap:9px; color:#fff; font-weight:800; font-size:15px; }
  .ig-gal__mark {
    width:30px; height:30px; border-radius:9px; flex-shrink:0;
    background:linear-gradient(45deg,#F58529 0%,#FEDA77 22%,#DD2A7B 52%,#8134AF 76%,#515BD4 100%);
    display:flex; align-items:center; justify-content:center;
  }
  .ig-gal__mark svg { width:18px; height:18px; color:#fff; }
  .ig-gal__profile {
    margin-left:auto; color:rgba(255,255,255,0.75); font-size:12px; font-weight:800;
    letter-spacing:.6px; text-transform:uppercase; text-decoration:none;
    border:1px solid rgba(255,255,255,0.18); border-radius:10px; padding:7px 13px; transition:background .2s, color .2s;
  }
  .ig-gal__profile:hover { background:rgba(255,255,255,0.1); color:#fff; }
  .ig-gal__close {
    width:38px; height:38px; border-radius:50%; border:1px solid rgba(255,255,255,0.18);
    background:rgba(255,255,255,0.06); color:#fff; cursor:pointer; font-size:22px; line-height:1;
    display:flex; align-items:center; justify-content:center; transition:background .2s;
  }
  .ig-gal__close:hover { background:rgba(255,255,255,0.16); }

  /* Cuerpo: solo el slide, con las flechas a los costados */
  .ig-gal__body { flex:1; min-height:0; display:flex; align-items:center; justify-content:center; gap:14px; }
  .ig-gal__slide { flex:0 1 auto; height:100%; min-height:0; display:flex; flex-direction:column; align-items:center; gap:10px; }
  .ig-gal__stage {
    position:relative; flex:0 0 auto; width:380px; height:700px; max-width:100%; max-height:100%;
    border-radius:16px; overflow:hidden; background:#000; border:1px solid rgba(255,255,255,0.1);
  }
  .ig-gal__stage iframe { width:100%; height:100%; border:0; display:block; }
  .ig-gal__stage.is-loading::before {
    content:''; position:absolute; inset:0; z-index:1; background:rgba(10,10,26,0.85);
    background-image:linear-gradient(90deg,transparent,rgba(255,255,255,0.08),transparent);
    background-size:200% 100%; animation:igGalShimmer 1.1s linear infinite;
  }
  @keyframes igGalShimmer { from { background-position:200% 0; } to { background-position:-200% 0; } }

  /* Puntos + contador debajo del slide */
  .ig-gal__bar { display:flex; align-items:center; justify-content:center; gap:12px; flex-shrink:0; }
  .ig-gal__dots { display:flex; align-items:center; gap:7px; }
  .ig-gal__dot {
    width:7px; height:7px; border-radius:50%; background:rgba(255,255,255,0.25);
    border:0; padding:0; cursor:pointer; transition:width .25s ease, background .25s ease;
  }
  .ig-gal__dot.is-active { width:22px; border-radius:20px; background:#DD2A7B; }
  .ig-gal__count { color:rgba(255,255,255,0.45); font-size:12px; font-weight:700; font-variant-numeric:tabular-nums; }

  .ig-gal__arrow {
    width:46px; height:46px; border-radius:50%; border:1px solid rgba(255,255,255,0.15);
    background:rgba(255,255,255,0.07); color:#fff; cursor:pointer; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; transition:background .2s, border-color .2s;
  }
  .ig-gal__arrow:hover { background:rgba(221,42,123,0.6); border-color:rgba(221,42,123,0.6); }
  .ig-gal__arrow svg { width:20px; height:20px; }

  @media (max-width:900px) {
    .sid-dock { right:14px; bottom:88px; }
    .sid-dock__btn { width:50px; height:50px; }
    .sid-dock__btn svg { width:25px; height:25px; }
    .ig-gal__panel { padding:14px; gap:10px; }
    .ig-gal__body { gap:0; }
    .ig-gal__slide { flex:1; width:100%; }
    .ig-gal__stage { width:100%; height:min(700px, 100%); flex:0 0 auto; }
    /* En móvil las flechas bajan a la barra, para no comerse el ancho del reel */
    .ig-gal__body > .ig-gal__arrow { display:none; }
    .ig-gal__bar { gap:16px; }
    .ig-gal__bar .ig-gal__arrow { display:flex; width:40px; height:40px; }
    .ig-gal__profile { display:none; }
  }
  @media (min-width:901px) {
    .ig-gal__bar .ig-gal__arrow { display:none; }
  }
</style>

