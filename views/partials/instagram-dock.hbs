    <div class="ig-gal__body">
      <button type="button" class="ig-gal__arrow" data-ig-prev aria-label="{{instagram_gallery.prevLabel}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="ig-gal__slide">
        <div class="ig-gal__stage" id="igGalStage"></div>
        <div class="ig-gal__bar">
          <button type="button" class="ig-gal__arrow" data-ig-prev aria-label="{{instagram_gallery.prevLabel}}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <span class="ig-gal__dots" id="igGalDots"></span>
          <span class="ig-gal__count" id="igGalCount"></span>
          <button type="button" class="ig-gal__arrow" data-ig-next aria-label="{{instagram_gallery.nextLabel}}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <button type="button" class="ig-gal__arrow" data-ig-next aria-label="{{instagram_gallery.nextLabel}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</div>

<script type="application/json" id="igGalData">[{{#each instagram_gallery.posts}}{{#unless @first}},{{/unless}}{"code":"{{this.code}}","type":"{{#if this.type}}{{this.type}}{{else}}p{{/if}}"}{{/each}}]</script>

<script>
  (function(){
    var gal = document.getElementById('igGal');
    var data = document.getElementById('igGalData');
    if (!gal || !data) return;

    var posts = [];
    try { posts = JSON.parse(data.textContent) || []; } catch (e) { return; }
    if (!posts.length) return;

    var stage = document.getElementById('igGalStage');
    var cntEl = document.getElementById('igGalCount');
    var dotsEl = document.getElementById('igGalDots');
    var current = 0, prevOverflow = '';

    // Puntos de navegación
    var dots = posts.map(function(_, i){
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'ig-gal__dot';
      b.setAttribute('aria-label', 'Ir a ' + (i + 1));
      b.addEventListener('click', function(){ render(i); });
      dotsEl.appendChild(b);
      return b;
    });

    function render(i){
      current = (i + posts.length) % posts.length;
      var post = posts[current];
      // El iframe se crea al vuelo: la página no carga los reels al arrancar.
      stage.classList.add('is-loading');
      var frame = document.createElement('iframe');
      frame.setAttribute('scrolling', 'no');
      frame.setAttribute('frameborder', '0');
      frame.setAttribute('allowtransparency', 'true');
      frame.setAttribute('allowfullscreen', '');
      frame.addEventListener('load', function(){ stage.classList.remove('is-loading'); });
      frame.src = 'https://www.instagram.com/' + (post.type || 'p') + '/' + post.code + '/embed';
      stage.innerHTML = '';
      stage.appendChild(frame);

      cntEl.textContent = (current + 1) + ' / ' + posts.length;
      dots.forEach(function(d, n){ d.classList.toggle('is-active', n === current); });
    }

    function open(){
      prevOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      gal.classList.add('is-open');
      render(0);
    }

    function close(){
      gal.classList.remove('is-open');
      document.body.style.overflow = prevOverflow;
      stage.innerHTML = '';   // corta la carga del embed al cerrar
    }

    var opener = document.getElementById('sidIgOpen');
    if (opener) opener.addEventListener('click', open);

    gal.querySelectorAll('[data-ig-prev]').forEach(function(el){ el.addEventListener('click', function(){ render(current - 1); }); });
    gal.querySelectorAll('[data-ig-next]').forEach(function(el){ el.addEventListener('click', function(){ render(current + 1); }); });
    gal.querySelectorAll('[data-ig-close]').forEach(function(el){ el.addEventListener('click', close); });

    document.addEventListener('keydown', function(e){
      if (!gal.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') render(current - 1);
      else if (e.key === 'ArrowRight') render(current + 1);
    });

    // Swipe en el panel (el iframe se queda con sus propios toques, para poder reproducir)
    var x0 = null;
    gal.querySelector('.ig-gal__panel').addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; }, { passive: true });
    gal.querySelector('.ig-gal__panel').addEventListener('touchend', function(e){
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) render(current + (dx < 0 ? 1 : -1));
      x0 = null;
    }, { passive: true });
  })();
</script>
{{/if}}
