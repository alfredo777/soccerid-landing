    <span>&copy; {{year}} SOCCER iD{{#if data.confidencial}} · {{data.confidencial}}{{/if}}</span>
  </footer>

  {{!-- ═══════════ CAJONES: lo secundario, fuera del recorrido ═══════════
       Se abren desde los botones [data-cajon]; la mecánica (abrir, cerrar,
       Escape, foco) vive en la vista, en initContenido, con escuchadores
       delegados en document porque este contenido se inyecta. --}}

  {{!-- Presupuesto: la dona del partido 1 y los anticipos --}}
  <aside class="pa-cajon" id="pa-cajon-presupuesto" hidden aria-hidden="true">
    <div class="pa-cajon__velo" data-cajon-cerrar></div>
    <div class="pa-cajon__caja" role="dialog" aria-modal="true" aria-labelledby="pa-cajon-presupuesto-t">
      <header class="pa-cajon__cab">
        <div>
          <h3 class="pa-cajon__t" id="pa-cajon-presupuesto-t">{{data.capital.cajon.title}}</h3>
          {{#if data.capital.cajon.sub}}<p class="pa-cajon__s">{{data.capital.cajon.sub}}</p>{{/if}}
        </div>
        <button type="button" class="pa-cajon__x" data-cajon-cerrar aria-label="{{data.cajon.cerrar}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </header>
      <div class="pa-cajon__cuerpo">
        {{#if donut}}
        <div class="pa-destino pa-destino--cajon">
          <figure class="pa-donut">
            <svg viewBox="0 0 160 160" role="img" aria-label="{{data.capital.cajon.title}}">
              <g transform="rotate(-90 80 80)">
                <circle class="pa-donut__bg" cx="80" cy="80" r="60"></circle>
                {{#each donut.segmentos}}
                <circle class="pa-donut__s" cx="80" cy="80" r="60" stroke="{{this.color}}"
                        stroke-dasharray="{{this.dash}}" stroke-dashoffset="{{this.offset}}"></circle>
                {{/each}}
              </g>
            </svg>
            <figcaption>
              <strong>{{data.capital.cajon.totalValue}}</strong>
              <span>{{data.capital.cajon.totalLabel}}</span>
            </figcaption>
          </figure>
          <ul class="pa-leyenda">
            {{#each donut.segmentos}}
            <li class="pa-leyenda__i">
              <span class="pa-leyenda__p" style="background: {{this.color}}"></span>
              <span class="pa-leyenda__c">{{this.concepto}}</span>
              <strong class="pa-leyenda__m">{{this.monto}}</strong>
              <span class="pa-leyenda__pct">{{this.pct}}%</span>
            </li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
        <div class="pa-nota">
          <h4 class="pa-nota__t">{{data.capital.cajon.anticiposTitle}}</h4>
          <ul class="pa-kv pa-kv--dos">
            {{#each data.capital.items}}{{#unless @first}}
            <li class="pa-kv__i"><span>{{this.label}}</span><strong>{{this.value}}</strong><span class="pa-kv__n">{{this.note}}</span></li>
            {{/unless}}{{/each}}
          </ul>
          <p class="pa-nota__b">{{data.capital.cajon.anticiposNota}}</p>
        </div>
      </div>
    </div>
  </aside>

  {{!-- Detalles: contrato, panel, documentación, uso de recursos, beneficios --}}
  <aside class="pa-cajon" id="pa-cajon-detalles" hidden aria-hidden="true">
    <div class="pa-cajon__velo" data-cajon-cerrar></div>
    <div class="pa-cajon__caja" role="dialog" aria-modal="true" aria-labelledby="pa-cajon-detalles-t">
      <header class="pa-cajon__cab">
        <div>
          <h3 class="pa-cajon__t" id="pa-cajon-detalles-t">{{data.respaldo.cajon.title}}</h3>
          <p class="pa-cajon__s">{{data.respaldo.cajon.sub}}</p>
        </div>
        <button type="button" class="pa-cajon__x" data-cajon-cerrar aria-label="{{data.cajon.cerrar}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </header>
      <div class="pa-cajon__cuerpo">
        <div class="pa-lista">
          {{#each data.respaldo.cajon.items}}
          <div class="pa-card pa-card--fila">
            <svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>
            <div>
              <h4 class="pa-card__t">{{this.title}}</h4>
              <p class="pa-card__b">{{this.body}}</p>
            </div>
          </div>
          {{/each}}
        </div>
        {{#if data.respaldo.cajon.aviso}}<div class="pa-nota pa-nota--warn"><p class="pa-nota__b">{{data.respaldo.cajon.aviso}}</p></div>{{/if}}
      </div>
    </div>
  </aside>

  {{!-- Fuentes de ingresos: de dónde salen las utilidades que se reparten --}}
  {{#if data.participacion.ingresos.items.length}}
  <aside class="pa-cajon" id="pa-cajon-ingresos" hidden aria-hidden="true">
    <div class="pa-cajon__velo" data-cajon-cerrar></div>
    <div class="pa-cajon__caja" role="dialog" aria-modal="true" aria-labelledby="pa-cajon-ingresos-t">
      <header class="pa-cajon__cab">
        <div>
          <h3 class="pa-cajon__t" id="pa-cajon-ingresos-t">{{data.participacion.ingresos.title}}</h3>
          {{#if data.participacion.ingresos.sub}}<p class="pa-cajon__s">{{data.participacion.ingresos.sub}}</p>{{/if}}
        </div>
        <button type="button" class="pa-cajon__x" data-cajon-cerrar aria-label="{{data.cajon.cerrar}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </header>
      <div class="pa-cajon__cuerpo">
        <ul class="pa-fuentes">
          {{#each data.participacion.ingresos.items}}
          <li class="pa-fuentes__i"><span class="pa-fuentes__p" aria-hidden="true"></span>{{this}}</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </aside>
  {{/if}}

  {{!-- Trayectoria: las ediciones, lo que se sabe hacer y la cobertura en medios --}}
  <aside class="pa-cajon" id="pa-cajon-trayectoria" hidden aria-hidden="true">
    <div class="pa-cajon__velo" data-cajon-cerrar></div>
    <div class="pa-cajon__caja" role="dialog" aria-modal="true" aria-labelledby="pa-cajon-trayectoria-t">
      <header class="pa-cajon__cab">
        <div>
          <h3 class="pa-cajon__t" id="pa-cajon-trayectoria-t">{{data.trayectoria.cajon.title}}</h3>
          <p class="pa-cajon__s">{{data.trayectoria.cajon.sub}}</p>
        </div>
        <button type="button" class="pa-cajon__x" data-cajon-cerrar aria-label="{{data.cajon.cerrar}}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </header>
      <div class="pa-cajon__cuerpo">
        {{!-- Las tres ediciones NO se repiten aquí: ya están en el bloque 05,
              a la vista. El cajón es para lo que no cabe fuera. --}}
        {{#if data.trayectoria.cajon.capacidades}}<p class="pa-caps">{{data.trayectoria.cajon.capacidades}}</p>{{/if}}
        {{#if mediaLinks.length}}
        {{#if data.trayectoria.cajon.mediosTitle}}<h4 class="pa-cajon__h4">{{data.trayectoria.cajon.mediosTitle}}</h4>{{/if}}
        {{#if data.trayectoria.cajon.mediosSub}}<p class="pa-cajon__s">{{data.trayectoria.cajon.mediosSub}}</p>{{/if}}
        <ul class="pa-medios pa-medios--cajon">
          {{#each mediaLinks}}
          <li class="pa-medio">
            <a href="{{this.url}}" target="_blank" rel="noopener">
              {{#if this.image}}<span class="pa-medio__foto" style="background-image: url('{{this.image}}')" aria-hidden="true"></span>{{/if}}
              <span class="pa-medio__txt">
                <span class="pa-medio__f">{{this.source}}</span>
                <span class="pa-medio__t">{{this.title}}</span>
              </span>
            </a>
          </li>
          {{/each}}
        </ul>
        {{/if}}
        <p class="pa-cajon__pie"><a href="{{data.trayectoria.cajon.ctaHistoriaUrl}}"{{{salida data.trayectoria.cajon.ctaHistoriaUrl}}} class="pa-btn pa-btn--ghost">{{data.trayectoria.cajon.ctaHistoria}} →</a></p>
      </div>
    </div>
  </aside>

  {{!-- Volver arriba: estilo y comportamiento en la vista, compartidos con la propuesta de partido. --}}
  <button class="pp-btt" id="ppBtt" type="button" aria-label="{{#if isEs}}Volver al inicio de la página{{else}}Back to top{{/if}}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
  </button>

  <style>
    /* ───────────── RÓTULO DE BLOQUE ───────────── */
    .pa-rot {
      display: flex; align-items: center; gap: 14px; margin-bottom: 14px;
      font-size: 11px; font-weight: 800; letter-spacing: 2.2px; color: var(--pp-accent);
    }
    .pa-rot::after { content: ''; flex: 1 1 auto; height: 1px; background: rgba(255,255,255,0.16); }
    .pa-rot--centro { justify-content: center; }
    .pa-rot--centro::after { display: none; }

    /* ───────────── PANEL: una columna, fondo plano ───────────── */
    .pa-panel { position: relative; padding: 26px 26px 60px; }
    .pa-panel__fondo { position: absolute; inset: 0; background: var(--pp-dark); }
    .pa-panel__col { position: relative; z-index: 2; max-width: 1240px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
    .pa-box__h { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 10px 40px; align-items: end; margin-bottom: 20px; }
    .pa-box { padding: 22px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.12); background: var(--tour-card, #1E222C); }
    .pa-box--cifras { padding: 14px; margin-top: -4px; }
    .pa-box__t { font-size: 23px; font-weight: 900; line-height: 1.15; }
    .pa-box__s { font-size: 14.5px; line-height: 1.55; color: #D2D5DC; margin: 8px 0 0; }
    .pa-box__dato { color: #FFFFFF; font-weight: 800; }
    .pa-box__pie { font-size: 13px; line-height: 1.55; color: #C9CCD4; margin: 0; }
    /* Nota y botón en la misma hilera: el botón a la derecha, visible. */
    .pa-box__pie-cta { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 16px; }
    .pa-box__pie-cta > .pa-nota { margin-top: 0; flex: 1 1 auto; }
    .pa-box__pie-cta--solo { justify-content: flex-end; }

    .pa-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pa-tile { padding: 14px 16px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.055); }
    .pa-tile__l { display: block; font-size: 9.5px; font-weight: 800; letter-spacing: 1.5px; color: var(--tour-rotulo, #C9CCD4); }
    .pa-tile__v { display: block; font-size: 27px; font-weight: 900; line-height: 1.1; margin: 5px 0 4px; color: #FFFFFF; }
    .pa-tile__n { display: block; font-size: 12px; line-height: 1.45; color: #D2D5DC; }
    .pa-tile__t { display: block; font-size: 15px; font-weight: 800; line-height: 1.3; }
    .pa-tile--fila { display: flex; align-items: center; gap: 12px; }
    .pa-tile--fila .pa-ico { margin-bottom: 0; flex: 0 0 auto; }
    .pa-tile--fila .pa-tile__txt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .pa-tile__d { font-size: 12.5px; line-height: 1.4; color: #AEB2BB; }
    .pa-tile--ed { text-align: center; }
    .pa-tile--ed .pa-tile__t { margin: 4px 0 2px; }

    .pa-kv { list-style: none; padding: 0; margin: 14px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    .pa-kv--dos { grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 12px 0 14px; }
    /* Una sola tarjeta: el desglose por partido ya está en la barra de arriba. */
    .pa-kv--una { grid-template-columns: minmax(0, 1fr); }
    .pa-kv__i {
      display: flex; flex-direction: column; gap: 7px; padding: 16px 18px; border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.055);
      font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: var(--tour-rotulo, #C9CCD4);
    }
    .pa-kv__i strong { font-size: 22px; font-weight: 900; letter-spacing: 0; color: #FFFFFF; }
    .pa-kv__i--total { border-color: rgba(255,255,255,0.22); background: rgba(255,255,255,0.09); }
    .pa-kv__n { font-size: 12px; font-weight: 400; letter-spacing: 0; color: #D2D5DC; }

    /* ───────────── PORTADA ───────────── */
    /* El hero ocupa todo el ancho, como el cierre: sin tarjeta, sin bordes y
       sin esquinas. Antes vivía dentro de la columna de 1240px y se leía como
       un bloque más; ahora abre la página de lado a lado. */
    .pa-foto {
      position: relative; min-height: 72vh; overflow: hidden;
      display: flex; align-items: center; justify-content: center; text-align: center;
      padding: 96px 32px;
      background: url('/assets/images/back-tour-27.png') center/cover no-repeat;
    }
    .pa-foto__veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,21,25,0.3) 0%, rgba(28,30,35,0.62) 52%, rgba(44,47,53,0.94) 100%); }
    .pa-foto__body { position: relative; z-index: 2; max-width: 620px; }
    .pa-foto__t { font-size: clamp(30px, 4.2vw, 52px); font-weight: 900; line-height: 1.03; margin: 14px 0 14px; }
    .pa-foto__t--oculto { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
    /* El logo va en blanco: lo despega una sombra oscura, no un resplandor. */
    .pa-logo { display: block; width: clamp(120px, 13vw, 190px); height: auto; margin: 16px auto 18px; filter: drop-shadow(0 8px 26px rgba(0,0,0,0.6)); }
    .pa-cierre__logo { display: block; width: clamp(104px, 11vw, 150px); height: auto; margin: 0 auto 20px; filter: drop-shadow(0 6px 20px rgba(0,0,0,0.55)); }
    .pa-foto__lead { font-size: 18px; line-height: 1.45; color: rgba(255,255,255,0.9); }
    /* Dos renglones: el primero pesa, el segundo acompaña. Cada uno en su
       bloque para que el corte no dependa del ancho de la ventana ni del
       idioma, que parten en sitios distintos. */
    .pa-foto__lead-f { display: block; font-size: 22px; font-weight: 900; color: #FFFFFF; }
    .pa-foto__lead-s { display: block; margin-top: 4px; }
    /* Blanco translúcido nunca por debajo de 0.75 para texto chico (docs/variables-del-proyecto.md). */
    .pa-foto__meta { font-size: 12.5px; letter-spacing: 1.3px; color: rgba(255,255,255,0.86); margin-top: 9px; }
    /* Sobre la foto no hay fondo que medir: la pastilla oscura es lo que protege al rótulo. */
    .pa-badge { display: inline-block; padding: 6px 18px; border-radius: 20px; font-size: 11.5px; font-weight: 800; letter-spacing: 2px; background: rgba(10,11,14,0.72); color: #FFFFFF; border: 1px solid rgba(255,255,255,0.28); }

    /* ───────────── LOS TRES PARTIDOS ───────────── */
    .pa-temporada { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pa-pt { display: flex; flex-direction: column; padding: 20px 18px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.055); }
    .pa-pt--inc { border-style: dashed; border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.025); }
    /* El partido confirmado resalta sobre los otros dos: acento cian, igual que
       el bloque de inversión mínima. */
    .pa-pt--destacado { border-color: rgba(var(--tour-cian-rgb, 56,225,255), 0.5); background: rgba(var(--tour-cian-rgb, 56,225,255), 0.08); box-shadow: 0 0 0 1px rgba(var(--tour-cian-rgb, 56,225,255), 0.18); }
    .pa-pt__cab { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .pa-pt__n { font-size: 11px; font-weight: 800; letter-spacing: 1.6px; color: var(--tour-rotulo, #C9CCD4); }
    .pa-pt__cuando { display: block; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: var(--tour-rotulo, #C9CCD4); margin-top: 14px; }
    .pa-pt__t { display: block; font-size: 19px; font-weight: 900; line-height: 1.18; margin: 7px 0 5px; }
    .pa-pt__lugar { display: block; font-size: 13px; color: #D2D5DC; flex: 1 1 auto; }
    .pa-pt .pa-btn { margin-top: 16px; align-self: flex-start; }

    /* ───────────── BARRAS ───────────── */
    .pa-apilada { margin: 4px 0 0; }
    .pa-apilada__l { display: block; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: var(--tour-rotulo, #C9CCD4); margin-bottom: 10px; }
    .pa-apilada__barra { display: flex; gap: 4px; }
    .pa-apilada__t {
      flex: 0 0 calc(var(--w, 33%) - 3px); min-width: 0;
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      min-height: 44px; padding: 8px 14px; border-radius: 10px;
      background: var(--tour-grafico, #38E1FF);
      /* Tinta NEGRA sobre el azul, no el carbón de marca: #1C1E23 encima del
         azul daba 5.57 y la casa pide 7.0 bajo 16px. En negro son 7.01 sobre
         el azul base y 9.36 sobre el claro del segundo tramo. */
      color: #000000; transform-origin: left center;
    }
    /* La barra se lee como UNA pieza segmentada, igual que la del 70/30: la
       cápsula solo en las orillas de FUERA, y recto por dentro. El tramo de en
       medio no toca ningún extremo, así que va recto por los dos lados. */
    .pa-apilada__t { border-radius: 0; }
    .pa-apilada__t:first-child { border-radius: 999px 12px 12px 999px; }
    .pa-apilada__t:last-child { border-radius: 12px 999px 999px 12px; }
    /* Y si solo hubiera un tramo, cápsula entera. */
    .pa-apilada__t:only-child { border-radius: 999px; }
    .pa-apilada__t:not(:first-child) { background: var(--tour-grafico-2, #7FDCF0); }
    .pa-apilada__n { font-size: 10px; font-weight: 800; letter-spacing: 1.3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pa-apilada__v { font-size: 13px; font-weight: 900; white-space: nowrap; }
    /* Tramo estrecho: rótulo arriba y cifra debajo, centrados. En fila no
       caben los dos y el rótulo se cortaba. */
    .pa-apilada__t--estrecho {
      flex-direction: column; align-items: center; justify-content: center; gap: 1px; padding: 6px 8px;
    }
    .pa-apilada__t--estrecho .pa-apilada__n { font-size: 9px; letter-spacing: .8px; opacity: .75; }
    .pa-apilada__t--estrecho .pa-apilada__v { font-size: 12px; }

    .pa-partida { display: flex; gap: 4px; margin: 0 0 16px; }
    .pa-partida__t { flex: 0 0 calc(var(--w, 50%) - 2px); min-width: 0; display: flex; align-items: baseline; gap: 10px; padding: 16px 18px; border-radius: 12px; background: var(--tour-grafico, #38E1FF); color: #000000; transform-origin: left center; }
    .pa-partida__t:first-child { border-radius: 999px 12px 12px 999px; }
    .pa-partida__t:last-child { border-radius: 12px 999px 999px 12px; background: rgba(255,255,255,0.16); color: #FFFFFF; }
    .pa-partida__t strong { font-size: 26px; font-weight: 900; line-height: 1; }
    .pa-partida__t span { font-size: 10px; font-weight: 800; letter-spacing: 1.4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* El papel de cada parte, dos columnas alineadas con la barra 70/30. */
    .pa-roles { display: grid; grid-template-columns: 70fr 30fr; gap: 4px; margin: 0 0 20px; }
    .pa-rol { padding: 2px 18px 0 2px; }
    .pa-rol:last-child { padding-left: 18px; padding-right: 2px; }
    .pa-rol__t { display: block; font-size: 12px; font-weight: 800; letter-spacing: 0.6px; color: var(--tour-cian, #38E1FF); margin-bottom: 5px; }
    .pa-rol__t strong { font-weight: 900; }
    .pa-rol__b { display: block; font-size: 13px; line-height: 1.5; color: #C9CCD4; }
    /* Inversión mínima: bloque propio, protagonista, separado del capital total. */
    .pa-minimo { margin-top: 14px; padding: 22px 24px; border-radius: 16px;
      border: 1px solid rgba(var(--tour-cian-rgb, 56,225,255), 0.38); background: rgba(var(--tour-cian-rgb, 56,225,255), 0.07); }
    .pa-minimo__l { display: block; font-size: 11px; font-weight: 800; letter-spacing: 2px; color: var(--tour-rotulo, #C9CCD4); margin-bottom: 8px; }
    .pa-minimo__v { display: block; font-size: clamp(34px, 5vw, 48px); font-weight: 900; line-height: 1; color: var(--tour-cian, #38E1FF); }
    .pa-minimo__p { display: block; margin-top: 12px; font-size: 16px; font-weight: 700; color: #FFFFFF; }
    .pa-minimo__n { display: block; margin-top: 6px; font-size: 12.5px; color: #AEB2BB; }
    /* Ejemplo del cálculo del 5%, dentro del mismo bloque. */
    .pa-calc5 { margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(var(--tour-cian-rgb, 56,225,255), 0.22); }
    .pa-calc5__t { display: block; font-size: 10.5px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; color: var(--tour-rotulo, #C9CCD4); margin-bottom: 10px; }
    .pa-calc5__row { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 7px 0; border-top: 1px solid rgba(255,255,255,0.07); }
    .pa-calc5__row:first-of-type { border-top: 0; }
    .pa-calc5__op { font-size: 13.5px; color: #C9CCD4; }
    .pa-calc5__res { font-size: 13.5px; font-weight: 800; color: var(--tour-cian, #38E1FF); white-space: nowrap; text-align: right; }
    /* Una sola columna: la tarjeta ocupa todo el ancho del bloque. */
    .pa-retorno { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
    /* La advertencia va dentro de la tarjeta, al final, separada por un filete. */
    .pa-tile__nota {
      margin: 14px 0 0; padding-top: 12px;
      border-top: 1px solid rgba(255,255,255,0.12);
      font-size: 13px; line-height: 1.55; color: #D2D5DC;
    }

    /* ───────────── MOVIMIENTO ─────────────
       Las barras crecen al entrar en pantalla; lo dispara un observador en la
       vista (initContenido). Sin JavaScript se ve quieto y completo. */
    @keyframes pa-crece { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    .pa-anima--armada { transform: scaleX(0); }
    .pa-anima--on { animation: pa-crece .9s cubic-bezier(.2,.7,.2,1) both; }
    @media (prefers-reduced-motion: reduce) { .pa-anima--armada { transform: none; } .pa-anima--on { animation: none; } }

    /* ───────────── PIEZAS ───────────── */
    .pa-btn { display: inline-block; padding: 13px 26px; border-radius: 12px; font-size: 12.5px; font-weight: 800; letter-spacing: 1.1px; text-decoration: none; background: var(--pp-accent); color: var(--tour-tinta, #0A0A0E); white-space: nowrap; border: 1px solid transparent; cursor: pointer; font-family: inherit; }
    .pa-btn--ghost { background: transparent; color: var(--pp-accent); border-color: rgba(255,255,255,0.55); }
    .pa-btn--ghost:hover { border-color: #FFFFFF; background: rgba(255,255,255,0.06); }
    .pa-btn--chico { padding: 11px 18px; font-size: 11.5px; }
    /* Lo pendiente y el estado de cada partido van en el cian del tour. El
       tinte al 8 %: al 13 % el cian aclaraba el fondo y el texto de 11 px se
       quedaba en 6.4 de contraste; así da 7.3. */
    .pa-pend { display: inline-block; padding: 3px 10px; border-radius: 999px; font-style: normal; font-size: 11px; font-weight: 800; letter-spacing: 1.2px; background: rgba(var(--tour-cian-rgb, 56,225,255), 0.08); color: var(--tour-cian, #38E1FF); }
    .pa-sprite { display: none; }
    .pa-ico { display: block; width: 30px; height: 30px; margin-bottom: 10px; padding: 5px; border-radius: 9px; flex-shrink: 0; color: var(--tour-grafico, #38E1FF); background: rgba(var(--tour-grafico-rgb, 56,225,255), 0.14); stroke: currentColor; stroke-width: 1.6; fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .pa-ico use { pointer-events: none; }
    .pa-nota { margin-top: 16px; padding: 18px 20px; border-radius: 14px; border-left: 3px solid var(--tour-grafico, #38E1FF); background: rgba(255,255,255,0.05); }
    .pa-nota--warn { border-left-color: var(--tour-cian, #38E1FF); }
    .pa-nota--compacta { padding: 14px 18px; }
    .pa-nota__t { font-size: 15px; font-weight: 800; margin: 0 0 10px; }
    /* La nota de riesgo se mantiene legible: sin opacidad, 9.9 sobre la tarjeta. */
    .pa-nota__b { font-size: 13.5px; line-height: 1.6; color: #D2D5DC; margin: 0; }
    .pa-caps { font-size: 13px; letter-spacing: .6px; color: #C9CCD4; margin: 18px 0 22px; }

    /* ───────────── CAJONES ─────────────
       Mismo mecanismo que .pn-drawer del panel, en oscuro: velo, caja a la
       derecha, desliza desde fuera. En teléfono ocupa todo el ancho. */
    .pa-cajon { position: fixed; inset: 0; z-index: 160; display: flex; justify-content: flex-end; background: rgba(10,11,14,0.6); opacity: 0; pointer-events: none; transition: opacity .22s ease; }
    .pa-cajon.is-open { opacity: 1; pointer-events: auto; }
    .pa-cajon__velo { position: absolute; inset: 0; }
    .pa-cajon__caja { position: relative; width: 100%; max-width: 560px; height: 100%; overflow-y: auto; background: var(--tour-card, #1E222C); box-shadow: -16px 0 48px rgba(0,0,0,0.45); transform: translateX(100%); transition: transform .26s cubic-bezier(.4,0,.2,1); }
    .pa-cajon.is-open .pa-cajon__caja { transform: translateX(0); }
    .pa-cajon__cab { position: sticky; top: 0; z-index: 1; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 22px 24px 18px; background: var(--tour-card, #1E222C); border-bottom: 1px solid rgba(255,255,255,0.1); }
    .pa-cajon__t { font-size: 19px; font-weight: 900; line-height: 1.2; margin: 0; }
    .pa-cajon__s { font-size: 13.5px; line-height: 1.5; color: #D2D5DC; margin: 6px 0 0; }
    .pa-cajon__h4 { font-size: 15px; font-weight: 800; margin: 26px 0 0; }
    .pa-cajon__x { flex: none; width: 44px; height: 44px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.06); color: #FFFFFF; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .pa-cajon__x svg { width: 20px; height: 20px; }
    .pa-cajon__cuerpo { padding: 22px 24px 32px; }
    .pa-cajon__pie { margin: 24px 0 0; }
    .pa-lista { display: grid; gap: 10px; }
    .pa-fuentes { list-style: none; padding: 0; margin: 4px 0 0; }
    .pa-fuentes__i { display: flex; align-items: center; gap: 14px; padding: 15px 2px; font-size: 16px; color: #E7E9EE; border-top: 1px solid rgba(255,255,255,0.1); }
    .pa-fuentes__i:first-child { border-top: 0; }
    .pa-fuentes__p { flex: 0 0 auto; width: 11px; height: 11px; border-radius: 3px; background: var(--tour-cian, #38E1FF); }
    .pa-card { padding: 18px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.045); }
    .pa-card--fila { display: flex; align-items: flex-start; gap: 14px; }
    .pa-card--fila .pa-ico { margin-bottom: 0; }
    .pa-card__t { font-size: 15.5px; font-weight: 800; margin: 0 0 6px; }
    .pa-card__b { font-size: 13.5px; line-height: 1.55; color: #D2D5DC; margin: 0; }
    .pa-card__anio { flex: none; font-size: 22px; font-weight: 900; color: #FFFFFF; min-width: 58px; }

    /* Destino del capital: la dona la calcula el servidor desde el desglose. */
    .pa-destino { display: grid; grid-template-columns: minmax(0, 200px) minmax(0, 1fr); gap: 24px; align-items: center; }
    .pa-donut { position: relative; margin: 0; }
    .pa-donut svg { display: block; width: 100%; height: auto; }
    .pa-donut__bg { fill: none; stroke: rgba(255,255,255,0.07); stroke-width: 22; }
    .pa-donut__s { fill: none; stroke-width: 22; }
    .pa-donut figcaption { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
    .pa-donut figcaption strong { font-size: 26px; font-weight: 900; line-height: 1; }
    .pa-donut figcaption span { font-size: 9.5px; font-weight: 800; letter-spacing: 1.5px; margin-top: 6px; color: var(--tour-rotulo, #C9CCD4); }
    .pa-leyenda { list-style: none; padding: 0; margin: 0; display: grid; gap: 2px; }
    .pa-leyenda__i { display: grid; grid-template-columns: 12px minmax(0, 1fr) auto 50px; align-items: center; gap: 12px; padding: 11px 4px; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .pa-leyenda__i:last-child { border-bottom: 0; }
    .pa-leyenda__p { width: 12px; height: 12px; border-radius: 4px; }
    .pa-leyenda__c { font-size: 14px; color: #D2D5DC; min-width: 0; }
    .pa-leyenda__m { font-size: 15px; font-weight: 800; font-variant-numeric: tabular-nums; }
    .pa-leyenda__pct { font-size: 13px; font-weight: 800; text-align: right; font-variant-numeric: tabular-nums; color: var(--tour-rotulo, #C9CCD4); }

    /* Ediciones: tarjeta-enlace con su foto. La foto es decoración, así que va
       de fondo en un span aria-hidden y no como <img> con alt vacío. */
    .pa-ed {
      display: flex; flex-direction: column; overflow: hidden;
      border-radius: 16px; border: 1px solid rgba(255,255,255,0.09);
      background: rgba(255,255,255,0.055); text-decoration: none; color: inherit;
      transition: border-color .2s, transform .2s;
    }
    .pa-ed:hover { border-color: rgba(255,255,255,0.45); transform: translateY(-2px); }
    /* El encuadre va ALTO, no centrado: en estas fotos la acción (y las
       cabezas) está entre el 12 % y el 45 % del alto, así que un recorte
       centrado decapitaba a los jugadores de 2023. Con 30 % y algo más de
       altura las tres entran enteras. */
    .pa-ed__foto { display: block; height: 150px; background-size: cover; background-position: center var(--foco, 30%); }
    .pa-ed__cuerpo { display: block; padding: 16px 18px 18px; }
    .pa-ed__anio { display: block; font-size: 24px; font-weight: 900; line-height: 1; color: #FFFFFF; }
    .pa-ed__t { display: block; font-size: 15px; font-weight: 800; line-height: 1.3; margin: 7px 0 4px; }
    .pa-ed__n { display: block; font-size: 12.5px; line-height: 1.45; color: #C9CCD4; }
    .pa-ed__dato { display: inline-block; margin-top: 10px; font-size: 10.5px; font-weight: 800; letter-spacing: 1.2px; color: var(--tour-rotulo, #C9CCD4); }
    /* En el cajón, la misma tarjeta en horizontal: cabe más en menos alto. */
    .pa-ed--ancha { flex-direction: row; align-items: stretch; }
    .pa-ed--ancha .pa-ed__foto { flex: 0 0 116px; height: auto; min-height: 112px; background-position: center var(--foco, 32%); }
    .pa-ed--ancha .pa-ed__cuerpo { flex: 1 1 auto; padding: 14px 16px; }
    .pa-ed--ancha .pa-ed__anio { font-size: 20px; }

    .pa-medios { list-style: none; padding: 0; margin: 12px 0 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .pa-medio a { display: flex; align-items: stretch; gap: 0; overflow: hidden; border-radius: 12px; text-decoration: none; color: inherit; border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.045); transition: border-color .2s; }
    .pa-medio__foto { flex: 0 0 88px; background-size: cover; background-position: center 32%; }
    .pa-medio__txt { flex: 1 1 auto; min-width: 0; padding: 14px 16px; }
    .pa-medio a:hover { border-color: rgba(255,255,255,0.5); }
    /* Gris de rótulo, no azul: sobre la tarjeta del cajón el azul se quedaba en 4.69 a 10.5px. */
    .pa-medio__f { display: block; font-size: 10.5px; font-weight: 800; letter-spacing: 1.5px; color: var(--tour-rotulo, #C9CCD4); margin-bottom: 6px; }
    .pa-medio__t { display: block; font-size: 14px; line-height: 1.45; }

    /* ───────────── CIERRE ───────────── */
    .pa-cierre { position: relative; display: flex; align-items: center; justify-content: center; text-align: center; min-height: 54vh; padding: 86px 32px; background: url('/assets/images/back-tour-27.png') center/cover no-repeat; }
    .pa-cierre .pa-foto__veil { background: linear-gradient(180deg, rgba(18,20,24,0.74) 0%, rgba(26,28,33,0.84) 100%); }
    .pa-cierre__body { position: relative; z-index: 2; max-width: 780px; }
    .pa-cierre__t { font-size: clamp(28px, 4vw, 44px); font-weight: 900; line-height: 1.08; margin-bottom: 16px; }
    .pa-cierre__b { font-size: 17px; line-height: 1.55; color: rgba(255,255,255,0.88); margin-bottom: 26px; }
    /* Botón de WhatsApp del cierre, en el verde de la marca de WhatsApp, igual
       que el de /partido-1. */
    .pa-btn--wa { background: #25D366; border-color: #25D366; color: #0A2E16; display: inline-flex; align-items: center; gap: 10px; }
    .pa-btn--wa:hover { background: #1EBE5B; border-color: #1EBE5B; }
    .pa-btn--wa svg { width: 20px; height: 20px; }
    .pa-cierre__conf { display: block; margin-top: 28px; font-size: 12px; letter-spacing: 3px; color: rgba(255,255,255,0.35); }

    /* ───────────── BARRA DE MARCA ───────────── */
    .pa-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 48px; border-top: 1px solid rgba(255,255,255,0.06); background: var(--pp-dark); }
    .pa-footer img { display: block; height: 28px; width: auto; }
    .pa-footer span { font-size: 12px; color: rgba(255,255,255,0.35); }
    .pa-footer__redes { display: flex; align-items: center; gap: 10px; }
    .pa-footer__redes a { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; color: rgba(255,255,255,0.72); border: 1px solid rgba(255,255,255,0.14); transition: color .2s, border-color .2s, background .2s; }
    .pa-footer__redes a:hover { color: #0A0B0E; background: var(--tour-cian, #38E1FF); border-color: var(--tour-cian, #38E1FF); }
    .pa-footer__redes svg { width: 18px; height: 18px; }

    /* ───────────── ESCALA DE PANTALLAS: 1180 · 860 · 560 ───────────── */
    @media (max-width: 1180px) {
      .pa-box__h { grid-template-columns: minmax(0, 1fr); gap: 8px; align-items: start; }
      .pa-kv { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .pa-retorno { grid-template-columns: minmax(0, 1fr); }
    }
    @media (max-width: 860px) {
      .pa-panel { padding: 16px 16px 32px; }
      .pa-foto { min-height: 62vh; padding: 72px 20px; }
      .pa-tiles, .pa-temporada { grid-template-columns: minmax(0, 1fr); }
      .pa-roles { grid-template-columns: minmax(0, 1fr); gap: 14px; }
      .pa-rol, .pa-rol:last-child { padding: 0; }
      .pa-apilada__barra { flex-direction: column; }
      .pa-apilada__t, .pa-apilada__t:first-child, .pa-apilada__t:last-child { flex-basis: auto; border-radius: 10px; }
      .pa-partida { flex-direction: column; }
      .pa-partida__t, .pa-partida__t:first-child, .pa-partida__t:last-child { flex-basis: auto; border-radius: 12px; }
      .pa-box__pie-cta { flex-direction: column; align-items: stretch; }
      .pa-box__pie-cta .pa-btn { text-align: center; }
      .pa-destino { grid-template-columns: minmax(0, 1fr); justify-items: center; }
      .pa-donut { max-width: 220px; }
      .pa-leyenda { width: 100%; }
      .pa-cierre { padding: 64px 20px; }
      .pa-footer { padding: 16px 20px; flex-direction: column; gap: 10px; text-align: center; }
    }
    @media (max-width: 560px) {
      .pa-kv, .pa-kv--dos { grid-template-columns: minmax(0, 1fr); }
      .pa-medio__foto { flex-basis: 74px; }
      .pa-leyenda__i { grid-template-columns: 12px minmax(0, 1fr) auto; row-gap: 2px; }
      .pa-leyenda__pct { grid-column: 2 / -1; text-align: left; }
      .pa-cajon__cab, .pa-cajon__cuerpo { padding-left: 16px; padding-right: 16px; }
    }
  </style>

