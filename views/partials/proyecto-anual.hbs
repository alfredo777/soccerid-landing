{{!-- Perfil anual del proyecto 2027.

     La lámina 19 de la presentación define tres niveles:

         SOCCER iD CUP        historia de la copa      → /es/socceridcup (pública)
         PROYECTO 2027        esta página              → detrás del candado
         PERFIL DEL PARTIDO   Cruz Azul vs. Pumas…     → /socceridcup2027/partido-N

     Arriba va un panel: la foto del primer partido al centro con el nombre
     encima, y alrededor lo que se lee de un vistazo —el resumen, los tres
     partidos y el calendario—. Lo que necesita lectura pausada queda abajo,
     en secciones normales. La idea es que el inversionista entienda el
     proyecto sin hacer scroll y baje solo si quiere el detalle.

     Ocupa el mismo lugar que `propuesta-contenido`, así que hereda el candado,
     la barra de idioma y las variables de color de la vista.

     Las cifras que la presentación deja abiertas vienen con `pendiente` y se
     pintan como POR DEFINIR: ninguna se inventó. Cerrar una es escribir su
     valor en `contents/cup_tour_2027.json` y quitarle la marca. --}}

  {{!-- Iconografía. Un solo sprite al principio y cada dato dice cuál le toca
       con su campo `icon`; así no hay SVG repetido por la vista. Trazo, no
       relleno, para que hereden el color. --}}
  <svg class="pa-sprite" aria-hidden="true" focusable="false"><defs>
    <g id="i-balon"><circle cx="12" cy="12" r="9"/><path d="M12 7.5l3.5 2.5-1.3 4.1H9.8L8.5 10z"/><path d="M12 3v4.5M3.6 9.6l4.9.4M20.4 9.6l-4.9.4M7.2 20.2l2.6-5.6M16.8 20.2l-2.6-5.6"/></g>
    <g id="i-reparto"><circle cx="12" cy="12" r="9"/><path d="M12 12V3a9 9 0 017.8 4.5z"/><path d="M12 12l7.8-4.5"/></g>
    <g id="i-calendario-ok"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17M9 15l2.2 2.2L15.5 13"/></g>
    <g id="i-calendario"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17"/></g>
    <g id="i-estadio"><path d="M3 8.5c0-1.9 4-3.4 9-3.4s9 1.5 9 3.4-4 3.4-9 3.4-9-1.5-9-3.4z"/><path d="M3 8.5v6.8c0 1.9 4 3.4 9 3.4s9-1.5 9-3.4V8.5"/><ellipse cx="12" cy="12.5" rx="3.6" ry="1.4"/></g>
    <g id="i-lugar"><path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></g>
    <g id="i-dinero"><rect x="3" y="6" width="18" height="12" rx="2.5"/><circle cx="12" cy="12" r="2.8"/><path d="M6.5 9.5v5M17.5 9.5v5"/></g>
    <g id="i-boleto"><path d="M3.5 8.5A2 2 0 015.5 6.5h13a2 2 0 012 2v1.2a2.3 2.3 0 000 4.6v1.2a2 2 0 01-2 2h-13a2 2 0 01-2-2v-1.2a2.3 2.3 0 000-4.6z"/><path d="M14 6.5v11"/></g>
    <g id="i-etiqueta"><path d="M11.2 3.5H20v8.8l-8.4 8.4a1.8 1.8 0 01-2.6 0l-6.2-6.2a1.8 1.8 0 010-2.6z"/><circle cx="16.2" cy="7.8" r="1.4"/></g>
    <g id="i-caja"><path d="M3.5 7.5l8.5-4 8.5 4v9l-8.5 4-8.5-4z"/><path d="M3.5 7.5l8.5 4 8.5-4M12 11.5v9"/></g>
    <g id="i-apreton"><path d="M8 12.5l3 3 2-2 3 3"/><path d="M3 9.5l3.5-3h4L13 8.5l3-2h5v8l-3 1.5"/><path d="M3 9.5v7l3 1.5"/></g>
    <g id="i-engrane"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v2.6M12 18.6v2.6M4.5 7.6l2.3 1.3M17.2 15.1l2.3 1.3M4.5 16.4l2.3-1.3M17.2 8.9l2.3-1.3"/></g>
    <g id="i-capas"><path d="M12 3l9 4.8-9 4.8-9-4.8z"/><path d="M3 12.4l9 4.8 9-4.8M3 16.8l9 4.8 9-4.8"/></g>
    <g id="i-grafica"><path d="M3.5 20.5h17"/><path d="M6.5 17V11M11 17V5.5M15.5 17v-8M20 17v-4"/></g>
    <g id="i-cartera"><path d="M3.5 8.5A2 2 0 015.5 6.5H18a2 2 0 012 2v9a2 2 0 01-2 2H5.5a2 2 0 01-2-2z"/><path d="M3.5 9.5h13a1.8 1.8 0 011.8 1.8v2.4a1.8 1.8 0 01-1.8 1.8h-13"/><circle cx="15.5" cy="12.5" r="1"/></g>
    <g id="i-banco"><path d="M3.5 9.5L12 4l8.5 5.5"/><path d="M5.5 9.5v8M10 9.5v8M14 9.5v8M18.5 9.5v8M3 20.5h18"/></g>
    <g id="i-check"><circle cx="12" cy="12" r="9"/><path d="M8 12.2l2.6 2.6L16.2 9"/></g>
    <g id="i-escudo"><path d="M12 3l7.5 3v5.5c0 4.6-3.1 8-7.5 9.5-4.4-1.5-7.5-4.9-7.5-9.5V6z"/><path d="M9 12.2l2.2 2.2 4-4.2"/></g>
    <g id="i-candado"><rect x="4.5" y="10.5" width="15" height="9.5" rx="2.2"/><path d="M8 10.5V8a4 4 0 118 0v2.5"/><circle cx="12" cy="15" r="1.3"/></g>
    <g id="i-ojo"><path d="M2.5 12S6 6 12 6s9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/><circle cx="12" cy="12" r="2.8"/></g>
  </defs></svg>

  <div class="pp-lang-bar">
    <a href="/es/{{slug}}" class="{{#if isEs}}active{{/if}}">ES</a>
    <a href="/en/{{slug}}" class="{{#if isEn}}active{{/if}}">EN</a>
  </div>

  {{!-- ─────────── PANEL ─────────── --}}
  <div class="pa-panel">
    <div class="pa-panel__fondo" aria-hidden="true"></div>

    <div class="pa-panel__rejilla">

      {{!-- Columna izquierda: el resumen en cifras --}}
      <aside class="pa-col-l">
        <section class="pa-box">
          <header class="pa-box__h">
            <h2 class="pa-box__t">{{data.resumen.title}}</h2>
            <p class="pa-box__s">{{data.resumen.sub}}</p>
          </header>

          <div class="pa-tiles">
            {{#each data.resumen.cifras}}
            <div class="pa-tile">
              {{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}
              <span class="pa-tile__l">{{this.label}}</span>
              <strong class="pa-tile__v">{{this.value}}</strong>
              <span class="pa-tile__n">{{this.note}}</span>
            </div>
            {{/each}}
          </div>
        </section>

        <section class="pa-box">
          <h3 class="pa-box__t pa-box__t--sm">{{data.capital.title}}</h3>
          <ul class="pa-kv">
            {{#each data.resumen.pie}}
            <li class="pa-kv__i">
              <span>{{this.label}}</span>
              {{#if this.pendiente}}<em class="pa-pend">{{../data.pendienteLabel}}</em>{{else}}<strong>{{this.value}}</strong>{{/if}}
            </li>
            {{/each}}
          </ul>
          <p class="pa-box__pie">{{data.resumen.disclaimer}}</p>
          <a href="#pa-capital" class="pa-link">{{data.capital.kicker}} →</a>
        </section>

        {{!-- El ejemplo de participación cierra la columna: es corto, es de lo
             que más se busca de un vistazo y deja la izquierda a la altura de
             las otras dos. --}}
        <section class="pa-box">
          <span class="pa-eyebrow">{{data.ejemplo.kicker}}</span>
          <h3 class="pa-box__t pa-box__t--sm">{{data.ejemplo.title}}</h3>
          <ol class="pa-pasos">
            {{#each data.ejemplo.pasos}}
            <li class="pa-paso">
              <strong class="pa-paso__v">{{this.value}}</strong>
              <span class="pa-paso__l">{{this.label}}</span>
            </li>
            {{/each}}
          </ol>
          <p class="pa-box__pie">{{data.ejemplo.pie}}</p>
        </section>
      </aside>

      {{!-- Centro: la foto del primer partido con el nombre del proyecto --}}
      <main class="pa-col-c">
        <section class="pa-foto">
          <div class="pa-foto__veil" aria-hidden="true"></div>
          <div class="pa-foto__body">
            <span class="pa-badge">{{data.hero.badge}}</span>
            {{#if logo}}
            <img class="pa-logo" src="{{logo}}" alt="{{data.hero.title}}" width="300" height="330">
            <h1 class="pa-foto__t pa-foto__t--oculto">{{data.hero.title}}</h1>
            {{else}}
            <h1 class="pa-foto__t">{{data.hero.title}}</h1>
            {{/if}}
            <p class="pa-foto__lead">{{data.hero.lead}}</p>
            <p class="pa-foto__meta">{{data.hero.meta}}</p>
          </div>
        </section>

        {{!-- Los tres partidos, juntos y del mismo tamaño: la vista es de una
             ronda de tres, no del primero. El que está cerrado enseña su sede
             y lleva a su perfil; de los otros dos todavía no hay nada que
             contar, así que se enseñan como incógnitas. --}}
        <section class="pa-box">
          <header class="pa-box__h">
            <span class="pa-eyebrow">{{data.partidos.kicker}}</span>
            <h2 class="pa-box__t">{{data.partidos.title}}</h2>
            <p class="pa-box__s">{{data.partidos.sub}}</p>
          </header>

          <div class="pa-temporada">
            {{#each partidosNav}}
            <a href="{{this.url}}" class="pa-pt{{#unless this.abierto}} pa-pt--inc{{/unless}}">
              <span class="pa-pt__n">{{this.n}}</span>
              {{#unless this.abierto}}<span class="pa-pt__q" aria-hidden="true">?</span>{{/unless}}
              <span class="pa-pt__cuando">{{this.cuando}}</span>
              <strong class="pa-pt__t">{{this.titulo}}</strong>
              <span class="pa-pt__sede">{{this.sede}}</span>
              <span class="pa-pt__lugar">{{this.lugar}}</span>
              <span class="pa-pt__cta">{{#if this.abierto}}{{../data.partidos.ctaAbierto}} →{{else}}{{../data.partidos.ctaPendiente}}{{/if}}</span>
            </a>
            {{/each}}
          </div>
          <p class="pa-box__pie">{{data.partidos.proximosPie}}</p>
        </section>
      </main>

      {{!-- Columna derecha: los tres partidos y el calendario --}}
      <aside class="pa-col-r">
        <section class="pa-box">
          <span class="pa-eyebrow">{{data.referencia.kicker}}</span>
          <h3 class="pa-box__t pa-box__t--sm">{{data.referencia.title}}</h3>
          <p class="pa-box__s">{{data.referencia.sub}}</p>
          <div class="pa-ref">
            {{#each data.referencia.cifras}}
            <div class="pa-ref__i">
              {{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}
              <strong class="pa-ref__v">{{this.value}}</strong>
              <span class="pa-ref__l">{{this.label}}</span>
            </div>
            {{/each}}
          </div>
          <div class="pa-nota pa-nota--warn pa-nota--compacta">
            <h3 class="pa-nota__t">{{data.referencia.avisoTitle}}</h3>
            <p class="pa-nota__b">{{data.referencia.avisoBody}}</p>
          </div>
        </section>

        <section class="pa-box">
          <span class="pa-eyebrow">{{data.calendario.kicker}}</span>
          <h3 class="pa-box__t pa-box__t--sm">{{data.calendario.title}}</h3>
          <ol class="pa-tl">
            {{#each data.calendario.hitos}}
            <li class="pa-tl__i">
              <span class="pa-tl__e">{{this.etapa}}</span>
              <strong class="pa-tl__c">{{this.cuando}}</strong>
              <span class="pa-tl__q">{{this.que}}</span>
            </li>
            {{/each}}
          </ol>
        </section>
      </aside>
    </div>
  </div>

  {{!-- ─────────── EL DETALLE, HACIA ABAJO ─────────── --}}

  <section class="pa-sec">
    <p class="pa-kicker">{{data.partido1.kicker}}</p>
    <h2 class="pa-title">{{data.partido1.title}}</h2>
    <p class="pa-sub">{{data.partido1.sub}}</p>
    <div class="pa-cifras">
      {{#each data.partido1.datos}}
      <div class="pa-cifra">
        {{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}
        <span class="pa-cifra__l">{{this.label}}</span>
        <strong class="pa-cifra__v pa-cifra__v--md">{{this.value}}</strong>
      </div>
      {{/each}}
    </div>
    <p class="pa-aviso">{{data.partido1.pie}}</p>
    {{#if urlPartido1}}<p style="margin-top:18px;"><a href="{{urlPartido1}}" class="pa-btn">{{data.partido1.cta}}</a></p>{{/if}}
  </section>

  <section class="pa-sec pa-sec--alt">
    <p class="pa-kicker">{{data.oportunidad.kicker}}</p>
    <h2 class="pa-title">{{data.oportunidad.title}}</h2>
    <div class="pa-grid4">
      {{#each data.oportunidad.items}}
      <div class="pa-card">
        <span class="pa-card__h">{{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}<span class="pa-card__n">{{this.n}}</span></span>
        <h3 class="pa-card__t">{{this.title}}</h3>
        <p class="pa-card__b">{{this.body}}</p>
      </div>
      {{/each}}
    </div>
  </section>

  <section class="pa-sec" id="pa-capital">
    <p class="pa-kicker">{{data.capital.kicker}}</p>
    <h2 class="pa-title">{{data.capital.title}}</h2>
    <p class="pa-sub">{{data.capital.sub}}</p>

    <div class="pa-cifras">
      {{#each data.capital.items}}
      <div class="pa-cifra">
        <span class="pa-cifra__l">{{this.label}}</span>
        {{#if this.pendiente}}
        <strong class="pa-cifra__v"><em class="pa-pend">{{../data.pendienteLabel}}</em></strong>
        {{else}}
        <strong class="pa-cifra__v">{{this.value}}</strong>
        {{/if}}
        <span class="pa-cifra__n">{{this.note}}</span>
      </div>
      {{/each}}
    </div>

    <div class="pa-total">
      <span class="pa-total__l">{{data.capital.totalLabel}}</span>
      {{#if data.capital.totalPendiente}}
      <strong class="pa-total__v"><em class="pa-pend">{{data.pendienteLabel}}</em></strong>
      {{else}}
      <strong class="pa-total__v">{{data.capital.totalValue}}</strong>
      {{/if}}
    </div>
    <p class="pa-aviso">{{data.capital.disclaimer}}</p>
  </section>

  <section class="pa-sec pa-sec--alt">
    <p class="pa-kicker">{{data.costos.kicker}}</p>
    <h2 class="pa-title">{{data.costos.title}}</h2>
    <p class="pa-sub">{{data.costos.sub}}</p>
    <ul class="pa-lineas">
      {{#each data.costos.lineas}}
      <li class="pa-linea"><span>{{this.concepto}}</span><strong>{{this.monto}}</strong></li>
      {{/each}}
    </ul>
    <div class="pa-total">
      <span class="pa-total__l">{{data.costos.totalLabel}}</span>
      <strong class="pa-total__v">{{data.costos.totalValue}}</strong>
      <span class="pa-cifra__n">{{data.costos.totalNote}}</span>
    </div>
  </section>

  <section class="pa-sec">
    <p class="pa-kicker">{{data.potencial.kicker}}</p>
    <h2 class="pa-title">{{data.potencial.title}}</h2>
    <p class="pa-sub">{{data.potencial.sub}}</p>
    <div class="pa-cols">
      {{#each data.potencial.columnas}}
      <div class="pa-col">
        <h3 class="pa-col__t">{{this.titulo}}</h3>
        {{#each this.filas}}
        <div class="pa-col__f">
          <span>{{this.label}}</span>
          {{#if this.pendiente}}<em class="pa-pend">{{../../data.pendienteLabel}}</em>{{else}}<strong>{{this.value}}</strong>{{/if}}
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
    <div class="pa-nota">
      <h3 class="pa-nota__t">{{data.potencial.cierreTitle}}</h3>
      <p class="pa-nota__b">{{data.potencial.cierreBody}}</p>
    </div>
  </section>

  <section class="pa-sec pa-sec--alt">
    <p class="pa-kicker">{{data.flujo.kicker}}</p>
    <h2 class="pa-title">{{data.flujo.title}}</h2>
    <p class="pa-sub">{{data.flujo.sub}}</p>
    <div class="pa-grid4">
      {{#each data.flujo.pasos}}
      <div class="pa-card">
        <span class="pa-card__h">{{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}<span class="pa-card__n">{{this.n}}</span></span>
        <h3 class="pa-card__t">{{this.title}}</h3>
        <p class="pa-card__b">{{this.body}}</p>
      </div>
      {{/each}}
    </div>
    <p class="pa-aviso">{{data.flujo.pie}}</p>
  </section>

  <section class="pa-sec">
    <p class="pa-kicker">{{data.participacion.kicker}}</p>
    <h2 class="pa-title">{{data.participacion.title}}</h2>
    <div class="pa-reparto">
      {{#each data.participacion.partes}}
      <div class="pa-parte">
        <strong class="pa-parte__pct">{{this.pct}}</strong>
        <span class="pa-parte__q">{{this.quien}}</span>
        <p class="pa-parte__b">{{this.body}}</p>
      </div>
      {{/each}}
    </div>
    <p class="pa-aviso">{{data.participacion.pie}}</p>
  </section>

  <section class="pa-sec">
    <p class="pa-kicker">{{data.experiencia.kicker}}</p>
    <h2 class="pa-title">{{data.experiencia.title}}</h2>
    <p class="pa-sub">{{data.experiencia.sub}}</p>
    <div class="pa-cols">
      {{#each data.experiencia.ediciones}}
      <div class="pa-col pa-col--ed">
        <strong class="pa-col__anio">{{this.anio}}</strong>
        <h3 class="pa-col__t">{{this.match}}</h3>
        <p class="pa-col__sede">{{this.sede}}</p>
      </div>
      {{/each}}
    </div>
    <p class="pa-caps">{{data.experiencia.capacidades}}</p>
    <a href="{{data.experiencia.ctaUrl}}" class="pa-btn pa-btn--ghost">{{data.experiencia.cta}}</a>
  </section>

  {{#if mediaLinks.length}}
  <section class="pa-sec pa-sec--alt">
    <p class="pa-kicker">{{data.medios.kicker}}</p>
    <h2 class="pa-title">{{data.medios.title}}</h2>
    <p class="pa-sub">{{data.medios.sub}}</p>
    <ul class="pa-medios">
      {{#each mediaLinks}}
      <li class="pa-medio">
        <a href="{{this.url}}" target="_blank" rel="noopener">
          <span class="pa-medio__f">{{this.source}}</span>
          <span class="pa-medio__t">{{this.title}}</span>
        </a>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <section class="pa-sec">
    <p class="pa-kicker">{{data.condiciones.kicker}}</p>
    <h2 class="pa-title">{{data.condiciones.title}}</h2>
    <p class="pa-sub">{{data.condiciones.sub}}</p>
    <div class="pa-grid4">
      {{#each data.condiciones.items}}
      <div class="pa-card">
        {{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}
        <h3 class="pa-card__t">{{this.title}}</h3>
        <p class="pa-card__b">{{this.body}}</p>
      </div>
      {{/each}}
    </div>
    <div class="pa-nota pa-nota--warn"><p class="pa-nota__b">{{data.condiciones.aviso}}</p></div>
  </section>

  <section class="pa-cierre">
    <div class="pa-foto__veil" aria-hidden="true"></div>
    <div class="pa-cierre__body">
      <p class="pa-kicker">{{data.contacto.kicker}}</p>
      <h2 class="pa-cierre__t">{{data.contacto.title}}</h2>
      <p class="pa-cierre__b">{{data.contacto.body}}</p>
      <a href="{{data.contacto.ctaUrl}}" class="pa-btn">{{data.contacto.cta}}</a>
    </div>
  </section>

  <style>
    /* ───────────── PANEL ───────────── */
    /* La foto del estadio va de fondo de todo el panel y los paneles flotan
       encima translúcidos: así la foto se lee como una sola pieza con el
       contenido, en vez de una portada seguida de tarjetas. */
    .pa-panel { position: relative; padding: 60px 26px 34px; }
    .pa-panel__fondo {
      position: absolute; inset: 0;
      background: url('{{heroImage}}') center/cover no-repeat;
    }
    .pa-panel__fondo::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(51,54,61,0.80) 0%, rgba(51,54,61,0.93) 55%, rgba(51,54,61,0.985) 100%);
    }
    .pa-panel__rejilla {
      position: relative; z-index: 2;
      max-width: 1560px; margin: 0 auto;
      display: grid; gap: 16px;
      grid-template-columns: minmax(280px, 330px) minmax(0, 1fr) minmax(290px, 360px);
      align-items: stretch;
    }
    /* Las tres columnas miden lo mismo y la ÚLTIMA tarjeta de cada una se
       estira hasta el fondo. Así el panel cierra parejo por arriba y por
       abajo sin repartir el sobrante entre las tarjetas, que abría huecos
       enormes, ni dejarlo suelto debajo, que las dejaba desparejas.
       El aire de la barra de idioma lo pone el panel, no una columna. */
    .pa-col-l, .pa-col-c, .pa-col-r {
      display: flex; flex-direction: column; gap: 16px; min-width: 0;
    }
    /* En cada columna hay UN elemento que absorbe el sobrante, elegido porque
       crece sin dejar hueco: en el centro, la foto —una imagen más alta se lee
       igual de bien—; a los lados, la última tarjeta, cuya lista reparte sus
       renglones. Las tarjetas de partido NO se estiran: alargarlas dejaba tres
