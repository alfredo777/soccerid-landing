{{!-- Perfil anual del proyecto 2027.

     La lámina 19 de la presentación define tres niveles:

         SOCCER iD CUP        historia de la copa      → /es/socceridcup (pública)
         PROYECTO 2027        esta página              → detrás del candado
         PERFIL DEL PARTIDO   Cruz Azul vs. Pumas…     → /socceridcup2027/partido-N

     ORDEN: el de la presentación es el de un documento que se lee entero. Un
     inversionista no lee así: quiere saber qué compra y qué le toca antes que
     en qué se gasta. Arriba va un panel con lo que se entiende de un vistazo,
     debajo la temporada en un eje, y luego las secciones en el orden en que se
     hacen las preguntas: por qué una temporada, qué me toca, cuál es el primer
     partido, a dónde va el capital, de dónde sale el retorno, cómo trabaja,
     quién lo hace, qué respaldo tiene y bajo qué condiciones. NO SE QUITÓ NADA
     de la presentación: está todo, en otro orden.

     LECTURA RÁPIDA: cada bloque abre con su rótulo y un filete, las cifras van
     en pastillas, el destino del capital en una dona con su leyenda y el
     calendario en un eje horizontal. Son los recursos de las referencias que
     dio el organizador, con la tipografía y los colores de la casa.

     Ocupa el mismo lugar que `propuesta-contenido`, así que hereda el candado,
     la barra de idioma y las variables de color de la vista.

     Las cifras que la presentación deja abiertas vienen con `pendiente` y se
     pintan como POR DEFINIR: ninguna se inventó. Cerrar una es escribir su
     valor en `contents/cup_tour_2027.json` y quitarle la marca. --}}

  {{!-- Iconografía. Un solo sprite y cada dato dice cuál le toca con su campo
       `icon`; así no hay SVG repetido por la vista. Trazo, no relleno, para
       que hereden el color. --}}
  <svg class="pa-sprite" aria-hidden="true" focusable="false"><defs>
    <g id="i-balon"><circle cx="12" cy="12" r="9"/><path d="M12 7.5l3.5 2.5-1.3 4.1H9.8L8.5 10z"/><path d="M12 3v4.5M3.6 9.6l4.9.4M20.4 9.6l-4.9.4M7.2 20.2l2.6-5.6M16.8 20.2l-2.6-5.6"/></g>
    <g id="i-reparto"><circle cx="12" cy="12" r="9"/><path d="M12 12V3a9 9 0 017.8 4.5z"/><path d="M12 12l7.8-4.5"/></g>
    <g id="i-calendario-ok"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17M9 15l2.2 2.2L15.5 13"/></g>
    <g id="i-calendario"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17"/></g>
    <g id="i-estadio"><path d="M3 8.5c0-1.9 4-3.4 9-3.4s9 1.5 9 3.4-4 3.4-9 3.4-9-1.5-9-3.4z"/><path d="M3 8.5v6.8c0 1.9 4 3.4 9 3.4s9-1.5 9-3.4V8.5"/><ellipse cx="12" cy="12.5" rx="3.6" ry="1.4"/></g>
    <g id="i-lugar"><path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></g>
    <g id="i-dinero"><rect x="3" y="6" width="18" height="12" rx="2.5"/><circle cx="12" cy="12" r="2.8"/><path d="M6.5 9.5v5M17.5 9.5v5"/></g>
    <g id="i-boleto"><path d="M3.5 8.5A2 2 0 015.5 6.5h13a2 2 0 012 2v1.2a2.3 2.3 0 000 4.6v1.2a2 2 0 01-2 2h-13a2 2 0 01-2-2v-1.2a2.3 2.3 0 000-4.6z"/><path d="M14 6.5v11"/></g>
    <g id="i-etiqueta"><path d="M11.2 3.5H20v8.8l-8.4 8.4a1.8 1.8 0 01-2.6 0l-6.2-6.2a1.8 1.8 0 010-2.6z"/><circle cx="16.2" cy="7.8" r="1.4"/></g>
    <g id="i-caja"><path d="M3.5 7.5l8.5-4 8.5 4v9l-8.5 4-8.5-4z"/><path d="M3.5 7.5l8.5 4 8.5-4M12 11.5v9"/></g>
    <g id="i-apreton"><path d="M8 12.5l3 3 2-2 3 3"/><path d="M3 9.5l3.5-3h4L13 8.5l3-2h5v8l-3 1.5"/><path d="M3 9.5v7l3 1.5"/></g>
    <g id="i-engrane"><circle cx="12" cy="12" r="3.4"/><path d="M12 2.6v2.4M12 19v2.4M5.4 5.4l1.7 1.7M16.9 16.9l1.7 1.7M2.6 12h2.4M19 12h2.4M5.4 18.6l1.7-1.7M16.9 7.1l1.7-1.7"/></g>
    <g id="i-capas"><path d="M12 3l9 4.8-9 4.8-9-4.8z"/><path d="M3 12.4l9 4.8 9-4.8M3 16.8l9 4.8 9-4.8"/></g>
    <g id="i-grafica"><path d="M3.5 20.5h17"/><path d="M6.5 17V11M11 17V5.5M15.5 17v-8M20 17v-4"/></g>
    <g id="i-cartera"><path d="M3.5 8.5A2 2 0 015.5 6.5H18a2 2 0 012 2v9a2 2 0 01-2 2H5.5a2 2 0 01-2-2z"/><path d="M3.5 9.5h13a1.8 1.8 0 011.8 1.8v2.4a1.8 1.8 0 01-1.8 1.8h-13"/><circle cx="15.5" cy="12.5" r="1"/></g>
    <g id="i-banco"><path d="M3.5 9.5L12 4l8.5 5.5"/><path d="M5.5 9.5v8M10 9.5v8M14 9.5v8M18.5 9.5v8M3 20.5h18"/></g>
    <g id="i-check"><circle cx="12" cy="12" r="9"/><path d="M8 12.2l2.6 2.6L16.2 9"/></g>
    <g id="i-escudo"><path d="M12 3l7.5 3v5.5c0 4.6-3.1 8-7.5 9.5-4.4-1.5-7.5-4.9-7.5-9.5V6z"/><path d="M9 12.2l2.2 2.2 4-4.2"/></g>
    <g id="i-candado"><rect x="4.5" y="10.5" width="15" height="9.5" rx="2.2"/><path d="M8 10.5V8a4 4 0 118 0v2.5"/><circle cx="12" cy="15" r="1.3"/></g>
    <g id="i-ojo"><path d="M2.5 12S6 6 12 6s9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/><circle cx="12" cy="12" r="2.8"/></g>
  </defs></svg>

  <div class="pp-lang-bar">
    <a href="/es/{{slug}}" class="{{#if isEs}}active{{/if}}">ES</a>
    <a href="/en/{{slug}}" class="{{#if isEn}}active{{/if}}">EN</a>
  </div>

  {{!-- ═══════════ PANEL: lo que se entiende sin hacer scroll ═══════════ --}}
  <div class="pa-panel">
    <div class="pa-panel__fondo" aria-hidden="true"></div>

    <div class="pa-panel__col">

      {{!-- La marca sobre la foto --}}
      <section class="pa-foto">
        <div class="pa-foto__veil" aria-hidden="true"></div>
        <div class="pa-foto__body">
          <span class="pa-badge">{{data.hero.badge}}</span>
          {{#if logo}}
          <img class="pa-logo" src="{{logo}}" alt="{{data.hero.title}}" width="190" height="209">
          <h1 class="pa-foto__t pa-foto__t--oculto">{{data.hero.title}}</h1>
          {{else}}
          <h1 class="pa-foto__t">{{data.hero.title}}</h1>
          {{/if}}
          <p class="pa-foto__lead">{{data.hero.lead}}</p>
          <p class="pa-foto__meta">{{data.hero.meta}}</p>
        </div>
      </section>

      {{!-- La temporada en cifras --}}
      <section class="pa-box">
        <div class="pa-box__h">
          <div>
            <p class="pa-rot"><span>{{data.resumen.kicker}}</span></p>
            <h2 class="pa-box__t">{{data.resumen.title}}</h2>
          </div>
          <p class="pa-box__s">{{data.resumen.sub}}</p>
        </div>
        <div class="pa-tiles">
          {{#each data.resumen.cifras}}
          <div class="pa-tile">
            {{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}
            <span class="pa-tile__l">{{this.label}}</span>
            <strong class="pa-tile__v">{{this.value}}</strong>
            <span class="pa-tile__n">{{this.note}}</span>
          </div>
          {{/each}}
        </div>
        <p class="pa-box__pie">{{data.resumen.disclaimer}}</p>
      </section>

      {{!-- Los tres partidos: la vista es de una ronda de tres, no del primero.
           El cerrado enseña su sede y lleva a su perfil; de los otros dos
           todavía no hay nada que contar. --}}
      <section class="pa-box">
        <div class="pa-box__h">
          <div>
            <p class="pa-rot"><span>{{data.partidos.kicker}}</span></p>
            <h2 class="pa-box__t">{{data.partidos.title}}</h2>
          </div>
          <p class="pa-box__s">{{data.partidos.sub}}</p>
        </div>
        <div class="pa-temporada">
          {{#each partidosNav}}
          <a href="{{this.url}}" class="pa-pt{{#unless this.abierto}} pa-pt--inc{{/unless}}">
            <span class="pa-pt__n">{{this.n}}</span>
            {{#unless this.abierto}}<span class="pa-pt__q" aria-hidden="true">?</span>{{/unless}}
            <span class="pa-pt__cuando">{{this.cuando}}</span>
            <strong class="pa-pt__t">{{this.titulo}}</strong>
            <span class="pa-pt__sede">{{this.sede}}</span>
            <span class="pa-pt__lugar">{{this.lugar}}</span>
            <span class="pa-pt__cta">{{#if this.abierto}}{{../data.partidos.ctaAbierto}} →{{else}}{{../data.partidos.ctaPendiente}}{{/if}}</span>
          </a>
          {{/each}}
        </div>
        <p class="pa-box__pie">{{data.partidos.proximosPie}}</p>
      </section>

      {{!-- El capital que se pide --}}
      <section class="pa-box">
        <div class="pa-box__h">
          <div>
            <p class="pa-rot"><span>{{data.capital.kicker}}</span></p>
            <h2 class="pa-box__t">{{data.capital.title}}</h2>
          </div>
          <p class="pa-box__s">{{data.capital.sub}}</p>
        </div>
        <ul class="pa-kv">
          {{#each data.capital.items}}
          <li class="pa-kv__i">
            <span>{{this.label}}</span>
            {{#if this.pendiente}}<em class="pa-pend">{{../data.pendienteLabel}}</em>{{else}}<strong>{{this.value}}</strong>{{/if}}
            <span class="pa-kv__n">{{this.note}}</span>
          </li>
          {{/each}}
        </ul>
        {{!-- La composición del capital como barra apilada: el tramo del partido 1
             sólido, y los dos que faltan punteados, para que se vea que el objetivo
             es la suma de tres y que dos están por cerrar. Los tres tramos miden lo
             mismo a propósito: sin cifras no hay escala que respetar. --}}
        <div class="pa-apilada" aria-hidden="true">
          <span class="pa-apilada__l">{{data.capital.barraLabel}}</span>
          <div class="pa-apilada__barra">
            {{#each data.capital.items}}
            <span class="pa-apilada__t{{#if this.pendiente}} pa-apilada__t--pend{{/if}}">
              <span class="pa-apilada__n">{{this.label}}</span>
              {{#if this.pendiente}}<span class="pa-apilada__v pa-apilada__v--pend">?</span>{{else}}<span class="pa-apilada__v">{{this.value}}</span>{{/if}}
            </span>
            {{/each}}
          </div>
        </div>
        <div class="pa-total">
          <span class="pa-total__l">{{data.capital.totalLabel}}</span>
          {{#if data.capital.totalPendiente}}
          <strong class="pa-total__v"><em class="pa-pend">{{data.pendienteLabel}}</em></strong>
          {{else}}
          <strong class="pa-total__v">{{data.capital.totalValue}}</strong>
          {{/if}}
        </div>
        <p class="pa-box__pie">{{data.capital.disclaimer}}</p>
      </section>

      {{!-- Lo que le toca a quien entra --}}
      <section class="pa-box">
        <div class="pa-box__h">
          <div>
            <p class="pa-rot"><span>{{data.ejemplo.kicker}}</span></p>
            <h2 class="pa-box__t">{{data.ejemplo.title}}</h2>
          </div>
          <p class="pa-box__s">{{data.ejemplo.pie}}</p>
        </div>
        {{!-- Cada paso es una barra con su porción llena: así el 10 % se ve
             chico, el 70 % grande y el 7 % resultado de los dos. --}}
        <ol class="pa-pasos">
          {{#each graficos.ejemplo}}
          <li class="pa-paso">
            <span class="pa-paso__cab">
              <strong class="pa-paso__v">{{this.value}}</strong>
              <span class="pa-paso__l">{{this.label}}</span>
            </span>
            <span class="pa-barra" aria-hidden="true"><span class="pa-barra__f pa-anima" style="--w: {{this.pct}}%"></span></span>
          </li>
          {{/each}}
        </ol>
      </section>

      {{!-- La referencia de taquilla del primer partido --}}
      <section class="pa-box">
        <div class="pa-box__h">
          <div>
            <p class="pa-rot"><span>{{data.referencia.kicker}}</span></p>
            <h2 class="pa-box__t">{{data.referencia.title}}</h2>
          </div>
          <p class="pa-box__s">{{data.referencia.sub}}</p>
        </div>
        {{!-- La referencia como ecuación —boletos × ticket = taquilla— y, al
             lado, cuántos boletos cubren el costo del partido 1: 1.0 M entre
             100 son 10,000, el 46 % del aforo. Es el dato que un inversionista
             quiere ver y sale de las mismas cifras. --}}
        <div class="pa-ref">
          {{#each data.referencia.cifras}}
          <div class="pa-ref__i">
            {{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}
            <strong class="pa-ref__v">{{this.value}}</strong>
            <span class="pa-ref__l">{{this.label}}</span>
          </div>
          {{#unless @last}}<span class="pa-ref__op" aria-hidden="true">{{#if @first}}×{{else}}={{/if}}</span>{{/unless}}
          {{/each}}
        </div>

        {{#if graficos.equilibrio}}
        <div class="pa-medidor">
          <div class="pa-medidor__cab">
            <span class="pa-medidor__l">{{data.referencia.equilibrioLabel}}</span>
            <span class="pa-medidor__cifras">
              <strong>{{graficos.equilibrio.boletos}}</strong> {{data.referencia.equilibrioBoletos}}
              <em>·</em>
              <strong>{{graficos.equilibrio.pct}}%</strong> {{data.referencia.equilibrioAforo}}
            </span>
          </div>
          <span class="pa-barra pa-barra--alta" aria-hidden="true">
            <span class="pa-barra__f pa-anima" style="--w: {{graficos.equilibrio.pct}}%"></span>
            <span class="pa-barra__marca" style="left: {{graficos.equilibrio.pct}}%"></span>
          </span>
          <div class="pa-medidor__pie"><span>0</span><span>{{graficos.taquilla.boletos}} {{data.referencia.equilibrioBoletos}}</span></div>
          <p class="pa-box__pie">{{data.referencia.equilibrioNota}}</p>
        </div>
        {{/if}}
        <div class="pa-nota pa-nota--warn pa-nota--compacta">
          <h3 class="pa-nota__t">{{data.referencia.avisoTitle}}</h3>
          <p class="pa-nota__b">{{data.referencia.avisoBody}}</p>
        </div>
      </section>
    </div>
  </div>

  {{!-- ═══════════ LA TEMPORADA EN UN EJE ═══════════ --}}
  <section class="pa-ruta">
    <div class="pa-ruta__caja">
      <p class="pa-rot"><span>{{data.calendario.kicker}}</span></p>
      <h2 class="pa-title pa-title--sm">{{data.calendario.title}}</h2>

      <ol class="pa-eje">
        {{#each data.calendario.hitos}}
        <li class="pa-eje__i">
          <span class="pa-eje__e">{{this.etapa}}</span>
          <span class="pa-eje__q">{{this.que}}</span>
          <span class="pa-eje__punto" aria-hidden="true"></span>
          <strong class="pa-eje__c">{{this.cuando}}</strong>
        </li>
        {{/each}}
      </ol>
      {{!-- La regla del año: cada hito ocupa los meses en los que cae, así se
           ve de un vistazo que marzo, el verano y el otoño tienen partido y
           diciembre, cierre. --}}
      <div class="pa-regla">
        <span class="pa-regla__l">{{data.calendario.reglaLabel}}</span>
        <div class="pa-regla__meses" aria-hidden="true">
          {{#each data.calendario.mesesCortos}}<span class="pa-regla__m{{#if @first}} pa-regla__m--anio{{/if}}">{{this}}</span>{{/each}}
        </div>
        <div class="pa-regla__pista">
          {{#each graficos.regla}}
          <span class="pa-regla__h pa-anima" style="left: {{this.left}}%; width: {{this.width}}%" title="{{this.etapa}} · {{this.cuando}}"><span>{{this.etapa}}</span></span>
          {{/each}}
        </div>
      </div>
      <p class="pa-aviso">{{data.calendario.pie}}</p>
    </div>
  </section>

  {{!-- ═══════════ POR QUÉ UNA TEMPORADA ═══════════ --}}
  <section class="pa-sec">
    <p class="pa-rot"><span>{{data.oportunidad.kicker}}</span></p>
    <h2 class="pa-title">{{data.oportunidad.title}}</h2>
    <div class="pa-grid4">
      {{#each data.oportunidad.items}}
      <div class="pa-card">
        <span class="pa-card__h">{{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}<span class="pa-card__n">{{this.n}}</span></span>
        <h3 class="pa-card__t">{{this.title}}</h3>
        <p class="pa-card__b">{{this.body}}</p>
      </div>
      {{/each}}
    </div>
  </section>

  {{!-- ═══════════ TU PARTICIPACIÓN ═══════════ --}}
  <section class="pa-sec pa-sec--alt">
    <p class="pa-rot"><span>{{data.participacion.kicker}}</span></p>
    <h2 class="pa-title">{{data.participacion.title}}</h2>

    {{!-- El reparto como una sola barra partida: la proporción se ve antes de
         leerla. --}}
    <div class="pa-partida" aria-hidden="true">
      {{#each graficos.reparto}}
      <span class="pa-partida__t pa-anima" style="--w: {{this.pct}}%"><strong>{{this.pct}}%</strong><span>{{this.quien}}</span></span>
      {{/each}}
    </div>

    <div class="pa-reparto">
      {{#each data.participacion.partes}}
      <div class="pa-parte">
        <strong class="pa-parte__pct">{{this.pct}}</strong>
        <span class="pa-parte__q">{{this.quien}}</span>
        <p class="pa-parte__b">{{this.body}}</p>
      </div>
      {{/each}}
    </div>
    <p class="pa-aviso">{{data.participacion.pie}}</p>
  </section>

  {{!-- ═══════════ EL PRIMER PARTIDO ═══════════ --}}
  <section class="pa-sec">
    <p class="pa-rot"><span>{{data.partido1.kicker}}</span></p>
    <h2 class="pa-title">{{data.partido1.title}}</h2>
    <p class="pa-sub">{{data.partido1.sub}}</p>
    <div class="pa-cifras">
      {{#each data.partido1.datos}}
      <div class="pa-cifra">
        {{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}
        <span class="pa-cifra__l">{{this.label}}</span>
        <strong class="pa-cifra__v pa-cifra__v--md">{{this.value}}</strong>
      </div>
      {{/each}}
    </div>
    <p class="pa-aviso">{{data.partido1.pie}}</p>
    {{#if urlPartido1}}<p class="pa-cta"><a href="{{urlPartido1}}" class="pa-btn">{{data.partido1.cta}}</a></p>{{/if}}
  </section>

  {{!-- ═══════════ A DÓNDE VA EL CAPITAL ═══════════ --}}
  <section class="pa-sec pa-sec--alt">
    <p class="pa-rot"><span>{{data.costos.kicker}}</span></p>
    <h2 class="pa-title">{{data.costos.title}}</h2>
    <p class="pa-sub">{{data.costos.sub}}</p>

    <div class="pa-destino">
      {{#if donut}}
      <figure class="pa-donut">
        <svg class="pa-anima" viewBox="0 0 160 160" role="img" aria-label="{{data.costos.title}}">
          <g transform="rotate(-90 80 80)">
            <circle class="pa-donut__bg" cx="80" cy="80" r="60"></circle>
            {{#each donut.segmentos}}
            <circle class="pa-donut__s" cx="80" cy="80" r="60" stroke="{{this.color}}"
                    stroke-dasharray="{{this.dash}}" stroke-dashoffset="{{this.offset}}"></circle>
            {{/each}}
          </g>
        </svg>
        <figcaption>
          <strong>{{data.costos.totalValue}}</strong>
          <span>{{data.costos.totalLabel}}</span>
        </figcaption>
      </figure>

      <ul class="pa-leyenda">
        {{#each donut.segmentos}}
        <li class="pa-leyenda__i">
          <span class="pa-leyenda__p" style="background: {{this.color}}"></span>
          <span class="pa-leyenda__c">{{this.concepto}}</span>
          <strong class="pa-leyenda__m">{{this.monto}}</strong>
          <span class="pa-leyenda__pct">{{this.pct}}%</span>
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </div>
    <p class="pa-aviso">{{data.costos.totalNote}}</p>
  </section>

  {{!-- ═══════════ DE DÓNDE SALE EL RETORNO ═══════════ --}}
  <section class="pa-sec">
    <p class="pa-rot"><span>{{data.potencial.kicker}}</span></p>
    <h2 class="pa-title">{{data.potencial.title}}</h2>
    <p class="pa-sub">{{data.potencial.sub}}</p>

    {{#if graficos.potencial}}
    {{!-- Costo contra taquilla a lleno del partido 1, en la misma escala: es
         lo único con cifra, y es lo que sostiene el "potencial". Los otros dos
         partidos van punteados hasta que tengan números. --}}
    <div class="pa-grafica">
      <div class="pa-grafica__cab">
        <span class="pa-grafica__l">{{data.potencial.graficaLabel}}</span>
        <strong class="pa-grafica__veces">{{graficos.potencial.veces}}</strong>
      </div>
      <div class="pa-grafica__filas">
        {{#each graficos.potencial.barras}}
        <div class="pa-grafica__fila">
          <span class="pa-grafica__n">{{this.label}}</span>
          <span class="pa-barra pa-barra--alta"><span class="pa-barra__f pa-anima{{#if @last}} pa-barra__f--acento{{/if}}" style="--w: {{this.pct}}%"></span></span>
          <strong class="pa-grafica__v">{{this.valor}}</strong>
        </div>
        {{/each}}
        {{#each data.potencial.columnas}}
        {{#unless @first}}
        <div class="pa-grafica__fila pa-grafica__fila--pend">
          <span class="pa-grafica__n">{{this.titulo}}</span>
          <span class="pa-barra pa-barra--alta pa-barra--pend"></span>
          <em class="pa-pend">{{../data.pendienteLabel}}</em>
        </div>
        {{/unless}}
        {{/each}}
      </div>
      <p class="pa-box__pie">{{data.potencial.graficaNota}}</p>
    </div>
    {{/if}}

    <div class="pa-cols">
      {{#each data.potencial.columnas}}
      <div class="pa-col">
        <h3 class="pa-col__t">{{this.titulo}}</h3>
        {{#each this.filas}}
        <div class="pa-col__f">
          <span>{{this.label}}</span>
          {{#if this.pendiente}}<em class="pa-pend">{{../../data.pendienteLabel}}</em>{{else}}<strong>{{this.value}}</strong>{{/if}}
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
    <div class="pa-nota">
      <h3 class="pa-nota__t">{{data.potencial.cierreTitle}}</h3>
      <p class="pa-nota__b">{{data.potencial.cierreBody}}</p>
    </div>
  </section>

  {{!-- ═══════════ CÓMO TRABAJA EL CAPITAL ═══════════ --}}
  <section class="pa-sec pa-sec--alt">
    <p class="pa-rot"><span>{{data.flujo.kicker}}</span></p>
    <h2 class="pa-title">{{data.flujo.title}}</h2>
    <p class="pa-sub">{{data.flujo.sub}}</p>
    {{!-- Es una secuencia: se dibuja como una, con una flecha entre paso y paso. --}}
    <ol class="pa-proceso">
      {{#each data.flujo.pasos}}
      <li class="pa-proceso__p">
        <span class="pa-card__h">{{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}<span class="pa-card__n">{{this.n}}</span></span>
        <h3 class="pa-card__t">{{this.title}}</h3>
        <p class="pa-card__b">{{this.body}}</p>
        {{#unless @last}}<span class="pa-proceso__flecha" aria-hidden="true"></span>{{/unless}}
      </li>
      {{/each}}
    </ol>
    <p class="pa-aviso">{{data.flujo.pie}}</p>
  </section>

  {{!-- ═══════════ EXPERIENCIA ═══════════ --}}
  <section class="pa-sec">
    <p class="pa-rot"><span>{{data.experiencia.kicker}}</span></p>
    <h2 class="pa-title">{{data.experiencia.title}}</h2>
    <p class="pa-sub">{{data.experiencia.sub}}</p>
    <div class="pa-cols">
      {{#each data.experiencia.ediciones}}
      <div class="pa-col pa-col--ed">
        <strong class="pa-col__anio">{{this.anio}}</strong>
        <h3 class="pa-col__t">{{this.match}}</h3>
        <p class="pa-col__sede">{{this.sede}}</p>
      </div>
      {{/each}}
    </div>
    <p class="pa-caps">{{data.experiencia.capacidades}}</p>
    <a href="{{data.experiencia.ctaUrl}}" class="pa-btn pa-btn--ghost">{{data.experiencia.cta}}</a>
  </section>

  {{!-- ═══════════ RESPALDO EN MEDIOS ═══════════ --}}
  {{#if mediaLinks.length}}
  <section class="pa-sec pa-sec--alt">
    <p class="pa-rot"><span>{{data.medios.kicker}}</span></p>
    <h2 class="pa-title">{{data.medios.title}}</h2>
    <p class="pa-sub">{{data.medios.sub}}</p>
    <ul class="pa-medios">
      {{#each mediaLinks}}
      <li class="pa-medio">
        <a href="{{this.url}}" target="_blank" rel="noopener">
          <span class="pa-medio__f">{{this.source}}</span>
          <span class="pa-medio__t">{{this.title}}</span>
        </a>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{!-- ═══════════ CONDICIONES ═══════════ --}}
  <section class="pa-sec">
    <p class="pa-rot"><span>{{data.condiciones.kicker}}</span></p>
    <h2 class="pa-title">{{data.condiciones.title}}</h2>
    <p class="pa-sub">{{data.condiciones.sub}}</p>
    <div class="pa-grid4">
      {{#each data.condiciones.items}}
      <div class="pa-card">
        {{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}
        <h3 class="pa-card__t">{{this.title}}</h3>
        <p class="pa-card__b">{{this.body}}</p>
      </div>
      {{/each}}
    </div>
    <div class="pa-nota pa-nota--warn"><p class="pa-nota__b">{{data.condiciones.aviso}}</p></div>
  </section>

  {{!-- ═══════════ CONTACTO ═══════════ --}}
  <section class="pa-cierre">
    <div class="pa-foto__veil" aria-hidden="true"></div>
    <div class="pa-cierre__body">
      <p class="pa-rot pa-rot--centro"><span>{{data.contacto.kicker}}</span></p>
      <h2 class="pa-cierre__t">{{data.contacto.title}}</h2>
      <p class="pa-cierre__b">{{data.contacto.body}}</p>
      <a href="{{data.contacto.ctaUrl}}" class="pa-btn">{{data.contacto.cta}}</a>
    </div>
  </section>

  <style>
    /* ───────────── RÓTULO DE BLOQUE ─────────────
       Cada bloque abre igual: etiqueta corta y un filete hasta el borde. Es lo
       que deja escanear la página sin leerla, y viene de las referencias que
       dio el organizador. */
    .pa-rot {
      display: flex; align-items: center; gap: 14px;
      margin-bottom: 14px;
      font-size: 11px; font-weight: 800; letter-spacing: 2.2px;
      color: var(--pp-accent);
    }
    .pa-rot::after {
      content: ''; flex: 1 1 auto; height: 1px;
      background: rgba(255,255,255,0.16);
    }
    .pa-rot--centro { justify-content: center; }
    .pa-rot--centro::after { display: none; }

    /* ───────────── PANEL ───────────── */
    /* La foto del estadio va de fondo de todo el panel y los paneles flotan
       encima translúcidos: así la foto se lee como una sola pieza con el
       contenido, en vez de una portada seguida de tarjetas. */
    .pa-panel { position: relative; padding: 60px 26px 34px; }
    .pa-panel__fondo {
      position: absolute; inset: 0;
      background: url('{{heroImage}}') center/cover no-repeat;
    }
    .pa-panel__fondo::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(51,54,61,0.80) 0%, rgba(51,54,61,0.93) 55%, rgba(51,54,61,0.985) 100%);
    }
    /* Una sola columna: cada bloque ocupa todo el ancho y reparte su
       contenido en hileras. Se lee de arriba abajo, sin saltar de columna,
       que era lo que costaba. */
    .pa-panel__col {
      position: relative; z-index: 2;
      max-width: 1240px; margin: 0 auto;
      display: flex; flex-direction: column; gap: 16px;
    }
    /* El encabezado de cada bloque usa el ancho: el título a la izquierda y la
       bajada a su derecha, en vez de una debajo de la otra. */
    .pa-box__h {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 10px 40px; align-items: end; margin-bottom: 20px;
    }

    .pa-box {
      padding: 22px; border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(var(--tour-card-rgb, 56,60,68), 0.84);
      -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
    }
    .pa-box__t { font-size: 23px; font-weight: 900; line-height: 1.15; }
    .pa-box__t--sm { font-size: 18px; }
    .pa-box__s { font-size: 13.5px; line-height: 1.55; color: #D2D5DC; margin: 8px 0 18px; }
    .pa-box__pie { font-size: 12.5px; line-height: 1.5; color: #D2D5DC; opacity: .75; margin-top: 14px; }

    .pa-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pa-tile {
      padding: 14px 16px; border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.055);
    }
    .pa-tile__l { display: block; font-size: 9.5px; font-weight: 800; letter-spacing: 1.5px; color: var(--tour-rotulo, rgba(255,255,255,0.45)); }
    .pa-tile__v { display: block; font-size: 27px; font-weight: 900; line-height: 1.1; margin: 5px 0 4px; color: #FFFFFF; }
    .pa-tile__n { display: block; font-size: 12px; line-height: 1.45; color: #D2D5DC; }

    .pa-kv { list-style: none; padding: 0; margin: 0 0 14px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pa-kv__i {
      display: flex; flex-direction: column; gap: 7px;
      padding: 16px 18px; border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.055);
      font-size: 10px; font-weight: 800; letter-spacing: 1.5px;
      color: var(--tour-rotulo, rgba(255,255,255,0.45));
    }
    .pa-kv__i strong { font-size: 22px; font-weight: 900; letter-spacing: 0; color: #FFFFFF; }
    .pa-kv__i .pa-pend { align-self: flex-start; }
    .pa-kv__n {
      font-size: 12px; font-weight: 400; letter-spacing: 0;
      color: #D2D5DC; opacity: .8;
    }

    .pa-pasos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pa-paso {
      display: flex; align-items: baseline; gap: 14px;
      padding: 18px 20px; border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.055);
    }
    .pa-paso__v { font-size: 30px; font-weight: 900; color: #FFFFFF; flex-shrink: 0; min-width: 62px; }
    .pa-paso__l { font-size: 10.5px; font-weight: 800; letter-spacing: 1.2px; line-height: 1.35; color: var(--tour-rotulo, rgba(255,255,255,0.45)); }

    /* Centro */
    .pa-foto {
      position: relative; min-height: 440px; border-radius: 22px; overflow: hidden;
      display: flex; align-items: flex-end; justify-content: center; text-align: center;
      padding: 52px 28px 40px;
      background: url('{{heroImage}}') center/cover no-repeat;
      border: 1px solid rgba(255,255,255,0.12);
    }
    .pa-foto__veil {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(20,21,25,0.3) 0%, rgba(28,30,35,0.62) 52%, rgba(44,47,53,0.94) 100%);
    }
    .pa-foto__body { position: relative; z-index: 2; max-width: 620px; }
    .pa-foto__t {
      font-size: clamp(30px, 4.2vw, 52px); font-weight: 900; line-height: 1.03;
      margin: 14px 0 14px;
    }
    /* El logo dice el nombre; el h1 se queda para lectores de pantalla y para
       que la página no pierda su encabezado. */
    .pa-foto__t--oculto {
      position: absolute; width: 1px; height: 1px; margin: -1px;
      padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    .pa-logo {
      display: block; width: clamp(120px, 13vw, 190px); height: auto;
      margin: 16px auto 18px;
      /* El aro y el letrero son negros y sobre el gris se apagarían. */
      filter: drop-shadow(0 0 26px rgba(255,255,255,0.3)) drop-shadow(0 10px 26px rgba(0,0,0,0.5));
    }
    .pa-foto__lead { font-size: 18px; line-height: 1.45; color: rgba(255,255,255,0.9); }
    .pa-foto__meta { font-size: 12.5px; letter-spacing: 1.3px; color: rgba(255,255,255,0.68); margin-top: 9px; }

    /* Los tres partidos, del mismo tamaño. El cerrado enseña sede y ciudad;
       los dos que se negocian, una incógnita y el borde punteado, para que se
       lean como un hueco por llenar y no como una ficha a medias. */
    .pa-temporada { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pa-pt {
      display: block; padding: 20px 18px; border-radius: 16px;
      text-decoration: none; color: inherit;
      border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.055);
      transition: border-color .2s, background .2s;
    }
    .pa-pt:hover { border-color: rgba(var(--pp-accent-rgb), 0.55); background: rgba(var(--pp-accent-rgb), 0.08); }
    .pa-pt--inc { border-style: dashed; border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.025); }
    .pa-pt__n { display: block; font-size: 11px; font-weight: 800; letter-spacing: 1.6px; color: var(--tour-rotulo, rgba(255,255,255,0.45)); }
    .pa-pt__q { display: block; font-size: 34px; font-weight: 900; line-height: 1; color: rgba(255,255,255,0.3); margin-top: 10px; }
    .pa-pt__cuando { display: block; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: var(--tour-rotulo, rgba(255,255,255,0.45)); margin-top: 12px; }
    .pa-pt__t { display: block; font-size: 19px; font-weight: 900; line-height: 1.18; margin: 7px 0 7px; }
    .pa-pt__sede { display: block; font-size: 13.5px; color: #D2D5DC; }
    .pa-pt__lugar { display: block; font-size: 12.5px; color: #D2D5DC; opacity: .7; }
    .pa-pt__cta {
      display: block; margin-top: 16px;
      font-size: 10.5px; font-weight: 800; letter-spacing: 1.2px; color: var(--pp-accent);
    }
    .pa-pt--inc .pa-pt__cta { color: rgba(255,255,255,0.5); }

    .pa-ref { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pa-ref__i {
      padding: 16px; border-radius: 14px; text-align: center;
      border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.055);
    }
    .pa-ref__v { display: block; font-size: 28px; font-weight: 900; color: #FFFFFF; line-height: 1.1; }
    .pa-ref__l { display: block; font-size: 9.5px; font-weight: 800; letter-spacing: 1.4px; color: var(--tour-rotulo, rgba(255,255,255,0.45)); margin-top: 7px; }

    /* ───────────── LA TEMPORADA EN UN EJE ─────────────
       El calendario como línea con su eje y sus fechas debajo: se entiende de
       un golpe de vista, que es para lo que sirve. */
    /* Mismo ancho que el panel y que las secciones: un solo borde en toda la página. */
    .pa-ruta { padding: 0 26px; margin: -14px auto 0; max-width: 1292px; }
    .pa-ruta__caja {
      padding: 26px 28px 24px; border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.12);
      background: var(--tour-card, rgba(255,255,255,0.04));
    }
    .pa-eje {
      list-style: none; padding: 0; margin: 22px 0 0;
      display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0;
    }
    .pa-eje__i { position: relative; padding: 0 14px 0 0; display: flex; flex-direction: column; }
    .pa-eje__e {
      font-size: 10px; font-weight: 800; letter-spacing: 1.6px;
      color: var(--tour-rotulo, rgba(255,255,255,0.45));
    }
    .pa-eje__q { font-size: 13px; line-height: 1.45; color: #D2D5DC; margin: 7px 0 16px; flex: 1 1 auto; }
    .pa-eje__punto {
      position: relative; display: block; height: 2px;
      background: rgba(255,255,255,0.18);
    }
    .pa-eje__punto::before {
      content: ''; position: absolute; left: 0; top: 50%;
      width: 11px; height: 11px; border-radius: 50%;
      transform: translateY(-50%);
      background: var(--tour-azul, #6B93EC);
      box-shadow: 0 0 0 4px rgba(107,147,236,0.22);
    }
    .pa-eje__i:last-child .pa-eje__punto { background: linear-gradient(90deg, rgba(255,255,255,0.18), rgba(255,255,255,0)); }
    .pa-eje__c { display: block; font-size: 14.5px; font-weight: 800; margin-top: 14px; }

    /* ───────────── GRÁFICAS ─────────────
       Barras con la porción llena como variable CSS (--w), para que el servidor
       mande el número y el estilo lo dibuje. */
    .pa-barra {
      position: relative; display: block; height: 10px; border-radius: 999px;
      background: rgba(255,255,255,0.08); overflow: hidden;
    }
    .pa-barra--alta { height: 16px; }
    .pa-barra__f {
      display: block; height: 100%; width: var(--w, 0%); border-radius: inherit;
      background: var(--tour-azul, #6B93EC);
      transform-origin: left center;
    }
    .pa-barra__f--acento { background: var(--pp-accent); }
    .pa-barra--pend { background: transparent; border: 1px dashed rgba(255,255,255,0.22); overflow: visible; }
    .pa-barra__marca {
      position: absolute; top: -4px; bottom: -4px; width: 2px;
      background: #FFFFFF; transform: translateX(-1px);
    }

    /* Tu proporción: cada paso con su barra. */
    .pa-paso { display: block; }
    .pa-paso__cab { display: flex; align-items: baseline; gap: 14px; margin-bottom: 12px; }

    /* Capital: barra apilada. */
    .pa-apilada { margin: 4px 0 14px; }
    .pa-apilada__l { display: block; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: var(--tour-rotulo, rgba(255,255,255,0.45)); margin-bottom: 10px; }
    .pa-apilada__barra { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; }
    .pa-apilada__t {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      min-height: 44px; padding: 8px 14px; border-radius: 10px;
      background: var(--tour-azul, #6B93EC); color: var(--tour-tinta, #1C1E23);
    }
    .pa-apilada__t:first-child { border-radius: 999px 10px 10px 999px; }
    .pa-apilada__t:last-child { border-radius: 10px 999px 999px 10px; }
    .pa-apilada__t--pend {
      background: transparent; border: 1px dashed rgba(255,255,255,0.25);
      color: var(--tour-rotulo, rgba(255,255,255,0.45));
    }
    .pa-apilada__n { font-size: 10px; font-weight: 800; letter-spacing: 1.3px; }
    .pa-apilada__v { font-size: 14px; font-weight: 900; }
    .pa-apilada__v--pend { font-size: 20px; opacity: .6; }

    /* Referencia: la ecuación y el medidor. */
    .pa-ref { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr); align-items: stretch; }
    .pa-ref__op {
      align-self: center; font-size: 30px; font-weight: 300; line-height: 1;
      color: var(--tour-rotulo, rgba(255,255,255,0.45));
    }
    .pa-medidor { margin-top: 18px; padding: 18px 20px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.04); }
    .pa-medidor__cab { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 12px; }
    .pa-medidor__l { font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: var(--tour-rotulo, rgba(255,255,255,0.45)); }
    .pa-medidor__cifras { font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: var(--tour-rotulo, rgba(255,255,255,0.45)); }
    .pa-medidor__cifras strong { font-size: 20px; font-weight: 900; letter-spacing: 0; color: #FFFFFF; margin-right: 4px; }
    .pa-medidor__cifras em { font-style: normal; margin: 0 10px; opacity: .5; }
    .pa-medidor__pie { display: flex; justify-content: space-between; margin-top: 8px; font-size: 10.5px; font-weight: 800; letter-spacing: 1.2px; color: var(--tour-rotulo, rgba(255,255,255,0.45)); }
    .pa-medidor .pa-box__pie { margin-top: 12px; }

    /* Calendario: la regla del año. */
    .pa-regla { margin-top: 26px; }
    .pa-regla__l { display: block; font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: var(--tour-rotulo, rgba(255,255,255,0.45)); margin-bottom: 10px; }
    .pa-regla__meses { display: grid; grid-template-columns: repeat(13, minmax(0, 1fr)); font-size: 10.5px; font-weight: 800; letter-spacing: .8px; color: var(--tour-rotulo, rgba(255,255,255,0.45)); text-align: center; margin-bottom: 6px; }
    .pa-regla__m--anio { color: rgba(255,255,255,0.3); }
    .pa-regla__pista {
      position: relative; height: 46px; border-radius: 10px;
      background: repeating-linear-gradient(90deg, rgba(255,255,255,0.05) 0, rgba(255,255,255,0.05) calc(100% / 13 - 1px), rgba(255,255,255,0.12) calc(100% / 13 - 1px), rgba(255,255,255,0.12) calc(100% / 13));
      overflow: hidden;
    }
    .pa-regla__h {
      position: absolute; top: 7px; bottom: 7px; border-radius: 8px;
      background: var(--tour-azul, #6B93EC); color: var(--tour-tinta, #1C1E23);
      display: flex; align-items: center; padding: 0 7px; overflow: hidden;
      transform-origin: left center;
    }
    .pa-regla__h span { font-size: 8.5px; font-weight: 800; letter-spacing: .6px; white-space: nowrap; }
    .pa-regla__h:first-child { background: rgba(255,255,255,0.18); color: #FFFFFF; }
    .pa-regla__h:last-child { background: var(--pp-accent); }

    /* Participación: la barra partida. */
    .pa-partida { display: flex; gap: 4px; margin: 0 0 22px; }
    .pa-partida__t {
      flex: 0 0 calc(var(--w, 50%) - 2px); min-width: 0;
      display: flex; align-items: baseline; gap: 10px;
      padding: 16px 18px; border-radius: 12px;
      background: var(--tour-azul, #6B93EC); color: var(--tour-tinta, #1C1E23);
      transform-origin: left center;
    }
    .pa-partida__t:first-child { border-radius: 999px 12px 12px 999px; }
