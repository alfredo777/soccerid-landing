{{!-- Perfil anual del proyecto 2027.

     La lámina 19 de la presentación define tres niveles:

         SOCCER iD CUP        historia de la copa      → /es/socceridcup (pública)
         PROYECTO 2027        esta página              → detrás del candado
         PERFIL DEL PARTIDO   Cruz Azul vs. Pumas…     → /socceridcup2027/partido-N

     ORDEN: el de la presentación es el de un documento que se lee entero. Un
     inversionista no lee así: quiere saber qué compra y qué le toca antes que
     en qué se gasta. Arriba va un panel con lo que se entiende de un vistazo,
     debajo la temporada en un eje, y luego las secciones en el orden en que se
     hacen las preguntas: por qué una temporada, qué me toca, cuál es el primer
     partido, a dónde va el capital, de dónde sale el retorno, cómo trabaja,
     quién lo hace, qué respaldo tiene y bajo qué condiciones. NO SE QUITÓ NADA
     de la presentación: está todo, en otro orden.

     LECTURA RÁPIDA: cada bloque abre con su rótulo y un filete, las cifras van
     en pastillas, el destino del capital en una dona con su leyenda y el
     calendario en un eje horizontal. Son los recursos de las referencias que
     dio el organizador, con la tipografía y los colores de la casa.

     Ocupa el mismo lugar que `propuesta-contenido`, así que hereda el candado,
     la barra de idioma y las variables de color de la vista.

     Las cifras que la presentación deja abiertas vienen con `pendiente` y se
     pintan como POR DEFINIR: ninguna se inventó. Cerrar una es escribir su
     valor en `contents/cup_tour_2027.json` y quitarle la marca. --}}

  {{!-- Iconografía. Un solo sprite y cada dato dice cuál le toca con su campo
       `icon`; así no hay SVG repetido por la vista. Trazo, no relleno, para
       que hereden el color. --}}
  <svg class="pa-sprite" aria-hidden="true" focusable="false"><defs>
    <g id="i-balon"><circle cx="12" cy="12" r="9"/><path d="M12 7.5l3.5 2.5-1.3 4.1H9.8L8.5 10z"/><path d="M12 3v4.5M3.6 9.6l4.9.4M20.4 9.6l-4.9.4M7.2 20.2l2.6-5.6M16.8 20.2l-2.6-5.6"/></g>
    <g id="i-reparto"><circle cx="12" cy="12" r="9"/><path d="M12 12V3a9 9 0 017.8 4.5z"/><path d="M12 12l7.8-4.5"/></g>
    <g id="i-calendario-ok"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17M9 15l2.2 2.2L15.5 13"/></g>
    <g id="i-calendario"><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17"/></g>
    <g id="i-estadio"><path d="M3 8.5c0-1.9 4-3.4 9-3.4s9 1.5 9 3.4-4 3.4-9 3.4-9-1.5-9-3.4z"/><path d="M3 8.5v6.8c0 1.9 4 3.4 9 3.4s9-1.5 9-3.4V8.5"/><ellipse cx="12" cy="12.5" rx="3.6" ry="1.4"/></g>
    <g id="i-lugar"><path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/></g>
    <g id="i-dinero"><rect x="3" y="6" width="18" height="12" rx="2.5"/><circle cx="12" cy="12" r="2.8"/><path d="M6.5 9.5v5M17.5 9.5v5"/></g>
    <g id="i-boleto"><path d="M3.5 8.5A2 2 0 015.5 6.5h13a2 2 0 012 2v1.2a2.3 2.3 0 000 4.6v1.2a2 2 0 01-2 2h-13a2 2 0 01-2-2v-1.2a2.3 2.3 0 000-4.6z"/><path d="M14 6.5v11"/></g>
    <g id="i-etiqueta"><path d="M11.2 3.5H20v8.8l-8.4 8.4a1.8 1.8 0 01-2.6 0l-6.2-6.2a1.8 1.8 0 010-2.6z"/><circle cx="16.2" cy="7.8" r="1.4"/></g>
    <g id="i-caja"><path d="M3.5 7.5l8.5-4 8.5 4v9l-8.5 4-8.5-4z"/><path d="M3.5 7.5l8.5 4 8.5-4M12 11.5v9"/></g>
    <g id="i-apreton"><path d="M8 12.5l3 3 2-2 3 3"/><path d="M3 9.5l3.5-3h4L13 8.5l3-2h5v8l-3 1.5"/><path d="M3 9.5v7l3 1.5"/></g>
    <g id="i-engrane"><circle cx="12" cy="12" r="3.4"/><path d="M12 2.6v2.4M12 19v2.4M5.4 5.4l1.7 1.7M16.9 16.9l1.7 1.7M2.6 12h2.4M19 12h2.4M5.4 18.6l1.7-1.7M16.9 7.1l1.7-1.7"/></g>
    <g id="i-capas"><path d="M12 3l9 4.8-9 4.8-9-4.8z"/><path d="M3 12.4l9 4.8 9-4.8M3 16.8l9 4.8 9-4.8"/></g>
    <g id="i-grafica"><path d="M3.5 20.5h17"/><path d="M6.5 17V11M11 17V5.5M15.5 17v-8M20 17v-4"/></g>
    <g id="i-cartera"><path d="M3.5 8.5A2 2 0 015.5 6.5H18a2 2 0 012 2v9a2 2 0 01-2 2H5.5a2 2 0 01-2-2z"/><path d="M3.5 9.5h13a1.8 1.8 0 011.8 1.8v2.4a1.8 1.8 0 01-1.8 1.8h-13"/><circle cx="15.5" cy="12.5" r="1"/></g>
    <g id="i-banco"><path d="M3.5 9.5L12 4l8.5 5.5"/><path d="M5.5 9.5v8M10 9.5v8M14 9.5v8M18.5 9.5v8M3 20.5h18"/></g>
    <g id="i-check"><circle cx="12" cy="12" r="9"/><path d="M8 12.2l2.6 2.6L16.2 9"/></g>
    <g id="i-escudo"><path d="M12 3l7.5 3v5.5c0 4.6-3.1 8-7.5 9.5-4.4-1.5-7.5-4.9-7.5-9.5V6z"/><path d="M9 12.2l2.2 2.2 4-4.2"/></g>
    <g id="i-candado"><rect x="4.5" y="10.5" width="15" height="9.5" rx="2.2"/><path d="M8 10.5V8a4 4 0 118 0v2.5"/><circle cx="12" cy="15" r="1.3"/></g>
    <g id="i-ojo"><path d="M2.5 12S6 6 12 6s9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/><circle cx="12" cy="12" r="2.8"/></g>
  </defs></svg>

  {{#if hayEn}}
  <div class="pp-lang-bar">
    <a href="/es/{{slug}}" class="{{#if isEs}}active{{/if}}">ES</a>
    <a href="/en/{{slug}}" class="{{#if isEn}}active{{/if}}">EN</a>
  </div>
  {{/if}}

    {{!-- Portada: la marca sobre la foto y las tres cifras que resumen todo --}}
    <section class="pa-foto">
      <div class="pa-foto__veil" aria-hidden="true"></div>
      <div class="pa-foto__body">
        <span class="pa-badge">{{data.hero.badge}}</span>
        {{#if logo}}
        <img class="pa-logo" src="{{logo}}" alt="{{data.hero.title}}" width="190" height="200">
        <h1 class="pa-foto__t pa-foto__t--oculto">{{data.hero.title}}</h1>
        {{else}}
        <h1 class="pa-foto__t">{{data.hero.title}}</h1>
        {{/if}}
        <p class="pa-foto__lead">
          {{#if data.hero.leadFuerte}}<strong class="pa-foto__lead-f">{{data.hero.leadFuerte}}</strong>{{/if}}
          <span class="pa-foto__lead-s">{{data.hero.lead}}</span>
        </p>
        <p class="pa-foto__meta">{{data.hero.meta}}</p>
      </div>
    </section>

  {{!-- ═══════════ CINCO BLOQUES ═══════════
       Estructura del brief "Estructura del sitio": cifras grandes, textos de
       una o dos líneas y botones visibles. Lo secundario —presupuesto,
       condiciones, trayectoria— vive en cajones laterales, fuera del
       recorrido principal. Una sola columna, fondo plano. --}}
  <div class="pa-panel">
    <div class="pa-panel__fondo" aria-hidden="true"></div>
    <div class="pa-panel__col">

      <section class="pa-box pa-box--cifras" aria-label="{{data.hero.lead}}">
        <div class="pa-tiles">
          {{#each data.hero.cifras}}
          <div class="pa-tile">
            {{#if this.icon}}<svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>{{/if}}
            <span class="pa-tile__l">{{this.label}}</span>
            <strong class="pa-tile__v">{{this.value}}</strong>
            <span class="pa-tile__n">{{this.note}}</span>
          </div>
          {{/each}}
        </div>
      </section>

      {{!-- 01 · El proyecto: los tres partidos, cada uno con su estado y su botón --}}
      <section class="pa-box">
        <div class="pa-box__h">
          <div>
            <p class="pa-rot"><span>{{data.proyecto.kicker}}</span></p>
            <h2 class="pa-box__t">{{data.proyecto.title}}</h2>
          </div>
          {{#if data.proyecto.sub}}<p class="pa-box__s">{{data.proyecto.sub}}</p>{{/if}}
        </div>
        <div class="pa-temporada">
          {{#each partidosNav}}
          <article class="pa-pt{{#if this.abierto}} pa-pt--destacado{{else}} pa-pt--inc{{/if}}">
            <span class="pa-pt__cab">
              <span class="pa-pt__n">{{this.n}}</span>
              <em class="pa-pend">{{#if this.abierto}}{{../data.proyecto.estados.previsto}}{{else}}{{../data.proyecto.estados.proceso}}{{/if}}</em>
            </span>
            <span class="pa-pt__cuando">{{this.cuando}}</span>
            <strong class="pa-pt__t">{{this.titulo}}</strong>
            <span class="pa-pt__lugar">{{this.lugar}}</span>
            <a href="{{this.url}}"{{{salida this.url}}} class="pa-btn pa-btn--chico{{#unless this.abierto}} pa-btn--ghost{{/unless}}">{{../data.proyecto.cta}} →</a>
          </article>
          {{/each}}
        </div>
      </section>

      {{!-- 02 · Capital y destino: cuánto se pide y a dónde va, con el desglose en su cajón --}}
      <section class="pa-box">
        <div class="pa-box__h">
          <div>
            <p class="pa-rot"><span>{{data.capital.kicker}}</span></p>
            <h2 class="pa-box__t">{{data.capital.title}}</h2>
          </div>
          <p class="pa-box__s">{{data.capital.sub}}</p>
        </div>
        {{!-- La composición del capital como barra apilada, cada tramo a su
             medida: el partido 1 pesa el 71 % y los anticipos el 14 % cada uno. --}}
        <div class="pa-apilada" aria-hidden="true">
          <span class="pa-apilada__l">{{data.capital.barraLabel}}</span>
          <div class="pa-apilada__barra">
            {{#each graficos.capital}}
            <span class="pa-apilada__t pa-anima{{#if this.estrecho}} pa-apilada__t--estrecho{{/if}}" style="--w: {{this.pct}}%" title="{{this.label}} · {{this.value}}">
              <span class="pa-apilada__n">{{this.label}}</span>
              <span class="pa-apilada__v">{{this.value}}</span>
            </span>
            {{/each}}
          </div>
        </div>
        {{!-- Nota de financiamiento, acompañando al desglose. --}}
        {{#if data.capital.nota}}<div class="pa-nota pa-nota--warn pa-nota--compacta"><p class="pa-nota__b">{{data.capital.nota}}</p></div>{{/if}}
        {{!-- Inversión mínima: bloque propio y protagonista, separado del capital total. --}}
        {{#unless data.capital.minimo.pendiente}}
        <div class="pa-minimo">
          <span class="pa-minimo__l">{{data.capital.minimo.label}}</span>
          <strong class="pa-minimo__v">{{data.capital.minimo.value}}</strong>
          {{#if data.capital.minimo.participacion}}<span class="pa-minimo__p">{{data.capital.minimo.participacion}}</span>{{/if}}
          {{#if data.capital.minimo.note}}<span class="pa-minimo__n">{{data.capital.minimo.note}}</span>{{/if}}
          {{#if data.capital.minimo.calc.length}}
          <div class="pa-calc5">
            {{#if data.capital.minimo.calcTitle}}<span class="pa-calc5__t">{{data.capital.minimo.calcTitle}}</span>{{/if}}
            {{#each data.capital.minimo.calc}}
            <div class="pa-calc5__row">
              <span class="pa-calc5__op">{{this.op}}</span>
              <strong class="pa-calc5__res">{{this.res}}</strong>
            </div>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/unless}}
        <div class="pa-box__pie-cta pa-box__pie-cta--solo">
          <button type="button" class="pa-btn pa-btn--ghost" data-cajon="presupuesto">{{data.capital.cta}} →</button>
        </div>
      </section>

      {{!-- 03 · Participación y retorno: el 70/30 como barra y dos líneas --}}
      <section class="pa-box">
        <div class="pa-box__h">
          <div>
            <p class="pa-rot"><span>{{data.participacion.kicker}}</span></p>
            <h2 class="pa-box__t">{{data.participacion.title}}</h2>
          </div>
          {{#if data.participacion.lineas.[1]}}<p class="pa-box__s">{{data.participacion.lineas.[0]}}</p>{{/if}}
        </div>
        <div class="pa-partida" aria-hidden="true">
          {{#each graficos.reparto}}
          <span class="pa-partida__t pa-anima" style="--w: {{this.pct}}%"><strong>{{this.pct}}%</strong><span>{{this.quien}}</span></span>
          {{/each}}
        </div>
        {{!-- El papel de cada parte, alineado con la barra 70/30. --}}
        <div class="pa-roles">
          {{#each graficos.reparto}}
          {{#if this.rol}}
          <div class="pa-rol">
            <span class="pa-rol__t"><strong>{{this.pct}}%</strong> · {{this.quien}}</span>
            <span class="pa-rol__b">{{this.rol}}</span>
          </div>
          {{/if}}
          {{/each}}
        </div>
        <div class="pa-retorno">
          <div class="pa-tile">
            <svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-calendario-ok"></use></svg>
            <span class="pa-tile__l">{{data.participacion.devolucion.label}}</span>
            <strong class="pa-tile__v">{{data.participacion.devolucion.value}}</strong>
            <span class="pa-tile__n">{{data.participacion.lineas.[0]}}</span>
            <p class="pa-tile__nota">{{data.participacion.nota}}</p>
          </div>
          {{!-- El rendimiento estimado está pendiente: cuando se valide la
               proyección entran aquí los tres escenarios (bajo, base,
               favorable). Mientras tanto no se publica nada. --}}
          {{#unless data.participacion.rendimiento.pendiente}}
          <div class="pa-tile">
            <span class="pa-tile__l">{{data.participacion.rendimiento.label}}</span>
            <strong class="pa-tile__v">{{data.participacion.rendimiento.value}}</strong>
          </div>
          {{/unless}}
        </div>
        {{#if data.participacion.ingresos.items.length}}
        <div class="pa-box__pie-cta pa-box__pie-cta--solo">
          <button type="button" class="pa-btn pa-btn--ghost" data-cajon="ingresos">{{data.participacion.ingresos.cta}} →</button>
        </div>
        {{/if}}
      </section>

      {{!-- 04 · Respaldo y seguimiento: tres piezas, el detalle en su cajón y la nota de riesgo --}}
      <section class="pa-box">
        <div class="pa-box__h">
          <div>
            <p class="pa-rot"><span>{{data.respaldo.kicker}}</span></p>
            <h2 class="pa-box__t">{{data.respaldo.title}}</h2>
          </div>
          {{#if data.respaldo.lead}}<p class="pa-box__s">{{data.respaldo.lead}}</p>{{/if}}
        </div>
        <div class="pa-tiles">
          {{#each data.respaldo.items}}
          <div class="pa-tile pa-tile--fila">
            <svg class="pa-ico" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{this.icon}}"></use></svg>
            <div class="pa-tile__txt">
              <strong class="pa-tile__t">{{this.title}}</strong>
              {{#if this.body}}<span class="pa-tile__d">{{this.body}}</span>{{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        <div class="pa-box__pie-cta">
          <div class="pa-nota pa-nota--warn pa-nota--compacta"><p class="pa-nota__b">{{data.respaldo.aviso}}</p></div>
          <button type="button" class="pa-btn pa-btn--ghost" data-cajon="detalles">{{data.respaldo.cta}} →</button>
        </div>
      </section>

      {{!-- 05 · Trayectoria: las tres ediciones, y el resto en su cajón --}}
      <section class="pa-box">
        <div class="pa-box__h">
          <div>
            <p class="pa-rot"><span>{{data.trayectoria.kicker}}</span></p>
            <h2 class="pa-box__t">{{data.trayectoria.title}}</h2>
          </div>
          {{#if data.trayectoria.sub}}<p class="pa-box__s">{{data.trayectoria.sub}}</p>{{/if}}
        </div>
        {{!-- Cada edición lleva a su ficha. Antes eran tarjetas con borde que
              no abrían nada: el aspecto prometía un enlace que no existía. --}}
        <div class="pa-tiles">
          {{#each ediciones}}
          <a class="pa-ed" href="{{this.url}}"{{{salida this.url}}}>
            {{#if this.imagen}}<span class="pa-ed__foto" style="background-image: url('{{this.imagen}}'); --foco: {{#if this.foco}}{{this.foco}}{{else}}30%{{/if}}" aria-hidden="true"></span>{{/if}}
            <span class="pa-ed__cuerpo">
              <strong class="pa-ed__anio">{{this.anio}}</strong>
              <span class="pa-ed__t">{{this.match}}</span>
              <span class="pa-ed__n">{{#if this.venue}}{{this.venue}} · {{/if}}{{this.sede}}</span>
            </span>
          </a>
          {{/each}}
        </div>
        <div class="pa-box__pie-cta pa-box__pie-cta--solo">
          <button type="button" class="pa-btn pa-btn--ghost" data-cajon="trayectoria">{{data.trayectoria.cta}} →</button>
        </div>
      </section>

    </div>
  </div>

  {{!-- ═══════════ CONTACTO ═══════════ --}}
  <section class="pa-cierre">
    <div class="pa-foto__veil" aria-hidden="true"></div>
    <div class="pa-cierre__body">
      {{!-- El logo en blanco cierra la página: el mismo arte del hero, en
            monocromo, sobre la foto donde el velo ya es casi opaco. --}}
      <img class="pa-cierre__logo" src="/assets/images/logos/id-tour27-blanco.png"
           alt="{{data.marca}}" width="150" height="158" loading="lazy">
      <p class="pa-rot pa-rot--centro"><span>{{data.contacto.kicker}}</span></p>
      {{#if data.contacto.title}}<h2 class="pa-cierre__t">{{data.contacto.title}}</h2>{{/if}}
      {{#if data.contacto.body}}<p class="pa-cierre__b">{{data.contacto.body}}</p>{{/if}}
      <a href="{{data.contacto.ctaUrl}}"{{{salida data.contacto.ctaUrl}}} class="pa-btn pa-btn--wa">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        {{data.contacto.cta}}
      </a>
      {{#if data.confidencial}}<span class="pa-cierre__conf">{{data.confidencial}}</span>{{/if}}
    </div>
  </section>

  {{!-- Barra de marca, igual que en /partido-1, con enlaces a la web y a
        nuestras redes para quien aún no nos conoce. --}}
  <footer class="pa-footer">
    <a class="pa-footer__marca" href="/{{lang}}" target="_blank" rel="noopener"><img src="/assets/images/logo-horizontal-blanco.png" alt="SOCCER iD" height="28"></a>
    <nav class="pa-footer__redes" aria-label="{{#if isEs}}Sitio y redes{{else}}Site and social{{/if}}">
      <a href="/{{lang}}" target="_blank" rel="noopener" title="{{#if isEs}}Sitio web{{else}}Website{{/if}}" aria-label="{{#if isEs}}Sitio web{{else}}Website{{/if}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.7 3.8 9S14.5 18.5 12 21c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z"/></svg>
      </a>
      <a href="https://www.instagram.com/soccerid7" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.8.25 2.23.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.42 2.23.06 1.27.07 1.65.07 4.86s0 3.6-.07 4.86c-.05 1.17-.25 1.8-.42 2.23a3.7 3.7 0 01-.9 1.38 3.7 3.7 0 01-1.38.9c-.42.17-1.06.37-2.23.42-1.27.06-1.65.07-4.86.07s-3.6 0-4.86-.07c-1.17-.05-1.8-.25-2.23-.42a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.17-.42-.37-1.06-.42-2.23C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.86c.05-1.17.25-1.8.42-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.42C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.14 0-3.5 0-4.74.07-.9.04-1.38.2-1.7.33-.43.16-.74.36-1.06.68-.32.32-.52.63-.68 1.06-.13.32-.29.8-.33 1.7C3.4 8.96 3.4 9.3 3.4 12s0 3.04.07 4.26c.04.9.2 1.38.33 1.7.16.43.36.74.68 1.06.32.32.63.52 1.06.68.32.13.8.29 1.7.33 1.24.07 1.6.07 4.74.07s3.5 0 4.74-.07c.9-.04 1.38-.2 1.7-.33.43-.16.74-.36 1.06-.68.32-.32.52-.63.68-1.06.13-.32.29-.8.33-1.7.07-1.22.07-1.56.07-4.26s0-3.04-.07-4.26c-.04-.9-.2-1.38-.33-1.7a2.86 2.86 0 00-.68-1.06 2.86 2.86 0 00-1.06-.68c-.32-.13-.8-.29-1.7-.33C15.5 4 15.14 4 12 4zm0 3.06A4.94 4.94 0 1012 16.94 4.94 4.94 0 0012 7.06zm0 8.14A3.2 3.2 0 1112 8.8a3.2 3.2 0 010 6.4zm6.3-8.34a1.15 1.15 0 11-2.3 0 1.15 1.15 0 012.3 0z"/></svg>
      </a>
      <a href="https://www.facebook.com/soccerid7" target="_blank" rel="noopener" title="Facebook" aria-label="Facebook">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z"/></svg>
      </a>
      <a href="https://www.tiktok.com/@soccerid_7" target="_blank" rel="noopener" title="TikTok" aria-label="TikTok">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.08-.14 1.62.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
      </a>
