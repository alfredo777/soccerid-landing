{{!-- ═══════════ VIDEO DEL TOUR: card flotante + pantalla de celular ═══════════
     Solo para quien entró con código de NIVEL TOUR (lo decide index.js, que
     manda `videoTour`; sin él este partial no se emite).

     Es un <video> HTML5 nativo —el archivo vendrá de Amazon S3, no de un
     embed de terceros— y es UN SOLO elemento para las TRES etapas:
       1. cerrado     — la fila abajo a la derecha, con la miniatura reproduciendo
       2. desplegado  — la misma card, en su esquina, con el video grande debajo
       3. maximizado  — el video a toda la pantalla
     Sin lightbox: no es un modal, no se centra ni bloquea la pagina. En
     celular la etapa 2 oscurece el fondo, porque la card se come la
     pantalla, pero ni ahi captura el toque. El video no se mueve en el DOM
     al cambiar de etapa, solo cambia la clase del contenedor, y así la
     reproducción no se corta.

     El JS vive en la vista (socceridcup-project2027.hbs, en initContenido),
     porque este contenido se inyecta tras el candado y un <script> inyectado
     no corre. Aquí solo hay marcado y estilos. --}}
<div class="tv" id="tvCard" data-tv data-variante="{{variantId}}" hidden aria-hidden="true">
  {{!-- Etapa 0, CERRADO CON LA X: la card se va y queda este botón abajo a
       la izquierda. El cierre se guarda mientras dure el acceso del código
       (12 h), para que no vuelva a saltar en cada página. --}}
  <button type="button" class="tv__boton" data-tv-reabrir hidden aria-label="{{videoTour.txtReabrir}}" title="{{videoTour.txtReabrir}}">
    {{!-- Play macizo. El triangulo mide 12 de ancho y su centro cae 1.5 a la
         derecha del centro de la caja: esa es la correccion optica que lo hace
         VER centrado dentro del circulo. Por eso no lleva margen. --}}
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.5 5.6v12.8a1 1 0 001.52.85l10.4-6.4a1 1 0 000-1.7L9.02 4.75A1 1 0 007.5 5.6z"/></svg>
  </button>
  <div class="tv__card">
    {{!-- Asa de arrastre (solo celular): se jala con el dedo para desplegar
         el reproductor, y tocarla también lo despliega o recoge. --}}
    <button type="button" class="tv__asa" data-tv-alternar aria-label="{{videoTour.txtDesplegar}}"></button>
    {{!-- Cabeza: solo en MAXIMIZADO, sobre el video; el botón vuelve a desplegado --}}
    <header class="tv__cabeza">
      <div class="tv__cabeza-datos">
        <span class="tv__kicker">{{videoTour.kicker}}</span>
        <strong class="tv__titulo-g">{{videoTour.titulo}}</strong>
      </div>
      <button type="button" class="tv__x tv__x--g" data-tv-restaurar aria-label="{{videoTour.txtRestaurar}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>
      </button>
    </header>

    {{!-- El video: miniatura 9:16 en cerrado, grande dentro de la card en
         desplegado, a toda la pantalla en maximizado. El botón de la esquina
         avanza una etapa (cerrado → desplegado → maximizado). --}}
    <div class="tv__marco" id="tvMarco">
      {{!-- preload="auto": el navegador empieza a bajarse el video en cuanto
           existe este elemento, sin esperar a que se intente reproducir. La
           card entra 900 ms despues de que la propuesta se ve, y con solo la
           cabecera descargada esos 900 ms no alcanzan: se quedaba en la
           caratula un rato. Pidiendolo entero desde el principio, cuando
           aparece ya tiene con que arrancar.

           Es el unico video de la pagina y solo se emite detras del candado,
           con acceso de nivel tour, asi que la descarga no compite con el
           resto de propuestas ni le cae a nadie de paso. Lo que si seria una
           groseria es bajar varios megas sin avisar en una red medida: con
           "ahorro de datos" o en 2G el JS lo baja a "none" (la precarga, en
           initContenido). --}}
      <video id="tvVideo" class="tv__video"
             src="{{videoTour.src}}"
             poster="{{videoTour.poster}}"
             {{!-- Sin loop: se ve UNA vez. Al terminar queda apuntado en la
                  sesion y la card ya no vuelve a arrancar sola; el play la
                  revive. Ver "ya visto" en initContenido. --}}
             playsinline muted autoplay preload="auto"
             aria-label="{{videoTour.titulo}}"></video>
      <button type="button" class="tv__abrir" id="tvAbrir" data-tv-abrir aria-label="{{videoTour.txtAbrir}}">
        <span class="tv__abrir-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
        </span>
      </button>
      {{!-- Pausa/continúa tocando el video, en desplegado y maximizado --}}
      <button type="button" class="tv__toque" data-tv-toque aria-label="{{videoTour.txtPausa}}"></button>
      <div class="tv__pausado" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l10-6.5z"/></svg>
      </div>
    </div>

    {{!-- Fila de la card: datos + acciones (solo en cerrado) --}}
    <div class="tv__datos" data-tv-abrir>
      <span class="tv__kicker">{{videoTour.kicker}}</span>
      <strong class="tv__titulo">{{videoTour.titulo}}</strong>
    </div>
    <div class="tv__acciones">
      <button type="button" class="tv__btn tv__btn--sonido" data-tv-sonido aria-pressed="false" aria-label="{{videoTour.txtSonido}}">
        <svg class="tv__ico-mudo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4z"/><path d="M23 9l-6 6M17 9l6 6"/></svg>
        <svg class="tv__ico-sonido" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4z"/><path d="M15.5 8.5a5 5 0 010 7M19 5.5a9.5 9.5 0 010 13"/></svg>
      </button>
      <button type="button" class="tv__play" data-tv-play aria-label="{{videoTour.txtPausa}}">
        <svg class="tv__ico-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10-6.5z"/></svg>
        <svg class="tv__ico-pausa" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
      </button>
      <button type="button" class="tv__btn tv__btn--pliegue" data-tv-alternar aria-expanded="false" aria-label="{{videoTour.txtDesplegar}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
      </button>
      <button type="button" class="tv__x" data-tv-cerrar aria-label="{{videoTour.txtCerrar}}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    {{!-- Barra sobre el video: progreso, tiempo y sonido (desplegado y maximizado) --}}
    <div class="tv__barra">
      <button type="button" class="tv__btn tv__btn--barra" data-tv-play aria-label="{{videoTour.txtPausa}}">
        <svg class="tv__ico-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10-6.5z"/></svg>
        <svg class="tv__ico-pausa" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
      </button>
      <span class="tv__tiempo" id="tvTiempo">0:00 / 0:00</span>
      <div class="tv__progreso" data-tv-progreso role="slider" aria-label="{{videoTour.txtProgreso}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
        <div class="tv__progreso-lleno" id="tvLleno"></div>
      </div>
      <button type="button" class="tv__btn tv__btn--barra" data-tv-sonido aria-pressed="false" aria-label="{{videoTour.txtSonido}}">
        <svg class="tv__ico-mudo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4z"/><path d="M23 9l-6 6M17 9l6 6"/></svg>
        <svg class="tv__ico-sonido" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4z"/><path d="M15.5 8.5a5 5 0 010 7M19 5.5a9.5 9.5 0 010 13"/></svg>
      </button>
    </div>
  </div>
</div>

<style>
  /* ─── Medidas del reproductor del tour ───
     Todas las dimensiones salen de aquí. La card cerrada mide lo mismo en
     web y en celular a propósito: en web es una card pequeña abajo a la
     derecha, del tamaño de la de un teléfono, no una barra a lo ancho. */
  .tv {
    --tv-card-ancho: 344px;    /* card cerrada, web */
    --tv-card-alto: 112px;     /* 96 de miniatura + 8 de margen arriba y abajo */
    /* La forma del VIDEO manda en las tres etapas. Los archivos finales son
       horizontales (772x432), asi que la miniatura y el recuadro grande van
       en 16:9: con un marco 9:16 el "cover" se comia los lados y solo se veia
       una rebanada del centro. Si algun dia el video vuelve a ser vertical,
       se cambian estos tres numeros y las tres etapas siguen. */
    --tv-aspecto: 16 / 9;
    --tv-mini-ancho: 96px;     /* miniatura 16:9, como el video */
    --tv-mini-alto: 54px;
    --tv-play: 42px;           /* botón principal, en vidrio */
    --tv-radio: 20px;
    /* Vidrio: la card deja ver la página detrás (pedido del usuario, para
       despegarse del reproductor de Rockstars MX, que es opaco). El
       desenfoque hace legible el texto encima de lo que sea. */
    --tv-fondo: rgba(var(--tour-card-rgb, 30, 34, 44), 0.55);
    --tv-vidrio-borde: rgba(255, 255, 255, 0.14);
    --tv-acento: var(--tour-cian, #38E1FF);
    --tv-acento-rgb: var(--tour-cian-rgb, 56, 225, 255);
    --tv-tinta: var(--tour-tinta, #1C1E23);
    --tv-rotulo: var(--tour-rotulo, #C9CCD4);
    /* Desplegado: el video toma el ancho de la card en su proporcion (324 ×
       182 en web, 16:9) y nunca pasa de este alto, para que la fila siga a la
       vista. */
    --tv-despl-max: 60vh;
    /* La flecha de "volver arriba" (.pp-btt, estilada en la vista). La card y
       el boton de reabrir se cuelgan de estos dos numeros para quedar a su
       misma altura, en la esquina de enfrente: si alla se mueve la flecha,
       aqui se cambian y los tres siguen alineados. */
    --tv-btt-borde: 32px;
    --tv-btt-tam: 48px;
    position: fixed; inset: 0; z-index: 95;
    pointer-events: none;
    font-family: inherit;
  }
  .tv[hidden] { display: none; }

  /* ─── Etapa 0, cerrado con la X: el botón abajo a la IZQUIERDA ─── */
  .tv__boton {
    position: absolute;
    /* A la MISMA ALTURA que la flecha de volver arriba (.pp-btt, en la vista:
       fija a 32px del borde y 48px de lado). Este circulo mide 52, asi que su
       bottom baja la mitad de la diferencia y los dos centros quedan en la
       misma linea. Mismo borde de 32 a la izquierda que la flecha a la
       derecha. Sin env(safe-area): la flecha tampoco la lleva, y si una la
       suma y la otra no, dejan de estar alineadas. */
    left: var(--tv-btt-borde);
    bottom: calc(var(--tv-btt-borde) - (52px - var(--tv-btt-tam)) / 2);
    width: 52px; height: 52px; border-radius: 50%;
    border: 1px solid var(--tv-vidrio-borde); padding: 0;
    background: var(--tv-fondo);
    backdrop-filter: blur(24px) saturate(140%); -webkit-backdrop-filter: blur(24px) saturate(140%);
    color: var(--tv-acento); cursor: pointer; pointer-events: auto;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 12px 32px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.08);
    transition: transform .15s ease, background .15s ease;
  }
  .tv__boton[hidden] { display: none; }
  .tv__boton:hover { transform: scale(1.06); background: rgba(var(--tv-acento-rgb), 0.14); }
  .tv__boton svg { width: 24px; height: 24px; }
  /* ONDAS. Cerrada la card con la X, este boton es lo unico que queda del
     video y vive en una esquina, asi que tiene que llamar. Son dos anillos
     cian gruesos que salen del borde y se abren al doble escaso, mas un
     halo que empuja desde el propio boton: las tres cosas corren al mismo
     compas, de modo que se lee como UNA onda con cuerpo y no como tres cosas
     parpadeando. Nada de esto captura el dedo, asi que no estorba al toque. */
  .tv__boton::before,
  .tv__boton::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%;
    border: 2px solid rgba(var(--tv-acento-rgb), 0.95);
    pointer-events: none; opacity: 0;
    animation: tv-onda 2.2s cubic-bezier(.2,.6,.3,1) infinite;
  }
  /* El segundo anillo sale a mitad del ciclo: siempre hay una onda en camino,
     nunca un parpadeo doble. */
  .tv__boton::after { animation-delay: 1.1s; }
  /* El halo sale del boton mismo y le da peso a la onda. Las dos sombras de
     siempre se repiten en cada paso: box-shadow se anima entera o no se anima. */
  .tv__boton { animation: tv-onda-halo 2.2s cubic-bezier(.2,.6,.3,1) infinite; }
  /* Con el dedo o el raton encima ya esta visto: se calla todo. */
  .tv__boton:hover { animation: none; }
  .tv__boton:hover::before, .tv__boton:hover::after { animation: none; opacity: 0; }
  @keyframes tv-onda {
    0%   { transform: scale(1); opacity: .95; }
    60%  { opacity: .4; }
    100% { transform: scale(2.05); opacity: 0; }
  }
  @keyframes tv-onda-halo {
    0%        { box-shadow: 0 12px 32px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.08), 0 0 0 0 rgba(var(--tv-acento-rgb), 0.5); }
    70%, 100% { box-shadow: 0 12px 32px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.08), 0 0 0 13px rgba(var(--tv-acento-rgb), 0); }
  }
  /* Quien pidio menos movimiento no ve nada de esto; el boton se queda quieto. */
  @media (prefers-reduced-motion: reduce) {
    .tv__boton { animation: none; }
    .tv__boton::before, .tv__boton::after { animation: none; display: none; }
  }
  /* Mientras la card esté cerrada no se le pone nada encima a la fila */
  .tv.tv--minimizado .tv__card { display: none; }

  /* ─── Etapa 1, CERRADO: la fila abajo a la IZQUIERDA ─── */
  .tv__card {
    position: absolute;
    /* Esquina de abajo a la IZQUIERDA, en la misma linea de apoyo que la
       flecha de volver arriba (.pp-btt, a 32px del borde de enfrente): la
       card y la flecha quedan a la misma altura, cada una en su esquina, y
       el video ya no le cae encima. Mismas medidas que el boton de reabrir,
       que vive en esta misma esquina cuando la card se cierra con la X. */
    left: var(--tv-btt-borde);
    bottom: var(--tv-btt-borde);
    width: var(--tv-card-ancho);
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
    /* 54 de miniatura + 7 + 7 de relleno + el borde = 70 de alto */
    padding: 7px 10px 7px 7px;
    background: var(--tv-fondo);
    backdrop-filter: blur(24px) saturate(140%); -webkit-backdrop-filter: blur(24px) saturate(140%);
    border: 1px solid var(--tv-vidrio-borde);
    border-radius: var(--tv-radio);
    box-shadow: 0 18px 48px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.08);
    overflow: hidden;
    color: #fff;
    pointer-events: auto;
    transform: translateY(calc(100% + 24px)); opacity: 0;
    transition: transform .32s cubic-bezier(.2,.8,.2,1), opacity .25s ease;
  }
  .tv.tv--visible .tv__card { transform: none; opacity: 1; }

  .tv__marco {
    position: relative; flex: none; order: 1;
    width: var(--tv-mini-ancho); height: var(--tv-mini-alto);
    border-radius: 12px; overflow: hidden; background: #000;
    box-shadow: 0 0 0 1px rgba(var(--tv-acento-rgb), 0.45);
  }
  .tv__video { display: block; width: 100%; height: 100%; object-fit: cover; background: #000; }
  .tv.tv--desplegado .tv__video { background: rgba(0,0,0,0.6); }
  /* Toda la miniatura avanza una etapa; el icono asoma en la esquina */
  .tv__abrir {
    position: absolute; inset: 0; border: 0; padding: 0; margin: 0;
    background: transparent; cursor: pointer; color: #fff; z-index: 3;
  }
  .tv__abrir-ico {
    position: absolute; right: 4px; bottom: 4px;
    width: 20px; height: 20px; border-radius: 6px;
    background: rgba(0,0,0,0.55);
    display: flex; align-items: center; justify-content: center;
  }
  .tv__abrir-ico svg { width: 12px; height: 12px; }
  .tv__toque, .tv__pausado, .tv__cabeza, .tv__barra, .tv__asa { display: none; }

  .tv__datos { order: 2; min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; cursor: pointer; }
  .tv__kicker {
    align-self: flex-start; max-width: 100%;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    font-size: 9.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    color: var(--tv-acento);
    padding: 2px 8px; border-radius: 999px;
    border: 1px solid rgba(var(--tv-acento-rgb), 0.45);
    background: rgba(var(--tv-acento-rgb), 0.08);
  }
  .tv__cabeza .tv__kicker { align-self: flex-start; }
  .tv__titulo { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tv__titulo { font-size: 14px; font-weight: 800; line-height: 1.2; }

  .tv__acciones { order: 3; display: flex; align-items: center; gap: 2px; flex: none; }
  .tv__btn, .tv__x {
    width: 32px; height: 32px; border-radius: 10px; border: 0; padding: 0;
    background: transparent; color: var(--tv-rotulo); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background .15s ease, color .15s ease;
  }
  .tv__btn:hover, .tv__x:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .tv__btn svg, .tv__x svg { width: 18px; height: 18px; }
  .tv__btn--pliegue svg { transition: transform .2s ease; }
  .tv__play {
    width: var(--tv-play); height: var(--tv-play); border-radius: 50%; padding: 0;
    border: 1px solid rgba(255,255,255,0.28);
    background: rgba(255,255,255,0.10); color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: transform .15s ease, background .15s ease, border-color .15s ease;
  }
  .tv__play:hover { transform: scale(1.06); background: rgba(255,255,255,0.18); border-color: rgba(255,255,255,0.45); }
  .tv__play svg { width: 22px; height: 22px; }
  .tv__play .tv__ico-play { margin-left: 2px; }
  /* Línea de avance al pie de la card, en cerrado: se sabe cuánto va sin
     desplegar. Es una pseudo-barra que el JS alimenta con --tv-avance. */
  .tv__card::after {
    content: ""; position: absolute; left: 0; bottom: 0; height: 2px;
    width: calc(var(--tv-avance, 0) * 1%);
    background: var(--tv-acento); transition: width .25s linear;
  }
  .tv.tv--desplegado .tv__card::after, .tv.tv--maximizado .tv__card::after { display: none; }
  /* Iconos según estado: el <video> manda, la clase del contenedor refleja */
  .tv__ico-pausa, .tv__ico-sonido { display: none; }
  .tv--reproduciendo .tv__ico-play { display: none; }
  .tv--reproduciendo .tv__ico-pausa { display: block; }
  .tv--con-sonido .tv__ico-mudo { display: none; }
  .tv--con-sonido .tv__ico-sonido { display: block; }
  .tv--con-sonido .tv__btn--sonido { color: var(--tv-acento); }
  /* Mientras va en silencio, el botón de sonido llama la atención: es la
     única manera de que suene, porque el navegador no deja arrancar con audio. */
  .tv:not(.tv--con-sonido) .tv__btn--sonido { animation: tv-latido 2.4s ease-in-out infinite; }
  @keyframes tv-latido { 0%, 100% { background: transparent; } 50% { background: rgba(var(--tv-acento-rgb), 0.14); color: #fff; } }

  /* El botón de "volver arriba" de la página vive en la misma esquina:
     mientras la card esté, sube a quedar encima de ella. */
  /* Maximizado es el video a toda la pantalla: ahi no va nada encima. Desplegado
     ya no esconde la flecha en web, porque la card crece en la esquina de
     ENFRENTE y no la tapa; en celular si, y se apaga abajo. */
  body.tv-maximizado .pp-btt { opacity: 0; pointer-events: none; }

  /* ─── Etapa 2, DESPLEGADO: la misma card, en su esquina, con el video
     grande debajo de la fila (como el reproductor de Rockstars MX). La fila
     se queda arriba, sin miniatura; el video toma el ancho de la card en su
     proporcion. En celular, ademas, el fondo se oscurece (ver el velo en el
     bloque de celular); en web no hace falta. ─── */
  .tv.tv--desplegado .tv__card { gap: 10px 12px; padding: 7px 10px 10px; }
  .tv.tv--desplegado .tv__datos { order: 1; padding-left: 4px; }
  .tv.tv--desplegado .tv__acciones { order: 2; }
  .tv.tv--desplegado .tv__marco {
    order: 3; flex: 1 1 100%; width: 100%; height: auto;
    aspect-ratio: var(--tv-aspecto); max-height: var(--tv-despl-max);
    border-radius: 14px;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.10);
  }
  .tv.tv--desplegado .tv__video { object-fit: contain; }
  .tv.tv--desplegado .tv__btn--pliegue svg { transform: rotate(180deg); }
  /* El botón de maximizar sube a la esquina de arriba: abajo está la barra
     de progreso con el botón de sonido y se encimaban. */
  .tv.tv--desplegado .tv__abrir { inset: 0 0 auto auto; width: 44px; height: 44px; }
  .tv.tv--desplegado .tv__abrir-ico { right: 8px; top: 8px; bottom: auto; width: 28px; height: 28px; border-radius: 8px; }
  .tv.tv--desplegado .tv__abrir-ico svg { width: 15px; height: 15px; }

  /* ─── Etapa 3, MAXIMIZADO: el video a toda la pantalla. No es un modal
     con marco: la card se vuelve la pantalla, en web y en celular igual. ─── */
  .tv.tv--maximizado { z-index: 170; }
  .tv.tv--maximizado .tv__card {
    inset: 0; width: auto; padding: 0; gap: 0; display: block;
    background: rgba(6, 7, 10, 0.92); border: 0; border-radius: 0; box-shadow: none;
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  }
  .tv.tv--maximizado .tv__marco { width: 100%; height: 100%; max-height: none; aspect-ratio: auto; border-radius: 0; box-shadow: none; }
  .tv.tv--maximizado .tv__video { background: transparent; }
  .tv.tv--maximizado .tv__video { object-fit: contain; }
  .tv.tv--maximizado .tv__abrir, .tv.tv--maximizado .tv__datos, .tv.tv--maximizado .tv__acciones { display: none; }

  /* Lo que comparten desplegado y maximizado: tocar el video pausa, la barra
     de progreso sobre el video, y el aviso de pausa al centro. */
  .tv.tv--desplegado .tv__toque, .tv.tv--maximizado .tv__toque {
    display: block; position: absolute; inset: 0; border: 0; background: transparent; cursor: pointer;
  }
  .tv.tv--desplegado.tv--pausa .tv__pausado, .tv.tv--maximizado.tv--pausa .tv__pausado {
    display: flex; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 64px; height: 64px; border-radius: 50%; pointer-events: none;
    background: rgba(var(--tv-acento-rgb), 0.92); color: var(--tv-tinta);
    align-items: center; justify-content: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }
  .tv__pausado svg { width: 30px; height: 30px; margin-left: 3px; }
  .tv.tv--maximizado .tv__pausado { width: 72px; height: 72px; }

  .tv.tv--maximizado .tv__cabeza {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    position: absolute; left: 0; right: 0; top: 0; z-index: 2;
    padding: calc(14px + env(safe-area-inset-top, 0px)) 14px 28px 18px;
    background: linear-gradient(180deg, rgba(0,0,0,0.72), rgba(0,0,0,0));
    color: #fff;
  }
  .tv__cabeza-datos { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
