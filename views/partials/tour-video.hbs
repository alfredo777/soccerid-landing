  .tv__x--g { width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.12); color: #fff; flex: none; }
  .tv__x--g:hover { background: rgba(255,255,255,0.22); }
  .tv__x--g svg { width: 20px; height: 20px; }

  .tv.tv--desplegado .tv__barra, .tv.tv--maximizado .tv__barra {
    display: flex; align-items: center; gap: 8px;
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    padding: 24px 10px 8px;
    background: linear-gradient(0deg, rgba(0,0,0,0.78), rgba(0,0,0,0));
    color: #fff;
  }
  .tv.tv--maximizado .tv__barra { gap: 10px; padding: 28px 14px calc(14px + env(safe-area-inset-bottom, 0px)); }
  .tv__btn--barra { width: 36px; height: 36px; color: #fff; flex: none; }
  .tv__tiempo { font-size: 12px; font-variant-numeric: tabular-nums; color: var(--tv-rotulo); flex: none; min-width: 78px; }
  .tv__progreso {
    flex: 1; height: 4px; border-radius: 4px; background: rgba(255,255,255,0.22);
    position: relative; cursor: pointer;
  }
  .tv__progreso::before { content: ""; position: absolute; inset: -12px 0; }  /* zona de toque más alta */
  .tv__progreso-lleno { position: relative; height: 100%; width: 0; border-radius: 4px; background: var(--tv-acento); }
  .tv__progreso-lleno::after {
    content: ""; position: absolute; top: 50%; right: -6px; transform: translateY(-50%);
    width: 12px; height: 12px; border-radius: 50%; background: var(--tv-acento);
    box-shadow: 0 0 0 3px rgba(var(--tv-acento-rgb), 0.25);
  }

  /* ─── Celular ─── */
  @media (max-width: 640px) {
    .tv { --tv-despl-max: 52vh; }
    /* Velo, SOLO en celular. Aqui la card desplegada se come casi toda la
       pantalla de borde a borde y el poco fondo que asoma estorba; en web la
       card es chica, vive en su esquina y la propuesta se sigue leyendo al
       lado, asi que oscurecerla seria de mas. En maximizado tampoco se pone:
       el video ya ocupa todo. Sigue sin ser un modal, hereda el
       pointer-events:none de .tv y no bloquea la pagina; al ir antes que la
       card en el orden de pintado se queda detras sin pelear z-index. */
    .tv::before {
      content: ""; position: absolute; inset: 0;
      background: #000; opacity: 0;
      transition: opacity .32s ease;
    }
    .tv.tv--desplegado::before { opacity: .55; }
    /* Aqui la card si se le pone encima a la flecha de volver arriba: ocupa
       todo el ancho, pegada al borde de abajo. Son sus 112px de alto mas el
       hueco de siempre. En web no hace falta, la card esta en la otra esquina. */
    /* La card pegada abajo mide la miniatura mas sus rellenos; la flecha se
       pone justo encima. Se calcula para que siga cuadrando si cambia la
       forma del video. */
    body.tv-visible .pp-btt { bottom: calc(var(--tv-mini-alto, 54px) + 42px); }
    body.tv-desplegado .pp-btt { opacity: 0; pointer-events: none; }
    /* En celular la card va PEGADA al borde de abajo y a todo lo ancho, como
       el mini reproductor de Rockstars MX: flotando con margen se veía
       suelta, con un hueco debajo. Solo las esquinas de arriba se redondean
       y el relleno de abajo absorbe la safe area del teléfono. */
    .tv__card {
      left: 0; right: 0; bottom: 0; width: auto;
      /* El gesto vertical es nuestro (deslizar abre y recoge); el horizontal
         se le deja a la página. Sin esto el navegador decide por su cuenta. */
      touch-action: pan-x;
      -webkit-tap-highlight-color: transparent;
      /* Sitio para el asa de arrastre, arriba */
      padding-top: 18px;
      border-radius: var(--tv-radio) var(--tv-radio) 0 0;
      border-bottom: 0;
      padding-bottom: calc(7px + env(safe-area-inset-bottom, 0px));
    }
    .tv.tv--desplegado .tv__card { padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px)); }
    /* El asa: una franja de toque de 22 px a lo ancho (para que el dedo la
       encuentre sin apuntar) con la barra visible al centro, como las hojas
       de iOS. Deslizarla hacia arriba despliega; tocarla, también. */
    .tv__asa {
      display: block; position: absolute; top: 0; left: 0; right: 0; height: 22px;
      border: 0; padding: 0; background: transparent; cursor: grab; z-index: 2;
      -webkit-tap-highlight-color: transparent;
    }
    .tv__asa::before {
      content: ""; position: absolute; top: 7px; left: 50%; transform: translateX(-50%);
      width: 48px; height: 5px; border-radius: 5px;
      background: rgba(255,255,255,0.6);
    }
    .tv__asa:active::before, .tv.tv--desplegado .tv__asa::before { background: var(--tv-acento); }
    .tv.tv--maximizado .tv__card { padding-top: 0; touch-action: none; }
    .tv.tv--maximizado .tv__asa { display: none; }
    .tv.tv--maximizado .tv__card { inset: 0; padding-bottom: 0; border-radius: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tv__card { transition: none; }
    .tv:not(.tv--con-sonido) .tv__btn--sonido { animation: none; background: rgba(var(--tv-acento-rgb), 0.14); }
  }
