{{!-- Insignia del 10.º aniversario (2016–2026), con el diseño de boleto de
      los posts de redes. Lleva a «10 años de historia» en Nosotros.
      `chico=true` para el pie. Estilos: assets/css/aniversario.css. --}}
<a class="aniv{{#if chico}} aniv--chico{{/if}}" href="/{{@root.lang}}/nosotros#aniversario"
   aria-label="{{#if @root.isEs}}10.º aniversario, 2016 a 2026{{else}}10th anniversary, 2016 to 2026{{/if}}">
  <span class="aniv__num" aria-hidden="true">10<span class="aniv__o">{{#if @root.isEs}}º{{else}}th{{/if}}</span></span>
  <span class="aniv__sep" aria-hidden="true"></span>
  <span class="aniv__txt" aria-hidden="true">
    <b>{{#if @root.isEs}}Aniversario{{else}}Anniversary{{/if}}</b>
    <span>2016–2026</span>
  </span>
</a>
