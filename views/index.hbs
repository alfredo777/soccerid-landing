    {{#if nextMatch}}
    <!-- ================================================
         BANNER PRÓXIMO PARTIDO (completo cada 7 días + minimizado)
         ================================================ -->
    <div class="nm-wrap" id="nmWrap" data-match-id="{{nextMatch.id}}" data-match-iso="{{nextMatch.dateISO}}">
      <div class="nm-backdrop" id="nmBackdrop"></div>

      <div class="nm-full" id="nmFull" role="dialog" aria-modal="true" aria-label="{{#if isEs}}Próximo Partido{{else}}Next Match{{/if}}">
        <div class="nm-full__handle"></div>
        <div class="nm-full__head">
          <svg class="nm-full__star" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7L12 18.3 5.7 21.2l1.7-7L2 9.5l7.1-.6z"/></svg>
          <strong>{{#if isEs}}Próximo Partido{{else}}Next Match{{/if}}</strong>
          <button class="nm-full__close" id="nmClose" aria-label="Cerrar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>
        <div class="nm-card">
          <div class="nm-badge">{{nextMatch.badge}}</div>
          <div class="nm-matchup">
            <div class="nm-team"><div class="nm-team__icon"><img src="{{nextMatch.team1Icon}}" alt="{{nextMatch.team1}}"></div><span class="nm-team__name">{{nextMatch.team1}}</span></div>
            <div class="nm-vs">VS</div>
            <div class="nm-team"><div class="nm-team__icon"><img src="{{nextMatch.team2Icon}}" alt="{{nextMatch.team2}}"></div><span class="nm-team__name">{{nextMatch.team2}}</span></div>
          </div>
          <div class="nm-info">
