{{!-- Vista principal --}}

<!-- ==================== PRELOADER ==================== -->
    <div class="preloader" id="preloader">
        <div class="preloader-logo-container">
            <div class="preloader-spinner"></div>
            <div class="preloader-logo">
                <svg viewbox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="50" cy="50" r="45" stroke="url(#logoGradient)" stroke-width="4" fill="none"></circle>
                    <path d="M50 15 L50 85 M15 50 L85 50" stroke="url(#logoGradient)" stroke-width="3" stroke-linecap="round"></path>
                    <circle cx="50" cy="50" r="20" stroke="url(#logoGradient)" stroke-width="3" fill="none"></circle>
                    <circle cx="50" cy="50" r="8" fill="url(#logoGradient)"></circle>
                    <defs>
                        <lineargradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#667eea"></stop>
                            <stop offset="50%" style="stop-color:#764ba2"></stop>
                            <stop offset="100%" style="stop-color:#f093fb"></stop>
                        </lineargradient>
                    </defs>
                </svg>
            </div>
        </div>
        <div class="preloader-text"> <img src="{{img '/assets/images/soccerid.png'}}" width="300px"></div>
        <div class="preloader-subtext">Cargando...</div>
    </div>

        <!-- ==================== SELECTOR DE IDIOMA (FLOATING) ==================== -->
    <div class="language-selector-container" id="languageSelectorContainer">

    </div>

    <!-- ==================== DOT NAVIGATION ==================== -->
    <nav class="dot-nav" id="dotNav" aria-label="Section navigation">
      <a href="#hero" class="dot-nav__item active" data-section="hero" data-tooltip="{{#if isEs}}Inicio{{else}}Home{{/if}}">
        <span class="dot-nav__icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
        </span>
        <span class="dot-nav__dot"></span>
      </a>
      <a href="#servicios" class="dot-nav__item" data-section="servicios" data-tooltip="{{#if isEs}}Servicios{{else}}Services{{/if}}">
        <span class="dot-nav__icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z"/></svg>
        </span>
        <span class="dot-nav__dot"></span>
      </a>
      {{#if upcoming_events}}
      <a href="#eventos" class="dot-nav__item" data-section="eventos" data-tooltip="{{#if isEs}}Eventos{{else}}Events{{/if}}">
        <span class="dot-nav__icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg>
        </span>
        <span class="dot-nav__dot"></span>
      </a>
      {{/if}}
      <a href="#podcastSection" class="dot-nav__item" data-section="podcastSection" data-tooltip="Podcast">
        <span class="dot-nav__icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1c-4.97 0-9 4.03-9 9v7c0 1.66 1.34 3 3 3h3v-8H5v-2c0-3.87 3.13-7 7-7s7 3.13 7 7v2h-4v8h3c1.66 0 3-1.34 3-3v-7c0-4.97-4.03-9-9-9z"/></svg>
        </span>
        <span class="dot-nav__dot"></span>
      </a>
      <a href="#contacto" class="dot-nav__item" data-section="contacto" data-tooltip="{{#if isEs}}Contacto{{else}}Contact{{/if}}">
        <span class="dot-nav__icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
        </span>
        <span class="dot-nav__dot"></span>
      </a>
    </nav>

    <section class="hero-section" id="hero">
        <div class="hero-video-container">
           <img src="{{img '/assets/images/opi.png'}}" alt="Estadio de fútbol" class="hero-image" style="display: block;">

        </div>
        <div class="hero-content">
            <div class="hero-logo-text"> <img src="{{img '/assets/images/soccerid.png'}}" width="350px"></div>
            <h1 class="hero-tagline">AMAMOS TANTO EL DEPORTE<br>QUE NOS ATREVIMOS A REINVENTARLO</h1>
        </div>
        <a href="#servicios" class="scroll-indicator">
            <span class="scroll-text">Desliza</span>
            <div class="scroll-arrow"></div>
        </a>
    </section>
    
    <div class="main-container" id="mainContainer">
        <div class="container" id="servicios">
            <div class="bento-grid-section">
                <div class="bento-grid bento-grid-first" id="bentoGridFirst"></div>
            </div>
            <div class="bento-grid-section">
                <div class="bento-grid bento-grid-second" id="bentoGridSecond"></div>
            </div>
        </div>
    </div>

    <!-- ==================== PRÓXIMOS EVENTOS (COMBINADO) ==================== -->
    {{#if upcoming_events}}
    <section class="events-section" id="eventos">
        <div class="container">
            <header class="section-header">
                <h2>{{#if isEs}}Próximos Eventos{{else}}Upcoming Events{{/if}}</h2>
                <p>{{#if isEs}}Asegura tu lugar en tu evento favorito{{else}}Secure your spot at your favorite event{{/if}}</p>
            </header>
            <div class="events-grid" id="eventsGrid"></div>
        </div>

        <div class="mc-slider-area">
          <div class="mc-filters" id="matchCarouselFilters">
            <button class="mc-filter active" data-filter="all">{{#if isEs}}Todos{{else}}All{{/if}}</button>
            <button class="mc-filter" data-filter="clasico">{{#if isEs}}Clásicos{{else}}Clásicos{{/if}}</button>
            <button class="mc-filter" data-filter="rivalidad">{{#if isEs}}Rivalidades{{else}}Rivalries{{/if}}</button>
          </div>
          <div class="mc-track-wrapper">
            <div class="mc-track" id="matchCarouselTrack">
              {{#each upcoming_events}}
              <div class="mc-card" data-tipo="{{this.tipo}}">
                <div class="mc-card-badge">{{this.badge}} &middot; {{this.torneo}}</div>
                {{#if this.clasico}}<div class="mc-clasico">{{this.clasico}}</div>{{/if}}
                <div class="mc-matchup">
                  <div class="mc-team">
                    <div class="mc-team-icon"><img src="{{this.team1Icon}}" alt="{{this.team1}}"></div>
                    <span class="mc-team-name">{{this.team1}}</span>
                  </div>
                  <div class="mc-vs">VS</div>
                  <div class="mc-team">
                    <div class="mc-team-icon"><img src="{{this.team2Icon}}" alt="{{this.team2}}"></div>
                    <span class="mc-team-name">{{this.team2}}</span>
                  </div>
                </div>
                <div class="mc-info">
                  <div class="mc-pill">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
                    <span>{{this.date}}</span>
                  </div>
                  <div class="mc-pill">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                    <span>{{this.time}}</span>
                  </div>
                  <div class="mc-pill">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    <span>{{this.venue}}</span>
                  </div>
                </div>
                <div class="mc-actions">
                  <a href="/{{../lang}}/evento/{{this.id}}" class="mc-btn mc-btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 10V6c0-1.11-.9-2-2-2H4c-1.1 0-1.99.89-1.99 2v4c1.1 0 1.99.9 1.99 2s-.89 2-2 2v4c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-4c-1.1 0-2-.9-2-2s.9-2 2-2zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-2h2v2zm0-4.5h-2v-2h2v2z"/></svg>
                    {{#if ../isEs}}ACCESOS VIP{{else}}VIP ACCESS{{/if}}
                  </a>
                  <a href="https://wa.me/12315158991?text={{#if ../isEs}}Hola!%20Quiero%20accesos%20VIP%20para%20{{this.team1}}%20vs%20{{this.team2}}{{else}}Hi!%20I%20want%20VIP%20access%20for%20{{this.team1}}%20vs%20{{this.team2}}{{/if}}" target="_blank" class="mc-btn mc-btn-whatsapp">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  </a>
                </div>
              </div>
              {{/each}}
            </div>
          </div>
          <div class="mc-progress" id="matchCarouselProgress">
            <span class="mc-counter" id="matchCarouselCounter">1 / 1</span>
            <div class="mc-bar">
              <div class="mc-bar-fill" id="matchCarouselBar"></div>
            </div>
          </div>
        </div>

        <div class="container">
          <div class="view-all-events">
              <button class="view-all-btn" onclick="openEventsModal()">{{#if isEs}}Ver Todos los Eventos{{else}}View All Events{{/if}}<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></button>
          </div>
        </div>
    </section>
    <script>
    document.querySelectorAll('.mc-team-icon img').forEach(function(img) {
      img.onerror = function() {
        this.style.display='none';
        this.parentElement.innerHTML='<svg width="36" height="36" viewBox="0 0 24 24" fill="rgba(255,255,255,0.2)"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 3l2.5 2L13 9.5h-2L9.5 7 12 5zm-5.5 5L9 9l1.5 2.5L9 14l-2.5-1v-3zm3 7.5L8 16l1.5-2.5h5L16 16l-1.5 1.5h-5zm8-4.5L15 14l-1.5-2.5L15 9l2.5 1v3z" fill="rgba(255,255,255,0.3)"/></svg>';
      };
    });
    </script>
    {{/if}}

    <!-- INICIO DEL WIDGET (PODCAST) -->
    <div class="soccer-id-widget" id="podcastSection">
              <div id="widget-social-container"></div>
        <header class="widget-header">
            <div class="section-header">
                <h2 style="color:#ffffff !important; -webkit-text-fill-color:#ffffff;"> PODCAST </h2>
             </div>

            <div class="widget-tabs">
                <button class="widget-tab-btn active" data-target="video" title="Videos">
                    <svg viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
                </button>
                <button class="widget-tab-btn" data-target="audio" title="Audios">
                    <svg viewBox="0 0 24 24"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
                </button>
            </div>
        </header>
        <div class="widget-main-content">
            <div class="widget-playlist-section">
                <div class="widget-playlist-header">
                    <div>
                        <div class="widget-section-subtitle" id="widget-playlist-subtitle">VIDEO EPISODES</div>
                    </div>
                    <button class="widget-mobile-toggle-btn" id="widget-mobile-toggle-btn">
                        <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                </div>
                <div class="widget-playlist-items-wrapper" id="widget-playlist-wrapper">
                    <div class="widget-playlist-items" id="widget-playlist-container">
                    </div>
                </div>
            </div>
            <div class="widget-featured-section">
                <div class="widget-featured-container" id="widget-featured-container">
                </div>
            </div>
        </div>
    </div>
    <!-- FIN DEL WIDGET -->

