  .pp-closing__body h2 { font-size: 56px; font-weight: 900; margin-bottom: 16px; }
  .pp-closing__body p { font-size: 18px; color: rgba(255,255,255,0.7); margin-bottom: 28px; }
  .pp-closing__btn {
    display: inline-flex; align-items: center; gap: 10px;
