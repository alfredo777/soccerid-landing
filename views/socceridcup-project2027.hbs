  @media (max-width: 480px) {
    .pp-highlights { grid-template-columns: 1fr; }
    .pp-hero__teams { font-size: 28px; display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .pp-hero__teams em { margin: 0; font-size: 20px; }
    .pp-lock__card { padding: 32px 24px; }
    .pp-lock__digits { gap: 6px; }
    .pp-lock__digit { width: 38px; height: 48px; font-size: 20px; border-radius: 8px; }
    .pp-edition-card__match { font-size: 12px; }
