  // Si el servidor ya mandó la propuesta es porque la cookie de acceso era
  // válida: se muestra directo, sin volver a pedir el código. El estado del
  // acceso lo lleva esa cookie firmada, no el navegador.
  if (contenido.firstElementChild) {
    lock.style.display = 'none';
    contenido.style.display = 'block';
    initContenido();
  }

  var digits = document.querySelectorAll('.pp-lock__digit');
  var digitsWrap = document.getElementById('ppDigits');
  var btn = document.getElementById('ppSubmit');
  var err = document.getElementById('ppError');

  function getCode() {
    var code = '';
    digits.forEach(function(d) { code += d.value; });
    return code;
  }

  function updateFilled() {
    digits.forEach(function(d) {
      if (d.value) d.classList.add('filled');
      else d.classList.remove('filled');
    });
  }

  digits.forEach(function(d, i) {
    d.addEventListener('input', function() {
      var v = d.value.replace(/[^0-9]/g, '');
      d.value = v.charAt(0) || '';
      updateFilled();
      if (d.value && i < 6) digits[i + 1].focus();
      if (getCode().length === 7) tryAccess();
    });

    d.addEventListener('keydown', function(e) {
      if (e.key === 'Backspace' && !d.value && i > 0) {
        digits[i - 1].value = '';
        digits[i - 1].focus();
        updateFilled();
      }
      if (e.key === 'Enter') tryAccess();
    });

    d.addEventListener('paste', function(e) {
      e.preventDefault();
      var text = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '');
      for (var j = 0; j < 7 && j < text.length; j++) {
        digits[j].value = text.charAt(j);
      }
      updateFilled();
      var next = Math.min(text.length, 6);
      digits[next].focus();
      if (getCode().length === 7) tryAccess();
    });
  });

  digits[0].focus();

  var leadWrap = document.getElementById('ppLead');
  var leadName = document.getElementById('ppLeadName');
  var leadEmail = document.getElementById('ppLeadEmail');
  var leadBtn = document.getElementById('ppLeadBtn');
  var leadErr = document.getElementById('ppLeadError');
  var formWrap = document.querySelector('.pp-lock__form');
  var lastCode = '';
  // El candado tiene un solo renglón de error y ahora hay dos motivos: el
  // código no existe, o existe pero todavía no está habilitado.
  var errPorDefecto = err.textContent;
  var errSinNivel = {{#if isEs}}'Ese código todavía no está habilitado. Escríbele al organizador.'{{else}}'That code is not enabled yet. Please contact the organizer.'{{/if}};

  // Devuelve una promesa: quien la llama mantiene el botón en "..." hasta que
  // la propuesta esté en pantalla, para que se sienta un solo paso.
  function reveal() {
    if (contenido.firstElementChild) {
      lock.style.display = 'none';
      contenido.style.display = 'block';
      initContenido();
      return Promise.resolve();
    }
    // La propuesta todavía no está en la página: se pide al servidor —que
    // vuelve a comprobar la cookie de acceso— y se inyecta sin recargar.
    return fetch('/api/propuesta/{{variantId}}/contenido?lang={{lang}}', { credentials: 'same-origin' })
      .then(function(r) {
        if (!r.ok) throw new Error('sin acceso');
        // La propuesta puede no existir en el idioma de la dirección. El
        // servidor dice en qué idioma la mandó: si no es el que pedía la URL,
        // se corrige la barra. Como el contenido se inyecta y no se navega,
        // sin esto la dirección se quedaba diciendo /en con la propuesta en
        // español delante.
        var servido = r.headers.get('X-Idioma-Servido');
        if (servido && servido !== '{{lang}}' && window.history && history.replaceState) {
          history.replaceState(null, '', '/' + servido + '/{{slug}}');
        }
        return r.text();
      })
      .then(function(html) {
        contenido.innerHTML = html;
        lock.style.display = 'none';
        contenido.style.display = 'block';
        initContenido();
      })
      .catch(function() {
        // Si algo falla, recargar sí funciona: la cookie ya está puesta y el
        // servidor manda la propuesta directamente.
        window.location.reload();
      });
  }

  function post(payload) {
    // El endpoint es compartido por todas las propuestas; `variant` le dice
    // desde cuál se está entrando (queda en el log y en el aviso al admin).
    payload.variant = '{{variantId}}';
    // El idioma viaja para que, si el código manda a otra página, se conserve.
    payload.lang = '{{lang}}';
    return fetch('/api/project2027/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function(r) { return r.json(); });
  }

  function tryAccess() {
    var val = getCode();
    if (val.length < 7) return;
    btn.disabled = true;
    btn.textContent = '...';
    post({ code: val })
    .then(function(data) {
      // Con acceso concedido el botón se queda en "..." hasta que la propuesta
      // esté en pantalla: así el desbloqueo se lee como un solo paso.
      // El código abre otra página (por ejemplo, uno de partido tecleado en
      // el tour): se va para allá en vez de revelar esta.
      if (data.ok && data.ir) { window.location.href = data.ir; return; }
      if (data.ok) { return reveal(); }
      btn.disabled = false;
      btn.textContent = '{{lock.button}}';
      err.textContent = data.sinNivel ? errSinNivel : errPorDefecto;
      if (data.needLead) {
        lastCode = val;
        err.classList.remove('visible');
        if (formWrap) formWrap.style.display = 'none';
        leadWrap.style.display = 'block';
        leadName.focus();
        return;
      }
      err.classList.add('visible');
      digitsWrap.classList.add('shake');
      setTimeout(function() { digitsWrap.classList.remove('shake'); }, 400);
      digits.forEach(function(d) { d.value = ''; d.classList.remove('filled'); });
      digits[0].focus();
    })
    .catch(function() {
      btn.disabled = false;
      btn.textContent = '{{lock.button}}';
    });
  }
  btn.addEventListener('click', tryAccess);

  function submitLead() {
    var nm = (leadName.value || '').trim();
    var em = (leadEmail.value || '').trim();
    if (nm.length < 2 || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)) { leadErr.classList.add('visible'); return; }
    leadErr.classList.remove('visible');
    leadBtn.disabled = true;
    var original = leadBtn.textContent;
    leadBtn.textContent = '...';
    post({ code: lastCode, name: nm, email: em })
    .then(function(data) {
      if (data.ok && data.ir) { window.location.href = data.ir; return; }
      if (data.ok) { return reveal(); }
      leadBtn.disabled = false;
      leadBtn.textContent = original;
      if (data.sinNivel) leadErr.textContent = errSinNivel;
      leadErr.classList.add('visible');
    })
    .catch(function() { leadBtn.disabled = false; leadBtn.textContent = original; });
  }
  leadBtn.addEventListener('click', submitLead);
  leadEmail.addEventListener('keydown', function(e) { if (e.key === 'Enter') submitLead(); });

  // ─── Arranque de todo lo que vive DENTRO de la propuesta ───
  // Antes esto corría al cargar la página porque el contenido siempre estaba
  // ahí. Ahora el contenido puede llegar después (inyectado al desbloquear),
  // así que se agrupa aquí y se llama cuando ya está en el DOM. Es idempotente.
  var contenidoIniciado = false;
  function initContenido() {
    if (contenidoIniciado || !contenido.firstElementChild) return;
    contenidoIniciado = true;

  {{#if esTour}}
  // ─── Las gráficas del perfil anual crecen al entrar en pantalla ───
  // Se arman aquí (y no en CSS) para que sin JavaScript todo se vea quieto y
  // completo. Con reduced-motion no se arma nada.
  (function() {
    var piezas = contenido.querySelectorAll('.pa-anima');
    if (!piezas.length || !('IntersectionObserver' in window)) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    piezas.forEach(function(p) { p.classList.add('pa-anima--armada'); });
    var vigia = new IntersectionObserver(function(entradas) {
      entradas.forEach(function(e) {
        if (!e.isIntersecting) return;
        e.target.classList.add('pa-anima--on');
        vigia.unobserve(e.target);
      });
    }, { threshold: 0.15 });
    piezas.forEach(function(p) { vigia.observe(p); });
  })();

  // ─── Cajones laterales del perfil anual ───
  // Lo secundario (presupuesto, condiciones, trayectoria) se abre desde los
  // botones [data-cajon]. Los escuchadores van delegados en document, porque
  // este contenido se inyecta tras el candado y un escuchador atado a un
  // botón se iría con el nodo viejo. La guarda evita apilarlos si
  // initContenido corre dos veces.
  (function() {
    if (document.body.dataset.paCajones) return;
    document.body.dataset.paCajones = '1';
    var abierto = null, origen = null;

    function cerrar() {
      if (!abierto) return;
      var cajon = abierto; abierto = null;
      cajon.classList.remove('is-open');
      cajon.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      window.setTimeout(function() { cajon.hidden = true; }, 260);
      if (origen && origen.focus) origen.focus();
      origen = null;
    }
    function abrir(nombre, desde) {
      var cajon = document.getElementById('pa-cajon-' + nombre);
      if (!cajon) return;
      cerrar();
      abierto = cajon; origen = desde || null;
      cajon.hidden = false;
      cajon.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      window.requestAnimationFrame(function() { cajon.classList.add('is-open'); });
      var x = cajon.querySelector('.pa-cajon__x');
      if (x) window.setTimeout(function() { x.focus(); }, 280);
    }

    document.addEventListener('click', function(e) {
      var boton = e.target.closest('[data-cajon]');
      if (boton) { e.preventDefault(); abrir(boton.getAttribute('data-cajon'), boton); return; }
      if (e.target.closest('[data-cajon-cerrar]')) { e.preventDefault(); cerrar(); }
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && abierto) cerrar();
    });
  })();
  {{/if}}

  // ─── Calculadora de utilidades ───
  (function() {
    var cfgEl = document.getElementById('ppCalcCfg');
    var modal = document.getElementById('ppCalc');
    var openBtn = document.getElementById('ppCalcOpen');
    if (!cfgEl || !modal || !openBtn) return;

    var cfg = JSON.parse(cfgEl.textContent);
    var L = cfg.labels;
    // Con nivel de tour no se elige tipo: toda la participación es a riesgo,
    // y el selector ni siquiera se pinta.
    var state = { type: cfg.soloRiesgo ? 'risk' : 'fixed', cur: cfg.currencies[0], amount: 0, att: 0 };

    var elSymbol = document.getElementById('ppCalcSymbol');
    var elAmount = document.getElementById('ppCalcAmount');
    var elAmountRange = document.getElementById('ppCalcAmountRange');
    var elHint = document.getElementById('ppCalcHint');
    var elErr = document.getElementById('ppCalcErr');
    var elAttField = document.getElementById('ppCalcAttField');
    var elAtt = document.getElementById('ppCalcAtt');
    var elAttVal = document.getElementById('ppCalcAttVal');
    var elOcc = document.getElementById('ppCalcOcc');
    var elBreak = document.getElementById('ppCalcBreak');
    var elResult = document.getElementById('ppCalcResult');
    var amountBox = elAmount.closest('.pp-calc__amount');

    function nf(n) {
      return new Intl.NumberFormat(state.cur.locale, { maximumFractionDigits: 0 }).format(Math.round(n));
    }
    function money(n) {
      return (n < 0 ? '-' : '') + state.cur.symbol + nf(Math.abs(n));
    }
    function pct(n) {
      return new Intl.NumberFormat(state.cur.locale, { maximumFractionDigits: 1 }).format(n) + '%';
    }
    function fill(tpl, map) {
      return Object.keys(map).reduce(function(s, k) { return s.split('{' + k + '}').join(map[k]); }, tpl);
    }
    function digits(s) { return parseInt(String(s).replace(/[^0-9]/g, ''), 10) || 0; }
    function clamp(n, lo, hi) { return Math.min(hi, Math.max(lo, n)); }

    function setCurrency(cur, keepRatio) {
      var ratio = keepRatio && state.amount ? state.amount / state.cur.projectCost : null;
      state.cur = cur;
      elSymbol.textContent = cur.symbol;
      elAmountRange.min = cur.min;
      elAmountRange.max = cur.max;
      elAmountRange.step = cur.step;
      elHint.textContent = fill(L.amountHint, { min: cur.symbol + nf(cur.min), max: cur.symbol + nf(cur.max) });
      setAmount(ratio !== null ? ratio * cur.projectCost : cur.min);
    }

    function setAmount(n, fromInput) {
      state.amount = clamp(Math.round(n), state.cur.min, state.cur.max);
      if (!fromInput) elAmount.value = nf(state.amount);
      elAmountRange.value = state.amount;
      render();
    }

    // Verde para cifras a favor, rojo para cifras en contra
    function signo(n) {
      return n > 0 ? ' pp-calc__row--pos' : (n < 0 ? ' pp-calc__row--neg' : '');
    }

    function row(label, value, cls, sufijo, nota) {
      return '<div class="pp-calc__row' + (cls ? ' ' + cls : '') + '">' +
             '<span>' + label +
             (nota ? '<em class="pp-calc__rownote">' + nota + '</em>' : '') +
             '</span>' +
             '<span class="pp-calc__val"><strong>' + value + '</strong>' +
             (sufijo ? '<em class="pp-calc__pct">' + sufijo + '</em>' : '') +
             '</span></div>';
    }

    // Los tres pasos intermedios del proyecto van juntos en una tira compacta
    function tira(items) {
      return '<div class="pp-calc__math">' + items.map(function(it) {
        return '<div><span>' + it[0] + '</span><b' + (it[2] ? ' class="' + it[2] + '"' : '') +
               '>' + it[1] + '</b></div>';
      }).join('') + '</div>';
    }

    function render() {
      var a = state.amount, cur = state.cur, html = '<div class="pp-calc__rtitle">' + L.resultTitle + '</div>';
      html += row(L.investment, money(a), 'pp-calc__row--inv');

      if (state.type === 'fixed') {
        var profit = a * cfg.fixedRate / 100;
        var signoFijo = signo(profit);
        html += row(fill(L.fixedProfit, { rate: cfg.fixedRate }), money(profit), signoFijo);
        html += row(L.yield, pct(cfg.fixedRate), signoFijo);
        html += row(L.totalFixed, money(a + profit), 'pp-calc__row--big' + signoFijo);
      } else {
        // El proyecto reparte sus utilidades 50% SOCCER iD / 50% pool de
        // inversionistas; dentro del pool, cada quien va en proporción a su aporte.
        var splitPct = cfg.investorSplit;                 // 50
        var enCapital = a / cur.projectCost;              // % del capital requerido
        var efectiva = enCapital * (splitPct / 100);      // participación real en la utilidad
        var box = state.att * cur.ticketPrice;
        var projectProfit = box - cur.projectCost;
        // El 50/50 aplica SOLO a la utilidad. Si hay pérdida, el inversionista
        // la absorbe completa en proporción a su capital (no se reparte a la mitad).
        var pool = projectProfit > 0 ? projectProfit * (splitPct / 100) : projectProfit;
        var mine = pool * enCapital;
        var sgn = signo(mine);
        var rend = pct(a ? (mine / a) * 100 : 0);

        html += tira([
          [L.boxOffice, money(box), box > 0 ? 'is-pos' : ''],
          [L.projectCost, '− ' + money(cur.projectCost), 'is-neg'],
          [L.projectProfit, money(projectProfit), projectProfit > 0 ? 'is-pos' : (projectProfit < 0 ? 'is-neg' : '')]
        ]);
        html += row(L.yourProfit, money(mine), sgn);
        html += row(L.yield, rend, 'pp-calc__row--yield' + sgn);
        html += row(L.total, money(a + mine), 'pp-calc__row--big' + sgn, rend);
        var breakEven = Math.ceil(cur.projectCost / cur.ticketPrice);
        if (state.att < breakEven) {
          html += '<p class="pp-calc__warn">' + fill(L.breakEven, { n: nf(breakEven) }) + '</p>';
        }
      }
      elResult.innerHTML = html;
    }

    function setType(t) {
      state.type = t;
      elAttField.style.display = t === 'risk' ? '' : 'none';
      render();
    }

    function setAtt(n) {
      state.att = clamp(Math.round(n), 0, cfg.capacity);
      elAtt.value = state.att;
      elAttVal.textContent = nf(state.att);
      var occ = (state.att / cfg.capacity) * 100;
      elOcc.textContent = state.att >= cfg.capacity
        ? L.attendanceFull
        : L.attendanceSold + ' · ' + pct(occ) + ' ' + L.occupancy;
      var be = Math.ceil(state.cur.projectCost / state.cur.ticketPrice);
      if (elBreak) {
        elBreak.innerHTML = '<b>' + nf(be) + ' · ' + L.breakEvenTag + '</b><span>' + L.breakEvenHelp + '</span>';
        elBreak.classList.toggle('is-below', state.att < be);
      }
      render();
    }

    // Switch de dos posiciones: se puede tocar cualquiera de las dos
    // etiquetas o la pastilla para alternar.
    function segment(id, onPick) {
      var wrap = document.getElementById(id);
      if (!wrap) return;
      var lados = [].slice.call(wrap.querySelectorAll('.pp-switch__side'));
      var track = wrap.querySelector('.pp-switch__track');

      function elegir(i, avisar) {
        lados.forEach(function(x, j) { x.classList.toggle('is-active', j === i); });
        wrap.classList.toggle('is-second', i === 1);
        track.setAttribute('aria-checked', i === 1 ? 'true' : 'false');
        if (avisar !== false) onPick(lados[i].getAttribute('data-val'));
      }

      lados.forEach(function(x, i) {
        x.addEventListener('click', function() { elegir(i); });
      });
      track.addEventListener('click', function() {
        elegir(wrap.classList.contains('is-second') ? 0 : 1);
      });
    }

    if (!cfg.soloRiesgo) segment('ppCalcType', setType);
    segment('ppCalcCurrency', function(id) {
      var cur = cfg.currencies.filter(function(c) { return c.id === id; })[0];
      if (cur) setCurrency(cur, true);
    });

    elAmount.addEventListener('input', function() {
      var raw = digits(elAmount.value);
      elAmount.value = raw ? nf(raw) : '';
      var bad = raw < state.cur.min || raw > state.cur.max;
      amountBox.classList.toggle('is-error', bad);
      elErr.classList.toggle('is-visible', bad);
      if (bad) {
        elErr.textContent = fill(L.amountError, {
          min: state.cur.symbol + nf(state.cur.min),
          max: state.cur.symbol + nf(state.cur.max)
        });
      }
      setAmount(raw, true);
    });
    elAmount.addEventListener('blur', function() {
      amountBox.classList.remove('is-error');
      elErr.classList.remove('is-visible');
      setAmount(state.amount);
    });
    elAmountRange.addEventListener('input', function() {
      amountBox.classList.remove('is-error');
      elErr.classList.remove('is-visible');
      setAmount(+elAmountRange.value);
    });
    elAtt.addEventListener('input', function() { setAtt(+elAtt.value); });

    elAtt.max = cfg.capacity;
    setCurrency(cfg.currencies[0], false);
    // El tipo de arranque lo decide `state`, no una constante: con nivel de
    // tour no hay retorno fijo que ofrecer y arrancar en 'fixed' pintaba el
    // cálculo equivocado aunque el selector ya no estuviera.
    setType(state.type);
    setAtt(cfg.defaultAttendance || Math.ceil(cfg.currencies[0].projectCost / cfg.currencies[0].ticketPrice));

    function open() {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function close() {
      modal.hidden = true;
      document.body.style.overflow = '';
      openBtn.focus();
    }
    openBtn.addEventListener('click', open);
    modal.addEventListener('click', function(e) { if (e.target.closest('[data-calc-close]')) close(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !modal.hidden) close(); });
  })();

  // ─── Menú lateral de secciones ───
  (function() {
    var nav = document.getElementById('ppNav');
    if (!nav) return;
    var items = [].slice.call(nav.querySelectorAll('.pp-nav__item[href]'));
    var secciones = items.map(function(a) {
      return document.querySelector(a.getAttribute('href'));
    });

    // Desplazamiento propio: el scroll suave del navegador es demasiado
    // rapido para las distancias de esta pagina.
    var MS_POR_PIXEL = 0.52;  // sube este valor para que vaya mas lento
    var MS_MINIMO = 900;
    var MS_MAXIMO = 3200;
    var animando = null;

    function cancelar() {
      if (animando) { cancelAnimationFrame(animando); animando = null; }
    }
    ['wheel', 'touchstart', 'keydown'].forEach(function(evt) {
      window.addEventListener(evt, cancelar, { passive: true });
    });

    function desplazar(destino) {
      var inicio = window.pageYOffset;
      var delta = destino - inicio;
      var duracion = Math.min(MS_MAXIMO, Math.max(MS_MINIMO, Math.abs(delta) * MS_POR_PIXEL));
      var t0 = null;
      cancelar();
      function paso(t) {
        if (t0 === null) t0 = t;
        var p = Math.min((t - t0) / duracion, 1);
        // Arranca y frena despacio (easeInOutCubic)
        var e = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
        window.scrollTo(0, inicio + delta * e);
        if (p < 1) { animando = requestAnimationFrame(paso); }
        else { animando = null; }
      }
      animando = requestAnimationFrame(paso);
    }

    items.forEach(function(a, i) {
      a.addEventListener('click', function(e) {
        var destino = secciones[i];
        if (!destino) return;
        e.preventDefault();
        var y = destino.getBoundingClientRect().top + window.pageYOffset - 8;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          window.scrollTo(0, y);
        } else {
          desplazar(y);
        }
      });
    });

    var navCalc = document.getElementById('ppNavCalc');
    var abreCalc = document.getElementById('ppCalcOpen');
    if (navCalc && abreCalc) {
      navCalc.addEventListener('click', function() { abreCalc.click(); });
    }

    // ── Movil: el menu se despliega mostrando el titulo de cada icono ──
    function esMovil() { return window.matchMedia('(max-width: 768px)').matches; }
    var temporizador = null;
    var gracia = null;
    var presentando = false;   // margen para que el scroll de entrada no lo cierre de golpe
    var yAlAbrir = 0;
    var PX_PARA_CERRAR = 90;   // hay que desplazarse de verdad para replegarlo

    function abrirMenu(msAutoCierre, msGracia) {
      if (!esMovil()) return;
      nav.classList.add('is-open');
      yAlAbrir = window.pageYOffset;
      clearTimeout(temporizador);
      clearTimeout(gracia);
      presentando = !!msGracia;
      if (msGracia) gracia = setTimeout(function() { presentando = false; }, msGracia);
      if (msAutoCierre) temporizador = setTimeout(cerrarMenu, msAutoCierre);
    }
    function cerrarMenu() {
      clearTimeout(temporizador);
      clearTimeout(gracia);
      presentando = false;
      nav.classList.remove('is-open');
    }
    function replegarSiHuboScroll() {
      if (presentando || animando) return;
      if (!nav.classList.contains('is-open')) return;
      if (Math.abs(window.pageYOffset - yAlAbrir) > PX_PARA_CERRAR) cerrarMenu();
    }

    // El primer toque despliega; el siguiente ya navega.
    nav.addEventListener('click', function(e) {
      if (!esMovil()) return;
      if (!nav.classList.contains('is-open')) {
        e.preventDefault();
        e.stopPropagation();
        abrirMenu(5000);
      } else {
        setTimeout(cerrarMenu, 250);
      }
    }, true);

    document.addEventListener('click', function(e) {
      if (esMovil() && nav.classList.contains('is-open') && !nav.contains(e.target)) cerrarMenu();
    });
    window.addEventListener('resize', function() { if (!esMovil()) cerrarMenu(); });

    // El menú aparece al pasar el hero y marca la sección en curso
    var pendiente = false;
    var yaSePresento = false;
    function actualizar() {
      pendiente = false;
      var visible = window.pageYOffset > window.innerHeight * 0.6;
      nav.classList.toggle('is-visible', visible);
      if (visible && !yaSePresento) {
        yaSePresento = true;
        abrirMenu(4200, 1000);   // se presenta desplegado; luego el scroll lo repliega
      } else if (!visible) {
        cerrarMenu();
      }
      var referencia = window.pageYOffset + window.innerHeight * 0.35;
      var activo = -1;
      secciones.forEach(function(sec, i) {
        if (sec && sec.getBoundingClientRect().top + window.pageYOffset <= referencia) activo = i;
      });
      items.forEach(function(a, i) { a.classList.toggle('is-active', i === activo); });
    }
    window.addEventListener('scroll', function() {
      replegarSiHuboScroll();
      if (!pendiente) { pendiente = true; requestAnimationFrame(actualizar); }
    }, { passive: true });
    window.addEventListener('resize', actualizar);
    actualizar();
  })();

  // ─── ¿Por qué este partido?: panel colapsable ───
  (function() {
    var boton = document.getElementById('ppWhyBtn');
    var panel = document.getElementById('ppWhyPanel');
    if (!boton || !panel) return;
    boton.addEventListener('click', function() {
      var abierto = panel.hidden;
      panel.hidden = !abierto;
      boton.setAttribute('aria-expanded', abierto ? 'true' : 'false');
      if (abierto) panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  })();

  // ─── Notas de prensa: una por edición, el resto colapsadas ───
  (function() {
    var lista = document.getElementById('ppMediaList');
    var boton = document.getElementById('ppMediaToggle');
    if (!lista || !boton) return;
    var etiqueta = boton.querySelector('span');
    boton.addEventListener('click', function() {
      var abierto = lista.classList.toggle('is-expanded');
      boton.setAttribute('aria-expanded', abierto ? 'true' : 'false');
      etiqueta.textContent = boton.getAttribute(abierto ? 'data-menos' : 'data-mas');
      if (!abierto) lista.scrollIntoView({ block: 'nearest' });
    });
  })();

  // ─── Carrusel de "detrás de cámaras" ───
  // Vivía dentro del markup del contenido, pero al inyectarse con innerHTML
  // un <script> no se ejecuta. Vive aquí para que arranque igual venga el
  // contenido del servidor o inyectado tras desbloquear.
    (function(){
      var SHIELD_LABEL = '{{#if isEs}}Ver publicación{{else}}View post{{/if}}';
      document.querySelectorAll('.bts').forEach(function(root){
        var track = root.querySelector('.bts-track');
        if (!track) return;
        var prev = root.querySelector('.bts-prev'), next = root.querySelector('.bts-next');
        var dotsWrap = root.querySelector('.bts-dots');
        function step(){ var c = track.querySelector('.bts-card'); var w = c ? c.getBoundingClientRect().width : 0; return (w || 340) + 16; }
        // Flechas siempre activas: scrollBy se limita solo en los extremos
        if (prev) prev.addEventListener('click', function(){ track.scrollBy({ left: -step(), behavior:'smooth' }); });
        if (next) next.addEventListener('click', function(){ track.scrollBy({ left: step(), behavior:'smooth' }); });

        // Escudo transparente sobre cada embed: el swipe del carrusel funciona sobre el
        // embed (los iframes no capturan el gesto) y un tap abre la publicación original.
        track.querySelectorAll('.bts-embed').forEach(function(embed){
          if (embed.querySelector('.bts-shield')) return;
          var iframe = embed.querySelector('iframe'); if (!iframe) return;
          var src = iframe.getAttribute('src') || '';
          var link = '#', m = src.match(/instagram\.com\/p\/([^\/]+)\/embed/);
          if (m) { link = 'https://www.instagram.com/p/' + m[1] + '/'; }
          else { var fb = src.match(/[?&]href=([^&]+)/); if (fb) link = decodeURIComponent(fb[1]); }
          var a = document.createElement('a');
          a.className = 'bts-shield'; a.href = link; a.target = '_blank'; a.rel = 'noopener';
          a.setAttribute('aria-label', SHIELD_LABEL);
          embed.appendChild(a);
        });

        // Puntos indicadores (visibles en mobile): posición actual + navegación al tocar
        var cards = track.querySelectorAll('.bts-card');
        if (dotsWrap && cards.length) {
          cards.forEach(function(_, i){
            var b = document.createElement('button');
            b.type = 'button'; b.className = 'bts-dot-i'; b.setAttribute('aria-label', 'Ir a ' + (i + 1));
            b.addEventListener('click', function(){ cards[i].scrollIntoView({ behavior:'smooth', inline:'center', block:'nearest' }); });
            dotsWrap.appendChild(b);
          });
          var dots = dotsWrap.querySelectorAll('.bts-dot-i');
          var syncDots = function(){
            var tr = track.getBoundingClientRect(), center = tr.left + tr.width / 2, best = 0, bestDist = Infinity;
            cards.forEach(function(c, i){ var r = c.getBoundingClientRect(), cc = r.left + r.width / 2, d = Math.abs(cc - center); if (d < bestDist) { bestDist = d; best = i; } });
            dots.forEach(function(d, i){ d.classList.toggle('is-active', i === best); });
          };
          track.addEventListener('scroll', syncDots, { passive: true });
          window.addEventListener('resize', syncDots);
          syncDots();
        }

        var moved = false;
        // Táctil: distingue swipe de tap (el scroll horizontal es nativo con scroll-snap)
        var tsx = 0, tsy = 0;
        track.addEventListener('touchstart', function(e){ var t = e.touches[0]; tsx = t.clientX; tsy = t.clientY; moved = false; }, { passive: true });
        track.addEventListener('touchmove', function(e){ var t = e.touches[0]; if (Math.abs(t.clientX - tsx) > 8 || Math.abs(t.clientY - tsy) > 8) moved = true; }, { passive: true });
        // Arrastre con mouse en desktop
        var down = false, startX = 0, startLeft = 0;
        track.addEventListener('pointerdown', function(e){ if (e.pointerType === 'mouse') { down = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft; track.classList.add('is-dragging'); } });
        window.addEventListener('pointermove', function(e){ if (down) { var dx = e.clientX - startX; if (Math.abs(dx) > 3) moved = true; track.scrollLeft = startLeft - dx; } });
        window.addEventListener('pointerup', function(){ if (down) { down = false; track.classList.remove('is-dragging'); } });
        // Si hubo swipe/arrastre, no abrir el enlace (escudo o tarjeta de video)
        track.addEventListener('click', function(e){ var a = e.target.closest('.bts-shield, .bts-video'); if (a && moved) { e.preventDefault(); e.stopPropagation(); } }, true);
      });
    })();

  // ─── Botón de volver arriba ───
  // Ahora lo llevan las dos vistas, la propuesta de partido y el perfil del
  // tour, que es largo y se recorre entero.
  (function() {
    var btt = document.getElementById('ppBtt');
    if (!btt) return;
    // initContenido puede correr más de una vez (contenido ya servido, o
    // inyectado tras el candado): sin esto se apilarían los escuchas.
    if (btt.dataset.listo) return;
    btt.dataset.listo = '1';

    // El scroll dispara muchísimo; se deja que pinte el navegador.
    var pendiente = false;
    function repintar() {
      pendiente = false;
      btt.classList.toggle('visible', window.scrollY > 600);
    }
    window.addEventListener('scroll', function() {
      if (pendiente) return;
      pendiente = true;
      window.requestAnimationFrame(repintar);
    }, { passive: true });
    repintar();

    btt.addEventListener('click', function() {
      // Quien pidió menos movimiento no quiere ver la página entera desfilar.
      var quieto = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: quieto ? 'auto' : 'smooth' });
    });
  })();

  } // fin de initContenido
})();
</script>
