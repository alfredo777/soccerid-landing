  /* ─── VIDEOS ─── */
  .pp-videos { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; }
  .pp-video__wrap {
    position: relative; width: 100%; padding-bottom: 56.25%;
