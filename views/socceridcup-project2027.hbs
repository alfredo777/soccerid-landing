    }
  </style>
  <script>
    (function(){
      var SHIELD_LABEL = '{{#if isEs}}Ver publicación{{else}}View post{{/if}}';
      document.querySelectorAll('.bts').forEach(function(root){
        var track = root.querySelector('.bts-track');
        if (!track) return;
        var prev = root.querySelector('.bts-prev'), next = root.querySelector('.bts-next');
        var dotsWrap = root.querySelector('.bts-dots');
        function step(){ var c = track.querySelector('.bts-card'); var w = c ? c.getBoundingClientRect().width : 0; return (w || 340) + 16; }
        // Flechas siempre activas: scrollBy se limita solo en los extremos
        if (prev) prev.addEventListener('click', function(){ track.scrollBy({ left: -step(), behavior:'smooth' }); });
        if (next) next.addEventListener('click', function(){ track.scrollBy({ left: step(), behavior:'smooth' }); });

        // Escudo transparente sobre cada embed: el swipe del carrusel funciona sobre el
        // embed (los iframes no capturan el gesto) y un tap abre la publicación original.
        track.querySelectorAll('.bts-embed').forEach(function(embed){
          if (embed.querySelector('.bts-shield')) return;
          var iframe = embed.querySelector('iframe'); if (!iframe) return;
          var src = iframe.getAttribute('src') || '';
          var link = '#', m = src.match(/instagram\.com\/p\/([^\/]+)\/embed/);
          if (m) { link = 'https://www.instagram.com/p/' + m[1] + '/'; }
          else { var fb = src.match(/[?&]href=([^&]+)/); if (fb) link = decodeURIComponent(fb[1]); }
          var a = document.createElement('a');
          a.className = 'bts-shield'; a.href = link; a.target = '_blank'; a.rel = 'noopener';
          a.setAttribute('aria-label', SHIELD_LABEL);
          embed.appendChild(a);
        });

        // Puntos indicadores (visibles en mobile): posición actual + navegación al tocar
        var cards = track.querySelectorAll('.bts-card');
        if (dotsWrap && cards.length) {
          cards.forEach(function(_, i){
            var b = document.createElement('button');
            b.type = 'button'; b.className = 'bts-dot-i'; b.setAttribute('aria-label', 'Ir a ' + (i + 1));
            b.addEventListener('click', function(){ cards[i].scrollIntoView({ behavior:'smooth', inline:'center', block:'nearest' }); });
            dotsWrap.appendChild(b);
          });
          var dots = dotsWrap.querySelectorAll('.bts-dot-i');
          var syncDots = function(){
            var tr = track.getBoundingClientRect(), center = tr.left + tr.width / 2, best = 0, bestDist = Infinity;
            cards.forEach(function(c, i){ var r = c.getBoundingClientRect(), cc = r.left + r.width / 2, d = Math.abs(cc - center); if (d < bestDist) { bestDist = d; best = i; } });
            dots.forEach(function(d, i){ d.classList.toggle('is-active', i === best); });
          };
          track.addEventListener('scroll', syncDots, { passive: true });
          window.addEventListener('resize', syncDots);
          syncDots();
        }

        var moved = false;
        // Táctil: distingue swipe de tap (el scroll horizontal es nativo con scroll-snap)
        var tsx = 0, tsy = 0;
        track.addEventListener('touchstart', function(e){ var t = e.touches[0]; tsx = t.clientX; tsy = t.clientY; moved = false; }, { passive: true });
        track.addEventListener('touchmove', function(e){ var t = e.touches[0]; if (Math.abs(t.clientX - tsx) > 8 || Math.abs(t.clientY - tsy) > 8) moved = true; }, { passive: true });
        // Arrastre con mouse en desktop
        var down = false, startX = 0, startLeft = 0;
        track.addEventListener('pointerdown', function(e){ if (e.pointerType === 'mouse') { down = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft; track.classList.add('is-dragging'); } });
        window.addEventListener('pointermove', function(e){ if (down) { var dx = e.clientX - startX; if (Math.abs(dx) > 3) moved = true; track.scrollLeft = startLeft - dx; } });
        window.addEventListener('pointerup', function(){ if (down) { down = false; track.classList.remove('is-dragging'); } });
        // Si hubo swipe/arrastre, no abrir el enlace (escudo o tarjeta de video)
        track.addEventListener('click', function(e){ var a = e.target.closest('.bts-shield, .bts-video'); if (a && moved) { e.preventDefault(); e.stopPropagation(); } }, true);
      });
    })();
  </script>

