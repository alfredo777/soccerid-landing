    .pp-donut { width: 180px; height: 180px; }
    .pp-donut__hole { width: 100px; height: 100px; }
    .pp-donut__hole strong { font-size: 20px; }
    .pp-jump { font-size: 12px; letter-spacing: 1px; padding: 13px 20px; gap: 9px; }
    .pp-jump svg { width: 16px; height: 16px; }
    .pp-calc-cta { padding: 0 46px; }
    .pp-callout { gap: 14px; padding: 16px 18px; margin-top: 28px; align-items: flex-start; }
    .pp-callout__icon { width: 26px; height: 26px; margin-top: 2px; }
    .pp-callout p { font-size: 13.5px; line-height: 1.55; }
    .pp-callout--info { gap: 12px; }
    .pp-callout--info .pp-callout__icon { width: 22px; height: 22px; }
