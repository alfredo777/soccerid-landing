  .pp-timeline__badge::before {
    content: ''; width: 7px; height: 7px; border-radius: 50%; background: #22c55e; flex-shrink: 0;
    box-shadow: 0 0 0 0 rgba(34,197,94,0.6); animation: ppPulse 1.8s infinite;
