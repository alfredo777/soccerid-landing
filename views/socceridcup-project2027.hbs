  .pp-timeline__row--active .pp-timeline__activity { color: #fff; }
  .pp-timeline__row--active .pp-timeline__period { font-weight: 700; color: #22c55e; }
  .pp-timeline__badge {
    display: inline-flex; align-items: center; gap: 6px;
