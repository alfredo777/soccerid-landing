</style>

<script>
(function() {
  var stored = sessionStorage.getItem('pp2027');
  if (stored === 'granted') {
    document.getElementById('ppLock').style.display = 'none';
    document.getElementById('ppContent').style.display = 'block';
  }
  var digits = document.querySelectorAll('.pp-lock__digit');
  var digitsWrap = document.getElementById('ppDigits');
  var btn = document.getElementById('ppSubmit');
  var err = document.getElementById('ppError');

  function getCode() {
    var code = '';
    digits.forEach(function(d) { code += d.value; });
    return code;
  }

  function updateFilled() {
    digits.forEach(function(d) {
      if (d.value) d.classList.add('filled');
      else d.classList.remove('filled');
    });
  }

  digits.forEach(function(d, i) {
    d.addEventListener('input', function() {
      var v = d.value.replace(/[^0-9]/g, '');
      d.value = v.charAt(0) || '';
      updateFilled();
      if (d.value && i < 6) digits[i + 1].focus();
      if (getCode().length === 7) tryAccess();
    });

    d.addEventListener('keydown', function(e) {
      if (e.key === 'Backspace' && !d.value && i > 0) {
        digits[i - 1].value = '';
        digits[i - 1].focus();
        updateFilled();
      }
      if (e.key === 'Enter') tryAccess();
    });

    d.addEventListener('paste', function(e) {
      e.preventDefault();
      var text = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '');
      for (var j = 0; j < 7 && j < text.length; j++) {
        digits[j].value = text.charAt(j);
      }
      updateFilled();
      var next = Math.min(text.length, 6);
      digits[next].focus();
      if (getCode().length === 7) tryAccess();
    });
  });

  digits[0].focus();

  var leadWrap = document.getElementById('ppLead');
  var leadName = document.getElementById('ppLeadName');
  var leadEmail = document.getElementById('ppLeadEmail');
  var leadBtn = document.getElementById('ppLeadBtn');
  var leadErr = document.getElementById('ppLeadError');
  var formWrap = document.querySelector('.pp-lock__form');
  var lastCode = '';

  function reveal() {
    sessionStorage.setItem('pp2027', 'granted');
    document.getElementById('ppLock').style.display = 'none';
    document.getElementById('ppContent').style.display = 'block';
  }

  function post(payload) {
    return fetch('/api/project2027/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function(r) { return r.json(); });
  }

  function tryAccess() {
    var val = getCode();
    if (val.length < 7) return;
    btn.disabled = true;
    btn.textContent = '...';
    post({ code: val })
    .then(function(data) {
      btn.disabled = false;
      btn.textContent = '{{data.lock.button}}';
      if (data.ok) { reveal(); return; }
      if (data.needLead) {
        lastCode = val;
        err.classList.remove('visible');
        if (formWrap) formWrap.style.display = 'none';
        leadWrap.style.display = 'block';
        leadName.focus();
        return;
      }
      err.classList.add('visible');
      digitsWrap.classList.add('shake');
      setTimeout(function() { digitsWrap.classList.remove('shake'); }, 400);
      digits.forEach(function(d) { d.value = ''; d.classList.remove('filled'); });
      digits[0].focus();
    })
    .catch(function() {
      btn.disabled = false;
      btn.textContent = '{{data.lock.button}}';
    });
  }
  btn.addEventListener('click', tryAccess);

  function submitLead() {
    var nm = (leadName.value || '').trim();
    var em = (leadEmail.value || '').trim();
    if (nm.length < 2 || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)) { leadErr.classList.add('visible'); return; }
    leadErr.classList.remove('visible');
    leadBtn.disabled = true;
    var original = leadBtn.textContent;
    leadBtn.textContent = '...';
    post({ code: lastCode, name: nm, email: em })
    .then(function(data) {
      leadBtn.disabled = false;
      leadBtn.textContent = original;
      if (data.ok) { reveal(); return; }
      leadErr.classList.add('visible');
    })
    .catch(function() { leadBtn.disabled = false; leadBtn.textContent = original; });
  }
  leadBtn.addEventListener('click', submitLead);
  leadEmail.addEventListener('keydown', function(e) { if (e.key === 'Enter') submitLead(); });

  // ─── Calculadora de utilidades ───
  (function() {
    var cfgEl = document.getElementById('ppCalcCfg');
    var modal = document.getElementById('ppCalc');
    var openBtn = document.getElementById('ppCalcOpen');
    if (!cfgEl || !modal || !openBtn) return;

    var cfg = JSON.parse(cfgEl.textContent);
    var L = cfg.labels;
    var state = { type: 'fixed', cur: cfg.currencies[0], amount: 0, att: 0 };

    var elSymbol = document.getElementById('ppCalcSymbol');
    var elAmount = document.getElementById('ppCalcAmount');
    var elAmountRange = document.getElementById('ppCalcAmountRange');
    var elHint = document.getElementById('ppCalcHint');
    var elErr = document.getElementById('ppCalcErr');
    var elAttField = document.getElementById('ppCalcAttField');
    var elAtt = document.getElementById('ppCalcAtt');
    var elAttVal = document.getElementById('ppCalcAttVal');
    var elOcc = document.getElementById('ppCalcOcc');
    var elResult = document.getElementById('ppCalcResult');
    var amountBox = elAmount.closest('.pp-calc__amount');

    function nf(n) {
      return new Intl.NumberFormat(state.cur.locale, { maximumFractionDigits: 0 }).format(Math.round(n));
    }
    function money(n) {
      return (n < 0 ? '-' : '') + state.cur.symbol + nf(Math.abs(n));
    }
    function pct(n) {
      return new Intl.NumberFormat(state.cur.locale, { maximumFractionDigits: 1 }).format(n) + '%';
    }
    function fill(tpl, map) {
      return Object.keys(map).reduce(function(s, k) { return s.split('{' + k + '}').join(map[k]); }, tpl);
    }
    function digits(s) { return parseInt(String(s).replace(/[^0-9]/g, ''), 10) || 0; }
    function clamp(n, lo, hi) { return Math.min(hi, Math.max(lo, n)); }

    function setCurrency(cur, keepRatio) {
      var ratio = keepRatio && state.amount ? state.amount / state.cur.projectCost : null;
      state.cur = cur;
      elSymbol.textContent = cur.symbol;
      elAmountRange.min = cur.min;
      elAmountRange.max = cur.max;
      elAmountRange.step = cur.step;
      elHint.textContent = fill(L.amountHint, { min: cur.symbol + nf(cur.min), max: cur.symbol + nf(cur.max) });
      setAmount(ratio !== null ? ratio * cur.projectCost : cur.min);
    }

    function setAmount(n, fromInput) {
      state.amount = clamp(Math.round(n), state.cur.min, state.cur.max);
      if (!fromInput) elAmount.value = nf(state.amount);
      elAmountRange.value = state.amount;
      render();
    }

    function row(label, value, cls, sufijo) {
      return '<div class="pp-calc__row' + (cls ? ' ' + cls : '') + '">' +
             '<span>' + label + '</span>' +
             '<span class="pp-calc__val"><strong>' + value + '</strong>' +
             (sufijo ? '<em class="pp-calc__pct">' + sufijo + '</em>' : '') +
             '</span></div>';
    }

    // Los tres pasos intermedios del proyecto van juntos en una tira compacta
    function tira(items) {
      return '<div class="pp-calc__math">' + items.map(function(it) {
        return '<div><span>' + it[0] + '</span><b' + (it[2] ? ' class="' + it[2] + '"' : '') +
               '>' + it[1] + '</b></div>';
      }).join('') + '</div>';
    }

    function render() {
      var a = state.amount, cur = state.cur, html = '<div class="pp-calc__rtitle">' + L.resultTitle + '</div>';
      html += row(L.investment, money(a), 'pp-calc__row--inv');

      if (state.type === 'fixed') {
        var profit = a * cfg.fixedRate / 100;
        html += row(fill(L.fixedProfit, { rate: cfg.fixedRate }), money(profit));
        html += row(L.yield, pct(cfg.fixedRate));
        html += row(L.totalFixed, money(a + profit), 'pp-calc__row--big');
      } else {
        var share = a / cur.projectCost;
        var box = state.att * cur.ticketPrice;
        var projectProfit = box - cur.projectCost;
        var mine = projectProfit * share;
        var neg = mine < 0 ? ' pp-calc__row--neg' : '';
        var rend = pct(a ? (mine / a) * 100 : 0);
        html += row(L.share, pct(share * 100));
        html += tira([
          [L.boxOffice, money(box)],
          [L.projectCost, '− ' + money(cur.projectCost)],
          [L.projectProfit, money(projectProfit), projectProfit < 0 ? 'is-neg' : '']
        ]);
        html += row(L.yourProfit, money(mine), neg);
        html += row(L.yield, rend, 'pp-calc__row--yield' + neg);
        html += row(L.total, money(a + mine), 'pp-calc__row--big' + neg, rend);
        var breakEven = Math.ceil(cur.projectCost / cur.ticketPrice);
        if (state.att < breakEven) {
          html += '<p class="pp-calc__warn">' + fill(L.breakEven, { n: nf(breakEven) }) + '</p>';
        }
      }
      elResult.innerHTML = html;
    }

    function setType(t) {
      state.type = t;
      elAttField.style.display = t === 'risk' ? '' : 'none';
      render();
    }

    function setAtt(n) {
      state.att = clamp(Math.round(n), 0, cfg.capacity);
      elAtt.value = state.att;
      elAttVal.textContent = nf(state.att);
      var occ = (state.att / cfg.capacity) * 100;
      elOcc.textContent = state.att >= cfg.capacity
        ? L.attendanceFull
        : L.attendanceSold + ' · ' + pct(occ) + ' ' + L.occupancy;
      render();
    }

    // Switch de dos posiciones: se puede tocar cualquiera de las dos
    // etiquetas o la pastilla para alternar.
    function segment(id, onPick) {
      var wrap = document.getElementById(id);
      var lados = [].slice.call(wrap.querySelectorAll('.pp-switch__side'));
      var track = wrap.querySelector('.pp-switch__track');

      function elegir(i, avisar) {
        lados.forEach(function(x, j) { x.classList.toggle('is-active', j === i); });
        wrap.classList.toggle('is-second', i === 1);
        track.setAttribute('aria-checked', i === 1 ? 'true' : 'false');
        if (avisar !== false) onPick(lados[i].getAttribute('data-val'));
      }

      lados.forEach(function(x, i) {
        x.addEventListener('click', function() { elegir(i); });
      });
      track.addEventListener('click', function() {
        elegir(wrap.classList.contains('is-second') ? 0 : 1);
      });
    }

    segment('ppCalcType', setType);
    segment('ppCalcCurrency', function(id) {
      var cur = cfg.currencies.filter(function(c) { return c.id === id; })[0];
      if (cur) setCurrency(cur, true);
    });

    elAmount.addEventListener('input', function() {
      var raw = digits(elAmount.value);
      elAmount.value = raw ? nf(raw) : '';
      var bad = raw < state.cur.min || raw > state.cur.max;
      amountBox.classList.toggle('is-error', bad);
      elErr.classList.toggle('is-visible', bad);
      if (bad) {
        elErr.textContent = fill(L.amountError, {
          min: state.cur.symbol + nf(state.cur.min),
          max: state.cur.symbol + nf(state.cur.max)
        });
      }
      setAmount(raw, true);
    });
    elAmount.addEventListener('blur', function() {
      amountBox.classList.remove('is-error');
      elErr.classList.remove('is-visible');
      setAmount(state.amount);
    });
    elAmountRange.addEventListener('input', function() {
      amountBox.classList.remove('is-error');
      elErr.classList.remove('is-visible');
      setAmount(+elAmountRange.value);
    });
    elAtt.addEventListener('input', function() { setAtt(+elAtt.value); });

    elAtt.max = cfg.capacity;
    setCurrency(cfg.currencies[0], false);
    setType('fixed');
    setAtt(Math.round(cfg.capacity * 0.688 / 100) * 100);

    function open() {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function close() {
      modal.hidden = true;
      document.body.style.overflow = '';
      openBtn.focus();
    }
    openBtn.addEventListener('click', open);
    modal.addEventListener('click', function(e) { if (e.target.closest('[data-calc-close]')) close(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !modal.hidden) close(); });
  })();

  // ─── Menú lateral de secciones ───
  (function() {
    var nav = document.getElementById('ppNav');
    if (!nav) return;
    var items = [].slice.call(nav.querySelectorAll('.pp-nav__item[href]'));
    var secciones = items.map(function(a) {
      return document.querySelector(a.getAttribute('href'));
    });

    // Desplazamiento propio: el scroll suave del navegador es demasiado
    // rapido para las distancias de esta pagina.
    var MS_POR_PIXEL = 0.52;  // sube este valor para que vaya mas lento
    var MS_MINIMO = 900;
    var MS_MAXIMO = 3200;
    var animando = null;

    function cancelar() {
      if (animando) { cancelAnimationFrame(animando); animando = null; }
    }
    ['wheel', 'touchstart', 'keydown'].forEach(function(evt) {
      window.addEventListener(evt, cancelar, { passive: true });
    });

    function desplazar(destino) {
      var inicio = window.pageYOffset;
      var delta = destino - inicio;
      var duracion = Math.min(MS_MAXIMO, Math.max(MS_MINIMO, Math.abs(delta) * MS_POR_PIXEL));
      var t0 = null;
      cancelar();
      function paso(t) {
        if (t0 === null) t0 = t;
        var p = Math.min((t - t0) / duracion, 1);
        // Arranca y frena despacio (easeInOutCubic)
        var e = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
        window.scrollTo(0, inicio + delta * e);
        if (p < 1) { animando = requestAnimationFrame(paso); }
        else { animando = null; }
      }
      animando = requestAnimationFrame(paso);
    }

    items.forEach(function(a, i) {
      a.addEventListener('click', function(e) {
        var destino = secciones[i];
        if (!destino) return;
        e.preventDefault();
        var y = destino.getBoundingClientRect().top + window.pageYOffset - 8;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          window.scrollTo(0, y);
        } else {
          desplazar(y);
        }
      });
    });

    var navCalc = document.getElementById('ppNavCalc');
    var abreCalc = document.getElementById('ppCalcOpen');
    if (navCalc && abreCalc) {
      navCalc.addEventListener('click', function() { abreCalc.click(); });
    }

    // ── Movil: el menu se despliega mostrando el titulo de cada icono ──
    function esMovil() { return window.matchMedia('(max-width: 768px)').matches; }
    var temporizador = null;
    var gracia = null;
    var presentando = false;   // breve margen para que el scroll de entrada no lo cierre de golpe

    function abrirMenu(msAutoCierre, msGracia) {
      if (!esMovil()) return;
      nav.classList.add('is-open');
      clearTimeout(temporizador);
      clearTimeout(gracia);
      presentando = !!msGracia;
      if (msGracia) gracia = setTimeout(function() { presentando = false; }, msGracia);
      if (msAutoCierre) temporizador = setTimeout(cerrarMenu, msAutoCierre);
    }
    function cerrarMenu() {
      clearTimeout(temporizador);
      clearTimeout(gracia);
      presentando = false;
      nav.classList.remove('is-open');
    }

    // El primer toque despliega; el siguiente ya navega.
    nav.addEventListener('click', function(e) {
      if (!esMovil()) return;
      if (!nav.classList.contains('is-open')) {
        e.preventDefault();
        e.stopPropagation();
        abrirMenu(3500);
      } else {
        setTimeout(cerrarMenu, 250);
      }
    }, true);

    document.addEventListener('click', function(e) {
      if (esMovil() && nav.classList.contains('is-open') && !nav.contains(e.target)) cerrarMenu();
    });
    window.addEventListener('resize', function() { if (!esMovil()) cerrarMenu(); });

    // El menú aparece al pasar el hero y marca la sección en curso
    var pendiente = false;
    var yaSePresento = false;
    function actualizar() {
      pendiente = false;
      var visible = window.pageYOffset > window.innerHeight * 0.6;
      nav.classList.toggle('is-visible', visible);
      if (visible && !yaSePresento) {
        yaSePresento = true;
        abrirMenu(2400, 650);   // se presenta desplegado; el scroll lo repliega enseguida
      } else if (!visible) {
        cerrarMenu();
      }
      var referencia = window.pageYOffset + window.innerHeight * 0.35;
      var activo = -1;
      secciones.forEach(function(sec, i) {
        if (sec && sec.getBoundingClientRect().top + window.pageYOffset <= referencia) activo = i;
      });
      items.forEach(function(a, i) { a.classList.toggle('is-active', i === activo); });
    }
    window.addEventListener('scroll', function() {
      if (!presentando && !animando && nav.classList.contains('is-open')) cerrarMenu();
      if (!pendiente) { pendiente = true; requestAnimationFrame(actualizar); }
    }, { passive: true });
    window.addEventListener('resize', actualizar);
    actualizar();
  })();

  var btt = document.getElementById('ppBtt');
  window.addEventListener('scroll', function() {
    if (window.scrollY > 600) btt.classList.add('visible');
    else btt.classList.remove('visible');
  });
  btt.addEventListener('click', function() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>
