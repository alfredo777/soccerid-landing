  }

  /* ─── FOOTER ─── */
  .pp-footer {
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 48px; border-top: 1px solid rgba(255,255,255,0.06);
  }
  .pp-footer span { font-size: 12px; color: rgba(255,255,255,0.3); }
  .pp-btt {
    position: fixed; bottom: 32px; right: 32px; z-index: 90;
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--pp-gold); color: #000; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.3s, transform 0.3s;
    box-shadow: 0 4px 16px rgba(0,0,0,0.4);
  }
  .pp-btt.visible { opacity: 1; pointer-events: auto; }
  .pp-btt:hover { transform: scale(1.1); }
  .pp-btt svg { width: 22px; height: 22px; }

  /* ─── MOBILE ─── */
  @media (max-width: 1024px) {
    .pp-highlights { grid-template-columns: repeat(2, 1fr); }
