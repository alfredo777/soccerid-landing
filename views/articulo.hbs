<div class="promo-page">
  <a href="/{{lang}}" class="promo-back">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    <span>SOCCER iD</span>
  </a>

  <div class="promo-banner">
    <img src="{{articulo.image}}" alt="{{articulo.title}}">
    {{#if articulo.typeBadge}}
    <span class="article-badge article-badge--{{articulo.type}}">
      {{#eq articulo.type "video"}}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      {{/eq}}
      {{#eq articulo.type "magazine"}}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"/><path d="M7 7h10v2H7zm0 4h10v2H7zm0 4h7v2H7z"/></svg>
      {{/eq}}
      {{articulo.typeBadge}}
    </span>
    {{/if}}
  </div>

  <div class="promo-content">
    <span class="promo-badge">{{articulo.source}}</span>

    <h1 class="article-title">{{articulo.title}}</h1>
    <p class="article-excerpt">{{articulo.excerpt}}</p>

    {{#eq articulo.type "video"}}
    <div class="article-video-wrapper">
      <video controls playsinline preload="metadata" poster="{{articulo.image}}">
        <source src="{{articulo.videoUrl}}" type="video/mp4">
        {{#if isEs}}Tu navegador no soporta video.{{else}}Your browser does not support video.{{/if}}
      </video>
    </div>
    {{/eq}}

    {{#eq articulo.type "magazine"}}
    {{#if articulo.magazineData.pages}}
    <div class="mag-viewer" id="magViewer">
      <div class="mag-viewer__display">
        <button class="mag-viewer__arrow mag-viewer__arrow--prev" id="magPrev" type="button" disabled>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="mag-viewer__page" id="magPage">
          <img src="{{articulo.magazineData.pages.[0].url}}" alt="{{articulo.magazineData.pages.[0].alt}}" draggable="false">
        </div>
        <button class="mag-viewer__arrow mag-viewer__arrow--next" id="magNext" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
      <div class="mag-viewer__counter">
        <span id="magCurrent">1</span> / <span id="magTotal">{{articulo.pageCount}}</span>
      </div>
      <div class="mag-viewer__thumbs" id="magThumbs">
        {{#each articulo.magazineData.pages}}
        <div class="mag-thumb{{#if @first}} active{{/if}}" data-idx="{{@index}}">
          <img src="{{this.url}}" alt="{{this.alt}}" draggable="false">
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}
    {{/eq}}

    <div class="promo-cta">
      {{#eq articulo.type "video"}}
      <a href="{{articulo.videoUrl}}" target="_blank" class="cta-video">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        {{#if isEs}}Ver Video Completo{{else}}Watch Full Video{{/if}}
      </a>
      {{/eq}}
      {{#eq articulo.type "magazine"}}
      <a href="{{articulo.url}}" target="_blank" class="cta-magazine">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14z"/><path d="M7 7h10v2H7zm0 4h10v2H7zm0 4h7v2H7z"/></svg>
        {{#if isEs}}Leer Revista{{else}}Read Magazine{{/if}}
      </a>
      {{/eq}}
      {{#eq articulo.type "link"}}
      <a href="{{articulo.url}}" target="_blank" class="cta-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        {{#if isEs}}Leer Articulo Completo{{else}}Read Full Article{{/if}}
      </a>
      {{/eq}}
    </div>

    <div class="promo-share">
      <a href="https://wa.me/?text={{articulo.title}}%20{{baseUrl}}/{{lang}}/articulo/{{articulo.id}}" target="_blank" title="WhatsApp">
        <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      </a>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{baseUrl}}/{{lang}}/articulo/{{articulo.id}}" target="_blank" title="Facebook">
        <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href="https://twitter.com/intent/tweet?text={{articulo.title}}&url={{baseUrl}}/{{lang}}/articulo/{{articulo.id}}" target="_blank" title="X / Twitter">
        <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </div>

    <div class="promo-logo">
      <img src="/assets/images/iconsoccerid.png" alt="SOCCER iD">
    </div>
    <div class="promo-powered">SOCCER iD &copy; {{year}}</div>
  </div>
</div>

<style>
  .article-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
  }
  .article-badge--video {
    background: linear-gradient(135deg, #e53e3e, #c53030);
    color: #fff;
    box-shadow: 0 4px 12px rgba(229,62,62,0.4);
  }
  .article-badge--magazine {
    background: linear-gradient(135deg, #6c3ce0, #9b59f0);
    color: #fff;
    box-shadow: 0 4px 12px rgba(108,60,224,0.4);
  }
  .article-badge--link {
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(8px);
    color: rgba(255,255,255,0.85);
    border: 1px solid rgba(255,255,255,0.1);
  }

  .promo-banner {
    position: relative;
  }

  .article-title {
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: 14px;
    text-align: center;
  }

  .article-excerpt {
    color: rgba(255,255,255,0.6);
    font-size: 1rem;
    line-height: 1.7;
    text-align: center;
    margin-bottom: 28px;
    max-width: 600px;
  }

  .article-video-wrapper {
    width: 100%;
    margin-bottom: 24px;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }

  .article-video-wrapper video {
    width: 100%;
    display: block;
    max-height: 440px;
    object-fit: contain;
    background: #000;
  }

  .promo-cta a.cta-video {
    background: linear-gradient(135deg, #e53e3e, #c53030);
    box-shadow: 0 8px 24px rgba(229,62,62,0.3);
  }
  .promo-cta a.cta-video:hover {
    box-shadow: 0 12px 32px rgba(229,62,62,0.45);
  }

  .promo-cta a.cta-magazine {
    background: linear-gradient(135deg, #6c3ce0, #9b59f0);
    box-shadow: 0 8px 24px rgba(108,60,224,0.3);
  }
  .promo-cta a.cta-magazine:hover {
    box-shadow: 0 12px 32px rgba(108,60,224,0.45);
  }

  .promo-cta a.cta-link {
    background: linear-gradient(135deg, #667eea, #764ba2);
    box-shadow: 0 8px 24px rgba(102,126,234,0.3);
  }
  .promo-cta a.cta-link:hover {
    box-shadow: 0 12px 32px rgba(102,126,234,0.45);
  }

  /* Magazine Inline Viewer */
  .mag-viewer {
    width: 100%;
    margin-bottom: 28px;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
  }
  .mag-viewer__display {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    min-height: 300px;
  }
  .mag-viewer__page {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    width: 100%;
    user-select: none;
    -webkit-user-select: none;
  }
  .mag-viewer__page img {
    max-width: 100%;
    max-height: 520px;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .mag-viewer__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .mag-viewer__arrow:hover:not(:disabled) {
    background: rgba(108,60,224,0.6);
    border-color: rgba(155,89,240,0.5);
  }
  .mag-viewer__arrow:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }
  .mag-viewer__arrow--prev { left: 8px; }
  .mag-viewer__arrow--next { right: 8px; }
  .mag-viewer__counter {
    text-align: center;
    padding: 10px;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    background: rgba(0,0,0,0.4);
  }
  .mag-viewer__thumbs {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    overflow-x: auto;
    background: rgba(0,0,0,0.3);
    scrollbar-width: thin;
    scrollbar-color: rgba(155,89,240,0.4) transparent;
  }
  .mag-viewer__thumbs::-webkit-scrollbar { height: 4px; }
  .mag-viewer__thumbs::-webkit-scrollbar-thumb { background: rgba(155,89,240,0.4); border-radius: 2px; }
  .mag-thumb {
    flex-shrink: 0;
    width: 60px;
    height: 80px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    opacity: 0.5;
    transition: all 0.2s;
  }
  .mag-thumb.active {
    border-color: #9b59f0;
    opacity: 1;
    box-shadow: 0 0 12px rgba(155,89,240,0.4);
  }
  .mag-thumb:hover { opacity: 0.8; }
  .mag-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

{{#eq articulo.type "magazine"}}
{{#if articulo.magazineData.pages}}
<script>
(function() {
  var pages = [{{#each articulo.magazineData.pages}}"{{this.url}}"{{#unless @last}},{{/unless}}{{/each}}];
  var alts = [{{#each articulo.magazineData.pages}}"{{this.alt}}"{{#unless @last}},{{/unless}}{{/each}}];
  var cur = 0;
  var img = document.querySelector('#magPage img');
  var prev = document.getElementById('magPrev');
  var next = document.getElementById('magNext');
  var counter = document.getElementById('magCurrent');
  var thumbs = document.querySelectorAll('.mag-thumb');

  function go(i) {
    if (i < 0 || i >= pages.length || i === cur) return;
    cur = i;
    img.style.opacity = '0';
    setTimeout(function() {
      img.src = pages[cur];
      img.alt = alts[cur] || '';
      img.style.opacity = '1';
    }, 150);
    counter.textContent = cur + 1;
    prev.disabled = cur === 0;
    next.disabled = cur === pages.length - 1;
    thumbs.forEach(function(t, idx) {
      t.classList.toggle('active', idx === cur);
      if (idx === cur) t.scrollIntoView({behavior:'smooth', block:'nearest', inline:'center'});
    });
  }

  prev.addEventListener('click', function() { go(cur - 1); });
  next.addEventListener('click', function() { go(cur + 1); });
  thumbs.forEach(function(t) {
    t.addEventListener('click', function() { go(parseInt(t.dataset.idx)); });
  });

  var startX = 0;
  var display = document.querySelector('.mag-viewer__display');
  display.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; }, {passive:true});
  display.addEventListener('touchend', function(e) {
    var diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) go(diff > 0 ? cur + 1 : cur - 1);
  }, {passive:true});
})();
</script>
{{/if}}
{{/eq}}
