  }
  .gl-lightbox__nav:hover { background: rgba(108,60,224,0.5); border-color: rgba(108,60,224,0.5); }
  .gl-lightbox__nav--prev { left: 16px; }
  .gl-lightbox__nav--next { right: 16px; }

  .gl-lightbox__counter {
