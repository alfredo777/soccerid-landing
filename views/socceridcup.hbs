<div class="promo-page gallery-page">

  <!-- ═══ HERO ═══ -->
  <section class="gp-hero">
    <img class="gp-hero__bg" src="{{galeria.banner}}" alt="{{galeria.title}}">
    <div class="gp-hero__dim"></div>
    <div class="gp-hero__grain"></div>

    <a href="/{{lang}}" class="gp-nav-back">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    </a>

    <div class="gp-hero__share">
      <a href="https://wa.me/?text={{ogTitle}}%20{{baseUrl}}/{{lang}}/socceridcup" target="_blank" title="WhatsApp"><svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></a>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{baseUrl}}/{{lang}}/socceridcup" target="_blank" title="Facebook"><svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
      <a class="gp-hero__share-x" onclick="window.open('https://x.com/intent/tweet?text=' + encodeURIComponent(document.title) + '&url=' + encodeURIComponent(window.location.href), '_blank', 'width=550,height=420'); return false;" href="#" title="X"><svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
    </div>

    <div class="gp-hero__body">
      <div class="gp-hero__logo">
        <img src="/assets/images/iconsoccerid.png" alt="SOCCER iD" height="36">
      </div>
      <h1 class="gp-hero__title">
        <span class="gp-hero__title-main">{{galeria.title}}</span>
        {{#if galeria.year}}<span class="gp-hero__title-year">{{galeria.year}}</span>{{/if}}
      </h1>
      <p class="gp-hero__sub">{{galeria.subtitle}}</p>
      <div class="gp-hero__pills">
        <span class="gp-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>
          {{galeria.date}}
        </span>
        <span class="gp-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          {{galeria.venue}}
        </span>
      </div>
      <a class="gp-hero__wa" href="https://wa.me/525534660028?text={{galeria.ctaMessage}}" target="_blank">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        {{galeria.ctaText}}
      </a>
      <button class="gp-hero__cta" onclick="document.getElementById('statsSection').scrollIntoView({behavior:'smooth'})" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
      </button>
    </div>
  </section>

  <!-- ═══ STATS ═══ -->
  <section class="gp-stats" id="statsSection">
    <div class="gp-stats__inner">
      <div class="gp-stats__text">
        <span class="gp-label">{{#if isEs}}EL EVENTO{{else}}THE EVENT{{/if}}</span>
        <h2 class="gp-stats__heading">{{galeria.description}}</h2>
      </div>
      <div class="gp-stats__cards">
        {{#each galeria.stats}}
        <div class="gp-stat-card">
          <span class="gp-stat-card__value">{{this.value}}</span>
          <span class="gp-stat-card__label">{{this.label}}</span>
          <span class="gp-stat-card__sub">{{this.sub}}</span>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ═══ QUÉ HACEMOS / WHAT WE DO ═══ -->
  <section class="gp-whatwedo">
    <div class="gp-whatwedo__inner">
      <span class="gp-label">{{#if isEs}}QUÉ HACEMOS{{else}}WHAT WE DO{{/if}}</span>
      <h2 class="gp-section-title">{{#if isEs}}Experiencia en el mercado{{else}}Market Experience{{/if}}</h2>
      <div class="gp-whatwedo__grid">
        <div class="gp-whatwedo__card">
          <div class="gp-whatwedo__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 000 20M12 2a14.5 14.5 0 010 20M2 12h20"/></svg>
          </div>
          <h3>{{#if isEs}}Partidos Internacionales{{else}}International Matches{{/if}}</h3>
          <p>{{galeria.description}}</p>
        </div>
        <div class="gp-whatwedo__card">
          <div class="gp-whatwedo__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <h3>Meet & Greet</h3>
          <p>{{#if isEs}}Experiencias exclusivas con jugadores profesionales de los equipos participantes.{{else}}Exclusive experiences with professional players from the participating teams.{{/if}}</p>
        </div>
        <div class="gp-whatwedo__card">
          <div class="gp-whatwedo__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
          </div>
          <h3>{{#if isEs}}Patrocinios{{else}}Sponsorships{{/if}}</h3>
          <p>{{#if isEs}}Oportunidades de patrocinio y branding en eventos de alto impacto.{{else}}Sponsorship and branding opportunities in high-impact events.{{/if}}</p>
        </div>
        <div class="gp-whatwedo__card">
          <div class="gp-whatwedo__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.5 10c-.83 0-1.5-.67-1.5-1.5v-5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5zM20.5 10H19V8.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM9.5 14c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5S8 21.33 8 20.5v-5c0-.83.67-1.5 1.5-1.5zM3.5 14H5v1.5c0 .83-.67 1.5-1.5 1.5S2 16.33 2 15.5 2.67 14 3.5 14zM21.5 14c0-.83-.67-1.5-1.5-1.5h-5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5h5c.83 0 1.5-.67 1.5-1.5zM10 3.5c0 .83-.67 1.5-1.5 1.5h-5C2.67 5 2 4.33 2 3.5S2.67 2 3.5 2h5c.83 0 1.5.67 1.5 1.5z"/></svg>
          </div>
          <h3>{{#if isEs}}Hospitalidad{{else}}Hospitality{{/if}}</h3>
          <p>{{#if isEs}}Suites VIP, experiencias premium y servicios exclusivos en cada evento.{{else}}VIP suites, premium experiences, and exclusive services at every event.{{/if}}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ALCANCE / REACH ═══ -->
  <section class="gp-reach">
    <div class="gp-reach__inner">
      <span class="gp-label">{{#if isEs}}ALCANCE DE LA COPA{{else}}CUP REACH{{/if}}</span>
      <div class="gp-reach__cards">
        {{#each galeria.reach}}
        <div class="gp-reach__card">
          <div class="gp-reach__icon">
            {{#eq this.icon 'stadium'}}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7v4a9 9 0 0018 0V7"/><path d="M3 7c0-1.1 4.03-2 9-2s9 .9 9 2"/><ellipse cx="12" cy="7" rx="9" ry="2"/></svg>
            {{/eq}}
            {{#eq this.icon 'tv'}}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><path d="M17 2l-5 5-5-5"/></svg>
            {{/eq}}
            {{#eq this.icon 'social'}}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
            {{/eq}}
          </div>
          <span class="gp-reach__value">{{this.value}}</span>
          <span class="gp-reach__label">{{this.label}}</span>
        </div>
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ═══ NUESTRAS CAPACIDADES ═══ -->
  <section class="gp-capabilities">
    <div class="gp-capabilities__inner">
      <span class="gp-label">{{#if isEs}}NUESTRAS CAPACIDADES{{else}}OUR CAPABILITIES{{/if}}</span>
      <div class="gp-capabilities__grid">
        <div class="gp-capabilities__item">
          <div class="gp-capabilities__num">01</div>
          <h3>{{#if isEs}}Producción de eventos{{else}}Event Production{{/if}}</h3>
          <p>{{#if isEs}}Gestión integral de partidos internacionales de fútbol en estadios de primer nivel.{{else}}End-to-end management of international football matches in top-tier stadiums.{{/if}}</p>
        </div>
        <div class="gp-capabilities__item">
          <div class="gp-capabilities__num">02</div>
          <h3>{{#if isEs}}Relaciones con clubes{{else}}Club Relations{{/if}}</h3>
          <p>{{#if isEs}}Red de contactos directos con clubes de primera división en Latinoamérica.{{else}}Direct contact network with first-division clubs across Latin America.{{/if}}</p>
        </div>
        <div class="gp-capabilities__item">
          <div class="gp-capabilities__num">03</div>
          <h3>{{#if isEs}}Comercialización{{else}}Commercialization{{/if}}</h3>
          <p>{{#if isEs}}Venta de boletos, patrocinios, hospitalidad y contenido digital.{{else}}Ticket sales, sponsorships, hospitality, and digital content.{{/if}}</p>
        </div>
        <div class="gp-capabilities__item">
          <div class="gp-capabilities__num">04</div>
          <h3>{{#if isEs}}Cobertura mediática{{else}}Media Coverage{{/if}}</h3>
          <p>{{#if isEs}}Transmisión en TV, streaming y amplificación en redes sociales.{{else}}TV broadcast, streaming, and social media amplification.{{/if}}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PREVIOUS EDITIONS ═══ -->
  <section class="gp-editions">
    <div class="gp-editions__inner">
      <span class="gp-label">{{#if isEs}}EDICIONES{{else}}EDITIONS{{/if}}</span>
      <div class="gp-timeline">
        {{#each galeria.highlights}}
        {{#eq this.city 'Por confirmar'}}
        <div class="gp-timeline__item gp-timeline__item--soon">
          <span class="gp-timeline__year">{{this.year}}</span>
          <div class="gp-timeline__content">
            <span class="gp-timeline__match">{{this.match}}</span>
            <span class="gp-timeline__city">{{this.city}}</span>
          </div>
        </div>
        {{else}}
        {{#eq this.city 'TBA'}}
        <div class="gp-timeline__item gp-timeline__item--soon">
          <span class="gp-timeline__year">{{this.year}}</span>
          <div class="gp-timeline__content">
            <span class="gp-timeline__match">{{this.match}}</span>
            <span class="gp-timeline__city">{{this.city}}</span>
          </div>
        </div>
        {{else}}
        {{#eq this.city 'FIFA World Cup 2026'}}
        <div class="gp-timeline__item gp-timeline__item--pause">
          <span class="gp-timeline__year">{{this.year}}</span>
          <div class="gp-timeline__content">
            <span class="gp-timeline__match">{{this.match}}</span>
            <span class="gp-timeline__city">{{this.city}}</span>
          </div>
        </div>
        {{else}}
        <a class="gp-timeline__item gp-timeline__item--link" href="/{{../lang}}/socceridcup/{{this.year}}">
          <span class="gp-timeline__year">{{this.year}}</span>
          <div class="gp-timeline__content">
            <span class="gp-timeline__match">{{this.match}}</span>
            <span class="gp-timeline__city">{{this.city}}</span>
          </div>
          <svg class="gp-timeline__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        {{/eq}}
        {{/eq}}
        {{/eq}}
        {{/each}}
      </div>
    </div>
  </section>

  <!-- ═══ GALLERY ═══ -->
  <section class="gp-gallery" id="gallerySection">
    <div class="gp-gallery__inner">
      <div class="gp-gallery__header">
        <div>
          <span class="gp-label">{{#if isEs}}MOMENTOS{{else}}MOMENTS{{/if}}</span>
          <h2 class="gp-section-title">{{galeria.galleryTitle}}</h2>
        </div>
        <span class="gp-gallery__count">{{galeria.imageCount}} {{#if isEs}}fotos{{else}}photos{{/if}}</span>
      </div>
    </div>
    <div class="gp-mosaic">
      {{#each galeria.images}}
      <div class="gp-mosaic__item" onclick="openGalleryLightbox({{@index}})">
        <img src="{{this.src}}" alt="{{this.alt}}" loading="lazy" draggable="false">
        <div class="gp-mosaic__hover">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
        </div>
      </div>
      {{/each}}
    </div>
  </section>

  <!-- ═══ SPONSORS ═══ -->
  <section class="gp-sponsors">
    <div class="gp-sponsors__inner">
      <span class="gp-label">{{#if isEs}}PATROCINADORES{{else}}SPONSORS{{/if}}</span>
      <div class="gp-sponsors__grid">
        <div class="gp-sponsors__item gp-sponsors__item--sq">
          <img src="/assets/images/sponsors/caliente.png" alt="Caliente MX">
        </div>
        <div class="gp-sponsors__item gp-sponsors__item--sq">
          <img src="/assets/images/sponsors/fox-sports.png" alt="Fox Sports">
        </div>
        <div class="gp-sponsors__item gp-sponsors__item--sq">
          <img src="/assets/images/sponsors/voit.png" alt="Voit">
        </div>
        <div class="gp-sponsors__item gp-sponsors__item--sq">
          <img src="/assets/images/sponsors/nuestra-vision.png" alt="Nuestra Visión">
        </div>
        <div class="gp-sponsors__item gp-sponsors__item--wide gp-sponsors__item--bottom">
          <img src="/assets/images/segurosidlogo.png" alt="Seguros iD">
        </div>
      </div>
      <div class="gp-sponsors__marquee">
        <div class="gp-sponsors__track">
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/caliente.png" alt="Caliente MX"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/fox-sports.png" alt="Fox Sports"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/voit.png" alt="Voit"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/nuestra-vision.png" alt="Nuestra Visión"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/caliente.png" alt="Caliente MX"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/fox-sports.png" alt="Fox Sports"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/voit.png" alt="Voit"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/nuestra-vision.png" alt="Nuestra Visión"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/caliente.png" alt="Caliente MX"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/fox-sports.png" alt="Fox Sports"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/voit.png" alt="Voit"></div>
          <div class="gp-sponsors__slide"><img src="/assets/images/sponsors/nuestra-vision.png" alt="Nuestra Visión"></div>
        </div>
        <div class="gp-sponsors__seguros-mobile">
          <img src="/assets/images/segurosidlogo.png" alt="Seguros iD">
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ MEDIA / PRESS ═══ -->
  {{#gt galeria.mediaLinks.length 0}}
  <section class="gp-media">
    <div class="gp-media__inner">
      <span class="gp-label">{{#if isEs}}NOTAS EN MEDIOS{{else}}MEDIA COVERAGE{{/if}}</span>
      <h2 class="gp-section-title">{{#if isEs}}Cobertura de prensa{{else}}Press Coverage{{/if}}</h2>
      <div class="gp-media__list">
        {{#each galeria.mediaLinks}}
        <a class="gp-media__item" href="{{this.url}}" target="_blank" rel="noopener">
          {{#if this.image}}
          <div class="gp-media__thumb">
            <img src="{{this.image}}" alt="" loading="lazy">
          </div>
          {{else}}
          <div class="gp-media__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 22h16a2 2 0 002-2V4a2 2 0 00-2-2H8a2 2 0 00-2 2v16a2 2 0 01-2 2zm0 0a2 2 0 01-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M18 18h-8M18 10h-8"/></svg>
          </div>
          {{/if}}
          <div class="gp-media__text">
            <span class="gp-media__title">{{this.title}}</span>
            <span class="gp-media__source">{{this.source}}</span>
          </div>
          <svg class="gp-media__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
        </a>
        {{/each}}
      </div>
    </div>
  </section>
  {{/gt}}

  <!-- ═══ CTA ═══ -->
  <section class="gp-cta-section">
    <img class="gp-cta-section__bg" src="/assets/images/gallery/socceridcup/1.jpg" alt="">
    <div class="gp-cta-section__dim"></div>
    <div class="gp-cta-section__body">
      <span class="gp-label" style="color:rgba(255,255,255,0.7)">SOCCER iD CUP</span>
      <h2 class="gp-cta-section__title">{{#if isEs}}Sé parte de la experiencia{{else}}Be part of the experience{{/if}}</h2>
      <a class="gp-cta-btn" href="https://wa.me/525534660028?text={{galeria.ctaMessage}}" target="_blank">
