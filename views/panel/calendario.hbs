<style>
  .cl-grid { display:grid; grid-template-columns: 1fr 340px; gap: 22px; align-items:start; }

  .cl-cal { padding: 22px; }
  .cl-cal__top { display:flex; align-items:center; gap: 14px; margin-bottom: 20px; }
  .cl-cal__month { font-size:22px; font-weight:900; letter-spacing:-.4px; }
  .cl-cal__month span { color: var(--pn-muted); font-weight:700; }
  .cl-nav { margin-left:auto; display:flex; gap:8px; }
  .cl-nav a { width:38px; height:38px; border-radius:11px; border:1px solid var(--pn-border); background:#fff; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .cl-nav a:hover { background: var(--pn-purple-soft); }
  .cl-nav a svg { width:16px; height:16px; stroke:var(--pn-ink); }

  .cl-week { display:grid; grid-template-columns: repeat(7, 1fr); gap:8px; margin-bottom:10px; }
  .cl-week span { text-align:center; font-size:11px; font-weight:900; text-transform:uppercase; letter-spacing:.5px; color:var(--pn-muted); }
  .cl-days { display:grid; grid-template-columns: repeat(7, 1fr); gap:8px; }
  .cl-day {
    aspect-ratio: 1 / 1; border:1px solid var(--pn-border); border-radius:13px;
    padding:8px; display:flex; flex-direction:column; gap:4px; background:#fff; overflow:hidden;
  }
  .cl-day.is-empty { background:#FAFAFC; border-style:dashed; }
  .cl-day__n { font-size:14px; font-weight:800; color:var(--pn-ink); }
  .cl-day.is-match { background: var(--pn-purple); border-color: var(--pn-purple); box-shadow: 0 10px 22px rgba(108,60,224,.28); }
  .cl-day.is-match .cl-day__n { color:#fff; }
  .cl-day.is-match .cl-ev { background: rgba(255,255,255,.22) !important; color:#fff !important; }
  .cl-ev { font-size:10.5px; font-weight:800; padding:3px 7px; border-radius:7px; line-height:1.2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

  .cl-legend { display:flex; gap:16px; flex-wrap:wrap; padding: 16px 4px 2px; border-top:1px solid var(--pn-border); margin-top:18px; }
  .cl-legend span { display:flex; align-items:center; gap:7px; font-size:12px; font-weight:700; color:var(--pn-ink-2); }
  .cl-legend .sw { width:10px; height:10px; border-radius:4px; }

  .cl-rail { display:flex; flex-direction:column; gap:18px; }
  .cl-agenda { padding: 4px 20px 18px; }
  .cl-agenda__date { font-size:13px; font-weight:800; color:var(--pn-ink); padding: 10px 0 4px; }
  .cl-slot { display:flex; gap:14px; padding: 14px 0; border-top:1px solid var(--pn-border); }
  .cl-slot__time { font-size:12px; font-weight:900; color:var(--pn-muted); width:44px; flex-shrink:0; padding-top:2px; }
  .cl-slot__bar { width:4px; border-radius:4px; flex-shrink:0; }
  .cl-slot__b strong { display:block; font-size:14px; font-weight:700; line-height:1.3; }
  .cl-slot__b small { font-size:12px; color:var(--pn-muted); font-weight:600; }

  .cl-mile__list { padding: 4px 20px 18px; }
  .cl-mile { display:flex; gap:13px; padding: 11px 0; border-bottom:1px solid var(--pn-border); }
  .cl-mile:last-child { border-bottom:none; padding-bottom:2px; }
  .cl-mile__dot { width:11px; height:11px; border-radius:50%; flex-shrink:0; margin-top:4px; background:var(--pn-muted); }
  .cl-mile__dot.completado { background:#1E8E5A; }
  .cl-mile__dot.en_curso { background:var(--pn-purple); box-shadow:0 0 0 4px var(--pn-purple-soft); }
  .cl-mile__b strong { display:block; font-size:14px; font-weight:700; line-height:1.3; }
  .cl-mile__b small { font-size:12px; color:var(--pn-muted); font-weight:600; }

  .cl-count { border-radius:18px; padding: 24px; color:#fff; text-align:center; background: var(--pn-ink); }
  .cl-count__num { font-size:40px; font-weight:900; letter-spacing:-1px; }
  .cl-count__lbl { font-size:13px; font-weight:700; margin-top:2px; opacity:.85; }
  .cl-count__date { font-size:12px; opacity:.6; margin-top:4px; }

  @media (max-width: 1100px) { .cl-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .cl-days { gap:5px; }
    .cl-day { padding:5px; border-radius:9px; }
    .cl-ev { display:none; }
    .cl-day.has-ev::after { content:''; width:6px; height:6px; border-radius:50%; background:var(--pn-purple); display:block; margin-top:auto; }
    .cl-day.is-match.has-ev::after { background:#fff; }
  }

  /* Línea de tiempo única (etapas + actividades) */
  .cl-linea__nota { font-size:12px; color:var(--pn-muted); font-weight:600; margin:-6px 0 12px; line-height:1.5; }
  .cl-linea { position:relative; padding-left:6px; }
  .cl-linea__it { display:flex; gap:11px; padding:9px 0; border-top:1px solid var(--pn-border); }
  .cl-linea__it:first-child { border-top:none; }
  .cl-linea__it.is-pasado { opacity:.55; }
  .cl-linea__it.is-hoy { background:var(--pn-purple-soft); border-radius:10px; padding-left:8px; padding-right:8px; opacity:1; }
  .cl-linea__dot { width:9px; height:9px; border-radius:50%; margin-top:6px; flex-shrink:0; }
  .cl-linea__b { min-width:0; }
  .cl-linea__b strong { display:block; font-size:13.5px; font-weight:800; }
  .cl-linea__b small { font-size:11.5px; color:var(--pn-muted); font-weight:600; display:block; }
  .cl-linea__f { color:var(--pn-purple); font-weight:800; text-transform:uppercase; letter-spacing:.3px; }

  /* Suscripción al calendario */
  .cl-sub { padding:20px; margin-bottom:18px; }
  .cl-sub__nota { font-size:12px; color:var(--pn-muted); font-weight:600; line-height:1.55; margin:-6px 0 12px; }
  .cl-sub__btns { display:flex; gap:9px; flex-wrap:wrap; margin-bottom:11px; }
  .cl-sub__btn { flex:1; min-width:150px; text-align:center; padding:11px 14px; border-radius:11px; background:var(--pn-purple); color:#fff; font-size:12.5px; font-weight:800; }
  .cl-sub__btn:hover { background:#5A2FC7; }
  .cl-sub__btn + .cl-sub__btn { background:#fff; color:var(--pn-purple); border:1px solid var(--pn-border); }
  .cl-sub__btn + .cl-sub__btn:hover { background:var(--pn-purple-soft); }
  .cl-sub__url { display:flex; gap:8px; }
  .cl-sub__url input { flex:1; min-width:0; border:1px solid var(--pn-border); border-radius:10px; padding:9px 11px; font-family:inherit; font-size:11.5px; color:var(--pn-muted); background:#FBFAFD; }
  .cl-sub__url button { padding:9px 14px; border:1px solid var(--pn-border); border-radius:10px; background:#fff; font-family:inherit; font-size:12px; font-weight:700; color:var(--pn-ink-2); cursor:pointer; }
  .cl-sub__url button:hover { background:var(--pn-purple-soft); color:var(--pn-purple); }
  a.cl-ev { text-decoration:none; display:block; }
  a.cl-ev:hover { filter:brightness(.94); }
</style>

<div class="cl-grid">
  <div class="pn-card cl-cal">
    <div class="cl-cal__top">
      <div class="cl-cal__month">{{panel.calendar.monthLabel}} <span>{{panel.calendar.year}}</span></div>
      <div class="cl-nav">
        <a aria-label="Mes anterior" href="/panel/calendario?y={{panel.calendar.prev.y}}&m={{panel.calendar.prev.m}}"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></a>
        <a aria-label="Mes siguiente" href="/panel/calendario?y={{panel.calendar.next.y}}&m={{panel.calendar.next.m}}"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></a>
      </div>
    </div>

    <div class="cl-week">
      <span>Dom</span><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span>
    </div>
    <div class="cl-days">
      {{#each panel.calendarCells}}
        {{#if this.empty}}
          <div class="cl-day is-empty"></div>
        {{else}}
          <div class="cl-day {{#if this.match}}is-match{{/if}} {{#if this.events.length}}has-ev{{/if}}">
            <span class="cl-day__n">{{this.day}}</span>
            {{#each this.events}}
            <a class="cl-ev" href="{{this.addUrl}}" target="_blank" rel="noopener noreferrer"
               title="Agregar &laquo;{{this.title}}&raquo; a mi calendario"
               style="color: {{this.color}}; background: {{this.color}}1A;">{{this.title}}</a>
            {{/each}}
          </div>
        {{/if}}
      {{/each}}
    </div>

    <div class="cl-legend">
      <span><span class="sw" style="background:#6C3CE0"></span>Evento</span>
      <span><span class="sw" style="background:#A78BE6"></span>Actualización</span>
      <span><span class="sw" style="background:#14141B"></span>Patrocinio</span>
      <span><span class="sw" style="background:#8A8F98"></span>Prensa</span>
      <span><span class="sw" style="background:#6C3CE0"></span>Partido</span>
    </div>
  </div>

  <aside class="cl-rail">
    <div class="pn-card">
      <div class="pn-card__head"><h3>Agenda del partido</h3></div>
      <div class="cl-agenda">
        <div class="cl-agenda__date">{{panel.calendar.agendaDate}}</div>
        {{#each panel.calendar.agenda}}
        <div class="cl-slot">
          <span class="cl-slot__time">{{this.time}}</span>
          <span class="cl-slot__bar" style="background: {{this.color}}"></span>
          <div class="cl-slot__b">
            <strong>{{this.title}}</strong>
            <small>{{this.sub}}</small>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="pn-card" id="cronograma">
      <div class="pn-card__head"><h3>Cronograma del proyecto</h3></div>
      <div class="cl-mile__list">
        {{#each panel.milestones}}
        <div class="cl-mile">
          <span class="cl-mile__dot {{this.status}}"></span>
          <div class="cl-mile__b">
            <strong>{{this.title}}</strong>
            <small>{{this.date}} · {{this.statusLabel}}{{#if this.owner}} · {{this.owner}}{{/if}}</small>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    {{#if panel.agenda.url}}
    <div class="pn-card cl-sub">
      <div class="pn-card__head"><h3>Llévate estas fechas</h3></div>
      <p class="cl-sub__nota">Suscr&iacute;bete una vez y las fechas del evento aparecen en tu calendario,
        actualiz&aacute;ndose solas cuando cambien. <strong>No pide permisos ni acceso a tu agenda</strong>:
        es solo una direcci&oacute;n que tu calendario consulta.</p>
      <div class="cl-sub__btns">
        <a class="cl-sub__btn" href="{{panel.agenda.google}}" target="_blank" rel="noopener noreferrer">Agregar a Google Calendar</a>
        <a class="cl-sub__btn" href="{{panel.agenda.webcal}}">Apple / Outlook</a>
      </div>
      <div class="cl-sub__url">
        <input type="text" value="{{panel.agenda.url}}" readonly onclick="this.select()">
        <button type="button" onclick="clCopiar(this)">Copiar</button>
      </div>
      <p class="cl-sub__nota" style="margin:8px 0 0;">Esta direcci&oacute;n es tuya: no la compartas, muestra tu agenda del evento.</p>
    </div>
    {{/if}}

    {{#if panel.timeline.length}}
    <div class="pn-card" id="linea">
      <div class="pn-card__head"><h3>Todo en orden</h3></div>
      <p class="cl-linea__nota">Etapas y actividades juntas, de la m&aacute;s antigua a la m&aacute;s pr&oacute;xima.</p>
      <div class="cl-linea">
        {{#each panel.timeline}}
        <div class="cl-linea__it {{#if this.pasado}}is-pasado{{/if}}{{#if this.esHoy}} is-hoy{{/if}}">
          <span class="cl-linea__dot" style="background:{{this.color}}"></span>
          <div class="cl-linea__b">
            <small class="cl-linea__f">{{this.fechaLabel}}{{#if this.esHoy}} · hoy{{/if}}</small>
            <strong>{{this.title}}</strong>
            <small>{{#eq this.kind 'etapa'}}Etapa{{else}}Actividad{{/eq}}{{#if this.meta}} · {{this.meta}}{{/if}}</small>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <div class="cl-count">
      <div class="cl-count__num" id="clCountdown">—</div>
      <div class="cl-count__lbl">para el partido</div>
      <div class="cl-count__date">{{panel.eventLabel}}</div>
    </div>
  </aside>
</div>

<script>
  function clCopiar(btn){
    var input = btn.previousElementSibling;
    input.select();
    var ok = false;
    // clipboard API primero; si el navegador no la da (http sin TLS), execCommand
    if (navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(input.value).then(function(){
        btn.textContent = 'Copiado';
        setTimeout(function(){ btn.textContent = 'Copiar'; }, 1600);
      }).catch(function(){ ok = document.execCommand && document.execCommand('copy'); });
    } else {
      try { ok = document.execCommand('copy'); } catch (_) {}
    }
    if (ok){
      btn.textContent = 'Copiado';
      setTimeout(function(){ btn.textContent = 'Copiar'; }, 1600);
    }
  }
</script>
<script>
  (function(){
    var el = document.getElementById('clCountdown');
    if (!el) return;
    var target = '{{panel.eventDateISO}}' || '2027-03-27T19:00:00-05:00';
    var days = Math.floor((new Date(target).getTime() - Date.now()) / 86400000);
    el.textContent = days > 0 ? days + ' días' : '¡Hoy!';
  })();
</script>
