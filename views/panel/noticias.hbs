<style>
  .nw-chips { display:flex; gap:10px; margin: 6px 0 22px; flex-wrap:wrap; }
  .nw-chip { padding: 10px 20px; border-radius: 13px; background:#fff; border:1px solid var(--pn-border); font-family: inherit; font-size:13px; font-weight:700; color:var(--pn-ink-2); cursor:pointer; }
  .nw-chip.is-active { background: var(--pn-purple); color:#fff; border-color: var(--pn-purple); }

  .nw-grid { display:grid; grid-template-columns: 1fr 320px; gap: 22px; align-items:start; }
  .nw-main { min-width:0; }

  /* Masonry (Pinterest) */
  .nw-masonry { column-count: 2; column-gap: 18px; }
  .nw-card {
    break-inside: avoid; width:100%; margin: 0 0 18px;
    background:#fff; border:1px solid var(--pn-border); border-radius:18px;
    box-shadow: var(--pn-shadow); overflow:hidden; display:inline-block;
    color:inherit; text-decoration:none; transition: box-shadow .15s, transform .15s;
  }
  .nw-card:hover { box-shadow: 0 10px 30px rgba(76,43,166,0.12); transform: translateY(-2px); }
  .nw-card:hover .nw-readmore { text-decoration: underline; }
  .nw-card__imgwrap { position:relative; }
  .nw-card img { width:100%; display:block; object-fit:cover; }
  .nw-card.is-tall img { height: 240px; }
  .nw-card.is-short img { height: 150px; }
  .nw-card__tag {
    position:absolute; top:12px; left:12px;
    display:inline-flex; align-items:center; gap:6px; font-size:10.5px; font-weight:900;
    text-transform:uppercase; letter-spacing:.5px; padding:6px 12px; border-radius:20px;
    background:#fff; color:var(--pn-ink);
  }
  .nw-card__tag .d { width:7px; height:7px; border-radius:50%; }
  .nw-card__b { padding: 16px 18px 18px; }
  .nw-card__b h3 { font-size:17px; font-weight:800; line-height:1.28; letter-spacing:-.2px; margin-bottom:8px; }
  .nw-card__b p { font-size:13px; color:var(--pn-ink-2); line-height:1.55; }
  .nw-card__foot { display:flex; align-items:center; justify-content:space-between; margin-top:16px; font-size:12px; color:var(--pn-muted); font-weight:700; }
  .nw-readmore { font-size:13px; font-weight:800; color:var(--pn-purple); display:flex; align-items:center; gap:6px; }

  /* Rail */
  .nw-rail { display:flex; flex-direction:column; gap: 18px; }

  /* Estado vacio */
  .nw-empty {
    background:#fff; border:1px dashed var(--pn-border); border-radius:18px;
    padding: 46px 28px; text-align:center; color:var(--pn-muted);
  }
  .nw-empty svg { color: var(--pn-muted); opacity:.7; margin-bottom:14px; }
  .nw-empty strong { display:block; font-size:16px; font-weight:800; color:var(--pn-ink); margin-bottom:7px; }
  .nw-empty p { font-size:13.5px; line-height:1.6; max-width:420px; margin:0 auto; }

  @media (max-width: 1100px) { .nw-grid { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .nw-masonry { column-count: 1; } }
</style>

{{#if panel.newsTags.length}}
<div class="nw-chips" id="nwChips">
  <button type="button" class="nw-chip is-active" data-tag="">Todas</button>
  {{#each panel.newsTags}}
  <button type="button" class="nw-chip" data-tag="{{this}}">{{this}}</button>
  {{/each}}
</div>
{{/if}}

<div class="nw-grid">
  <div class="nw-main">
    {{#unless panel.news.length}}
    <div class="nw-empty">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h13v14H6a2 2 0 0 1-2-2V5z"/><path d="M17 8h2a1 1 0 0 1 1 1v8a2 2 0 0 1-2 2"/><line x1="7" y1="9" x2="14" y2="9"/><line x1="7" y1="13" x2="14" y2="13"/></svg>
      <strong>Aún no hay noticias publicadas</strong>
      <p>Cuando el equipo publique avances, anuncios o notas de prensa de la edición, aparecerán aquí.</p>
    </div>
    {{/unless}}
    <div class="nw-masonry">
      {{#each panel.news}}
      <a href="/panel/noticias/{{this.id}}" class="nw-card {{#if this.size}}is-{{this.size}}{{else}}is-short{{/if}}" data-tag="{{this.tag}}">
        <div class="nw-card__imgwrap">
          <img src="{{this.image}}" alt="">
          <span class="nw-card__tag"><span class="d" style="background: {{this.tagColor}}"></span>{{this.tag}}</span>
        </div>
        <div class="nw-card__b">
          <h3>{{this.title}}</h3>
          <p>{{this.excerpt}}</p>
          <div class="nw-card__foot">
            <span>{{this.date}}</span>
            <span class="nw-readmore">Leer más
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
        </div>
      </a>
      {{/each}}
    </div>
    <div class="nw-empty" id="nwNoMatch" hidden>
      <strong>Sin noticias en esta categoría</strong>
      <p>Prueba con otra categoría o vuelve a &laquo;Todas&raquo;.</p>
    </div>
  </div>

  <aside class="nw-rail">
    <div class="pn-card">
      <div class="pn-card__head"><h3>Tu categoría</h3></div>
      <div style="padding: 6px 20px 20px;">
        <span class="pn-badge" style="color:#fff; background: {{panel.user.color}};">{{panel.user.categoryLabel}}</span>
        <p style="font-size:13px; color:var(--pn-ink-2); line-height:1.55; margin-top:14px;">Como inversionista {{panel.user.categoryLabel}} recibes todas las comunicaciones y actualizaciones con acceso prioritario.</p>
        <a href="/panel" class="pn-card__link" style="margin-top:14px; display:inline-flex;">Ver mis beneficios ›</a>
      </div>
    </div>
  </aside>
</div>

<script>
  // Filtro por categoria de los chips. Antes eran divs decorativos sin efecto.
  (function () {
    var chips = document.getElementById('nwChips');
    if (!chips) return;
    var cards = Array.prototype.slice.call(document.querySelectorAll('.nw-card[data-tag]'));
    var noMatch = document.getElementById('nwNoMatch');

    chips.addEventListener('click', function (e) {
      var btn = e.target.closest('.nw-chip');
      if (!btn) return;
      var tag = btn.getAttribute('data-tag');
      chips.querySelectorAll('.nw-chip').forEach(function (c) { c.classList.toggle('is-active', c === btn); });
      var shown = 0;
      cards.forEach(function (card) {
        var match = !tag || card.getAttribute('data-tag') === tag;
        card.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      if (noMatch) noMatch.hidden = shown > 0;
    });
  })();
</script>
