<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activar acceso · SOCCER iD Investor Hub</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png">
  <style>
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#F5F4F8;color:#14141B;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;-webkit-font-smoothing:antialiased;}
    .lg-card{width:100%;max-width:440px;background:#fff;border:1px solid #ECEAF2;border-radius:22px;box-shadow:0 10px 40px rgba(76,43,166,.08);overflow:hidden;}
    .lg-top{background:#6C3CE0;padding:30px;text-align:center;}
    .lg-top .logo{width:56px;height:56px;border-radius:16px;background:rgba(255,255,255,.15);display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px;}
    .lg-top .logo img{width:34px;height:34px;}
    .lg-top strong{display:block;color:#fff;font-size:18px;font-weight:800;}
    .lg-top small{color:rgba(255,255,255,.75);font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;}
    .lg-body{padding:32px 30px 30px;}
    .lg-body h1{font-size:22px;font-weight:800;margin-bottom:6px;}
    .lg-body p{font-size:13px;color:#6A6675;margin-bottom:24px;}
    .lg-body p b{color:#14141B;}
    .lg-field{margin-bottom:16px;}
    .lg-field label{display:block;font-size:12px;font-weight:700;color:#6A6675;margin-bottom:7px;}
    .lg-field input{width:100%;padding:14px 16px;border:1px solid #ECEAF2;border-radius:13px;font-size:14px;font-family:inherit;background:#FAFAFC;outline:none;}
    .lg-field input:focus{border-color:#6C3CE0;background:#fff;}
    .lg-btn{width:100%;padding:15px;border:none;border-radius:13px;background:#6C3CE0;color:#fff;font-size:15px;font-weight:800;font-family:inherit;cursor:pointer;margin-top:8px;}
    .lg-btn:hover{background:#5A2FC7;}
    .lg-err{background:#FDECEC;color:#C0392B;font-size:13px;font-weight:600;padding:12px 14px;border-radius:11px;margin-bottom:18px;}
    .lg-hint{font-size:11px;color:#A6A2B3;margin-top:6px;}
    .lg-invalid{text-align:center;padding:20px 0;}
    .lg-invalid h1{font-size:20px;margin-bottom:8px;}
    .lg-invalid p{margin-bottom:20px;}
    .lg-invalid a{display:inline-block;padding:13px 24px;border-radius:12px;background:#6C3CE0;color:#fff;font-weight:800;text-decoration:none;font-size:14px;}
  </style>
</head>
<body>
  <div class="lg-card">
    <div class="lg-top">
      <span class="logo"><img src="/assets/images/iconsoccerid.png" alt="SOCCER iD"></span>
      <strong>SOCCER iD</strong>
      <small>Investor Hub</small>
    </div>
    <div class="lg-body">
      {{#if invalid}}
        <div class="lg-invalid">
          <h1>Enlace inválido o expirado</h1>
          <p style="font-size:13px;color:#6A6675;">Solicita una nueva invitación al organizador.</p>
          <a href="/panel/login">Ir al inicio de sesión</a>
        </div>
      {{else}}
        <h1>Activa tu acceso</h1>
        <p>Hola <b>{{name}}</b>, crea una contraseña para <b>{{email}}</b> y entra a tu panel.</p>
        {{#if error}}<div class="lg-err">{{error}}</div>{{/if}}
        <form method="POST" action="/panel/activar/{{token}}">
          <div class="lg-field">
            <label for="password">Nueva contraseña</label>
            <input type="password" id="password" name="password" required minlength="8" placeholder="Mínimo 8 caracteres">
            <div class="lg-hint">Usa al menos 8 caracteres.</div>
          </div>
          <div class="lg-field">
            <label for="password2">Repetir contraseña</label>
            <input type="password" id="password2" name="password2" required minlength="8" placeholder="••••••••">
          </div>
          <button type="submit" class="lg-btn">Activar y entrar</button>
        </form>
      {{/if}}
    </div>
  </div>
</body>
</html>
