<style>
  .db-chips { display:flex; gap:10px; margin: 6px 0 22px; flex-wrap: wrap; }
  .db-chip { padding: 10px 20px; border-radius: 13px; background:#fff; border:1px solid var(--pn-border); font-size:13px; font-weight:700; color:var(--pn-ink-2); cursor:pointer; }
  .db-chip.is-active { background: var(--pn-purple); color:#fff; border-color: var(--pn-purple); }

  .db-grid { display:grid; grid-template-columns: 1fr 348px; gap: 22px; align-items:start; }
  .db-col { display:flex; flex-direction:column; gap: 22px; min-width:0; }

  /* Category hero — membership stands out */
  .db-cat { border-radius: 22px; padding: 30px 32px; color:#fff; position:relative; overflow:hidden; }
  .db-cat__gemwm { position:absolute; right:-30px; top:-30px; width:220px; height:220px; opacity:.12; }
  .db-cat__gemwm svg { width:100%; height:100%; stroke:#fff; }
  .db-cat__top { display:flex; align-items:center; justify-content:space-between; position:relative; z-index:1; }
  .db-cat__tier { display:inline-flex; align-items:center; gap:10px; background:rgba(255,255,255,.16); padding:8px 16px 8px 10px; border-radius:30px; }
  .db-cat__tier .gem { width:26px; height:26px; display:flex; }
  .db-cat__tier .gem svg { width:26px; height:26px; stroke:#fff; }
  .db-cat__tier b { font-size:14px; font-weight:900; letter-spacing:2.5px; }
  .db-cat__id { font-size:12px; font-weight:700; opacity:.8; }
  .db-cat__label { font-size:12px; opacity:.85; font-weight:700; letter-spacing:1px; text-transform:uppercase; margin-top:26px; position:relative; z-index:1; }
  .db-cat__amount { font-size: 46px; font-weight: 900; letter-spacing:-1.2px; margin-top: 6px; line-height:1; position:relative; z-index:1; }
  .db-cat__meta { display:flex; gap: 34px; margin-top: 26px; position:relative; z-index:1; }
  .db-cat__meta div small { display:block; font-size:11px; opacity:.75; letter-spacing:.5px; text-transform:uppercase; margin-bottom:3px; }
  .db-cat__meta div strong { font-size:16px; font-weight:800; }

  /* Stats */
  .db-stats { display:grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .db-stat { background:#fff; border:1px solid var(--pn-border); border-radius:16px; padding:18px; box-shadow: var(--pn-shadow); }
  .db-stat__ico { width:40px; height:40px; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:14px; }
  .db-stat__ico svg { width:20px; height:20px; stroke:#fff; }
  .db-stat__val { font-size:22px; font-weight:900; letter-spacing:-.4px; }
  .db-stat__lbl { font-size:12px; color:var(--pn-ink-2); font-weight:600; margin-top:3px; }
  .db-stat__sub { font-size:11px; font-weight:800; margin-top:5px; }

  /* Benefits */
  .db-benefits { list-style:none; padding: 4px 22px 22px; display:flex; flex-direction:column; gap:13px; }
  .db-benefits li { display:flex; align-items:flex-start; gap:12px; font-size:14px; color:var(--pn-ink); line-height:1.4; }
  .db-benefits li svg { width:21px; height:21px; flex-shrink:0; margin-top:1px; }

  /* Distribution */
  .db-dist { display:flex; align-items:center; gap: 28px; padding: 6px 22px 24px; flex-wrap:wrap; }
  .db-donut { position:relative; width:158px; height:158px; flex-shrink:0; }
  .db-donut__hole { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .db-donut__hole strong { font-size:28px; font-weight:900; line-height:1; }
  .db-donut__hole small { font-size:11px; color:var(--pn-muted); font-weight:700; }
  .db-legend { flex:1; display:flex; flex-direction:column; gap:11px; min-width:170px; }
  .db-legend__row { display:flex; align-items:center; gap:11px; font-size:13px; }
  .db-legend__row .sw { width:11px; height:11px; border-radius:4px; flex-shrink:0; }
  .db-legend__row span { font-weight:600; }
  .db-legend__row b { margin-left:auto; font-weight:900; }

  /* Rail: my membership mini */
  .db-mini { border-radius: 18px; padding: 22px; color:#fff; position:relative; overflow:hidden; }
  .db-mini small { font-size:11px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase; opacity:.8; }
  .db-mini b { display:block; font-size:26px; font-weight:900; letter-spacing:1px; margin:6px 0 14px; }
  .db-mini .amt { font-size:20px; font-weight:900; }
  .db-mini .amt span { display:block; font-size:11px; font-weight:700; opacity:.8; text-transform:uppercase; letter-spacing:.5px; margin-top:2px; }

  /* Rail news */
  .db-news { padding: 6px 10px 12px; display:flex; flex-direction:column; }
  .db-news__item { display:flex; gap:12px; padding: 11px 10px; border-radius:13px; }
  .db-news__item:hover { background:var(--pn-purple-soft); }
  .db-news__thumb { width:48px; height:48px; border-radius:12px; object-fit:cover; flex-shrink:0; }
  .db-news__b strong { display:block; font-size:13px; font-weight:700; line-height:1.3; }
  .db-news__b small { font-size:11px; color:var(--pn-muted); font-weight:600; }
  .db-news__tag { font-size:10px; font-weight:900; text-transform:uppercase; letter-spacing:.4px; }

  /* Rail advisor */
  .db-advisor { padding: 6px 20px 20px; }
  .db-advisor__row { display:flex; align-items:center; gap:13px; margin-bottom:14px; }
  .db-advisor__av { width:46px; height:46px; border-radius:50%; background:var(--pn-purple); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:15px; flex-shrink:0; }
  .db-advisor__row strong { display:block; font-size:14px; font-weight:800; }
  .db-advisor__row small { font-size:12px; color:var(--pn-ink-2); }
  .db-wa { display:flex; align-items:center; justify-content:center; gap:9px; width:100%; padding:12px; border-radius:13px; background:var(--pn-ink); color:#fff; font-size:13px; font-weight:800; }
  .db-wa svg { width:17px; height:17px; fill:#fff; }

  /* Rail documents */
  .db-docs { padding: 4px 12px 14px; }
  .db-doc { display:flex; align-items:center; gap:13px; padding:11px 10px; border-radius:13px; }
  .db-doc:hover { background:var(--pn-purple-soft); }
  .db-doc__ic { width:38px; height:38px; border-radius:11px; background:var(--pn-purple-soft); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .db-doc__ic svg { width:19px; height:19px; stroke:var(--pn-purple); }
  .db-doc__b strong { display:block; font-size:13px; font-weight:700; }
  .db-doc__b small { font-size:11px; color:var(--pn-muted); font-weight:600; }
  .db-doc__dl { margin-left:auto; }
  .db-doc__dl svg { width:17px; height:17px; stroke:var(--pn-muted); }

  @media (max-width: 1100px) { .db-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .db-stats { grid-template-columns: 1fr; } .db-cat__meta { gap:20px; flex-wrap:wrap; } .db-cat__amount { font-size:38px; } }
</style>

<div class="db-chips">
  <div class="db-chip is-active">Resumen</div>
  <div class="db-chip">Mis beneficios</div>
  <div class="db-chip">Distribución</div>
  <div class="db-chip">Documentos</div>
</div>

<div class="db-grid">
  <div class="db-col">
    <!-- Category hero -->
    <div class="db-cat" style="background: {{panel.user.color}}">
      <div class="db-cat__gemwm">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3 6 9l6 12 6-12-3-6"/></svg>
      </div>
      <div class="db-cat__top">
        <span class="db-cat__tier">
          <span class="gem"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3 6 9l6 12 6-12-3-6"/></svg></span>
          <b>{{panel.user.categoryLabel}}</b>
        </span>
        <span class="db-cat__id">{{panel.user.memberId}}</span>
      </div>
      <div class="db-cat__label">Monto invertido</div>
      <div class="db-cat__amount">{{panel.user.amount}}</div>
      <div class="db-cat__meta">
        <div><small>Retorno proyectado</small><strong>{{panel.user.projectedReturn}}</strong></div>
        <div><small>Rendimiento</small><strong>{{panel.user.returnPct}}</strong></div>
        <div><small>Miembro desde</small><strong>{{panel.user.since}}</strong></div>
      </div>
    </div>

    <!-- Stats -->
    <div class="db-stats">
      {{#each panel.stats}}
      <div class="db-stat">
        <div class="db-stat__ico" style="background: {{this.accent}}">
          {{#eq this.icon 'wallet'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><circle cx="17" cy="14" r="1.3"/></svg>{{/eq}}
          {{#eq this.icon 'trend'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/></svg>{{/eq}}
          {{#eq this.icon 'diamond'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18"/></svg>{{/eq}}
          {{#eq this.icon 'clock'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>{{/eq}}
        </div>
        <div class="db-stat__val" {{#if this.countdown}}id="pnCountdown"{{/if}}>{{this.value}}</div>
        <div class="db-stat__lbl">{{this.label}}</div>
        {{#if this.sub}}<div class="db-stat__sub" style="color: {{this.accent}}">{{this.sub}}</div>{{/if}}
      </div>
      {{/each}}
    </div>

    <!-- Benefits collapsible -->
    <div class="pn-card pn-collapse">
      <div class="pn-card__head pn-collapse__head" data-collapse>
        <h3>Mis beneficios · {{panel.user.categoryLabel}}</h3>
        <svg class="pn-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--pn-ink-2)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
      <div class="pn-collapse__body">
        <ul class="db-benefits">
          {{#each panel.userBenefits}}
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="{{../panel.user.color}}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="8.5 12.5 11 15 16 9.5"/></svg>
            {{this}}
          </li>
          {{/each}}
        </ul>
      </div>
    </div>

    <!-- Distribution -->
    <div class="pn-card">
      <div class="pn-card__head"><h3>Distribución de inversionistas</h3><span class="pn-card__link" style="color:var(--pn-ink-2)">{{panel.investorTotal}} en total</span></div>
      <div class="db-dist">
        <div class="db-donut">
          <svg width="158" height="158" viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="54" fill="none" stroke="#F1F0F5" stroke-width="12"/>
            {{#each panel.donut}}
            <circle cx="60" cy="60" r="54" fill="none" stroke="{{this.color}}" stroke-width="12"
              stroke-dasharray="{{this.len}} {{../panel.donutC}}"
              transform="rotate({{this.angle}} 60 60)" stroke-linecap="butt"/>
            {{/each}}
          </svg>
          <div class="db-donut__hole"><strong>{{panel.investorTotal}}</strong><small>inversionistas</small></div>
        </div>
        <div class="db-legend">
          {{#each panel.distribution}}
          <div class="db-legend__row">
            <span class="sw" style="background: {{this.color}}"></span>
            <span>{{this.label}}</span>
            <b>{{this.count}}</b>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

  <!-- Right rail -->
  <div class="db-col">
    <!-- Membership mini -->
    <div class="db-mini" style="background: {{panel.user.color}}">
      <small>Tu membresía</small>
      <b>{{panel.user.categoryLabel}}</b>
      <div class="amt">{{panel.user.amount}}<span>Monto invertido</span></div>
    </div>

    <!-- News -->
    <div class="pn-card">
      <div class="pn-card__head"><h3>Noticias recientes</h3><a href="/panel/noticias" class="pn-card__link">Ver todas ›</a></div>
      <div class="db-news">
        {{#each panel.news}}
        <a href="/panel/noticias" class="db-news__item">
          <img class="db-news__thumb" src="{{this.image}}" alt="">
          <div class="db-news__b">
            <span class="db-news__tag" style="color: {{this.tagColor}}">{{this.tag}}</span>
            <strong>{{this.title}}</strong>
            <small>{{this.date}}</small>
          </div>
        </a>
        {{/each}}
      </div>
    </div>

    <!-- Advisor -->
    <div class="pn-card">
      <div class="pn-card__head"><h3>Tu asesor</h3></div>
      <div class="db-advisor">
        <div class="db-advisor__row">
          <div class="db-advisor__av">{{panel.advisor.initials}}</div>
          <div>
            <strong>{{panel.advisor.name}}</strong>
            <small>{{panel.advisor.role}}</small>
          </div>
        </div>
        <a class="db-wa" href="https://wa.me/{{panel.advisor.whatsapp}}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M17.5 14.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.6.2s-.7.9-.9 1.1c-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5s-.6-1.5-.9-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.2s.9 2.5 1.1 2.7c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.7-.7 1.9-1.3.2-.6.2-1.2.2-1.3-.1-.2-.3-.2-.6-.4zM12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2z"/></svg>
          Contactar por WhatsApp
        </a>
      </div>
    </div>

    <!-- Documents -->
    <div class="pn-card">
      <div class="pn-card__head"><h3>Contratos y documentos</h3><a href="/panel/documentos" class="pn-card__link">Ver todos ›</a></div>
      <div class="db-docs">
        {{#each panel.userDocuments}}
        <a href="{{this.url}}" target="_blank" rel="noopener" class="db-doc">
          <div class="db-doc__ic">
            {{#if this.ext}}<span style="font-size:10px;font-weight:900;color:var(--pn-purple);">{{this.ext}}</span>{{else}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><polyline points="14 3 14 8 19 8"/></svg>{{/if}}
          </div>
          <div class="db-doc__b">
            <strong>{{this.name}}</strong>
            <small>{{this.meta}}</small>
          </div>
          <span class="db-doc__dl"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></span>
        </a>
        {{else}}
        <p style="padding:14px 10px; font-size:12px; color:var(--pn-muted);">Aún no hay documentos compartidos contigo.</p>
        {{/each}}
      </div>
    </div>
  </div>
</div>

<script>
  (function(){
    var el = document.getElementById('pnCountdown');
    if (!el) return;
    var days = Math.floor((new Date('2027-03-27T19:00:00-05:00').getTime() - Date.now()) / 86400000);
    el.textContent = days > 0 ? days + ' días' : '¡Hoy!';
  })();
</script>
