<style>
  .db-chips { display:flex; gap:10px; margin: 6px 0 22px; flex-wrap: wrap; }
  .db-chip { padding: 10px 20px; border-radius: 13px; background:#fff; border:1px solid var(--pn-border); font-size:13px; font-weight:700; color:var(--pn-ink-2); cursor:pointer; text-decoration:none; }
  .db-chip:hover { background: var(--pn-purple-soft); color: var(--pn-purple); border-color:#E4DAFA; }
  .db-chip.is-active { background: var(--pn-purple); color:#fff; border-color: var(--pn-purple); }
  #mi-inversion, #ventas, #uso-capital, #beneficios, #distribucion { scroll-margin-top: 92px; }
  html { scroll-behavior: smooth; }

  .db-grid { display:grid; grid-template-columns: 1fr 348px; gap: 22px; align-items:start; }
  .db-col { display:flex; flex-direction:column; gap: 22px; min-width:0; }

  /* Category hero — membership stands out */
  .db-cat { border-radius: 22px; padding: 30px 32px; color:#fff; position:relative; overflow:hidden; }
  .db-cat__gemwm { position:absolute; right:-30px; top:-30px; width:220px; height:220px; opacity:.12; }
  .db-cat__gemwm svg { width:100%; height:100%; stroke:#fff; }
  .db-cat__top { display:flex; align-items:center; justify-content:space-between; position:relative; z-index:1; }
  .db-cat__tier { display:inline-flex; align-items:center; gap:10px; background:rgba(255,255,255,.16); padding:8px 16px 8px 10px; border-radius:30px; }
  .db-cat__tier .gem { width:26px; height:26px; display:flex; }
  .db-cat__tier .gem svg { width:26px; height:26px; stroke:#fff; }
  .db-cat__tier b { font-size:14px; font-weight:900; letter-spacing:2.5px; }
  .db-cat__id { font-size:12px; font-weight:700; opacity:.8; }
  .db-cat__label { font-size:12px; opacity:.85; font-weight:700; letter-spacing:1px; text-transform:uppercase; margin-top:26px; position:relative; z-index:1; }
  .db-cat__amount { font-size: 46px; font-weight: 900; letter-spacing:-1.2px; margin-top: 6px; line-height:1; position:relative; z-index:1; }
  .db-cat__meta { display:flex; gap: 34px; margin-top: 26px; position:relative; z-index:1; }
  .db-cat__meta div small { display:block; font-size:11px; opacity:.75; letter-spacing:.5px; text-transform:uppercase; margin-bottom:3px; }
  .db-cat__meta div strong { font-size:16px; font-weight:800; }

  /* Stats */
  .db-stats { display:grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .db-stat { background:#fff; border:1px solid var(--pn-border); border-radius:16px; padding:18px; box-shadow: var(--pn-shadow); }
  .db-stat__ico { width:40px; height:40px; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:14px; }
  .db-stat__ico svg { width:20px; height:20px; stroke:#fff; }
  .db-stat__val { font-size:22px; font-weight:900; letter-spacing:-.4px; }
  .db-stat__lbl { font-size:12px; color:var(--pn-ink-2); font-weight:600; margin-top:3px; }
  .db-stat__sub { font-size:11px; font-weight:800; margin-top:5px; }

  /* Ventas y break-even */
  .db-sales { padding: 4px 22px 22px; }
  .db-sales__top { display:flex; align-items:flex-end; gap:16px; flex-wrap:wrap; margin-bottom:18px; }
  .db-sales__big { font-size:34px; font-weight:900; letter-spacing:-1px; line-height:1; }
  .db-sales__big span { font-size:15px; font-weight:700; color:var(--pn-muted); }
  .db-sales__occ { margin-left:auto; text-align:right; }
  .db-sales__occ b { font-size:22px; font-weight:900; color:var(--pn-purple); }
  .db-sales__occ small { display:block; font-size:11px; color:var(--pn-muted); font-weight:700; text-transform:uppercase; letter-spacing:.5px; }
  .db-track { position:relative; height:14px; border-radius:20px; background:#F1F0F5; overflow:visible; margin:26px 0 12px; }
  .db-track__fill { height:100%; border-radius:20px; background:linear-gradient(90deg,#6C3CE0,#8A5CF0); }
  .db-track__be { position:absolute; top:-8px; bottom:-8px; width:2px; background:var(--pn-ink); }
  .db-track__be span { position:absolute; top:-20px; left:50%; transform:translateX(-50%); font-size:10px; font-weight:800; color:var(--pn-ink); white-space:nowrap; }
  .db-sales__foot { display:flex; gap:24px; flex-wrap:wrap; margin-top:20px; }
  .db-sales__m small { display:block; font-size:11px; color:var(--pn-muted); font-weight:700; text-transform:uppercase; letter-spacing:.4px; margin-bottom:3px; }
  .db-sales__m strong { font-size:15px; font-weight:800; }
  .db-sales__flag { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:800; padding:5px 12px; border-radius:20px; }
  .db-sales__flag.ok { background:#EAF7F0; color:#1E8E5A; }
  .db-sales__flag.no { background:#FDF2E7; color:#B26B00; }

  /* Uso del capital */
  .db-cap { padding: 6px 22px 22px; }
  .db-cap__tot { display:flex; align-items:center; gap:14px; padding:14px 16px; border-radius:13px; background:var(--pn-purple-soft); margin-bottom:20px; flex-wrap:wrap; }
  .db-cap__tot b { font-size:18px; font-weight:900; }
  .db-cap__tot small { font-size:12px; color:var(--pn-ink-2); font-weight:600; }
  .db-cap__tot .pill { margin-left:auto; font-size:12px; font-weight:800; color:var(--pn-purple); background:#fff; padding:5px 12px; border-radius:20px; }
  .db-cap__row { margin-bottom:16px; }
  .db-cap__row:last-child { margin-bottom:0; }
  .db-cap__rh { display:flex; align-items:baseline; gap:8px; margin-bottom:7px; }
  .db-cap__rh strong { font-size:14px; font-weight:700; }
  .db-cap__rh .amt { margin-left:auto; font-size:13px; font-weight:800; color:var(--pn-ink-2); }
  .db-cap__rh .amt b { color:var(--pn-ink); }
  .db-cap__bar { height:9px; border-radius:20px; background:#F1F0F5; overflow:hidden; }
  .db-cap__bar i { display:block; height:100%; border-radius:20px; background:var(--pn-purple); }
  .db-cap__note { font-size:12px; color:var(--pn-muted); margin-top:5px; }

  /* Riesgos */
  .db-risks { padding: 6px 22px 20px; display:flex; flex-direction:column; gap:14px; }
  .db-risk { display:flex; gap:13px; padding:14px; border:1px solid var(--pn-border); border-radius:14px; }
  .db-risk__dot { width:11px; height:11px; border-radius:50%; flex-shrink:0; margin-top:5px; }
  .db-risk__b { flex:1; min-width:0; }
  .db-risk__b strong { display:block; font-size:14px; font-weight:700; line-height:1.35; }
  .db-risk__b p { font-size:13px; color:var(--pn-ink-2); line-height:1.5; margin-top:4px; }
  .db-risk__tags { display:flex; gap:8px; margin-top:9px; flex-wrap:wrap; }
  .db-risk__tag { font-size:11px; font-weight:800; padding:4px 10px; border-radius:20px; }

  /* Benefits */
  .db-benefits { list-style:none; padding: 4px 22px 22px; display:flex; flex-direction:column; gap:13px; }
  .db-benefits li { display:flex; align-items:flex-start; gap:12px; font-size:14px; color:var(--pn-ink); line-height:1.4; }
  .db-benefits li svg { width:21px; height:21px; flex-shrink:0; margin-top:1px; }

  /* Distribution */

  /* Rail: my membership mini */
  .db-mini { border-radius: 18px; padding: 22px; color:#fff; position:relative; overflow:hidden; }
  .db-mini small { font-size:11px; font-weight:800; letter-spacing:1.5px; text-transform:uppercase; opacity:.8; }
  .db-mini b { display:block; font-size:26px; font-weight:900; letter-spacing:1px; margin:6px 0 14px; }
  .db-mini .amt { font-size:20px; font-weight:900; }
  .db-mini .amt span { display:block; font-size:11px; font-weight:700; opacity:.8; text-transform:uppercase; letter-spacing:.5px; margin-top:2px; }

  /* Rail news */
  .db-news { padding: 6px 10px 12px; display:flex; flex-direction:column; }
  .db-news__item { display:flex; gap:12px; padding: 11px 10px; border-radius:13px; }
  .db-news__item:hover { background:var(--pn-purple-soft); }
  .db-news__thumb { width:48px; height:48px; border-radius:12px; object-fit:cover; flex-shrink:0; }
  .db-news__b strong { display:block; font-size:13px; font-weight:700; line-height:1.3; }
  .db-news__b small { font-size:11px; color:var(--pn-muted); font-weight:600; }
  .db-news__tag { font-size:10px; font-weight:900; text-transform:uppercase; letter-spacing:.4px; }

  /* Rail advisor */
  .db-advisor { padding: 6px 20px 20px; }
  .db-advisor__row { display:flex; align-items:center; gap:13px; margin-bottom:14px; }
  .db-advisor__av { width:46px; height:46px; border-radius:50%; background:var(--pn-purple); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:15px; flex-shrink:0; }
  .db-advisor__row strong { display:block; font-size:14px; font-weight:800; }
  .db-advisor__row small { font-size:12px; color:var(--pn-ink-2); }
  .db-wa { display:flex; align-items:center; justify-content:center; gap:9px; width:100%; padding:12px; border-radius:13px; background:var(--pn-ink); color:#fff; font-size:13px; font-weight:800; }
  .db-wa svg { width:17px; height:17px; fill:#fff; }

  /* Rail documents */
  .db-docs { padding: 4px 12px 14px; }
  .db-doc { display:flex; align-items:center; gap:13px; padding:11px 10px; border-radius:13px; }
  .db-doc:hover { background:var(--pn-purple-soft); }
  .db-doc__ic { width:38px; height:38px; border-radius:11px; background:var(--pn-purple-soft); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .db-doc__ic svg { width:19px; height:19px; stroke:var(--pn-purple); }
  .db-doc__b strong { display:block; font-size:13px; font-weight:700; }
  .db-doc__b small { font-size:11px; color:var(--pn-muted); font-weight:600; }
  .db-doc__dl { margin-left:auto; }
  .db-doc__dl svg { width:17px; height:17px; stroke:var(--pn-muted); }

  /* Paquetes de inversión */
  .db-pkgs { display:flex; flex-direction:column; gap:14px; padding: 6px 22px 22px; }
  .db-pkg { border:1px solid var(--pn-border); border-radius:16px; padding:16px 18px; }
  .db-pkg.is-mine { border-color:#DCCFF7; background:var(--pn-purple-soft); }
  .db-pkg__top { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
  .db-pkg__top strong { font-size:16px; font-weight:800; }
  .db-pkg__tags { display:flex; gap:6px; }
  .db-pkg__tag { font-size:10.5px; font-weight:800; text-transform:uppercase; letter-spacing:.3px; padding:4px 9px; border-radius:20px; }
  .db-pkg__tag.mine { background:var(--pn-purple); color:#fff; }
  .db-pkg__tag.priv { background:#14141B; color:#fff; }
  .db-pkg__meta { font-size:13px; font-weight:700; color:var(--pn-ink-2); margin-top:4px; }
  .db-pkg__benefits { list-style:none; margin-top:10px; display:flex; flex-direction:column; gap:6px; }
  .db-pkg__benefits li { font-size:13px; color:var(--pn-ink); padding-left:18px; position:relative; line-height:1.4; }
  .db-pkg__benefits li::before { content:'✓'; position:absolute; left:0; color:var(--pn-purple); font-weight:900; }

  @media (max-width: 1100px) { .db-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .db-stats { grid-template-columns: 1fr; } .db-cat__meta { gap:20px; flex-wrap:wrap; } .db-cat__amount { font-size:38px; } }

  /* Desempeño del evento (riesgo) */
  .db-perf { display:flex; gap:16px; padding: 4px 22px 22px; flex-wrap:wrap; }
  .db-perf > div { flex:1; min-width:120px; background:var(--pn-purple-soft); border-radius:14px; padding:14px 16px; }
  .db-perf small { display:block; font-size:11px; color:var(--pn-ink-2); font-weight:700; text-transform:uppercase; letter-spacing:.4px; margin-bottom:5px; }
  .db-perf strong { font-size:18px; font-weight:900; letter-spacing:-.4px; }

  /* Simulador (riesgo) */
  .db-sim { padding: 4px 22px 22px; }
  .db-sim__note { font-size:12.5px; color:var(--pn-ink-2); margin-bottom:16px; }
  .db-sim__att { font-size:26px; font-weight:900; color:var(--pn-purple); letter-spacing:-.5px; margin-bottom:4px; }
  .db-sim__att span { font-size:13px; font-weight:700; color:var(--pn-muted); }
  .db-sim__range { width:100%; accent-color: var(--pn-purple); height:6px; margin:10px 0 20px; }
  .db-sim__out { display:flex; gap:14px; flex-wrap:wrap; }
  .db-sim__out > div { flex:1; min-width:150px; border:1px solid var(--pn-border); border-radius:14px; padding:14px 16px; }
  .db-sim__out small { display:block; font-size:11px; color:var(--pn-muted); font-weight:700; text-transform:uppercase; letter-spacing:.4px; margin-bottom:6px; }
  .db-sim__out strong { font-size:19px; font-weight:900; letter-spacing:-.4px; }
  .db-sim__out .hl { color:var(--pn-purple); }
  .db-sim__foot { font-size:11.5px; color:var(--pn-muted); margin-top:14px; }

  /* Aviso modalidad fija */
  .db-fixed-note { display:flex; gap:15px; align-items:flex-start; padding: 20px 22px 24px; }
  .db-fixed-note svg { width:26px; height:26px; stroke:var(--pn-purple); flex-shrink:0; margin-top:2px; }
  .db-fixed-note strong { display:block; font-size:15px; font-weight:800; margin-bottom:4px; }
  .db-fixed-note p { font-size:13px; color:var(--pn-ink-2); line-height:1.5; }
</style>

{{#if panel.showOnboarding}}
<style>
  .ob { position: fixed; inset: 0; z-index: 200; background: radial-gradient(1200px 700px at 50% 25%, #241a48 0%, #0E0E14 60%); display: flex; align-items: center; justify-content: center; text-align: center; color: #fff; padding: 24px; opacity: 1; transition: opacity .5s; }
  .ob.is-hiding { opacity: 0; }
  .ob__step { display: none; width: 100%; max-width: 980px; }
  .ob__step.is-active { display: block; animation: obIn .5s ease; }
  @keyframes obIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .ob__logo { width: 76px; height: 76px; margin: 0 auto 22px; border-radius: 22px; background: rgba(108,60,224,.18); border: 1px solid rgba(108,60,224,.4); display: flex; align-items: center; justify-content: center; }
  .ob__logo img { width: 48px; height: 48px; }
  .ob__kicker { font-size: 11px; font-weight: 800; letter-spacing: 3px; text-transform: uppercase; color: #A78BE6; margin-bottom: 12px; }
  .ob__title { font-size: clamp(26px, 5vw, 44px); font-weight: 900; letter-spacing: -.5px; line-height: 1.08; }
  .ob__sub { font-size: 15px; color: rgba(255,255,255,.7); margin-top: 14px; }
  .ob__btn { margin-top: 30px; background: var(--pn-purple); color: #fff; border: none; font-family: inherit; font-size: 16px; font-weight: 800; padding: 16px 40px; border-radius: 15px; cursor: pointer; box-shadow: 0 14px 34px rgba(108,60,224,.4); transition: background .15s, transform .15s; }
  .ob__btn:hover { background: #5A2FC7; transform: translateY(-1px); }
  .ob__btn:disabled { background: #3a3550; color: rgba(255,255,255,.5); box-shadow: none; cursor: default; transform: none; }
  .ob__skip { display: inline-block; margin-top: 18px; background: none; border: none; color: rgba(255,255,255,.5); font-family: inherit; font-size: 13px; font-weight: 700; cursor: pointer; opacity: 0; transition: opacity .4s; }
  .ob__skip.is-show { opacity: 1; }
  .ob__skip:hover { color: #fff; }
  .ob__frame { position: relative; width: 100%; max-width: 900px; margin: 0 auto; border-radius: 18px; overflow: hidden; background: #000; box-shadow: 0 30px 80px rgba(0,0,0,.55); border: 1px solid rgba(108,60,224,.3); }
  .ob__frame video { display: block; width: 100%; max-height: 74vh; object-fit: contain; background: #000; }
  .ob__check { width: 84px; height: 84px; margin: 0 auto 24px; border-radius: 50%; background: rgba(108,60,224,.18); border: 1px solid rgba(108,60,224,.45); display: flex; align-items: center; justify-content: center; }
  .ob__check svg { width: 42px; height: 42px; stroke: #A78BE6; }
  @media (max-width: 640px) { .ob__frame video { max-height: 62vh; } }
</style>
<div class="ob" id="ob" data-web="{{panel.tour.video}}" data-mobile="{{panel.tour.videoMobile}}">
  <!-- 1) Portada -->
  <div class="ob__step is-active" id="obCover">
    <div class="ob__logo"><img src="/assets/images/iconsoccerid.png" alt="SOCCER iD"></div>
    <div class="ob__kicker">SOCCER iD · Experiencia VIP</div>
    <h1 class="ob__title">Bienvenido a tu<br>experiencia VIP de inversionista</h1>
    <p class="ob__sub">Un recorrido rápido por tu panel · {{panel.tour.label}}</p>
    <div><button class="ob__btn" id="obStart">Comenzar</button></div>
    <button class="ob__skip" id="obSkip">Saltar intro</button>
  </div>
  <!-- 2) Video -->
  <div class="ob__step" id="obStage">
    <div class="ob__frame"><video id="obVideo" playsinline controls preload="auto"></video></div>
    <div><button class="ob__btn" id="obContinue" disabled>Continuar</button></div>
  </div>
  <!-- 3) Bienvenida -->
  <div class="ob__step" id="obWelcome">
    <div class="ob__check"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
    <h1 class="ob__title">Bienvenido a la experiencia VIP<br>de inversionista de SOCCER iD</h1>
  </div>
</div>
<script>
  (function(){
    var ob = document.getElementById('ob'); if (!ob) return;
    var cover = document.getElementById('obCover'), stage = document.getElementById('obStage'), welcome = document.getElementById('obWelcome');
    var start = document.getElementById('obStart'), cont = document.getElementById('obContinue'), skip = document.getElementById('obSkip');
    var v = document.getElementById('obVideo');
    var html = document.documentElement; html.style.overflow = 'hidden';
    function show(step){ [cover, stage, welcome].forEach(function(s){ s.classList.toggle('is-active', s === step); }); }
    function mark(){ fetch('/panel/onboarded', { method: 'POST', headers: { 'Content-Type': 'application/json' } }).catch(function(){}); }
    function finish(){ mark(); ob.classList.add('is-hiding'); setTimeout(function(){ ob.remove(); html.style.overflow = ''; }, 550); }
    setTimeout(function(){ skip.classList.add('is-show'); }, 6000);
    start.addEventListener('click', function(){
      var src = window.matchMedia('(max-width:860px)').matches ? ob.getAttribute('data-mobile') : ob.getAttribute('data-web');
      v.setAttribute('src', src); show(stage);
      try { v.play(); } catch(_){}
    });
    v.addEventListener('ended', function(){ cont.disabled = false; });
    v.addEventListener('error', function(){ cont.disabled = false; });
    cont.addEventListener('click', function(){ try { v.pause(); } catch(_){} show(welcome); setTimeout(finish, 3200); });
    skip.addEventListener('click', function(){ try { v.pause(); } catch(_){} finish(); });
  })();
</script>
{{/if}}

{{#if panel.stage.label}}
<div class="pn-stage">
  <span class="pn-stage__badge">Etapa {{panel.stage.step}} de {{panel.stage.total}}</span>
  <div class="pn-stage__b">
    <strong>{{panel.stage.label}}</strong>
    {{#if panel.stage.note}}<span>{{panel.stage.note}}</span>{{/if}}
  </div>
  <div class="pn-stage__prog">
    <small>Avance del proyecto · {{panel.stage.pct}}%</small>
    <div class="pn-stage__bar"><i style="width: {{panel.stage.pct}}%"></i></div>
  </div>
  {{#if panel.stage.updated}}<div class="pn-stage__updated">Actualizado {{panel.stage.updated}}</div>{{/if}}
</div>
{{/if}}

<div class="db-chips">
  <a href="#mi-inversion" class="db-chip is-active" data-anchor>{{#eq panel.user.role 'sponsor'}}Mi patrocinio{{else}}Mi inversión{{/eq}}</a>
  {{#if panel.user.isRisk}}
  <a href="#desempeno" class="db-chip" data-anchor>Desempeño</a>
  <a href="#simulador" class="db-chip" data-anchor>Simulador</a>
  {{/if}}
  {{#if panel.capital.items.length}}<a href="#uso-capital" class="db-chip" data-anchor>Uso del capital</a>{{/if}}
  <a href="/panel/documentos" class="db-chip">Documentos y evidencias</a>
  <a href="/panel/calendario" class="db-chip">Cronograma</a>
</div>

<div class="db-grid">
  <div class="db-col">
    <!-- Category hero -->
    <div class="db-cat" id="mi-inversion" style="background: {{panel.user.color}}">
      <div class="db-cat__gemwm">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3 6 9l6 12 6-12-3-6"/></svg>
      </div>
      <div class="db-cat__top">
        <span class="db-cat__tier">
          <span class="gem"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3 6 9l6 12 6-12-3-6"/></svg></span>
          <b>{{panel.user.categoryLabel}}</b>
        </span>
        <span class="db-cat__id">{{panel.user.memberId}}</span>
      </div>
      <div class="db-cat__label">{{#eq panel.user.role 'sponsor'}}Monto patrocinado{{else}}Monto invertido · {{panel.user.investmentTypeLabel}}{{/eq}}</div>
      <div class="db-cat__amount">{{panel.user.amount}}</div>
      <div class="db-cat__meta">
        {{#eq panel.user.role 'sponsor'}}
        <div><small>Categoría</small><strong>{{panel.user.categoryLabel}}</strong></div>
        <div><small>Miembro desde</small><strong>{{panel.user.since}}</strong></div>
        {{else}}
        <div><small>{{#if panel.user.isRisk}}Capital + utilidad{{else}}Capital + retorno{{/if}}</small><strong>{{panel.user.projectedReturn}}</strong></div>
        <div><small>{{panel.user.returnMetaLabel}}</small><strong>{{panel.user.returnPct}}</strong></div>
        {{#if panel.user.isRisk}}
        <div><small>Participación efectiva</small><strong>{{panel.user.effectiveSharePct}}</strong></div>
        {{else}}
        <div><small>Miembro desde</small><strong>{{panel.user.since}}</strong></div>
        {{/if}}
        {{/eq}}
      </div>
    </div>

    {{#if panel.trace.source}}
    <div class="pn-stamp" style="margin:-8px 2px 0;">
      <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
      {{#if panel.trace.updated}}<span>Actualizado <b>{{panel.trace.updated}}</b></span><span class="sep">·</span>{{/if}}<span>Fuente: <b>{{panel.trace.source}}</b></span>
    </div>
    {{/if}}

    <!-- Stats -->
    <div class="db-stats">
      {{#each panel.stats}}
      <div class="db-stat">
        <div class="db-stat__ico" style="background: {{this.accent}}">
          {{#eq this.icon 'wallet'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><circle cx="17" cy="14" r="1.3"/></svg>{{/eq}}
          {{#eq this.icon 'trend'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/></svg>{{/eq}}
          {{#eq this.icon 'diamond'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18"/></svg>{{/eq}}
          {{#eq this.icon 'clock'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>{{/eq}}
        </div>
        <div class="db-stat__val" {{#if this.countdown}}id="pnCountdown"{{/if}}>{{this.value}}</div>
        <div class="db-stat__lbl">{{this.label}}</div>
        {{#if this.sub}}<div class="db-stat__sub" style="color: {{this.accent}}">{{this.sub}}</div>{{/if}}
      </div>
      {{/each}}
    </div>

    {{#if panel.user.isRisk}}
    {{#if panel.eventPerf}}
    <!-- Desempeño del evento (solo riesgo) -->
    <div class="pn-card" id="desempeno">
      <div class="pn-card__head"><h3>Desempeño del evento</h3><span class="pn-card__link" style="color:var(--pn-muted)">Variables de tu modalidad</span></div>
      <div class="db-perf">
        <div><small>Presupuesto</small><strong>{{panel.eventPerf.budget}}</strong></div>
        <div><small>Ingreso proyectado</small><strong>{{panel.eventPerf.projectedIncome}}</strong></div>
        <div><small>Avance operativo</small><strong>{{panel.eventPerf.progress}}%</strong></div>
      </div>
    </div>
    {{/if}}

    <!-- Venta en taquilla (solo riesgo: es sensible a tu utilidad) -->
    <div class="pn-card" id="ventas">
      <div class="pn-card__head">
        <h3>Venta en taquilla</h3>
        {{#if panel.sales.updated}}<span class="pn-card__link" style="color:var(--pn-muted)">Al {{panel.sales.updated}}</span>{{/if}}
      </div>
      <div class="db-sales">
        <div class="db-sales__top">
          <div class="db-sales__big">{{panel.sales.soldLabel}} <span>/ {{panel.sales.capacityLabel}} boletos</span></div>
          <div class="db-sales__occ"><b>{{panel.sales.occupancyPct}}%</b><small>Ocupación</small></div>
        </div>
        <div class="db-track">
          <div class="db-track__fill" style="width: {{panel.sales.soldPct}}%"></div>
        </div>
        <div class="db-sales__foot">
          <div class="db-sales__m"><small>Taquilla estimada</small><strong>{{panel.sales.boxOffice}}</strong></div>
          <div class="db-sales__m"><small>Meta (lleno)</small><strong>{{panel.sales.goalBoxOffice}}</strong></div>
        </div>
        <p class="pn-stamp" style="margin-top:16px;">
          <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/></svg>
          <span>Tu utilidad a riesgo evoluciona con la taquilla del evento.</span>
        </p>
      </div>
    </div>

    {{#if panel.simulator}}
    <!-- Simulador · Escenario por asistencia (solo riesgo) -->
    <div class="pn-card" id="simulador">
      <div class="pn-card__head"><h3>Simulador · ¿Cuánto podrías ganar?</h3></div>
      <div class="db-sim"
        data-capital="{{panel.simulator.capital}}" data-budget="{{panel.simulator.budget}}"
        data-capacity="{{panel.simulator.capacity}}" data-ticket="{{panel.simulator.ticketPrice}}"
        data-ded="{{panel.simulator.deductionsPct}}" data-rebate="{{panel.simulator.rebatePer}}"
        data-cap="{{panel.simulator.capPct}}" data-split="{{panel.simulator.split}}">
        <p class="db-sim__note">Mueve la barra para ver, según cuánta gente asista, cuánto podrías recibir. Es un ejemplo: suponemos boleto de ${{panel.simulator.ticketPrice}} en promedio, {{panel.simulator.deductionsPct}}% de deducciones y ${{panel.simulator.rebatePer}} de rebate por asistente.</p>
        <div class="db-sim__att"><span id="simAtt">—</span> <span>asistentes de {{panel.simulator.capacity}}</span></div>
        <input type="range" id="simRange" class="db-sim__range" min="0" max="{{panel.simulator.capacity}}" step="100">
        <div class="db-sim__out">
          <div><small>Lo que recauda el evento (neto)</small><strong id="simNet">—</strong></div>
          <div><small>Ganancia del evento</small><strong id="simProfit">—</strong></div>
          <div><small>Tu retorno estimado</small><strong class="hl" id="simReturn">—</strong></div>
        </div>
        <p class="db-sim__foot">Ejemplo ilustrativo: tu retorno cambia con la asistencia, pero tu retorno real depende de tu contrato y no puede pasar del {{panel.simulator.capPct}}% de tu capital ({{panel.user.amount}}).</p>
      </div>
    </div>
    {{/if}}

    {{else}}
    <!-- Modalidad fija: sin taquilla ni sensibilidad del evento -->
    <div class="pn-card" id="ventas">
      <div class="db-fixed-note">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        <div>
          <strong>Tu retorno no cambia con la asistencia</strong>
          <p>Esta vista omite asistentes, precio de boleto, presupuesto y sensibilidad del evento porque no modifican el rendimiento contractual.</p>
        </div>
      </div>
    </div>
    {{/if}}

    <!-- Benefits collapsible -->
    <div class="pn-card pn-collapse" id="beneficios">
      <div class="pn-card__head pn-collapse__head" data-collapse>
        <h3>Mis beneficios · {{panel.user.categoryLabel}}</h3>
        <svg class="pn-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--pn-ink-2)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
      <div class="pn-collapse__body">
        <ul class="db-benefits">
          {{#each panel.userBenefits}}
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="{{../panel.user.color}}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="8.5 12.5 11 15 16 9.5"/></svg>
            {{this}}
          </li>
          {{/each}}
        </ul>
      </div>
    </div>

    <!-- Paquetes de inversión (del evento + privados del inversionista) -->
    {{#if panel.packages.length}}
    <div class="pn-card" id="paquetes">
      <div class="pn-card__head"><h3>Paquetes de inversión</h3><span class="pn-card__link" style="color:var(--pn-muted)">Disponibles para este evento</span></div>
      <div class="db-pkgs">
        {{#each panel.packages}}
        <div class="db-pkg {{#if this.isMine}}is-mine{{/if}}">
          <div class="db-pkg__top">
            <strong>{{this.name}}</strong>
            <div class="db-pkg__tags">
              {{#if this.isMine}}<span class="db-pkg__tag mine">Tu modalidad</span>{{/if}}
              {{#if this.isPrivate}}<span class="db-pkg__tag priv">Exclusivo para ti</span>{{/if}}
            </div>
          </div>
          <div class="db-pkg__meta">{{this.modalityLabel}} · desde {{this.amountLabel}}{{#if this.returnPct}} · hasta {{this.returnPct}}%{{/if}}</div>
          {{#if this.benefits.length}}
          <ul class="db-pkg__benefits">
            {{#each this.benefits}}<li>{{this}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <!-- Uso del capital -->
    {{#if panel.capital.items.length}}
    <div class="pn-card" id="uso-capital">
      <div class="pn-card__head"><h3>Uso del capital</h3><span class="pn-card__link" style="color:var(--pn-ink-2)">{{panel.capital.spentPct}}% ejercido</span></div>
      <div class="db-cap">
        <div class="db-cap__tot">
          <div><b>{{panel.capital.totalSpent}}</b> <small>ejercido de {{panel.capital.totalBudget}} presupuestado</small></div>
          {{! Capital comprometido oculto al inversionista (info de negocio, solo admin) }}
        </div>
        {{#each panel.capital.items}}
        <div class="db-cap__row">
          <div class="db-cap__rh">
            <strong>{{this.label}}</strong>
            <span class="amt"><b>{{this.spentLabel}}</b> / {{this.budgetLabel}} · {{this.pct}}%</span>
          </div>
          <div class="db-cap__bar"><i style="width: {{this.pct}}%"></i></div>
          {{#if this.note}}<div class="db-cap__note">{{this.note}}{{#if this.source}} · Fuente: {{this.source}}{{/if}}</div>{{/if}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

  </div>

  <!-- Right rail -->
  <div class="db-col">
    <!-- Membership mini -->
    <div class="db-mini" style="background: {{panel.user.color}}">
      <small>Tu membresía</small>
      <b>{{panel.user.categoryLabel}}</b>
      <div class="amt">{{panel.user.amount}}<span>Monto invertido</span></div>
    </div>

    <!-- News -->
    <div class="pn-card">
      <div class="pn-card__head"><h3>Noticias recientes</h3><a href="/panel/noticias" class="pn-card__link">Ver todas ›</a></div>
      <div class="db-news">
        {{#each panel.news}}
        <a href="/panel/noticias/{{this.id}}" class="db-news__item">
          <img class="db-news__thumb" src="{{this.image}}" alt="">
          <div class="db-news__b">
            <span class="db-news__tag" style="color: {{this.tagColor}}">{{this.tag}}</span>
            <strong>{{this.title}}</strong>
            <small>{{this.date}}</small>
          </div>
        </a>
        {{/each}}
      </div>
    </div>

    <!-- Advisor -->
    <div class="pn-card">
      <div class="pn-card__head"><h3>Tu asesor</h3></div>
      <div class="db-advisor">
        <div class="db-advisor__row">
          <div class="db-advisor__av">{{panel.advisor.initials}}</div>
          <div>
            <strong>{{panel.advisor.name}}</strong>
            <small>{{panel.advisor.role}}</small>
          </div>
        </div>
        <a class="db-wa" href="https://wa.me/{{panel.advisor.whatsapp}}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M17.5 14.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.6.2s-.7.9-.9 1.1c-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5s-.6-1.5-.9-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.2s.9 2.5 1.1 2.7c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.7-.7 1.9-1.3.2-.6.2-1.2.2-1.3-.1-.2-.3-.2-.6-.4zM12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2z"/></svg>
          Contactar por WhatsApp
        </a>
      </div>
    </div>

    <!-- Documents -->
    <div class="pn-card">
      <div class="pn-card__head"><h3>Documentos y evidencias</h3><a href="/panel/documentos" class="pn-card__link">Ver todos ›</a></div>
      <div class="db-docs">
        {{#if panel.sharedFolder}}
        <a href="{{panel.sharedFolder.url}}" target="_blank" rel="noopener" class="db-doc" style="background:var(--pn-purple-soft); border-radius:13px;">
          <div class="db-doc__ic" style="background:var(--pn-purple);">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="stroke:#fff;"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div class="db-doc__b">
            <strong>Carpeta compartida</strong>
            <small>Google Drive</small>
          </div>
          <span class="db-doc__dl"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></span>
        </a>
        {{/if}}
        {{#each panel.userDocuments}}
        <a href="{{this.url}}" target="_blank" rel="noopener" class="db-doc">
          <div class="db-doc__ic">
            {{#if this.ext}}<span style="font-size:10px;font-weight:900;color:var(--pn-purple);">{{this.ext}}</span>{{else}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><polyline points="14 3 14 8 19 8"/></svg>{{/if}}
          </div>
          <div class="db-doc__b">
            <strong>{{this.name}}</strong>
            <small>{{this.meta}}</small>
          </div>
          <span class="db-doc__dl"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg></span>
        </a>
        {{/each}}
        {{#unless panel.userDocuments.length}}{{#unless panel.sharedFolder}}
        <p style="padding:14px 10px; font-size:12px; color:var(--pn-muted);">Aún no hay documentos compartidos contigo.</p>
        {{/unless}}{{/unless}}
      </div>
    </div>
  </div>
</div>

<script>
  (function(){
    var el = document.getElementById('pnCountdown');
    if (!el) return;
    var target = '{{panel.eventDateISO}}' || '2027-03-27T19:00:00-05:00';
    var days = Math.floor((new Date(target).getTime() - Date.now()) / 86400000);
    el.textContent = days > 0 ? days + ' días' : '¡Hoy!';
  })();
  // Chips de ancla: marca el activo al hacer clic
  (function(){
    var chips = document.querySelectorAll('.db-chip[data-anchor]');
    chips.forEach(function(c){
      c.addEventListener('click', function(){
        chips.forEach(function(x){ x.classList.toggle('is-active', x === c); });
      });
    });
  })();
  // Simulador "Escenario por asistencia" (solo riesgo). Ilustrativo: NO cambia el
  // retorno pactado del perfil (ese viene del contrato / computeReturn).
  (function(){
    var sim = document.querySelector('.db-sim');
    if (!sim) return;
    var n = function(k){ return parseFloat(sim.getAttribute('data-' + k)) || 0; };
    var capacity = n('capacity'), ticket = n('ticket'), ded = n('ded'), rebate = n('rebate'), budget = n('budget');
    var capital = n('capital'), split = n('split'), capPct = n('cap');
    var range = document.getElementById('simRange');
    var elAtt = document.getElementById('simAtt'), elNet = document.getElementById('simNet'),
        elProfit = document.getElementById('simProfit'), elReturn = document.getElementById('simReturn');
    var usd = function(v){ return 'USD ' + Math.round(v).toLocaleString('en-US'); };
    // Participación efectiva del perfil sobre la utilidad del evento (modelo 50/50)
    var effShare = budget > 0 ? (capital / budget) * (split / 100) : 0;
    var tope = capital * (capPct / 100);
    function render(){
      var att = parseInt(range.value, 10) || 0;
      var bruto = att * ticket;
      var neto = bruto * (1 - ded / 100) - att * rebate;
      var utilidad = neto - budget;
      // Retorno del perfil: su parte de la utilidad, nunca negativo, con tope sobre el capital
      var retorno = Math.min(Math.max(utilidad, 0) * effShare, tope);
      elAtt.textContent = att.toLocaleString('en-US');
      elNet.textContent = usd(Math.max(0, neto));
      elProfit.textContent = usd(utilidad);
      if (elReturn) elReturn.textContent = usd(retorno);
    }
    range.value = Math.round(capacity * 0.7); // escenario inicial
    range.addEventListener('input', render);
    render();
  })();
</script>
