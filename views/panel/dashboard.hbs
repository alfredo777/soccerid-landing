<style>
  .db-chips { display:flex; gap:10px; margin: 6px 0 20px; flex-wrap: wrap; }
  .db-chip { padding: 9px 18px; border-radius: 12px; background:#fff; border:1px solid var(--pn-border); font-size:13px; font-weight:700; color:var(--pn-ink-2); cursor:pointer; }
  .db-chip.is-active { background: var(--pn-ink); color:#fff; border-color: var(--pn-ink); }

  .db-grid { display:grid; grid-template-columns: 1fr 340px; gap: 20px; align-items:start; }
  .db-col { display:flex; flex-direction:column; gap: 20px; min-width:0; }

  /* Category hero */
  .db-cat { border-radius: var(--pn-radius); padding: 24px; color:#fff; position:relative; overflow:hidden; }
  .db-cat__top { display:flex; align-items:center; justify-content:space-between; }
  .db-cat__tier { display:flex; align-items:center; gap:10px; font-size:12px; font-weight:800; letter-spacing:2px; text-transform:uppercase; opacity:.95; }
  .db-cat__gem { width:34px; height:34px; border-radius:10px; background: rgba(255,255,255,.18); display:flex; align-items:center; justify-content:center; }
  .db-cat__gem svg { width:19px; height:19px; stroke:#fff; }
  .db-cat__amount { font-size: 34px; font-weight: 900; letter-spacing:-.5px; margin-top: 20px; }
  .db-cat__label { font-size:12px; opacity:.85; font-weight:600; }
  .db-cat__meta { display:flex; gap: 28px; margin-top: 22px; }
  .db-cat__meta div small { display:block; font-size:11px; opacity:.75; letter-spacing:.5px; text-transform:uppercase; }
  .db-cat__meta div strong { font-size:15px; font-weight:800; }

  /* Stats */
  .db-stats { display:grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .db-stat { background:#fff; border:1px solid var(--pn-border); border-radius:14px; padding:16px; box-shadow: var(--pn-shadow); }
  .db-stat__ico { width:38px; height:38px; border-radius:11px; display:flex; align-items:center; justify-content:center; margin-bottom:12px; }
  .db-stat__ico svg { width:19px; height:19px; stroke:#fff; }
  .db-stat__val { font-size:20px; font-weight:900; letter-spacing:-.3px; }
  .db-stat__lbl { font-size:12px; color:var(--pn-ink-2); font-weight:600; margin-top:2px; }
  .db-stat__sub { font-size:11px; color:var(--pn-muted); font-weight:700; margin-top:4px; }

  /* Benefits */
  .db-benefits { list-style:none; padding: 6px 20px 20px; display:flex; flex-direction:column; gap:12px; }
  .db-benefits li { display:flex; align-items:flex-start; gap:12px; font-size:14px; color:var(--pn-ink); line-height:1.4; }
  .db-benefits li svg { width:20px; height:20px; flex-shrink:0; margin-top:1px; }

  /* Distribution */
  .db-dist { display:flex; align-items:center; gap: 26px; padding: 22px 20px; flex-wrap:wrap; }
  .db-donut { position:relative; width:150px; height:150px; flex-shrink:0; }
  .db-donut__hole { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
  .db-donut__hole strong { font-size:26px; font-weight:900; line-height:1; }
  .db-donut__hole small { font-size:11px; color:var(--pn-muted); font-weight:700; }
  .db-legend { flex:1; display:flex; flex-direction:column; gap:10px; min-width:170px; }
  .db-legend__row { display:flex; align-items:center; gap:10px; font-size:13px; }
  .db-legend__row .sw { width:11px; height:11px; border-radius:4px; flex-shrink:0; }
  .db-legend__row span { font-weight:600; }
  .db-legend__row b { margin-left:auto; font-weight:800; }

  /* Right rail news */
  .db-news { padding: 8px 10px 12px; display:flex; flex-direction:column; }
  .db-news__item { display:flex; gap:12px; padding: 12px 10px; border-radius:12px; }
  .db-news__item:hover { background:#F7F8FA; }
  .db-news__thumb { width:46px; height:46px; border-radius:11px; object-fit:cover; flex-shrink:0; }
  .db-news__b strong { display:block; font-size:13px; font-weight:700; line-height:1.3; }
  .db-news__b small { font-size:11px; color:var(--pn-muted); font-weight:600; }
  .db-news__tag { font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.4px; }

  /* Milestones */
  .db-miles { padding: 6px 20px 22px; }
  .db-mile { display:flex; gap:14px; position:relative; padding-bottom:18px; }
  .db-mile:last-child { padding-bottom:0; }
  .db-mile__dot { width:14px; height:14px; border-radius:50%; border:3px solid #fff; flex-shrink:0; margin-top:2px; box-shadow:0 0 0 1px var(--pn-border); z-index:1; }
  .db-mile:not(:last-child)::before { content:''; position:absolute; left:6px; top:14px; bottom:0; width:2px; background:var(--pn-border); }
  .db-mile__b strong { display:block; font-size:14px; font-weight:700; }
  .db-mile__b small { font-size:12px; color:var(--pn-muted); font-weight:600; }
  .db-mile__chip { font-size:10px; font-weight:800; text-transform:uppercase; padding:2px 8px; border-radius:20px; margin-left:8px; }

  @media (max-width: 1100px) { .db-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .db-stats { grid-template-columns: 1fr; } .db-cat__meta { gap:18px; flex-wrap:wrap; } }
</style>

<div class="db-chips">
  <div class="db-chip is-active">Resumen</div>
  <div class="db-chip">Mis beneficios</div>
  <div class="db-chip">Distribución</div>
  <div class="db-chip">Documentos</div>
</div>

<div class="db-grid">
  <div class="db-col">
    <!-- Category hero -->
    <div class="db-cat" style="background: {{panel.user.color}}">
      <div class="db-cat__top">
        <div class="db-cat__tier">
          <span class="db-cat__gem">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3 6 9l6 12 6-12-3-6"/></svg>
          </span>
          Inversionista {{panel.user.categoryLabel}}
        </div>
        <span style="font-size:12px; font-weight:700; opacity:.85;">{{panel.user.memberId}}</span>
      </div>
      <div class="db-cat__label">Monto invertido</div>
      <div class="db-cat__amount">{{panel.user.amount}}</div>
      <div class="db-cat__meta">
        <div><small>Retorno proyectado</small><strong>{{panel.user.projectedReturn}}</strong></div>
        <div><small>Rendimiento</small><strong>{{panel.user.returnPct}}</strong></div>
        <div><small>Miembro desde</small><strong>{{panel.user.since}}</strong></div>
      </div>
    </div>

    <!-- Stats -->
    <div class="db-stats">
      {{#each panel.stats}}
      <div class="db-stat">
        <div class="db-stat__ico" style="background: {{this.accent}}">
          {{#eq this.icon 'wallet'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><circle cx="17" cy="14" r="1.3"/></svg>{{/eq}}
          {{#eq this.icon 'trend'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/></svg>{{/eq}}
          {{#eq this.icon 'diamond'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18"/></svg>{{/eq}}
          {{#eq this.icon 'clock'}}<svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>{{/eq}}
        </div>
        <div class="db-stat__val" {{#if this.countdown}}id="pnCountdown"{{/if}}>{{this.value}}</div>
        <div class="db-stat__lbl">{{this.label}}</div>
        {{#if this.sub}}<div class="db-stat__sub" style="color: {{this.accent}}">{{this.sub}}</div>{{/if}}
      </div>
      {{/each}}
    </div>

    <!-- Benefits collapsible -->
    <div class="pn-card pn-collapse">
      <div class="pn-card__head pn-collapse__head" data-collapse>
        <h3>Mis beneficios · {{panel.user.categoryLabel}}</h3>
        <svg class="pn-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--pn-ink-2)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
      <div class="pn-collapse__body">
        <ul class="db-benefits">
          {{#each panel.userBenefits}}
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="{{../panel.user.color}}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="8.5 12.5 11 15 16 9.5"/></svg>
            {{this}}
          </li>
          {{/each}}
        </ul>
      </div>
    </div>

    <!-- Distribution -->
    <div class="pn-card">
      <div class="pn-card__head"><h3>Distribución de inversionistas</h3><span class="pn-card__link">{{panel.investorTotal}} en total</span></div>
      <div class="db-dist">
        <div class="db-donut">
          <svg width="150" height="150" viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="54" fill="none" stroke="#F0F1F4" stroke-width="12"/>
            {{#each panel.donut}}
            <circle cx="60" cy="60" r="54" fill="none" stroke="{{this.color}}" stroke-width="12"
              stroke-dasharray="{{this.len}} {{../panel.donutC}}"
              transform="rotate({{this.angle}} 60 60)" stroke-linecap="butt"/>
            {{/each}}
          </svg>
          <div class="db-donut__hole"><strong>{{panel.investorTotal}}</strong><small>inversionistas</small></div>
        </div>
        <div class="db-legend">
          {{#each panel.distribution}}
          <div class="db-legend__row">
            <span class="sw" style="background: {{this.color}}"></span>
            <span>{{this.label}}</span>
            <b>{{this.count}}</b>
          </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

  <!-- Right rail -->
  <div class="db-col">
    <div class="pn-card">
      <div class="pn-card__head"><h3>Noticias recientes</h3><a href="/panel/noticias" class="pn-card__link">Ver todas ›</a></div>
      <div class="db-news">
        {{#each panel.news}}
        <a href="/panel/noticias" class="db-news__item">
          <img class="db-news__thumb" src="{{this.image}}" alt="">
          <div class="db-news__b">
            <span class="db-news__tag" style="color: {{this.tagColor}}">{{this.tag}}</span>
            <strong>{{this.title}}</strong>
            <small>{{this.date}}</small>
          </div>
        </a>
        {{/each}}
      </div>
    </div>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Cronograma</h3><a href="/panel/calendario" class="pn-card__link">Calendario ›</a></div>
      <div class="db-miles">
        {{#each panel.milestones}}
        <div class="db-mile">
          <span class="db-mile__dot" style="background: {{#if this.done}}#2FB380{{else}}{{#if this.highlight}}#C79A2E{{else}}#fff{{/if}}{{/if}}"></span>
          <div class="db-mile__b">
            <strong>{{this.title}}{{#if this.highlight}}<span class="db-mile__chip" style="background:#FBF4E0; color:#C79A2E;">Partido</span>{{/if}}</strong>
            <small>{{this.date}}{{#if this.done}} · Completado{{/if}}</small>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</div>

<script>
  (function(){
    var el = document.getElementById('pnCountdown');
    if (!el) return;
    var target = new Date('2027-03-27T19:00:00-05:00').getTime();
    function tick(){
      var d = target - Date.now();
      if (d < 0) { el.textContent = '¡Hoy!'; return; }
      var days = Math.floor(d / 86400000);
      el.textContent = days + ' días';
    }
    tick();
  })();
</script>
