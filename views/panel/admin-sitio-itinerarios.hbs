{{!-- Panel › Sitio web › Itinerarios. Un bloque por viaje próximo; el
      formulario lo arma assets/js/admin-sitio.js con el esquema que se
      construye abajo a partir de los viajes. Lógica: lib/itinerarios.js. --}}
<link rel="stylesheet" href="/assets/css/admin-sitio.css?v={{version}}">

<div class="st-top">
  <a class="st-back" href="/panel/admin">← Volver al panel</a>
  <div class="st-top__der">
    <a class="st-ver" href="/es/travel#viajes" target="_blank" rel="noopener">Ver los viajes ↗</a>
  </div>
</div>

<div class="st-aviso">Todos los viajes arrancan con el itinerario de ejemplo del documento de textos y se ven <b>como ejemplo</b>, con su pastilla. Cuando captures el real, cámbialo a <b>Publicado</b>. Si un viaje no debe llevar itinerario, elige <b>No se muestra</b>.</div>

<div id="sitioEditor"></div>

<script type="application/json" id="sitioDatos">{{{datos}}}</script>
<script>
  (function () {
    var datos = JSON.parse(document.getElementById('sitioDatos').textContent);
    window.SITIO_ESQUEMA = {
      guardar: '/panel/admin/sitio/itinerarios',
      nota: 'Se guardan todos los itinerarios juntos.',
      secciones: (datos.viajes || []).map(function (v) {
        return {
          id: v.slug,
          titulo: v.nombre,
          sub: v.fechaTexto + ' · /es/viaje/' + v.slug,
          campos: [
            { k: v.slug + '.estado', l: '¿Cómo se ve en la ficha del viaje?', tipo: 'select',
              opciones: [['ejemplo', 'Como ejemplo (con la pastilla «Itinerario de ejemplo»)'], ['publicado', 'Publicado: itinerario confirmado'], ['oculto', 'No se muestra']] },
            { k: v.slug + '.entradas', l: 'Actividades, en orden', tipo: 'lista', max: 60, agregar: 'Agregar actividad',
              ayuda: 'Las actividades con la misma fecha, seguidas, se agrupan en un día. La hora es opcional.',
              cols: [
                { c: 'fecha', l: 'Fecha', ej: '26 de marzo de 2027' }, { c: 'hora', l: 'Hora (opcional)', ej: 'Ej. 18:00' },
                { c: 'concepto', l: 'Concepto', ej: 'Llegada y hospedaje' },
                { c: 'detalle', l: 'Detalle', tipo: 'area', filas: 2, ancho: 'ancha' }
              ] }
          ]
        };
      })
    };
  })();
</script>
<script src="/assets/js/admin-sitio.js?v={{version}}"></script>
