<script>
  window.__portfolioForms = {{{jsonScript portfolioForms}}};
  // Una sola edición por año: este drawer guarda identidad, contenido público,
  // presentación e inversión de una vez. Antes esto estaba partido en dos
  // pestañas que podían quedar contando cosas distintas del mismo año.
  var PF_IDENTIDAD = ['code','year','title','subtitle','match','description','venue','city','country',
    'event_date','date_phase','phase','status','progress_pct','accent','presentation_es','presentation_en',
    'budget','projected_income','capacity','ticket_price','deductions_pct','rebate_per','cap_pct','investor_split'];
  var PF_PUBLICO = ['banner','att_value','att_label_es','att_label_en','title_es','title_en','description_es','description_en'];

  function openPortfolio(id){
    var f = document.getElementById('form-portfolio');
    var data = (window.__portfolioForms || []).filter(function(x){ return String(x.id) === String(id); })[0];

    if (id && data){
      document.getElementById('pf-modal-title').textContent = 'Editar edición · ' + (data.title || '');
      f.action = '/panel/admin/portfolio/' + id + '/update';
      PF_IDENTIDAD.forEach(function(k){ var el = document.getElementById('pf-' + k); if (el) el.value = (data[k] != null ? data[k] : ''); });
      PF_PUBLICO.forEach(function(k){ var el = document.getElementById('ed-' + k); if (el) el.value = (data[k] != null ? data[k] : ''); });
      document.getElementById('pf-is_demo').checked = !!data.is_demo;
    } else {
      document.getElementById('pf-modal-title').textContent = 'Nueva edición';
      f.action = '/panel/admin/portfolio';
      f.reset();
      document.getElementById('pf-accent').value = '#6C3CE0';
      PF_PUBLICO.forEach(function(k){ var el = document.getElementById('ed-' + k); if (el) el.value = ''; });
    }

    var thumb = document.getElementById('ed-banner-thumb');
    if (thumb){
      var b = document.getElementById('ed-banner').value;
      thumb.hidden = !b;
      if (b) thumb.src = b;
    }
    var filas = (data && data.rows) || {};
    Object.keys(ED_JSON_FIELDS).forEach(function(name){
      edState[name] = (filas[name] || []).map(function(o){ return Object.assign({}, o); });
      edRender(name);
    });
    var prev = document.getElementById('ed-preview');
    if (prev){ prev.hidden = true; prev.innerHTML = ''; }
    setEditionLang('es');
    openModal('modal-portfolio');
  }
</script>

