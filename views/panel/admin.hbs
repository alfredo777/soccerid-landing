  var CODES_HISTORY = {{{jsonScript codesHistory}}};
  // Mapa de relaciones de códigos
  var RELATIONS = {{{jsonScript relations}}};
  (function(){
    var canvas = document.getElementById('mpCanvas');
    if (!canvas) return;
    var filtro = '';

    function cortar(t, n){ t = String(t || ''); return t.length > n ? t.slice(0, n - 1) + '\u2026' : t; }

    function dibujar(){
      var owners = RELATIONS.owners.filter(function(o){
        return !filtro || (o.tags || []).indexOf(filtro) !== -1;
      });
      var idsDuenio = {};
      owners.forEach(function(o){ idsDuenio[o.id] = true; });
      var edges = RELATIONS.edges.filter(function(e){ return idsDuenio[e.from]; });
      var idsVis = {};
      edges.forEach(function(e){ idsVis[e.to] = true; });
      var visitors = RELATIONS.visitors.filter(function(v){ return idsVis[v.id]; });

      if (!owners.length){
        canvas.innerHTML = '<div class="mp-empty"><strong>Todavía no hay nada que mapear.</strong>'
          + (RELATIONS.owners.length
              ? 'Ningún código con ese tag.'
              : 'Asigna un dueño a los códigos en la pestaña <b>Códigos</b>. En cuanto alguien entre con uno de ellos, aquí se dibuja la relación.')
          + '</div>';
        return;
      }
      if (!edges.length){
        canvas.innerHTML = '<div class="mp-empty"><strong>Nadie ha usado un código ajeno.</strong>'
          + 'Los códigos con dueño se han usado solo por su dueño (o no se han usado). Cuando alguien entre con un código que no es suyo, la relación aparece aquí.</div>';
        return;
      }

      var FILA = 62, TOP = 34, W = 900, XO = 26, XV = W - 26;
      var alto = Math.max(owners.length, visitors.length) * FILA + TOP + 30;
      var posO = {}, posV = {};
      owners.forEach(function(o, i){ posO[o.id] = TOP + i * FILA; });
      visitors.forEach(function(v, i){ posV[v.id] = TOP + i * FILA; });

      var out = '<svg viewBox="0 0 ' + W + ' ' + alto + '" role="img" aria-label="Mapa de relaciones de códigos">';

      edges.forEach(function(e){
        var y1 = posO[e.from], y2 = posV[e.to];
        if (y1 == null || y2 == null) return;
        var x1 = XO + 250, x2 = XV - 250, mx = (x1 + x2) / 2;
        out += '<path class="mp-edge" data-from="' + e.from + '" data-to="' + e.to + '"'
          + ' d="M' + x1 + ' ' + y1 + ' C' + mx + ' ' + y1 + ' ' + mx + ' ' + y2 + ' ' + x2 + ' ' + y2 + '"'
          + ' fill="none" stroke="' + (e.confirmed ? '#D97706' : '#C7C3D4') + '" stroke-width="' + Math.min(1 + e.count, 4) + '"'
          + (e.confirmed ? '' : ' stroke-dasharray="5 4"') + '>'
          + '<title>' + esc(e.codes.join(', ')) + ' \u00b7 ' + e.count + ' acceso(s)</title></path>';
      });

      owners.forEach(function(o){
        var y = posO[o.id];
        out += '<g class="mp-node" data-id="' + o.id + '">'
          + '<rect x="' + XO + '" y="' + (y - 19) + '" width="250" height="38" rx="11" fill="#EFE9FC" stroke="#DCCFF7"/>'
          + '<text x="' + (XO + 13) + '" y="' + (y - 3) + '" font-size="12.5" font-weight="800" fill="#3B2A6B">' + esc(cortar(o.label, 26)) + '</text>'
          + '<text x="' + (XO + 13) + '" y="' + (y + 12) + '" font-size="10.5" fill="#6C3CE0">'
          + o.codes.length + ' código(s) \u00b7 ' + o.others + ' de otra persona</text>'
          + '</g>';
      });

      visitors.forEach(function(v){
        var y = posV[v.id];
        out += '<g class="mp-node" data-id="' + v.id + '">'
          + '<rect x="' + (XV - 250) + '" y="' + (y - 19) + '" width="250" height="38" rx="11" fill="#FEF6E7" stroke="#F5DFB4"/>'
          + '<text x="' + (XV - 237) + '" y="' + (y - 3) + '" font-size="12.5" font-weight="800" fill="#7A4A08">' + esc(cortar(v.label, 26)) + '</text>'
          + '<text x="' + (XV - 237) + '" y="' + (y + 12) + '" font-size="10.5" fill="#B4700C">'
          + esc(cortar(v.email || 'sin correo', 30)) + ' \u00b7 ' + v.accesses + ' acceso(s)</text>'
          + '</g>';
      });

      out += '</svg>';
      canvas.innerHTML = out;

      var svg = canvas.querySelector('svg');
      svg.querySelectorAll('.mp-node').forEach(function(n){
        n.addEventListener('mouseenter', function(){
          var id = n.dataset.id;
          svg.querySelectorAll('.mp-edge').forEach(function(pth){
            var toca = pth.dataset.from === id || pth.dataset.to === id;
            pth.classList.toggle('mp-dim', !toca);
          });
        });
        n.addEventListener('mouseleave', function(){
          svg.querySelectorAll('.mp-edge').forEach(function(pth){ pth.classList.remove('mp-dim'); });
        });
      });
    }

    var chips = document.getElementById('mpChips');
    if (chips){
      chips.addEventListener('click', function(e){
        var b = e.target.closest('.mp-chip');
        if (!b) return;
        chips.querySelectorAll('.mp-chip').forEach(function(c){ c.classList.remove('is-on'); });
        b.classList.add('is-on');
        filtro = b.dataset.tag || '';
        dibujar();
      });
    }
    dibujar();
  })();

