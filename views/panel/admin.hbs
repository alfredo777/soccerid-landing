<style>
  .ad-tabs { display:flex; gap:10px; margin: 6px 0 22px; flex-wrap:wrap; }
  .ad-tab { padding:10px 20px; border-radius:13px; background:#fff; border:1px solid var(--pn-border); font-size:13px; font-weight:700; color:var(--pn-ink-2); cursor:pointer; }
  .ad-tab.is-active { background:var(--pn-purple); color:#fff; border-color:var(--pn-purple); }
  .ad-sec { display:none; }
  .ad-sec.is-active { display:block; }

  .ad-flash { padding:13px 18px; border-radius:13px; font-size:13px; font-weight:700; margin-bottom:20px; }
  .ad-flash.ok { background:#EAF7F0; color:#1E8E5A; }
  .ad-flash.error { background:#FDECEC; color:#C0392B; }

  .ad-grid { display:grid; grid-template-columns: 360px 1fr; gap:22px; align-items:start; }
  @media (max-width:1000px){ .ad-grid{ grid-template-columns:1fr; } }

  .ad-form { padding:20px; }
  .ad-form h3 { font-size:15px; font-weight:800; margin-bottom:16px; }
  .ad-f { margin-bottom:14px; }
  .ad-f label { display:block; font-size:12px; font-weight:700; color:var(--pn-ink-2); margin-bottom:6px; }
  .ad-f input, .ad-f select, .ad-f textarea { width:100%; padding:11px 13px; border:1px solid var(--pn-border); border-radius:11px; font-size:13px; font-family:inherit; background:#FAFAFC; outline:none; }
  .ad-f input:focus, .ad-f select:focus, .ad-f textarea:focus { border-color:var(--pn-purple); background:#fff; }
  .ad-f textarea { resize:vertical; min-height:70px; }
  .ad-row2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .ad-check { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:600; color:var(--pn-ink-2); }
  .ad-check input { width:auto; }
  .ad-btn { width:100%; padding:13px; border:none; border-radius:12px; background:var(--pn-purple); color:#fff; font-size:14px; font-weight:800; font-family:inherit; cursor:pointer; margin-top:6px; }
  .ad-btn:hover { background:#5A2FC7; }

  .ad-list { padding:6px 4px; }
  .ad-item { display:flex; align-items:center; gap:14px; padding:14px 16px; border-bottom:1px solid var(--pn-border); }
  .ad-item:last-child { border-bottom:none; }
  .ad-item__av { width:40px; height:40px; border-radius:10px; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px; flex-shrink:0; }
  .ad-item__thumb { width:52px; height:40px; border-radius:9px; object-fit:cover; flex-shrink:0; }
  .ad-item__b { flex:1; min-width:0; }
  .ad-item__b strong { display:block; font-size:14px; font-weight:700; }
  .ad-item__b small { font-size:12px; color:var(--pn-muted); }
  .ad-tagpill { font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.4px; padding:3px 9px; border-radius:20px; }
  .ad-status { font-size:11px; font-weight:800; text-transform:uppercase; padding:4px 10px; border-radius:20px; }
  .ad-status.active { background:#EAF7F0; color:#1E8E5A; }
  .ad-status.invited { background:#FFF4E5; color:#B77A1E; }
  .ad-status.disabled { background:#F1F0F5; color:#8A8F98; }
  .ad-actions { display:flex; gap:8px; flex-shrink:0; flex-wrap:wrap; justify-content:flex-end; }
  .ad-actions button { border:1px solid var(--pn-border); background:#fff; border-radius:9px; padding:7px 10px; font-size:12px; font-weight:700; cursor:pointer; color:var(--pn-ink-2); font-family:inherit; }
  .ad-actions button:hover { background:#F6F5F9; }
  .ad-actions button.primary { color:var(--pn-purple); border-color:#DCCFF7; }
  .ad-actions button.primary:hover { background:var(--pn-purple-soft); }
  .ad-actions button.danger:hover { background:#FDECEC; color:#C0392B; border-color:#F5C6C6; }
  .ad-empty { padding:30px; text-align:center; color:var(--pn-muted); font-size:13px; }
  .ad-hint { font-size:11px; color:var(--pn-muted); margin-top:6px; }
  .ad-note { font-size:13px; color:var(--pn-ink-2); margin:0 0 18px; }

  .ad-catgrid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  @media (max-width:900px){ .ad-catgrid{ grid-template-columns:1fr; } }
  .ad-tier { padding:20px; }
  .ad-tier__head { display:flex; align-items:center; gap:10px; margin-bottom:16px; }
  .ad-tier__dot { width:14px; height:14px; border-radius:5px; flex-shrink:0; }
  .ad-tier__head strong { font-size:16px; font-weight:800; }
  .ad-tier__role { margin-left:auto; font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.5px; color:var(--pn-muted); background:#F1F0F5; padding:4px 10px; border-radius:20px; }
  .ad-tier textarea { min-height:120px; }

  /* Modal */
  .ad-modal { position:fixed; inset:0; background:rgba(20,20,27,.5); z-index:100; display:none; align-items:center; justify-content:center; padding:20px; }
  .ad-modal.is-open { display:flex; }
  .ad-modal__card { background:#fff; border-radius:18px; width:100%; max-width:440px; max-height:90vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.25); }
  .ad-modal__head { display:flex; align-items:center; justify-content:space-between; padding:20px 22px; border-bottom:1px solid var(--pn-border); position:sticky; top:0; background:#fff; }
  .ad-modal__head h3 { font-size:16px; font-weight:800; }
  .ad-modal__close { background:none; border:none; cursor:pointer; padding:4px; }
  .ad-modal__close svg { width:20px; height:20px; stroke:var(--pn-ink-2); }
  .ad-modal__body { padding:20px 22px 22px; }
  .ad-langtabs { display:flex; gap:8px; margin:18px 0 14px; border-bottom:1px solid var(--pn-border); }
  .ad-langtab { padding:8px 14px; background:none; border:none; border-bottom:2px solid transparent; font-family:inherit; font-size:13px; font-weight:800; color:var(--pn-ink-2); cursor:pointer; }
  .ad-langtab.is-active { color:var(--pn-purple); border-bottom-color:var(--pn-purple); }
  .ad-langsec { display:none; }
  .ad-langsec.is-active { display:block; }
  .ad-f label em { font-style:normal; color:var(--pn-muted); font-weight:600; }
  .ad-select-sm { border:1px solid var(--pn-border); border-radius:9px; padding:7px 8px; font-size:12px; font-weight:700; font-family:inherit; color:var(--pn-ink-2); background:#fff; cursor:pointer; }
</style>

{{#if flash}}<div class="ad-flash {{#eq flashType 'error'}}error{{else}}ok{{/eq}}">{{flash}}</div>{{/if}}

<div class="ad-tabs">
  <div class="ad-tab is-active" data-tab="usuarios">Usuarios</div>
  <div class="ad-tab" data-tab="noticias">Noticias</div>
  <div class="ad-tab" data-tab="calendario">Calendario</div>
  <div class="ad-tab" data-tab="cronograma">Cronograma</div>
  <div class="ad-tab" data-tab="categorias">Categorías</div>
  <div class="ad-tab" data-tab="notificaciones">Notificaciones</div>
  <div class="ad-tab" data-tab="ediciones">Ediciones</div>
  <div class="ad-tab" data-tab="codigos">Códigos</div>
  <div class="ad-tab" data-tab="accesos">Accesos</div>
  <div class="ad-tab" data-tab="leads">Prospectos</div>
</div>

<!-- USUARIOS -->
<section class="ad-sec is-active" id="sec-usuarios">
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/invite">
      <h3>Invitar usuario</h3>
      <div class="ad-f"><label>Nombre completo</label><input type="text" name="name" required placeholder="Nombre y apellido"></div>
      <div class="ad-f"><label>Correo electrónico</label><input type="email" name="email" required placeholder="correo@ejemplo.com"></div>
      <div class="ad-f"><label>Tipo</label>
        <select name="role" id="ad-role"><option value="investor">Inversionista</option><option value="sponsor">Patrocinador</option></select>
      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Categoría</label><select name="category" id="ad-cat"></select></div>
        <div class="ad-f"><label>Monto (USD)</label><input type="number" name="amount" id="ad-amount" min="0" step="1000"></div>
      </div>
      <button type="submit" class="ad-btn">Enviar invitación</button>
    </form>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Usuarios ({{users.length}})</h3></div>
      <div class="ad-list">
        {{#each users}}
        <div class="ad-item">
          <div class="ad-item__av" style="background: {{this.color}}">{{this.tierLabel.[0]}}</div>
          <div class="ad-item__b">
            <strong>{{this.name}}</strong>
            <small>{{this.email}} · {{this.roleLabel}} {{this.tierLabel}} · {{this.amount}}</small>
          </div>
          <span class="ad-status {{this.status}}">{{this.status}}</span>
          <div class="ad-actions">
            <button type="button" class="primary" onclick="openUser(this)"
              data-id="{{this.id}}" data-name="{{this.name}}" data-email="{{this.email}}" data-role="{{this.role}}" data-category="{{this.category}}" data-amount="{{this.amountRaw}}" data-status="{{this.status}}">Editar</button>
            <button type="button" onclick="openDocs(this)" data-id="{{this.id}}" data-name="{{this.name}}">Docs{{#if this.docCount}} ({{this.docCount}}){{/if}}</button>
            <form method="POST" action="/panel/admin/user/{{this.id}}/resend"><button type="submit">Reenviar</button></form>
            <form method="POST" action="/panel/admin/user/{{this.id}}/delete" onsubmit="return confirm('¿Eliminar a {{this.name}}?')"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">Aún no hay usuarios. Invita al primero.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- NOTICIAS -->
<section class="ad-sec" id="sec-noticias">
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/news" enctype="multipart/form-data">
      <h3>Publicar noticia</h3>
      <div class="ad-f"><label>Categoría</label><select name="tag"><option>Anuncio</option><option>Actualización</option><option>Prensa</option></select></div>
      <div class="ad-f"><label>Título</label><input type="text" name="title" required></div>
      <div class="ad-f"><label>Extracto</label><textarea name="excerpt"></textarea></div>
      <div class="ad-f"><label>Imagen</label><input type="file" name="imageFile" accept="image/*">
        <div class="ad-hint">{{#if s3}}Se subirá a Amazon S3.{{else}}Se guardará localmente (configura S3 para producción).{{/if}} O pega una URL abajo.</div>
      </div>
      <div class="ad-f"><label>URL de imagen (opcional)</label><input type="text" name="image" placeholder="/assets/images/gallery/cup2025/6.jpg"></div>
      <div class="ad-row2">
        <div class="ad-f"><label>Fecha (texto)</label><input type="text" name="date_label" placeholder="12 Jul 2026"></div>
        <div class="ad-f"><label>Tamaño</label><select name="size"><option value="short">Normal</option><option value="tall">Grande</option></select></div>
      </div>
      <label class="ad-check"><input type="checkbox" name="featured" value="1"> Destacada</label>
      <button type="submit" class="ad-btn" style="margin-top:14px;">Publicar</button>
    </form>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Noticias ({{news.length}})</h3></div>
      <div class="ad-list">
        {{#each news}}
        <div class="ad-item">
          <img class="ad-item__thumb" src="{{this.image}}" alt="">
          <div class="ad-item__b">
            <span class="ad-tagpill" style="color:{{this.tag_color}}; background:{{this.tag_color}}1A;">{{this.tag}}</span>
            <strong style="margin-top:4px;">{{this.title}}</strong>
            <small>{{this.date_label}}{{#if this.featured}} · Destacada{{/if}}</small>
          </div>
          <div class="ad-actions">
            <button type="button" class="primary" onclick="openNews(this)"
              data-id="{{this.id}}" data-tag="{{this.tag}}" data-title="{{this.title}}" data-excerpt="{{this.excerpt}}" data-image="{{this.image}}" data-date="{{this.date_label}}" data-size="{{this.size}}" data-featured="{{#if this.featured}}1{{/if}}">Editar</button>
            <form method="POST" action="/panel/admin/news/{{this.id}}/notify" onsubmit="return confirm('¿Compartir esta noticia como notificación (email) a todos los usuarios?')"><button type="submit">Compartir</button></form>
            <form method="POST" action="/panel/admin/news/{{this.id}}/delete" onsubmit="return confirm('¿Eliminar noticia?')"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">No hay noticias.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- CALENDARIO -->
<section class="ad-sec" id="sec-calendario">
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/event">
      <h3>Agregar evento</h3>
      <div class="ad-f"><label>Título</label><input type="text" name="title" required></div>
      <div class="ad-row2">
        <div class="ad-f"><label>Día</label><input type="number" name="day" min="1" max="31" required></div>
        <div class="ad-f"><label>Tipo</label><select name="type"><option>Evento</option><option>Actualización</option><option>Patrocinio</option><option>Prensa</option><option>Partido</option></select></div>
      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Mes</label><input type="number" name="month" min="1" max="12" value="3"></div>
        <div class="ad-f"><label>Año</label><input type="number" name="year" value="2027"></div>
      </div>
      <button type="submit" class="ad-btn">Agregar al calendario</button>
    </form>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Eventos ({{events.length}})</h3></div>
      <div class="ad-list">
        {{#each events}}
        <div class="ad-item">
          <div class="ad-item__av" style="background: {{this.color}}">{{this.day}}</div>
          <div class="ad-item__b">
            <strong>{{this.title}}</strong>
            <small>{{this.day}}/{{this.month}}/{{this.year}} · {{this.type}}</small>
          </div>
          <div class="ad-actions">
            <button type="button" class="primary" onclick="openEvent(this)"
              data-id="{{this.id}}" data-title="{{this.title}}" data-day="{{this.day}}" data-month="{{this.month}}" data-year="{{this.year}}" data-type="{{this.type}}">Editar</button>
            <form method="POST" action="/panel/admin/event/{{this.id}}/delete" onsubmit="return confirm('¿Eliminar evento?')"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">No hay eventos.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- CRONOGRAMA -->
<section class="ad-sec" id="sec-cronograma">
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/milestone">
      <h3>Agregar hito</h3>
      <div class="ad-f"><label>Título</label><input type="text" name="title" required></div>
      <div class="ad-f"><label>Fecha (texto)</label><input type="text" name="date_label" placeholder="Sep 2026"></div>
      <label class="ad-check"><input type="checkbox" name="done" value="1"> Completado</label>
      <label class="ad-check" style="margin-top:8px;"><input type="checkbox" name="highlight" value="1"> Destacar (partido)</label>
      <button type="submit" class="ad-btn" style="margin-top:14px;">Agregar hito</button>
    </form>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Cronograma ({{milestones.length}})</h3></div>
      <div class="ad-list">
        {{#each milestones}}
        <div class="ad-item">
          <div class="ad-item__av" style="background: {{#if this.highlight}}#6C3CE0{{else}}{{#if this.done}}#1E8E5A{{else}}#8A8F98{{/if}}{{/if}}">{{#if this.done}}✓{{else}}○{{/if}}</div>
          <div class="ad-item__b">
            <strong>{{this.title}}</strong>
            <small>{{this.date_label}}{{#if this.done}} · Completado{{/if}}{{#if this.highlight}} · Destacado{{/if}}</small>
          </div>
          <div class="ad-actions">
            <button type="button" class="primary" onclick="openMile(this)"
              data-id="{{this.id}}" data-title="{{this.title}}" data-date="{{this.date_label}}" data-done="{{#if this.done}}1{{/if}}" data-highlight="{{#if this.highlight}}1{{/if}}">Editar</button>
            <form method="POST" action="/panel/admin/milestone/{{this.id}}/delete" onsubmit="return confirm('¿Eliminar hito?')"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">No hay hitos.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- NOTIFICACIONES -->
<section class="ad-sec" id="sec-notificaciones">
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/notify">
      <h3>Enviar notificación</h3>
      <div class="ad-f"><label>Título</label><input type="text" name="title" required placeholder="Ej. Nueva fecha confirmada"></div>
      <div class="ad-f"><label>Mensaje</label><textarea name="body" placeholder="Escribe el comunicado..."></textarea></div>
      <div class="ad-f"><label>Audiencia</label>
        <select name="audience"><option value="all">Todos</option><option value="investor">Solo inversionistas</option><option value="sponsor">Solo patrocinadores</option></select>
      </div>
      <label class="ad-check"><input type="checkbox" name="sendEmail" value="1" checked> Enviar también por email</label>
      <button type="submit" class="ad-btn" style="margin-top:14px;">Enviar notificación</button>
    </form>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Enviadas ({{notifications.length}})</h3></div>
      <div class="ad-list">
        {{#each notifications}}
        <div class="ad-item">
          <div class="ad-item__av" style="background:#6C3CE0">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          </div>
          <div class="ad-item__b">
            <strong>{{this.title}}</strong>
            <small>{{this.date}} · {{#eq this.audience 'all'}}Todos{{/eq}}{{#eq this.audience 'investor'}}Inversionistas{{/eq}}{{#eq this.audience 'sponsor'}}Patrocinadores{{/eq}}</small>
          </div>
          <div class="ad-actions">
            <form method="POST" action="/panel/admin/notification/{{this.id}}/delete" onsubmit="return confirm('¿Eliminar notificación?')"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">No has enviado notificaciones.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- CATEGORÍAS -->
<section class="ad-sec" id="sec-categorias">
  <p class="ad-note">Edita el nombre, color, monto, cupo y beneficios de cada categoría. Los cambios se reflejan en el panel de inversionistas y patrocinadores.</p>
  <div class="ad-catgrid">
    {{#each tiers}}
    <form class="pn-card ad-tier" method="POST" action="/panel/admin/tier/{{this.id}}/update">
      <div class="ad-tier__head">
        <span class="ad-tier__dot" style="background:{{this.color}}"></span>
        <strong>{{this.label}}</strong>
        <span class="ad-tier__role">{{this.roleLabel}}</span>
      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Nombre</label><input type="text" name="label" value="{{this.label}}" required></div>
        <div class="ad-f"><label>Color</label><input type="color" name="color" value="{{this.color}}" style="height:42px; padding:4px;"></div>
      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Monto (USD)</label><input type="number" name="amount" value="{{this.amount}}" step="1000" min="0"></div>
        <div class="ad-f"><label>Cupo</label><input type="number" name="count" value="{{this.count}}" min="0"></div>
      </div>
      <div class="ad-f"><label>Beneficios (uno por línea)</label><textarea name="benefits" rows="6">{{this.benefitsText}}</textarea></div>
      <button type="submit" class="ad-btn">Guardar categoría</button>
    </form>
    {{/each}}
  </div>
</section>

<!-- EDICIONES -->
<section class="ad-sec" id="sec-ediciones">
  <p class="ad-note">Gestiona las ediciones de la SOCCER iD CUP que aparecen en la página pública (timeline y páginas de detalle). Contenido en español e inglés. Estado <strong>Pasada</strong> genera su página; <strong>Próxima</strong>/<strong>Pausa</strong> solo aparecen en el timeline.</p>
  <div class="pn-card">
    <div class="pn-card__head">
      <h3>Ediciones ({{editions.length}})</h3>
      <button type="button" class="ad-btn" style="width:auto; padding:10px 16px; margin:0;" onclick="openEdition()">+ Nueva edición</button>
    </div>
    <div class="ad-list">
      {{#each editions}}
      <div class="ad-item">
        <div class="ad-item__av" style="background: {{#eq this.status 'past'}}#6C3CE0{{else}}{{#eq this.status 'pause'}}#eab308{{else}}#A78BE6{{/eq}}{{/eq}}">{{this.year}}</div>
        <div class="ad-item__b">
          <strong>{{#if this.match}}{{this.match}}{{else}}—{{/if}}</strong>
          <small>{{this.city}}{{#if this.city}} · {{/if}}{{this.statusLabel}}{{#if this.imageCount}} · {{this.imageCount}} fotos{{/if}}</small>
        </div>
        <div class="ad-actions">
          {{#eq this.status 'past'}}<a href="/es/socceridcup/{{this.year}}" target="_blank" rel="noopener" style="border:1px solid var(--pn-border);background:#fff;border-radius:9px;padding:7px 10px;font-size:12px;font-weight:700;color:var(--pn-ink-2);text-decoration:none;">Ver</a>{{/eq}}
          <button type="button" class="primary" onclick="openEdition('{{this.id}}')">Editar</button>
          <form method="POST" action="/panel/admin/edition/{{this.id}}/delete" onsubmit="return confirm('¿Eliminar la edición {{this.year}}?')"><button type="submit" class="danger">Eliminar</button></form>
        </div>
      </div>
      {{else}}
      <div class="ad-empty">No hay ediciones. Crea la primera.</div>
      {{/each}}
    </div>
  </div>
</section>

<!-- CÓDIGOS -->
<section class="ad-sec" id="sec-codigos">
  <p class="ad-note">Códigos de acceso a la <strong>propuesta 2027</strong> (<a href="/es/socceridcup2027" target="_blank" rel="noopener" style="color:var(--pn-purple);font-weight:700;">ver página</a>). Al entrar desde un dispositivo nuevo se pide nombre y correo (quedan en <strong>Prospectos</strong>) y se registra en <strong>Accesos</strong>.</p>
  <div class="ad-grid">
    <div>
      <form class="pn-card ad-form" method="POST" action="/panel/admin/codes/generate" style="margin-bottom:18px;">
        <h3>Generar códigos</h3>
        <div class="ad-f"><label>Cantidad</label><input type="number" name="count" value="10" min="1" max="100"></div>
        <button type="submit" class="ad-btn">Generar (por usar)</button>
      </form>
      <form class="pn-card ad-form" method="POST" action="/panel/admin/code">
        <h3>Agregar código manual</h3>
        <div class="ad-f"><label>Código</label><input type="text" name="code" placeholder="1234567" required></div>
        <div class="ad-f"><label>Estado</label><select name="status"><option value="unused">Por usar</option><option value="used">Usado</option></select></div>
        <button type="submit" class="ad-btn">Agregar</button>
      </form>
    </div>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Códigos ({{codes.length}})</h3><span class="ad-hint">{{codesUsed}} usados · {{codesUnused}} por usar</span></div>
      <div class="ad-list">
        {{#each codes}}
        <div class="ad-item">
          <div class="ad-item__av" style="background: {{#eq this.status 'used'}}#8A8F98{{else}}#1E8E5A{{/eq}}; font-size:13px;">{{#if this.isTest}}★{{else}}#{{/if}}</div>
          <div class="ad-item__b">
            <strong style="letter-spacing:2px;">{{this.code}}</strong>
            <small>{{#if this.isTest}}Código de prueba · {{/if}}{{this.statusLabel}}</small>
          </div>
          <div class="ad-actions">
            <form method="POST" action="/panel/admin/code/{{this.id}}/status">
              <select name="status" class="ad-select-sm" onchange="this.form.submit()">
                <option value="unused" {{#eq this.status 'unused'}}selected{{/eq}}>Por usar</option>
                <option value="used" {{#eq this.status 'used'}}selected{{/eq}}>Usado</option>
              </select>
            </form>
            <form method="POST" action="/panel/admin/code/{{this.id}}/delete" onsubmit="return confirm('¿Eliminar el código {{this.code}}?')"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- ACCESOS -->
<section class="ad-sec" id="sec-accesos">
  <p class="ad-note">Registro de accesos a la propuesta 2027, basado en dispositivo. Cada apertura queda guardada con fecha, IP y si es un dispositivo nuevo.</p>
  <div class="pn-card">
    <div class="pn-card__head"><h3>Accesos ({{accessLog.length}})</h3><span class="ad-hint">Últimos 200</span></div>
    <div class="ad-list">
      {{#each accessLog}}
      <div class="ad-item">
        <div class="ad-item__av" style="background: {{#if this.newDevice}}#6C3CE0{{else}}#8A8F98{{/if}}; font-size:10px;">{{#if this.newDevice}}NEW{{else}}···{{/if}}</div>
        <div class="ad-item__b">
          <strong>{{this.name}} · <span style="font-weight:600;color:var(--pn-ink-2);">{{this.email}}</span></strong>
          <small>Código {{this.code}} · {{this.when}} · disp. {{this.device}} · {{this.ip}}{{#if this.newDevice}} · dispositivo nuevo{{/if}}</small>
        </div>
      </div>
      {{else}}
      <div class="ad-empty">Aún no hay accesos registrados.</div>
      {{/each}}
    </div>
  </div>
</section>

<!-- PROSPECTOS -->
<section class="ad-sec" id="sec-leads">
  <p class="ad-note">Nombres y correos capturados en la propuesta 2027. Cambia su estado con el select, o envíales correo individual o masivo.</p>
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/leads/email" onsubmit="return confirm('¿Enviar este correo a los prospectos seleccionados?')">
      <h3>Correo masivo</h3>
      <div class="ad-f"><label>Audiencia</label><select name="audience"><option value="all">Todos</option><option value="nuevo">Nuevos</option><option value="contactado">Contactados</option><option value="cliente">Clientes</option><option value="descartado">Descartados</option></select></div>
      <div class="ad-f"><label>Asunto</label><input type="text" name="subject" required></div>
      <div class="ad-f"><label>Mensaje</label><textarea name="body" rows="5" required></textarea></div>
      <button type="submit" class="ad-btn">Enviar correo masivo</button>
    </form>
    <div class="pn-card">
      <div class="pn-card__head"><h3>Prospectos ({{leads.length}})</h3></div>
      <div class="ad-list">
        {{#each leads}}
        <div class="ad-item">
          <div class="ad-item__av" style="background:#6C3CE0;">{{this.name.[0]}}</div>
          <div class="ad-item__b">
            <strong>{{this.name}}</strong>
            <small>{{this.email}} · {{this.accesses}} accesos{{#if this.deviceCount}} · {{this.deviceCount}} disp.{{/if}}{{#if this.lastIp}} · IP {{this.lastIp}}{{/if}}{{#if this.lastWhen}} · último {{this.lastWhen}}{{/if}}</small>
          </div>
          <div class="ad-actions">
            <form method="POST" action="/panel/admin/lead/{{this.id}}/status">
              <select name="status" class="ad-select-sm" onchange="this.form.submit()">
                <option value="nuevo" {{#eq this.status 'nuevo'}}selected{{/eq}}>Nuevo</option>
                <option value="contactado" {{#eq this.status 'contactado'}}selected{{/eq}}>Contactado</option>
                <option value="cliente" {{#eq this.status 'cliente'}}selected{{/eq}}>Cliente</option>
                <option value="descartado" {{#eq this.status 'descartado'}}selected{{/eq}}>Descartado</option>
              </select>
            </form>
            <button type="button" onclick="openLeadHistory(this)" data-id="{{this.id}}" data-name="{{this.name}}" data-email="{{this.email}}">Historial{{#if this.accesses}} ({{this.accesses}}){{/if}}</button>
            <button type="button" class="primary" onclick="openLeadEmail(this)" data-id="{{this.id}}" data-name="{{this.name}}" data-email="{{this.email}}">Correo</button>
            <form method="POST" action="/panel/admin/lead/{{this.id}}/delete" onsubmit="return confirm('¿Eliminar a {{this.name}}?')"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">Aún no hay prospectos. Se registran al entrar a la propuesta desde un dispositivo nuevo.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

