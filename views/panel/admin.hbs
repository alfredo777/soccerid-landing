  // El tipo "Otro" abre un campo para escribirlo; con cualquier otro se esconde.
  function acTipo(pref){
    var sel = document.getElementById(pref + '-type');
    var wrap = document.getElementById(pref + '-custom-wrap');
    if (!sel || !wrap) return;
    var otro = sel.value === 'Otro';
    wrap.style.display = otro ? '' : 'none';
    var inp = document.getElementById(pref + '-custom');
    if (inp) inp.required = otro;
  }

  function openEvent(btn){
    var d = btn.dataset;
    document.getElementById('form-event').action = '/panel/admin/event/'+d.id+'/update';
    document.getElementById('ee-title').value = d.title;
    document.getElementById('ee-day').value = d.day;
    document.getElementById('ee-month').value = d.month;
    document.getElementById('ee-year').value = d.year;
    document.getElementById('ee-type').value = d.type;
    document.getElementById('ee-custom').value = d.custom || '';
    document.getElementById('ee-time').value = d.time || '';
    document.getElementById('ee-note').value = d.note || '';
    document.getElementById('ee-event').value = d.event || '';
    acTipo('ee');
    openModal('modal-event');
  }
  function openDocs(btn){
    var d = btn.dataset;
    document.getElementById('ed-user').textContent = d.name;
    document.getElementById('form-doc').action = '/panel/admin/user/'+d.id+'/document';
    var docs = USER_DOCS[d.id] || [];
    var list = document.getElementById('ed-list');
    if (!docs.length) {
      list.innerHTML = '<p style="font-size:13px;color:var(--pn-muted);padding:6px 0;">Sin documentos. Sube el primero abajo.</p>';
    } else {
      list.innerHTML = docs.map(function(doc){
        return '<div style="display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--pn-border);">'
          + '<div style="flex:1;min-width:0;"><strong style="display:block;font-size:14px;">'+esc(doc.name)+'</strong><small style="color:var(--pn-muted);font-size:12px;">'+esc(doc.meta||'')+'</small></div>'
          + '<a href="'+doc.url+'" target="_blank" rel="noopener" style="font-size:12px;font-weight:700;color:var(--pn-purple);">Ver</a>'
          + '<form method="POST" action="/panel/admin/document/'+doc.id+'/delete" data-confirm="¿Eliminar documento?"><button type="submit" style="border:1px solid var(--pn-border);background:#fff;border-radius:9px;padding:6px 10px;font-size:12px;font-weight:700;color:var(--pn-ink-2);cursor:pointer;">Eliminar</button></form>'
          + '</div>';
      }).join('');
    }
    openModal('modal-docs');
  }
  function esc(s){ var d=document.createElement('div'); d.textContent=s==null?'':s; return d.innerHTML; }

  function openMile(btn){
    var d = btn.dataset;
    document.getElementById('form-mile').action = '/panel/admin/milestone/'+d.id+'/update';
    document.getElementById('em-title').value = d.title;
    document.getElementById('em-date').value = d.date;
    document.getElementById('em-status').value = (d.status || 'pendiente');
    document.getElementById('em-owner').value = (d.owner || '');
    document.getElementById('em-highlight').checked = (d.highlight === '1');
    document.getElementById('em-desc').value = (d.desc || '');
    document.getElementById('em-start').value = (d.start || '');
    document.getElementById('em-end').value = (d.end || '');
    document.getElementById('em-event').value = (d.event || '');
    openModal('modal-mile');
  }

  function openCapital(btn){
    var d = btn.dataset;
    document.getElementById('form-capital').action = '/panel/admin/capital/'+d.id+'/update';
    document.getElementById('ec-label').value = d.label;
    document.getElementById('ec-budget').value = d.budget;
    document.getElementById('ec-spent').value = d.spent;
    document.getElementById('ec-note').value = d.note || '';
    document.getElementById('ec-source').value = d.source || '';
    document.getElementById('ec-budget').dispatchEvent(new Event('input'));
    document.getElementById('ec-spent').dispatchEvent(new Event('input'));
    openModal('modal-capital');
  }
  function openRisk(btn){
    var d = btn.dataset;
    document.getElementById('form-risk').action = '/panel/admin/risk/'+d.id+'/update';
    document.getElementById('er-title').value = d.title;
    document.getElementById('er-level').value = d.level;
    document.getElementById('er-status').value = d.status;
    document.getElementById('er-mitigation').value = d.mitigation || '';
    openModal('modal-risk');
  }

  // Tabs
  var tabs = document.querySelectorAll('.ad-tab');
  // La barra de ruta de móvil toma el nombre de la pestaña, para no duplicar la lista
  function setCrumb(name){
    var out = document.getElementById('adCrumbSec');
    var tab = document.querySelector('.ad-tab[data-tab="' + name + '"]');
    if (out && tab) out.textContent = (tab.getAttribute('data-label') || tab.textContent).trim();
  }
  function activate(name){
    setCrumb(name);
    var title = document.getElementById('adTabTitle');
    var tb = document.querySelector('.ad-tab[data-tab="' + name + '"]');
    if (title && tb) title.textContent = tb.getAttribute('data-label') || '';
    tabs.forEach(function(t){ t.classList.toggle('is-active', t.dataset.tab === name); });
    document.querySelectorAll('.ad-sec').forEach(function(s){ s.classList.toggle('is-active', s.id === 'sec-'+name); });
    // Sincroniza el estado activo del menú lateral del admin
    document.querySelectorAll('.pn-nav a[data-tab]').forEach(function(a){ a.classList.toggle('is-active', a.getAttribute('data-tab') === name); });
    // Limpia cualquier filtro de búsqueda al cambiar de sección
    var box = document.getElementById('pnSearch'); if (box && box.value){ box.value=''; box.dispatchEvent(new Event('input')); }
  }
  tabs.forEach(function(t){ t.addEventListener('click', function(){ activate(t.dataset.tab); history.replaceState(null,'','/panel/admin#'+t.dataset.tab); }); });
  // Permite que el sidebar (layout) cambie de pestaña
  window.__adminActivate = activate;
  window.addEventListener('hashchange', function(){ var h = location.hash.replace('#',''); if (document.getElementById('sec-'+h)) activate(h); });
  var initial = (location.hash ? location.hash.replace('#','') : 'usuarios');
  if (document.getElementById('sec-'+initial)) activate(initial);

  // ── Buscador global con desplegable agrupado por tipo/perfil ──
  (function(){
    var box = document.getElementById('pnSearch');
    var panel = document.getElementById('pnSearchResults');
    if (!box || !panel) return;
    box.setAttribute('placeholder', 'Buscar usuarios, noticias, eventos…');

    var SECTION = {
      estadisticas: { label: 'Estadísticas', color: '#0E9F6E' },
      noticias: { label: 'Noticias', color: '#6C3CE0' },
      calendario: { label: 'Eventos', color: '#A78BE6' },
      cronograma: { label: 'Cronograma', color: '#1E8E5A' },
      categorias: { label: 'Categorías', color: '#14141B' },
      notificaciones: { label: 'Notificaciones', color: '#6C3CE0' },
      eventos: { label: 'Ediciones', color: '#6C3CE0' },
      codigos: { label: 'Códigos', color: '#1E8E5A' },
      accesos: { label: 'Accesos', color: '#8A8F98' },
      mapa: { label: 'Mapa de códigos', color: '#D97706' },
      leads: { label: 'Prospectos', color: '#6C3CE0' }
    };
    var ORDER = ['Inversionistas','Patrocinadores','Prospectos','Estadísticas','Noticias','Ediciones','Cronograma','Categorías','Notificaciones','Códigos','Accesos','Mapa de códigos'];

    function buildIndex(){
      var idx = [];
      document.querySelectorAll('.ad-sec').forEach(function(sec){
        var secId = sec.id.replace('sec-','');
        sec.querySelectorAll('.ad-item, .ad-tier').forEach(function(el){
          var strong = el.querySelector('strong');
          var title = (strong ? strong.textContent : el.textContent).trim();
          var group, color = '#6C3CE0', sub = '';
          if (secId === 'usuarios'){
            var eb = el.querySelector('button[data-role]');
            var role = eb ? eb.getAttribute('data-role') : 'investor';
            group = role === 'sponsor' ? 'Patrocinadores' : 'Inversionistas';
            var av = el.querySelector('.ad-item__av'); if (av && av.style.background) color = av.style.background;
            var small = el.querySelector('small'); if (small) sub = small.textContent.trim();
          } else if (SECTION[secId]) {
            group = SECTION[secId].label; color = SECTION[secId].color;
            var sm = el.querySelector('small, .ad-tier__role'); if (sm) sub = sm.textContent.trim();
          } else { return; }
          idx.push({ text: el.textContent.toLowerCase(), title: title, sub: sub, group: group, color: color, secId: secId, el: el });
        });
      });
      return idx;
    }

    var INDEX = [];
    function esc(s){ var d=document.createElement('div'); d.textContent=(s==null?'':s); return d.innerHTML; }

    function render(q){
      q = (q||'').trim().toLowerCase();
      if (!q){ panel.classList.remove('is-open'); panel.innerHTML=''; return; }
      var matches = INDEX.filter(function(it){ return it.text.indexOf(q) !== -1; });
      if (!matches.length){ panel.innerHTML = '<div class="pn-search__empty">Sin resultados para “'+esc(q)+'”</div>'; panel.classList.add('is-open'); return; }
      var byGroup = {};
      matches.forEach(function(m){ (byGroup[m.group]=byGroup[m.group]||[]).push(m); });
      var html = '';
      ORDER.forEach(function(g){
        var arr = byGroup[g]; if (!arr || !arr.length) return;
        html += '<div class="pn-search__group">'+g+' ('+arr.length+')</div>';
        arr.slice(0,8).forEach(function(m){
          html += '<button type="button" class="pn-search__opt" data-i="'+INDEX.indexOf(m)+'">'
            + '<span class="pn-search__dot" style="background:'+(m.color||'#6C3CE0')+'"></span>'
            + '<span class="pn-search__txt"><strong>'+esc(m.title)+'</strong>'+(m.sub?'<small>'+esc(m.sub)+'</small>':'')+'</span>'
            + '</button>';
        });
        if (arr.length > 8) html += '<div class="pn-search__group" style="opacity:.7;">+'+(arr.length-8)+' más…</div>';
      });
      panel.innerHTML = html;
      panel.classList.add('is-open');
    }

    function jump(m){
      if (!m) return;
      var sec = m.secId, el = m.el;
      // Cambia de sección sin que se limpie el término hasta después de saltar
      var crumb = document.getElementById('adCrumbSec');
      var crumbTab = document.querySelector('.ad-tab[data-tab="' + sec + '"]');
      if (crumb && crumbTab) crumb.textContent = (crumbTab.getAttribute('data-label') || crumbTab.textContent).trim();
      document.querySelectorAll('.ad-tab').forEach(function(t){ t.classList.toggle('is-active', t.dataset.tab === sec); });
      document.querySelectorAll('.ad-sec').forEach(function(s){ s.classList.toggle('is-active', s.id === 'sec-'+sec); });
      document.querySelectorAll('.pn-nav a[data-tab]').forEach(function(a){ a.classList.toggle('is-active', a.getAttribute('data-tab') === sec); });
      panel.classList.remove('is-open');
      setTimeout(function(){
        try { el.scrollIntoView({ behavior:'smooth', block:'center' }); } catch(_){}
        el.classList.remove('ad-jump'); void el.offsetWidth; el.classList.add('ad-jump');
      }, 60);
    }

    window.__pnSearch = function(v){ INDEX = buildIndex(); render(v); };

    panel.addEventListener('click', function(e){
      var opt = e.target.closest('.pn-search__opt'); if (!opt) return;
      jump(INDEX[parseInt(opt.getAttribute('data-i'),10)]);
    });
    document.addEventListener('click', function(e){ if (!e.target.closest('.pn-search')) panel.classList.remove('is-open'); });
    box.addEventListener('keydown', function(e){
      if (e.key === 'Escape') panel.classList.remove('is-open');
      if (e.key === 'Enter'){ var first = panel.querySelector('.pn-search__opt'); if (first){ e.preventDefault(); first.click(); } }
    });
    box.addEventListener('focus', function(){ if (box.value.trim()){ INDEX = buildIndex(); render(box.value); } });
  })();

  // ── Confirmación inline (reemplaza confirm() nativo): "¿Eliminar? Sí / No" ──
  (function(){
    document.addEventListener('submit', function(e){
      var form = e.target;
      if (!form || !form.getAttribute || !form.getAttribute('data-confirm')) return;
      if (form.__ok) return;               // ya confirmado → deja pasar
      e.preventDefault();
      if (form.__confirming) return;       // ya se está mostrando el confirm
      form.__confirming = true;
      var btn = form.querySelector('[type="submit"], button:not([type])');
      var msg = form.getAttribute('data-confirm') || '¿Confirmar?';
      var wrap = document.createElement('span');
      wrap.className = 'ad-confirm';
      var q = document.createElement('span'); q.className = 'ad-confirm__q'; q.textContent = msg;
      var yes = document.createElement('button'); yes.type = 'button'; yes.className = 'yes'; yes.textContent = 'Sí, eliminar';
      var no = document.createElement('button'); no.type = 'button'; no.className = 'no'; no.textContent = 'Cancelar';
      if (/enviar|compartir/i.test(msg)) yes.textContent = 'Sí, continuar';
      wrap.appendChild(q); wrap.appendChild(yes); wrap.appendChild(no);
      if (btn) btn.style.display = 'none';
      form.appendChild(wrap);
      function cleanup(){ wrap.remove(); if (btn) btn.style.display = ''; form.__confirming = false; }
      no.addEventListener('click', cleanup);
      yes.addEventListener('click', function(){
        form.__ok = true; cleanup();
        if (form.requestSubmit) form.requestSubmit(btn); else form.submit();
      });
    }, true);
  })();

  // ── Toast: mostrar, auto-ocultar y limpiar el ?msg de la URL ──
  (function(){
    var t = document.getElementById('adToast');
    if (!t) return;
    requestAnimationFrame(function(){ t.classList.add('is-show'); });
    var hide = function(){ t.classList.remove('is-show'); setTimeout(function(){ t.remove(); }, 300); };
    var timer = setTimeout(hide, 3800);
    t.addEventListener('click', function(){ clearTimeout(timer); hide(); });
    // Quita ?type/?msg de la URL para que no reaparezca al refrescar
    if (history.replaceState){
      var u = new URL(window.location.href);
      u.searchParams.delete('msg'); u.searchParams.delete('type');
      history.replaceState(null, '', u.pathname + u.search + u.hash);
    }
  })();

  // ── Campos de dinero: prefijo $, formato en vivo y validación ejercido ≤ presupuestado ──
  (function(){
    function fmt(n){ return isNaN(n) ? '' : 'USD $' + Number(n).toLocaleString('en-US'); }
    function updateOne(inp){
      var wrap = inp.closest('.ad-money');
      var cap = wrap && wrap.nextElementSibling;
      if (cap && cap.classList.contains('ad-money__fmt')){
        var v = parseFloat(inp.value);
        cap.textContent = inp.value === '' ? '' : fmt(v);
      }
    }
    // Validación: en un mismo formulario, spent (ejercido) no debe superar budget (presupuestado)
    function validatePair(form){
      var budget = form.querySelector('[name=budget]'), spent = form.querySelector('[name=spent]');
      if (!budget || !spent) return;
      var cap = spent.closest('.ad-f') && spent.closest('.ad-f').querySelector('.ad-money__fmt');
      var b = parseFloat(budget.value), s = parseFloat(spent.value);
      if (cap){
        if (!isNaN(b) && !isNaN(s) && s > b){ cap.classList.add('ad-money__warn'); cap.textContent = 'Ejercido supera lo presupuestado'; }
        else { cap.classList.remove('ad-money__warn'); cap.textContent = spent.value === '' ? '' : fmt(s); }
      }
    }
    document.querySelectorAll('.ad-money__in').forEach(function(inp){
      updateOne(inp);
      inp.addEventListener('input', function(){ updateOne(inp); var f = inp.closest('form'); if (f) validatePair(f); });
    });
    document.querySelectorAll('form').forEach(function(f){ if (f.querySelector('[name=budget]') && f.querySelector('[name=spent]')) validatePair(f); });
  })();
</script>
