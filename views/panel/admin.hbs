<script>
  var INVESTOR_TIERS = {{{json investorTiers}}};
  var SPONSOR_TIERS = {{{json sponsorTiers}}};
  var USER_DOCS = {{{json docsByUser}}};
  var EDITIONS_FORMS = {{{json editionsForms}}};
  var EDITION_FIELDS = ['year','status','sort','match','date','city','venue','banner','att_value','att_label_es','att_label_en','title_es','title_en','description_es','description_en','stats_es','stats_en','media_es','media_en','sponsors','videos','images'];

  function setEditionLang(l){
    document.querySelectorAll('.ad-langtab').forEach(function(b){ b.classList.toggle('is-active', b.dataset.lang === l); });
    document.querySelectorAll('.ad-langsec').forEach(function(s){ s.classList.toggle('is-active', s.dataset.langsec === l); });
  }
  function openEdition(id){
    var data = id ? EDITIONS_FORMS.filter(function(e){ return String(e.id) === String(id); })[0] : null;
    document.getElementById('ed-modal-title').textContent = data ? ('Editar edición ' + data.year) : 'Nueva edición';
    document.getElementById('form-edition').action = data ? ('/panel/admin/edition/' + data.id + '/update') : '/panel/admin/edition';
    EDITION_FIELDS.forEach(function(f){
      var el = document.getElementById('ed-' + f);
      if (!el) return;
      el.value = data ? (data[f] == null ? '' : data[f]) : (f === 'status' ? 'past' : '');
    });
    setEditionLang('es');
    openModal('modal-edition');
  }
  document.querySelectorAll('.ad-langtab').forEach(function(b){ b.addEventListener('click', function(){ setEditionLang(b.dataset.lang); }); });

  function openLeadEmail(btn){
    var d = btn.dataset;
    document.getElementById('el-name').textContent = d.name;
    document.getElementById('el-email').textContent = d.email;
    document.getElementById('form-lead-email').action = '/panel/admin/lead/' + d.id + '/email';
    openModal('modal-lead');
  }

  var LEADS_HISTORY = {{{json leadsHistory}}};
  function openLeadHistory(btn){
    var d = btn.dataset;
    document.getElementById('elh-name').textContent = d.name;
    document.getElementById('elh-email').textContent = d.email;
    var rows = (LEADS_HISTORY[d.id] || []);
    var list = document.getElementById('elh-list');
    if (!rows.length){
      list.innerHTML = '<p style="font-size:13px;color:var(--pn-muted);padding:8px 0;">Sin accesos registrados.</p>';
    } else {
      list.innerHTML = rows.map(function(a){
        return '<div style="padding:12px 0;border-bottom:1px solid var(--pn-border);">'
          + '<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">'
          + '<strong style="font-size:13px;">' + esc(a.when) + '</strong>'
          + (a.newDevice ? '<span style="font-size:10px;font-weight:800;background:var(--pn-purple);color:#fff;padding:2px 7px;border-radius:20px;">DISPOSITIVO NUEVO</span>' : '')
          + '</div>'
          + '<small style="color:var(--pn-muted);font-size:12px;display:block;">Código ' + esc(a.code) + ' · IP ' + esc(a.ip) + ' · disp. ' + esc(a.device) + '</small>'
          + (a.ua ? '<small style="color:var(--pn-muted);font-size:11px;display:block;margin-top:2px;word-break:break-word;">' + esc(a.ua) + '</small>' : '')
          + '</div>';
      }).join('');
    }
    openModal('modal-lead-history');
  }

  function fillCatSelect(sel, role, selected){
    var tiers = role === 'sponsor' ? SPONSOR_TIERS : INVESTOR_TIERS;
    sel.innerHTML = tiers.map(function(t){ return '<option value="'+t.key+'" data-amt="'+t.amount+'"'+(t.key===selected?' selected':'')+'>'+t.label+'</option>'; }).join('');
  }

  // Invite form
  var roleSel = document.getElementById('ad-role'), catSel = document.getElementById('ad-cat'), amountInp = document.getElementById('ad-amount');
  function syncInvite(){ var o = catSel.options[catSel.selectedIndex]; if (o) amountInp.value = o.getAttribute('data-amt') || ''; }
  if (roleSel){
    roleSel.addEventListener('change', function(){ fillCatSelect(catSel, roleSel.value); syncInvite(); });
    catSel.addEventListener('change', syncInvite);
    fillCatSelect(catSel, roleSel.value); syncInvite();
  }

  // Modals
  function openModal(id){ document.getElementById(id).classList.add('is-open'); }
  function closeModal(id){ document.getElementById(id).classList.remove('is-open'); }
  document.querySelectorAll('.ad-modal').forEach(function(m){ m.addEventListener('click', function(e){ if (e.target === m) m.classList.remove('is-open'); }); });

  function openUser(btn){
    var d = btn.dataset;
    document.getElementById('form-user').action = '/panel/admin/user/'+d.id+'/update';
    document.getElementById('eu-name').value = d.name;
    document.getElementById('eu-email').value = d.email;
    document.getElementById('eu-role').value = d.role;
    fillCatSelect(document.getElementById('eu-cat'), d.role, d.category);
    document.getElementById('eu-amount').value = d.amount;
    document.getElementById('eu-active').checked = (d.status === 'active');
    openModal('modal-user');
  }
  document.getElementById('eu-role').addEventListener('change', function(){ fillCatSelect(document.getElementById('eu-cat'), this.value); });

  function openNews(btn){
    var d = btn.dataset;
    document.getElementById('form-news').action = '/panel/admin/news/'+d.id+'/update';
    document.getElementById('en-tag').value = d.tag;
    document.getElementById('en-title').value = d.title;
    document.getElementById('en-excerpt').value = d.excerpt;
    document.getElementById('en-image').value = d.image;
    document.getElementById('en-date').value = d.date;
    document.getElementById('en-size').value = d.size;
    document.getElementById('en-featured').checked = (d.featured === '1');
    openModal('modal-news');
  }
  function openEvent(btn){
    var d = btn.dataset;
    document.getElementById('form-event').action = '/panel/admin/event/'+d.id+'/update';
    document.getElementById('ee-title').value = d.title;
    document.getElementById('ee-day').value = d.day;
    document.getElementById('ee-month').value = d.month;
    document.getElementById('ee-year').value = d.year;
    document.getElementById('ee-type').value = d.type;
    openModal('modal-event');
  }
  function openDocs(btn){
    var d = btn.dataset;
    document.getElementById('ed-user').textContent = d.name;
    document.getElementById('form-doc').action = '/panel/admin/user/'+d.id+'/document';
    var docs = USER_DOCS[d.id] || [];
    var list = document.getElementById('ed-list');
    if (!docs.length) {
      list.innerHTML = '<p style="font-size:13px;color:var(--pn-muted);padding:6px 0;">Sin documentos. Sube el primero abajo.</p>';
    } else {
      list.innerHTML = docs.map(function(doc){
        return '<div style="display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--pn-border);">'
          + '<div style="flex:1;min-width:0;"><strong style="display:block;font-size:14px;">'+esc(doc.name)+'</strong><small style="color:var(--pn-muted);font-size:12px;">'+esc(doc.meta||'')+'</small></div>'
          + '<a href="'+doc.url+'" target="_blank" rel="noopener" style="font-size:12px;font-weight:700;color:var(--pn-purple);">Ver</a>'
          + '<form method="POST" action="/panel/admin/document/'+doc.id+'/delete" onsubmit="return confirm(\'¿Eliminar documento?\')"><button type="submit" style="border:1px solid var(--pn-border);background:#fff;border-radius:9px;padding:6px 10px;font-size:12px;font-weight:700;color:var(--pn-ink-2);cursor:pointer;">Eliminar</button></form>'
          + '</div>';
      }).join('');
    }
    openModal('modal-docs');
  }
  function esc(s){ var d=document.createElement('div'); d.textContent=s==null?'':s; return d.innerHTML; }

  function openMile(btn){
    var d = btn.dataset;
    document.getElementById('form-mile').action = '/panel/admin/milestone/'+d.id+'/update';
    document.getElementById('em-title').value = d.title;
    document.getElementById('em-date').value = d.date;
    document.getElementById('em-done').checked = (d.done === '1');
    document.getElementById('em-highlight').checked = (d.highlight === '1');
    openModal('modal-mile');
  }

  // Tabs
  var tabs = document.querySelectorAll('.ad-tab');
  function activate(name){
    tabs.forEach(function(t){ t.classList.toggle('is-active', t.dataset.tab === name); });
    document.querySelectorAll('.ad-sec').forEach(function(s){ s.classList.toggle('is-active', s.id === 'sec-'+name); });
    // Sincroniza el estado activo del menú lateral del admin
    document.querySelectorAll('.pn-nav a[data-tab]').forEach(function(a){ a.classList.toggle('is-active', a.getAttribute('data-tab') === name); });
    // Limpia cualquier filtro de búsqueda al cambiar de sección
    var box = document.getElementById('pnSearch'); if (box && box.value){ box.value=''; box.dispatchEvent(new Event('input')); }
  }
  tabs.forEach(function(t){ t.addEventListener('click', function(){ activate(t.dataset.tab); history.replaceState(null,'','/panel/admin#'+t.dataset.tab); }); });
  // Permite que el sidebar (layout) cambie de pestaña
  window.__adminActivate = activate;
  window.addEventListener('hashchange', function(){ var h = location.hash.replace('#',''); if (document.getElementById('sec-'+h)) activate(h); });
  var initial = (location.hash ? location.hash.replace('#','') : 'usuarios');
  if (document.getElementById('sec-'+initial)) activate(initial);

  // ── Buscador global con desplegable agrupado por tipo/perfil ──
  (function(){
    var box = document.getElementById('pnSearch');
    var panel = document.getElementById('pnSearchResults');
    if (!box || !panel) return;
    box.setAttribute('placeholder', 'Buscar usuarios, noticias, eventos…');

    var SECTION = {
      noticias: { label: 'Noticias', color: '#6C3CE0' },
      calendario: { label: 'Eventos', color: '#A78BE6' },
      cronograma: { label: 'Cronograma', color: '#1E8E5A' },
      categorias: { label: 'Categorías', color: '#14141B' },
      notificaciones: { label: 'Notificaciones', color: '#6C3CE0' },
      ediciones: { label: 'Ediciones', color: '#6C3CE0' },
      codigos: { label: 'Códigos', color: '#1E8E5A' },
      accesos: { label: 'Accesos', color: '#8A8F98' },
      leads: { label: 'Prospectos', color: '#6C3CE0' }
    };
    var ORDER = ['Inversionistas','Patrocinadores','Prospectos','Noticias','Eventos','Cronograma','Categorías','Notificaciones','Ediciones','Códigos','Accesos'];

    function buildIndex(){
      var idx = [];
      document.querySelectorAll('.ad-sec').forEach(function(sec){
        var secId = sec.id.replace('sec-','');
        sec.querySelectorAll('.ad-item, .ad-tier').forEach(function(el){
          var strong = el.querySelector('strong');
          var title = (strong ? strong.textContent : el.textContent).trim();
          var group, color = '#6C3CE0', sub = '';
          if (secId === 'usuarios'){
            var eb = el.querySelector('button[data-role]');
            var role = eb ? eb.getAttribute('data-role') : 'investor';
            group = role === 'sponsor' ? 'Patrocinadores' : 'Inversionistas';
            var av = el.querySelector('.ad-item__av'); if (av && av.style.background) color = av.style.background;
            var small = el.querySelector('small'); if (small) sub = small.textContent.trim();
          } else if (SECTION[secId]) {
            group = SECTION[secId].label; color = SECTION[secId].color;
            var sm = el.querySelector('small, .ad-tier__role'); if (sm) sub = sm.textContent.trim();
          } else { return; }
          idx.push({ text: el.textContent.toLowerCase(), title: title, sub: sub, group: group, color: color, secId: secId, el: el });
        });
      });
      return idx;
    }

    var INDEX = [];
    function esc(s){ var d=document.createElement('div'); d.textContent=(s==null?'':s); return d.innerHTML; }

    function render(q){
      q = (q||'').trim().toLowerCase();
      if (!q){ panel.classList.remove('is-open'); panel.innerHTML=''; return; }
      var matches = INDEX.filter(function(it){ return it.text.indexOf(q) !== -1; });
      if (!matches.length){ panel.innerHTML = '<div class="pn-search__empty">Sin resultados para “'+esc(q)+'”</div>'; panel.classList.add('is-open'); return; }
      var byGroup = {};
      matches.forEach(function(m){ (byGroup[m.group]=byGroup[m.group]||[]).push(m); });
      var html = '';
      ORDER.forEach(function(g){
        var arr = byGroup[g]; if (!arr || !arr.length) return;
        html += '<div class="pn-search__group">'+g+' ('+arr.length+')</div>';
        arr.slice(0,8).forEach(function(m){
          html += '<button type="button" class="pn-search__opt" data-i="'+INDEX.indexOf(m)+'">'
            + '<span class="pn-search__dot" style="background:'+(m.color||'#6C3CE0')+'"></span>'
            + '<span class="pn-search__txt"><strong>'+esc(m.title)+'</strong>'+(m.sub?'<small>'+esc(m.sub)+'</small>':'')+'</span>'
            + '</button>';
        });
        if (arr.length > 8) html += '<div class="pn-search__group" style="opacity:.7;">+'+(arr.length-8)+' más…</div>';
      });
      panel.innerHTML = html;
      panel.classList.add('is-open');
    }

    function jump(m){
      if (!m) return;
      var sec = m.secId, el = m.el;
      // Cambia de sección sin que se limpie el término hasta después de saltar
      document.querySelectorAll('.ad-tab').forEach(function(t){ t.classList.toggle('is-active', t.dataset.tab === sec); });
      document.querySelectorAll('.ad-sec').forEach(function(s){ s.classList.toggle('is-active', s.id === 'sec-'+sec); });
      document.querySelectorAll('.pn-nav a[data-tab]').forEach(function(a){ a.classList.toggle('is-active', a.getAttribute('data-tab') === sec); });
      panel.classList.remove('is-open');
      setTimeout(function(){
        try { el.scrollIntoView({ behavior:'smooth', block:'center' }); } catch(_){}
        el.classList.remove('ad-jump'); void el.offsetWidth; el.classList.add('ad-jump');
      }, 60);
    }

    window.__pnSearch = function(v){ INDEX = buildIndex(); render(v); };

    panel.addEventListener('click', function(e){
      var opt = e.target.closest('.pn-search__opt'); if (!opt) return;
      jump(INDEX[parseInt(opt.getAttribute('data-i'),10)]);
    });
    document.addEventListener('click', function(e){ if (!e.target.closest('.pn-search')) panel.classList.remove('is-open'); });
    box.addEventListener('keydown', function(e){
      if (e.key === 'Escape') panel.classList.remove('is-open');
      if (e.key === 'Enter'){ var first = panel.querySelector('.pn-search__opt'); if (first){ e.preventDefault(); first.click(); } }
    });
    box.addEventListener('focus', function(){ if (box.value.trim()){ INDEX = buildIndex(); render(box.value); } });
  })();
</script>
