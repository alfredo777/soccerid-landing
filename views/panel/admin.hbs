    <form class="pn-card ad-form" method="POST" action="/panel/admin/settings/dashboard">
      <input type="hidden" name="group" value="stage">
      <h3>Estado del proyecto</h3>
      <div class="ad-f"><label>Etapa actual</label><input type="text" name="stage_label" value="{{dashboardConfig.stageLabel}}" placeholder="Comercialización"></div>
