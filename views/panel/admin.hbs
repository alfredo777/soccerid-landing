<style>
  .ad-tabs { display:flex; align-items:center; gap:8px; margin: 6px 0 22px; flex-wrap:wrap; }
  .ad-tabtitle { font-size:15px; font-weight:800; color:var(--pn-ink); margin-left:6px; }
  @media (max-width:860px){ .ad-tabtitle { display:none; } }
  .ad-tab {
    position:relative; width:44px; height:44px; border-radius:13px;
    background:#fff; border:1px solid var(--pn-border); color:var(--pn-ink-2);
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    padding:0; transition: background .15s, color .15s, border-color .15s;
  }
  .ad-tab svg { width:20px; height:20px; stroke:currentColor; fill:none; }
  .ad-tab:hover { background:var(--pn-purple-soft); color:var(--pn-purple); border-color:#E4DAFA; }
  .ad-tab.is-active { background:var(--pn-purple); color:#fff; border-color:var(--pn-purple); box-shadow:0 8px 18px rgba(108,60,224,.24); }
  /* Tooltip al pasar el mouse */
  .ad-tab::after {
    content: attr(data-label);
    position:absolute; top:calc(100% + 9px); left:50%; transform:translateX(-50%) translateY(-3px);
    background:var(--pn-ink); color:#fff; font-size:12px; font-weight:700; letter-spacing:.2px;
    padding:6px 11px; border-radius:9px; white-space:nowrap;
    opacity:0; pointer-events:none; transition:opacity .14s, transform .14s; z-index:30;
    box-shadow:0 6px 18px rgba(20,20,27,.18);
  }
  .ad-tab::before {
    content:''; position:absolute; top:calc(100% + 3px); left:50%; transform:translateX(-50%) translateY(-3px);
    border:5px solid transparent; border-bottom-color:var(--pn-ink);
    opacity:0; pointer-events:none; transition:opacity .14s, transform .14s; z-index:30;
  }
  .ad-tab:hover::after, .ad-tab:hover::before, .ad-tab:focus-visible::after, .ad-tab:focus-visible::before {
    opacity:1; transform:translateX(-50%) translateY(0);
  }
  /* En móvil la navegación vive en el menú lateral, así que los chips sobran
     (ocupaban tres renglones). Se sustituyen por una barra de ruta. */
  .ad-crumb { display:none; }
  @media (max-width:860px){
    .ad-tabs { display:none; }
    .ad-crumb {
      display:flex; align-items:center; gap:8px; margin:6px 0 18px; padding:11px 14px;
      background:#fff; border:1px solid var(--pn-border); border-radius:13px;
      font-size:13px; font-weight:700; color:var(--pn-muted);
    }
    .ad-crumb strong { color:var(--pn-ink); font-weight:800; }
    .ad-crumb svg { width:14px; height:14px; stroke:currentColor; fill:none; flex-shrink:0; }
  }
  .ad-sec { display:none; }
  .ad-sec.is-active { display:block; }

  /* Toast flotante (feedback no bloqueante que se auto-oculta) */
  .ad-toast { position:fixed; right:24px; bottom:24px; z-index:200; display:flex; align-items:center; gap:11px;
    padding:14px 18px; border-radius:13px; font-size:13.5px; font-weight:700; color:#fff; background:var(--pn-ink);
    box-shadow:0 12px 34px rgba(20,20,27,.28); max-width:min(420px,calc(100vw - 48px));
    transform:translateY(16px); opacity:0; transition:transform .28s cubic-bezier(.4,0,.2,1), opacity .28s; }
  .ad-toast.is-show { transform:translateY(0); opacity:1; }
  .ad-toast.ok { background:#1E8E5A; }
  .ad-toast.error { background:#C0392B; }
  .ad-toast svg { width:18px; height:18px; stroke:#fff; fill:none; flex-shrink:0; }
  @media (max-width:560px){ .ad-toast { right:16px; left:16px; bottom:16px; } }

  .ad-grid { display:grid; grid-template-columns: 360px 1fr; gap:22px; align-items:start; }
  @media (max-width:1000px){ .ad-grid{ grid-template-columns:1fr; } }

  .ad-form { padding:20px; }
  .ad-form h3 { font-size:15px; font-weight:800; margin-bottom:16px; }
  .ad-f { margin-bottom:14px; }
  .ad-f label { display:block; font-size:12px; font-weight:700; color:var(--pn-ink-2); margin-bottom:6px; }
  .ad-f input, .ad-f select, .ad-f textarea { width:100%; padding:11px 13px; border:1px solid var(--pn-border); border-radius:11px; font-size:13px; font-family:inherit; background:#FAFAFC; outline:none; }
  .ad-f input:focus, .ad-f select:focus, .ad-f textarea:focus { border-color:var(--pn-purple); background:#fff; }
  .ad-f textarea { resize:vertical; min-height:70px; }
  .ad-row2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .ad-check { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:600; color:var(--pn-ink-2); }
  .ad-check input { width:auto; }
  .ad-btn { width:100%; padding:13px; border:none; border-radius:12px; background:var(--pn-purple); color:#fff; font-size:14px; font-weight:800; font-family:inherit; cursor:pointer; margin-top:6px; }
  .ad-btn:hover { background:#5A2FC7; }

  /* Encabezado de sección con enlace "Ver en el panel" */
  .ad-sechead { display:flex; align-items:center; justify-content:space-between; gap:16px; margin:0 0 18px; flex-wrap:wrap; }
  .ad-seelink { display:inline-flex; align-items:center; gap:7px; font-size:13px; font-weight:800; color:var(--pn-purple); background:var(--pn-purple-soft); padding:9px 15px; border-radius:11px; flex-shrink:0; }
  .ad-seelink:hover { background:#E4DAFA; }
  .ad-seelink svg { width:15px; height:15px; stroke:currentColor; fill:none; }

  /* Configuración en tarjetas independientes */
  .ad-cfggrid { display:grid; grid-template-columns:repeat(2,1fr); gap:18px; align-items:start; }
  @media (max-width:900px){ .ad-cfggrid{ grid-template-columns:1fr; } }

  /* Campo de dinero: prefijo $ + formato en vivo */
  .ad-money { position:relative; display:flex; align-items:center; }
  .ad-money > span { position:absolute; left:13px; font-size:13px; font-weight:800; color:var(--pn-muted); pointer-events:none; }
  .ad-money__in { padding-left:26px !important; }
  .ad-money__fmt { font-size:12px; font-weight:700; color:var(--pn-purple); margin-top:5px; min-height:15px; }
  .ad-money__warn { color:#C0392B; }

  /* Barra de progreso en la lista de capital */
  .ad-capbar { height:6px; border-radius:20px; background:#F1F0F5; overflow:hidden; margin-top:7px; max-width:280px; }
  .ad-capbar i { display:block; height:100%; border-radius:20px; background:var(--pn-purple); }
  .ad-capbar.over i { background:#C0392B; }
  .ad-item__pct { font-size:12px; font-weight:800; color:var(--pn-ink-2); flex-shrink:0; }

  /* Chips de color (nivel/estado de riesgo) */
  .ad-chips { display:flex; gap:6px; margin-top:6px; flex-wrap:wrap; }
  .ad-chip2 { font-size:10.5px; font-weight:800; padding:3px 9px; border-radius:20px; letter-spacing:.2px; }

  /* Confirmación inline de borrado (sin modal ni confirm nativo) */
  .ad-confirm { display:inline-flex; align-items:center; gap:7px; font-size:12px; font-weight:700; color:var(--pn-ink-2); flex-wrap:wrap; }
  .ad-confirm__q { white-space:nowrap; }
  .ad-confirm button { border:1px solid var(--pn-border); background:#fff; border-radius:8px; padding:6px 12px; font-size:12px; font-weight:800; cursor:pointer; font-family:inherit; }
  .ad-confirm .yes { background:#C0392B; color:#fff; border-color:#C0392B; }
  .ad-confirm .yes:hover { background:#A93226; }
  .ad-confirm .no { color:var(--pn-ink-2); }
  .ad-confirm .no:hover { background:#F6F5F9; }

  /* Flechas de reordenar */
  .ad-move { display:flex; flex-direction:column; gap:2px; flex-shrink:0; }
  .ad-move button { border:1px solid var(--pn-border); background:#fff; border-radius:7px; width:26px; height:19px; padding:0; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--pn-ink-2); }
  .ad-move button:hover { background:var(--pn-purple-soft); color:var(--pn-purple); border-color:#DCCFF7; }
  .ad-move button:disabled { opacity:.35; cursor:default; }
  .ad-move svg { width:12px; height:12px; stroke:currentColor; fill:none; }

  .ad-list { padding:6px 4px; }
  .ad-item { display:flex; align-items:center; gap:14px; padding:14px 16px; border-bottom:1px solid var(--pn-border); }
  .ad-item:last-child { border-bottom:none; }
  .ad-item__av { width:40px; height:40px; border-radius:10px; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px; flex-shrink:0; }
  .ad-item__thumb { width:52px; height:40px; border-radius:9px; object-fit:cover; flex-shrink:0; }
  .ad-item__b { flex:1; min-width:0; }
  .ad-item__b strong { display:block; font-size:14px; font-weight:700; }
  .ad-item__b small { font-size:12px; color:var(--pn-muted); }
  .ad-tagpill { font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.4px; padding:3px 9px; border-radius:20px; }
  .ad-status { font-size:11px; font-weight:800; text-transform:uppercase; padding:4px 10px; border-radius:20px; }
  .ad-status.active { background:#EAF7F0; color:#1E8E5A; }
  .ad-status.invited { background:#FFF4E5; color:#B77A1E; }
  .ad-status.disabled { background:#F1F0F5; color:#8A8F98; }
  .ad-actions { display:flex; gap:8px; flex-shrink:0; flex-wrap:wrap; justify-content:flex-end; }
  .ad-actions button { border:1px solid var(--pn-border); background:#fff; border-radius:9px; padding:7px 10px; font-size:12px; font-weight:700; cursor:pointer; color:var(--pn-ink-2); font-family:inherit; }
  .ad-actions button:hover { background:#F6F5F9; }
  .ad-actions button.primary { color:var(--pn-purple); border-color:#DCCFF7; }
  .ad-actions button.primary:hover { background:var(--pn-purple-soft); }
  .ad-actions button.danger:hover { background:#FDECEC; color:#C0392B; border-color:#F5C6C6; }
  .ad-empty { padding:30px; text-align:center; color:var(--pn-muted); font-size:13px; }

  /* En móvil las acciones no caben junto al texto: con flex-shrink:0 aplastaban
     el nombre/correo a una palabra por línea y se salían de la tarjeta.
     Pasan a una fila propia, en dos columnas. */
  @media (max-width:720px){
    .ad-item { flex-wrap:wrap; align-items:flex-start; gap:12px; padding:14px; }
    .ad-item__b { flex:1 1 0; }
    .ad-item__b small { word-break:break-word; }
    .ad-actions { flex:1 0 100%; display:grid; grid-template-columns:1fr 1fr; gap:8px; justify-content:stretch; }
    .ad-actions > * { min-width:0; }
    .ad-actions button, .ad-actions select, .ad-actions .ad-select-sm { width:100%; padding:9px 10px; }
    .ad-actions form { display:block; }
  }
  .ad-hint { font-size:11px; color:var(--pn-muted); margin-top:6px; }
  .ad-note { font-size:13px; color:var(--pn-ink-2); margin:0 0 18px; }

  .ad-catgrid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  @media (max-width:900px){ .ad-catgrid{ grid-template-columns:1fr; } }
  .ad-tier { padding:20px; }
  .ad-tier__head { display:flex; align-items:center; gap:10px; margin-bottom:16px; }
  .ad-tier__dot { width:14px; height:14px; border-radius:5px; flex-shrink:0; }
  .ad-tier__head strong { font-size:16px; font-weight:800; }
  .ad-tier__role { margin-left:auto; font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.5px; color:var(--pn-muted); background:#F1F0F5; padding:4px 10px; border-radius:20px; }
  .ad-tier textarea { min-height:120px; }

  /* Modal */
  /* Panel deslizante (drawer) — reemplaza a los modales centrados */
  .ad-modal { position:fixed; inset:0; background:rgba(20,20,27,.45); z-index:100; display:flex; justify-content:flex-end;
    opacity:0; pointer-events:none; transition:opacity .22s ease; }
  .ad-modal.is-open { opacity:1; pointer-events:auto; }
  .ad-modal__card { background:#fff; width:100%; max-width:480px; height:100%; max-height:100%; overflow-y:auto;
    box-shadow:-16px 0 48px rgba(20,20,27,.18); border-radius:0;
    transform:translateX(100%); transition:transform .26s cubic-bezier(.4,0,.2,1); }
  .ad-modal.is-open .ad-modal__card { transform:translateX(0); }
  .ad-modal__card[style*="max-width:640"], .ad-modal__card[style*="max-width:560"] { max-width:640px; }
  .ad-modal__head { display:flex; align-items:center; justify-content:space-between; padding:22px 24px; border-bottom:1px solid var(--pn-border); position:sticky; top:0; background:#fff; z-index:1; }
  .ad-modal__head h3 { font-size:17px; font-weight:800; }
  .ad-modal__close { background:#F6F5F9; border:none; cursor:pointer; padding:0; width:32px; height:32px; border-radius:9px; display:flex; align-items:center; justify-content:center; }
  .ad-modal__close:hover { background:#ECEAF2; }
  .ad-modal__close svg { width:18px; height:18px; stroke:var(--pn-ink-2); }
  .ad-modal__body { padding:22px 24px 28px; }
  @media (max-width:560px){ .ad-modal__card { max-width:100%; } }
  .ad-langtabs { display:flex; gap:8px; margin:18px 0 14px; border-bottom:1px solid var(--pn-border); }
  .ad-langtab { padding:8px 14px; background:none; border:none; border-bottom:2px solid transparent; font-family:inherit; font-size:13px; font-weight:800; color:var(--pn-ink-2); cursor:pointer; }
  .ad-langtab.is-active { color:var(--pn-purple); border-bottom-color:var(--pn-purple); }
  .ad-langsec { display:none; }
  .ad-langsec.is-active { display:block; }
  .ad-f label em { font-style:normal; color:var(--pn-muted); font-weight:600; }
  .ad-multi { display:inline-block; margin-top:3px; padding:1px 9px; border-radius:999px; background:var(--pn-purple-soft); color:var(--pn-purple); font-size:11px; font-weight:800; }
  .ad-select-sm { border:1px solid var(--pn-border); border-radius:9px; padding:7px 8px; font-size:12px; font-weight:700; font-family:inherit; color:var(--pn-ink-2); background:#fff; cursor:pointer; }
  .ad-actions__link { display:inline-flex; align-items:center; padding:7px 12px; border-radius:9px; background:var(--pn-purple); color:#fff; font-size:12px; font-weight:800; }
  .ad-actions__link:hover { background:#5A2FC7; }

  /* Editor de filas repetibles (ediciones) */
  .ed-shared { display:inline-block; margin-left:7px; padding:1px 8px; border-radius:999px; background:#F1F5F9; color:#475569; font-size:10px; font-weight:800; letter-spacing:.3px; text-transform:uppercase; vertical-align:middle; }
  .ed-hint-block { margin:18px 0 4px; padding:11px 13px; border-radius:11px; background:var(--pn-purple-soft); color:var(--pn-ink-2); font-size:12.5px; line-height:1.55; }
  .ed-group { margin:20px 0 0; }
  .ed-group__t { display:block; font-size:12.5px; font-weight:800; color:var(--pn-ink); margin-bottom:9px; }
  .ed-row { border:1px solid var(--pn-border); border-radius:13px; padding:12px 13px; margin-bottom:9px; background:#FCFCFD; }
  .ed-row__head { display:flex; align-items:center; justify-content:space-between; margin-bottom:9px; }
  .ed-row__n { font-size:11px; font-weight:800; color:var(--pn-muted); letter-spacing:.4px; }
  .ed-row__btns { display:flex; gap:5px; }
  .ed-row__btns button { width:26px; height:26px; border:1px solid var(--pn-border); border-radius:8px; background:#fff; cursor:pointer; font-size:12px; line-height:1; color:var(--pn-ink-2); font-family:inherit; }
  .ed-row__btns button:hover { background:#F3F2F7; }
  .ed-row__btns button.danger:hover { background:#FEF2F2; color:#B42318; border-color:#FCA5A5; }
  .ed-row__btns button[disabled] { opacity:.3; cursor:default; }
  .ed-fld { margin-bottom:9px; }
  .ed-fld:last-child { margin-bottom:0; }
  .ed-fld label { display:block; font-size:11px; font-weight:700; color:var(--pn-muted); margin-bottom:4px; }
  .ed-fld input { width:100%; border:1px solid var(--pn-border); border-radius:9px; padding:9px 11px; font-size:13px; font-family:inherit; color:var(--pn-ink); background:#fff; }
  .ed-fld input:focus { outline:none; border-color:var(--pn-purple); }
  .ed-img { display:flex; gap:8px; align-items:center; }
  .ed-img input { flex:1; min-width:0; }
  .ed-img button { white-space:nowrap; padding:9px 12px; border:1px solid var(--pn-border); border-radius:9px; background:#fff; font-family:inherit; font-size:12px; font-weight:700; color:var(--pn-purple); cursor:pointer; }
  .ed-img button:hover { background:var(--pn-purple-soft); }
  .ed-img img { width:38px; height:38px; object-fit:cover; border-radius:8px; border:1px solid var(--pn-border); background:#F3F2F7; }
  .ed-add { width:100%; padding:10px; border:1px dashed var(--pn-border); border-radius:11px; background:#fff; font-family:inherit; font-size:12.5px; font-weight:700; color:var(--pn-purple); cursor:pointer; }
  .ed-add:hover { background:var(--pn-purple-soft); border-color:#DCCFF7; }
  .ed-empty-rows { font-size:12.5px; color:var(--pn-muted); padding:6px 0 10px; }
  .ed-actions { display:flex; gap:10px; margin-top:22px; }
  .ed-actions .ad-btn { margin-top:0; }
  .ed-preview { margin-top:18px; border:1px solid var(--pn-border); border-radius:14px; overflow:hidden; background:#fff; }
  .ed-preview__banner { height:120px; background:#F3F2F7 center/cover no-repeat; }
  .ed-preview__b { padding:16px 18px; }
  .ed-preview__b h4 { font-size:16px; font-weight:800; margin-bottom:4px; }
  .ed-preview__meta { font-size:12px; color:var(--pn-muted); font-weight:600; margin-bottom:10px; }
  .ed-preview__desc { font-size:13px; color:var(--pn-ink-2); line-height:1.55; margin-bottom:12px; }
  .ed-preview__stats { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:12px; }
  .ed-preview__stat { background:var(--pn-purple-soft); border-radius:11px; padding:8px 12px; }
  .ed-preview__stat b { display:block; font-size:16px; font-weight:800; color:var(--pn-purple); }
  .ed-preview__stat span { font-size:10.5px; font-weight:700; color:var(--pn-ink-2); text-transform:uppercase; letter-spacing:.4px; }
  .ed-preview__thumbs { display:flex; gap:7px; flex-wrap:wrap; }
  .ed-preview__thumbs img { width:54px; height:40px; object-fit:cover; border-radius:7px; border:1px solid var(--pn-border); }
  .ed-preview__list { font-size:12.5px; color:var(--pn-ink-2); line-height:1.7; }
  .ed-preview__warn { margin:0; padding:10px 18px; background:#FEF3C7; color:#92400E; font-size:12px; font-weight:700; }
  .ed-preview__lang { display:flex; gap:6px; padding:10px 12px; border-bottom:1px solid var(--pn-border); background:#FBFAFD; }
  .ed-preview__lang button { padding:5px 12px; border:1px solid var(--pn-border); border-radius:999px; background:#fff; font-family:inherit; font-size:11.5px; font-weight:700; color:var(--pn-ink-2); cursor:pointer; }
  .ed-preview__lang button.is-on { background:var(--pn-purple); border-color:var(--pn-purple); color:#fff; }
</style>

{{#if flash}}
<div class="ad-toast {{#eq flashType 'error'}}error{{else}}ok{{/eq}}" id="adToast">
  {{#eq flashType 'error'}}
  <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
  {{else}}
  <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
  {{/eq}}
  <span>{{flash}}</span>
</div>
{{/if}}

<nav class="ad-crumb" aria-label="Ruta">
  <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
  <span>Administración</span>
  <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
  <strong id="adCrumbSec" aria-live="polite">Usuarios</strong>
</nav>

<div class="ad-tabs">
  <button type="button" class="ad-tab is-active" data-tab="usuarios" data-label="Usuarios" title="Usuarios" aria-label="Usuarios">
    <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
  <button type="button" class="ad-tab" data-tab="estadisticas" data-label="Estadísticas" title="Estadísticas" aria-label="Estadísticas">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="20" x2="6" y2="13"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="9"/></svg>
  </button>
  <button type="button" class="ad-tab" data-tab="noticias" data-label="Noticias" title="Noticias" aria-label="Noticias">
    <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h13v14H6a2 2 0 0 1-2-2V5z"/><path d="M17 8h2a1 1 0 0 1 1 1v8a2 2 0 0 1-2 2"/><line x1="7" y1="9" x2="14" y2="9"/><line x1="7" y1="13" x2="14" y2="13"/></svg>
  </button>
