</section>

<!-- EDICIONES -->
</section>

<!-- EDICIONES (una por año: contenido público + portafolio de inversión) -->
<section class="ad-sec" id="sec-eventos">
  <style>
    .ad-evgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:18px; }
    .ad-evcard { padding:20px; }
    .ad-evcard__top { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
    .ad-evcode { font-size:12px; font-weight:900; letter-spacing:1px; padding:8px 12px; border-radius:11px; }
    .ad-evtags { display:flex; gap:6px; }
    .ad-evphase { font-size:10.5px; font-weight:800; text-transform:uppercase; letter-spacing:.4px; color:var(--pn-ink-2); background:#F1F0F5; padding:4px 10px; border-radius:20px; }
    .ad-evdemo { font-size:10.5px; font-weight:800; text-transform:uppercase; color:#B77A1E; background:#FFF4E5; padding:4px 10px; border-radius:20px; }
    .ad-evactiva { font-size:10.5px; font-weight:800; text-transform:uppercase; color:#03543F; background:#DEF7EC; padding:4px 10px; border-radius:20px; }
    .ev-activa { display:flex; align-items:center; justify-content:space-between; gap:18px; padding:18px 20px; margin-bottom:18px; flex-wrap:wrap; }
    .ev-activa strong { display:block; font-size:14px; font-weight:800; margin-bottom:3px; }
    .ev-activa p { font-size:12.5px; color:var(--pn-ink-2); line-height:1.5; margin:0; max-width:560px; }
    .ev-activa__ctrl { display:flex; gap:9px; align-items:center; }
    .ev-activa select { border:1px solid var(--pn-border); border-radius:11px; padding:11px 13px; font-family:inherit; font-size:13.5px; font-weight:700; color:var(--pn-ink); background:#fff; }
    .ad-evtitle { font-size:19px; font-weight:900; letter-spacing:-.3px; display:block; }
    .ad-evmatch { font-size:13px; font-weight:700; color:var(--pn-purple); margin-top:2px; }
    .ad-evmeta { font-size:12px; color:var(--pn-muted); margin-top:4px; }
    .ad-evbar { margin:14px 0; }
    .ad-evbar small { font-size:11px; font-weight:700; color:var(--pn-ink-2); }
    .ad-evtrack { height:7px; border-radius:20px; background:#F1F0F5; overflow:hidden; margin-top:6px; }
    .ad-evtrack i { display:block; height:100%; border-radius:20px; }
    .ad-evstats { display:flex; gap:10px; border-top:1px solid var(--pn-border); padding-top:14px; }
    .ad-evstats > div { flex:1; }
    .ad-evstats b { display:block; font-size:15px; font-weight:900; }
    .ad-evstats span { font-size:10.5px; color:var(--pn-muted); font-weight:700; text-transform:uppercase; letter-spacing:.3px; }
  </style>
  <div class="ad-sechead">
    <p class="ad-note" style="margin:0;">Ediciones por año del portafolio. Cada edición alimenta la parte pública y el panel del inversionista (info, paquetes, presentación, cronología).</p>
    <button type="button" class="ad-btn" style="width:auto; padding:10px 16px; margin:0;" onclick="openPortfolio()">+ Nueva edición</button>
  </div>

  <form class="pn-card ev-activa" method="POST" action="/panel/admin/settings/edicion-activa">
    <div>
      <strong>Edición activa</strong>
      <p>Es la que ven <strong>todos los inversionistas</strong> en su panel, con sus datos y estadísticas.
        Lo decides tú: el inversionista no puede cambiarla. De las demás solo ve una ficha general.</p>
    </div>
    <div class="ev-activa__ctrl">
      <select name="active_edition_id">
        <option value="">Automática (la de mayor año)</option>
        {{#each portfolioEditions}}
        <option value="{{this.id}}"{{#if this.isActiveEdition}}{{#unless this.isAutoActive}} selected{{/unless}}{{/if}}>{{this.year}} · {{this.title}}</option>
        {{/each}}
      </select>
      <button type="submit" class="ad-btn" style="width:auto; margin:0; padding:11px 18px;">Guardar</button>
    </div>
  </form>
  <div class="ad-evgrid">
    {{#each portfolioEditions}}
    <div class="pn-card ad-evcard">
      <div class="ad-evcard__top">
        <span class="ad-evcode" style="background:{{this.accent}}22; color:{{this.accent}}">{{#if this.code}}{{this.code}}{{else}}{{this.year}}{{/if}}</span>
        <div class="ad-evtags">
          {{#if this.isActiveEdition}}<span class="ad-evactiva">{{#if this.isAutoActive}}Activa (auto){{else}}Activa{{/if}}</span>{{/if}}
          <span class="ad-evphase">{{this.phaseLabel}}</span>
          {{#if this.isDemo}}<span class="ad-evdemo">Demo</span>{{/if}}
        </div>
      </div>
      <strong class="ad-evtitle">{{this.title}}</strong>
      <div class="ad-evmatch">{{this.match}}</div>
      <div class="ad-evmeta">{{#if this.venue}}{{this.venue}} · {{/if}}{{this.city}}</div>
      <div class="ad-evmeta">{{this.dateLabel}}</div>
      <div class="ad-evbar">
        <small>{{this.phaseLabel}} · {{this.progress}}%</small>
        <div class="ad-evtrack"><i style="width:{{this.progress}}%; background:{{this.accent}}"></i></div>
      </div>
      <div class="ad-evstats">
        <div><b>{{this.budgetLabel}}</b><span>Presupuesto</span></div>
        <div><b>{{this.investments}}</b><span>Inversiones</span></div>
        <div><b>{{this.packages}}</b><span>Paquetes</span></div>
      </div>
