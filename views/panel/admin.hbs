      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Precio de boleto (USD)</label>
          <div class="ad-money"><span>$</span><input class="ad-money__in" type="number" name="ticket_price" value="{{dashboardConfig.ticketPrice}}" min="0" step="10"></div>
        </div>
