<!-- CÓDIGOS -->
<section class="ad-sec" id="sec-codigos">
  <style>
    .cd-flag { display:inline-block; margin-left:6px; padding:1px 8px; border-radius:999px; background:#FEF3C7; color:#92400E; font-size:10.5px; font-weight:800; }
    .cd-owner { display:inline-block; padding:1px 8px; border-radius:999px; background:var(--pn-purple-soft); color:var(--pn-purple); font-size:10.5px; font-weight:800; }
    .cd-none { color:var(--pn-muted); font-size:11.5px; }
    .ad-sendcode { margin-top:22px; padding-top:18px; border-top:1px solid var(--pn-border); }
    .ad-sendcode h4 { font-size:13px; font-weight:800; margin-bottom:4px; }
    .cd-tag { display:inline-block; margin-left:5px; padding:1px 8px; border-radius:999px; background:#F1F5F9; color:#475569; font-size:10.5px; font-weight:700; }
  </style>
  <p class="ad-note">Códigos de acceso a la <strong>propuesta 2027</strong> (<a href="/es/socceridcup2027" target="_blank" rel="noopener" style="color:var(--pn-purple);font-weight:700;">ver página</a>). Al entrar desde un dispositivo nuevo se pide nombre y correo (quedan en <strong>Prospectos</strong>) y se registra en <strong>Accesos</strong>.</p>
  <div class="ad-grid">
    <div>
      <form class="pn-card ad-form" method="POST" action="/panel/admin/codes/generate" style="margin-bottom:18px;">
        <h3>Generar códigos</h3>
        <div class="ad-f"><label>Cantidad</label><input type="number" name="count" value="10" min="1" max="100"></div>
        <button type="submit" class="ad-btn">Generar (por usar)</button>
      </form>
      <form class="pn-card ad-form" method="POST" action="/panel/admin/code">
        <h3>Agregar código manual</h3>
        <div class="ad-f"><label>Código</label><input type="text" name="code" placeholder="1234567" required></div>
        <div class="ad-f"><label>Estado</label><select name="status"><option value="unused">Por usar</option><option value="used">Usado</option></select></div>
        <button type="submit" class="ad-btn">Agregar</button>
      </form>
    </div>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Códigos ({{codes.length}})</h3><span class="ad-hint">{{codesUsed}} usados · {{codesUnused}} por usar · {{codesAssigned}} con dueño</span></div>
      <div class="ad-list">
        {{#each codes}}
        <div class="ad-item">
          <div class="ad-item__av" style="background: {{#eq this.status 'used'}}#8A8F98{{else}}#1E8E5A{{/eq}}; font-size:13px;">{{#if this.isTest}}★{{else}}#{{/if}}</div>
          <div class="ad-item__b">
            <strong style="letter-spacing:2px;">{{this.code}}</strong>
            <small>
              {{#if this.isTest}}Código de prueba · {{/if}}{{this.statusLabel}} · {{this.accesses}} accesos
              {{#if this.otherAccesses}}<span class="cd-flag">{{this.otherAccesses}} de otra persona</span>{{/if}}
            </small>
            <small>
              {{#if this.assigned}}<span class="cd-owner">{{this.assigneeName}}{{#unless this.assigneeName}}{{this.assigneeEmail}}{{/unless}}</span>{{else}}<span class="cd-none">Sin dueño asignado</span>{{/if}}
              {{#each this.tags}}<span class="cd-tag">{{this}}</span>{{/each}}
            </small>
          </div>
          <div class="ad-actions">
            <button type="button" onclick="openCodeAssign(this)"
              data-id="{{this.id}}" data-code="{{this.code}}"
              data-name="{{this.assigneeName}}" data-email="{{this.assigneeEmail}}"
              data-phone="{{this.assigneePhone}}" data-tags="{{this.tagsText}}">{{#if this.assigned}}Dueño{{else}}Asignar{{/if}}</button>
            <button type="button" onclick="openCodeHistory(this)" data-code="{{this.code}}">Accesos{{#if this.accesses}} ({{this.accesses}}){{/if}}</button>
            <form method="POST" action="/panel/admin/code/{{this.id}}/status">
              <select name="status" class="ad-select-sm" onchange="this.form.submit()">
                <option value="unused" {{#eq this.status 'unused'}}selected{{/eq}}>Por usar</option>
                <option value="used" {{#eq this.status 'used'}}selected{{/eq}}>Usado</option>
              </select>
            </form>
            <form method="POST" action="/panel/admin/code/{{this.id}}/delete" data-confirm="¿Eliminar el código {{this.code}}?"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- ACCESOS -->
<section class="ad-sec" id="sec-accesos">
  <p class="ad-note">Registro de accesos a la propuesta 2027, basado en dispositivo. Cada apertura queda guardada con fecha, IP y si es un dispositivo nuevo.</p>
  <div class="pn-card">
    <div class="pn-card__head"><h3>Accesos ({{accessLog.length}})</h3><span class="ad-hint">Últimos 200</span></div>
    <div class="ad-list">
      {{#each accessLog}}
      <div class="ad-item">
        <div class="ad-item__av" style="background: {{#if this.newDevice}}#6C3CE0{{else}}#8A8F98{{/if}}; font-size:10px;">{{#if this.newDevice}}NEW{{else}}···{{/if}}</div>
        <div class="ad-item__b">
          <strong>{{this.name}} · <span style="font-weight:600;color:var(--pn-ink-2);">{{this.email}}</span></strong>
          <small>Código {{this.code}} · {{this.when}} · disp. {{this.device}} · {{this.ip}}{{#if this.newDevice}} · dispositivo nuevo{{/if}}</small>
        </div>
      </div>
      {{else}}
      <div class="ad-empty">Aún no hay accesos registrados.</div>
      {{/each}}
    </div>
  </div>
</section>

<!-- MAPA DE CÓDIGOS -->
<section class="ad-sec" id="sec-mapa">
  <style>
    .mp-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:18px; }
    .mp-stat { background:#fff; border:1px solid var(--pn-border); border-radius:14px; padding:15px 17px; box-shadow:var(--pn-shadow); }
    .mp-stat b { display:block; font-size:24px; font-weight:800; line-height:1.1; }
    .mp-stat span { font-size:12px; color:var(--pn-muted); font-weight:600; }
    .mp-chips { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; }
    .mp-chip { padding:7px 14px; border-radius:999px; border:1px solid var(--pn-border); background:#fff; font-family:inherit; font-size:12.5px; font-weight:700; color:var(--pn-ink-2); cursor:pointer; }
    .mp-chip.is-on { background:var(--pn-purple); border-color:var(--pn-purple); color:#fff; }
    .mp-canvas { background:#fff; border:1px solid var(--pn-border); border-radius:16px; padding:8px; box-shadow:var(--pn-shadow); overflow-x:auto; }
    .mp-canvas svg { display:block; width:100%; min-width:640px; }
    .mp-node { cursor:default; }
    .mp-node text { font-family:inherit; }
    .mp-dim { opacity:.16; }
    .mp-legend { display:flex; gap:16px; flex-wrap:wrap; margin-top:14px; font-size:12px; color:var(--pn-muted); font-weight:600; }
    .mp-legend i { display:inline-block; width:10px; height:10px; border-radius:3px; margin-right:6px; vertical-align:middle; }
    .mp-empty { padding:54px 24px; text-align:center; color:var(--pn-muted); }
    .mp-empty strong { display:block; color:var(--pn-ink); font-size:15px; margin-bottom:8px; }
  </style>

  <p class="ad-note">Quién repartió su código y quién acabó entrando con él. Se arma con los códigos que
    tienen <strong>dueño asignado</strong> (pestaña Códigos, botón "Asignar"). Una línea significa
    <em>"el código de X lo usó Y"</em>: ahí es donde aparecen los reenvíos y los referidos.</p>

  <div class="mp-stats">
    <div class="mp-stat"><b>{{codesAssigned}}</b><span>códigos con dueño</span></div>
    <div class="mp-stat"><b>{{codesLeaked}}</b><span>códigos usados por otra persona</span></div>
    <div class="mp-stat"><b>{{relations.visitors.length}}</b><span>personas alcanzadas por reenvío</span></div>
    <div class="mp-stat"><b>{{relations.owners.length}}</b><span>repartidores en el mapa</span></div>
  </div>

  {{#if codeTags}}
  <div class="mp-chips" id="mpChips">
    <button type="button" class="mp-chip is-on" data-tag="">Todos</button>
    {{#each codeTags}}<button type="button" class="mp-chip" data-tag="{{this}}">{{this}}</button>{{/each}}
  </div>
  {{/if}}

  <div class="mp-canvas" id="mpCanvas"></div>
  <div class="mp-legend">
    <span><i style="background:#6C3CE0;"></i>Dueño del código</span>
    <span><i style="background:#D97706;"></i>Entró con el código de alguien más</span>
    <span>Línea sólida = confirmado que no era el dueño · punteada = no se pudo confirmar</span>
  </div>
</section>

<!-- PROSPECTOS -->
<section class="ad-sec" id="sec-leads">
  <p class="ad-note">Nombres y correos capturados en la propuesta 2027. Cambia su estado con el select, o envíales correo individual o masivo.</p>
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/leads/email" data-confirm="¿Enviar este correo a los prospectos seleccionados?">
      <h3>Correo masivo</h3>
      <div class="ad-f"><label>Audiencia</label><select name="audience"><option value="all">Todos</option><option value="nuevo">Nuevos</option><option value="contactado">Contactados</option><option value="cliente">Clientes</option><option value="descartado">Descartados</option></select></div>
      <div class="ad-f"><label>Asunto</label><input type="text" name="subject" required></div>
      <div class="ad-f"><label>Mensaje</label><textarea name="body" rows="5" required></textarea></div>
      <button type="submit" class="ad-btn">Enviar correo masivo</button>
    </form>
    <div class="pn-card">
      <div class="pn-card__head"><h3>Prospectos ({{leads.length}})</h3></div>
      <div class="ad-list">
        {{#each leads}}
        <div class="ad-item">
          <div class="ad-item__av" style="background:#6C3CE0;">{{this.name.[0]}}</div>
          <div class="ad-item__b">
            <strong>{{this.name}}</strong>
            <small>{{this.email}} · {{this.accesses}} accesos{{#if this.deviceCount}} · {{this.deviceCount}} disp.{{/if}}{{#if this.lastIp}} · IP {{this.lastIp}}{{/if}}{{#if this.lastWhen}} · último {{this.lastWhen}}{{/if}}</small>
          </div>
          <div class="ad-actions">
            <form method="POST" action="/panel/admin/lead/{{this.id}}/status">
              <select name="status" class="ad-select-sm" onchange="this.form.submit()">
                <option value="nuevo" {{#eq this.status 'nuevo'}}selected{{/eq}}>Nuevo</option>
                <option value="contactado" {{#eq this.status 'contactado'}}selected{{/eq}}>Contactado</option>
                <option value="cliente" {{#eq this.status 'cliente'}}selected{{/eq}}>Cliente</option>
                <option value="descartado" {{#eq this.status 'descartado'}}selected{{/eq}}>Descartado</option>
              </select>
            </form>
            <button type="button" onclick="openLeadHistory(this)" data-id="{{this.id}}" data-name="{{this.name}}" data-email="{{this.email}}">Historial{{#if this.accesses}} ({{this.accesses}}){{/if}}</button>
            <button type="button" class="primary" onclick="openLeadEmail(this)" data-id="{{this.id}}" data-name="{{this.name}}" data-email="{{this.email}}">Correo</button>
            <form method="POST" action="/panel/admin/lead/{{this.id}}/delete" data-confirm="¿Eliminar a {{this.name}}?"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">Aún no hay prospectos. Se registran al entrar a la propuesta desde un dispositivo nuevo.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- USO DEL CAPITAL -->
<section class="ad-sec" id="sec-capital">
  <div class="ad-sechead">
    <p class="ad-note" style="margin:0;">Rubros de <strong>uso del capital</strong>: presupuestado vs. ejercido. Total: <strong>{{capitalTotalSpent}}</strong> ejercido de {{capitalTotalBudget}}.</p>
    <a class="ad-seelink" href="/panel/admin/preview/investor" target="_blank" rel="noopener">Ver en el panel
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
    </a>
  </div>
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/capital">
      <h3>Agregar rubro</h3>
      <div class="ad-f"><label>Rubro</label><input type="text" name="label" required placeholder="Ej. Producción y transmisión"></div>
      <div class="ad-row2">
        <div class="ad-f"><label>Presupuestado</label>
          <div class="ad-money"><span>$</span><input class="ad-money__in" type="number" name="budget" min="0" step="1000" value="0"></div>
          <div class="ad-money__fmt"></div>
        </div>
        <div class="ad-f"><label>Ejercido</label>
          <div class="ad-money"><span>$</span><input class="ad-money__in" type="number" name="spent" min="0" step="1000" value="0"></div>
          <div class="ad-money__fmt"></div>
        </div>
      </div>
      <div class="ad-f"><label>Detalle</label><input type="text" name="note" placeholder="Nota breve"></div>
      <div class="ad-f"><label>Fuente del dato</label><input type="text" name="source" placeholder="Ej. Área financiera"></div>
      <button type="submit" class="ad-btn">Agregar rubro</button>
    </form>
    <div class="pn-card">
      <div class="pn-card__head"><h3>Rubros ({{capitalItems.length}})</h3></div>
      <div class="ad-list">
        {{#each capitalItems}}
        <div class="ad-item">
          <div class="ad-item__av" style="background:{{#if this.over}}#C0392B{{else}}#6C3CE0{{/if}}; font-size:12px;">{{this.pct}}%</div>
          <div class="ad-item__b">
            <strong>{{this.label}}</strong>
            <small>{{this.spentLabel}} / {{this.budgetLabel}}{{#if this.source}} · {{this.source}}{{/if}}</small>
            <div class="ad-capbar {{#if this.over}}over{{/if}}"><i style="width: {{this.pct}}%"></i></div>
          </div>
          <div class="ad-move">
            <form method="POST" action="/panel/admin/capital/{{this.id}}/move"><input type="hidden" name="dir" value="up"><button type="submit" {{#if @first}}disabled{{/if}} title="Subir"><svg viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg></button></form>
            <form method="POST" action="/panel/admin/capital/{{this.id}}/move"><input type="hidden" name="dir" value="down"><button type="submit" {{#if @last}}disabled{{/if}} title="Bajar"><svg viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button></form>
          </div>
          <div class="ad-actions">
            <button type="button" class="primary" onclick="openCapital(this)"
              data-id="{{this.id}}" data-label="{{this.label}}" data-budget="{{this.budget}}" data-spent="{{this.spent}}" data-note="{{this.note}}" data-source="{{this.source}}">Editar</button>
            <form method="POST" action="/panel/admin/capital/{{this.id}}/delete" data-confirm="¿Eliminar rubro?"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">No hay rubros. Agrega el primero.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- CONFIGURACIÓN DEL DASHBOARD -->
<section class="ad-sec" id="sec-configuracion">
  <div class="ad-sechead">
    <p class="ad-note" style="margin:0;">Personaliza lo que ven <strong>todos los inversionistas</strong>. Cada tarjeta se guarda por separado.</p>
    <a class="ad-seelink" href="/panel/admin/preview/investor" target="_blank" rel="noopener">Ver en el panel
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
    </a>
  </div>

