<!-- USUARIOS -->
<section class="ad-sec is-active" id="sec-usuarios">
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/invite">
      <h3>Invitar usuario</h3>
      <div class="ad-f"><label>Nombre completo</label><input type="text" name="name" required placeholder="Nombre y apellido"></div>
      <div class="ad-f"><label>Correo electrónico</label><input type="email" name="email" required placeholder="correo@ejemplo.com"></div>
      <div class="ad-f"><label>Tipo</label>
        <select name="role" id="ad-role"><option value="investor">Inversionista</option><option value="sponsor">Patrocinador</option></select>
      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Categoría</label><select name="category" id="ad-cat"></select></div>
        <div class="ad-f"><label>Monto (USD)</label><input type="number" name="amount" id="ad-amount" min="0" step="1000"></div>
      </div>
      <div class="ad-f"><label>Tipo de inversión</label>
        <select name="investment_type"><option value="fijo">Retorno fijo</option><option value="riesgo">Participación a riesgo</option></select>
      </div>
      <button type="submit" class="ad-btn">Enviar invitación</button>
    </form>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Usuarios ({{users.length}})</h3></div>
      <div class="ad-list">
        {{#each users}}
        <div class="ad-item">
          <div class="ad-item__av" style="background: {{this.color}}">{{this.tierLabel.[0]}}</div>
          <div class="ad-item__b">
            <strong>{{this.name}}</strong>
            <small>{{this.email}} · {{this.roleLabel}} {{this.tierLabel}} · {{this.amount}}{{#eq this.role 'investor'}} · {{this.investmentTypeLabel}}{{/eq}}</small>
            {{#if this.edicionesN}}<small class="ad-multi">{{this.capitalTotal}} en {{this.edicionesN}} edición(es): {{this.edicionesLabel}}</small>{{/if}}
          </div>
          <span class="ad-status {{this.status}}">{{this.status}}</span>
          <div class="ad-actions">
            <button type="button" class="primary" onclick="location.href='/panel/admin/user/{{this.id}}'">Editar cuenta{{#if this.docCount}} · {{this.docCount}} doc{{/if}}</button>
            <form method="POST" action="/panel/admin/user/{{this.id}}/resend"><button type="submit">Reenviar</button></form>
            <form method="POST" action="/panel/admin/user/{{this.id}}/delete" data-confirm="¿Eliminar a {{this.name}}?"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">Aún no hay usuarios. Invita al primero.</div>
        {{/each}}
      </div>
    </div>
  </div>

<!-- ESTADÍSTICAS -->
<section class="ad-sec" id="sec-estadisticas">
  <style>
    .st-note { margin:0 0 18px; padding:12px 15px; border-radius:12px; background:var(--pn-purple-soft); color:var(--pn-ink-2); font-size:12.5px; line-height:1.55; }
    .st-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:16px; margin-bottom:22px; }
    .st-card { padding:20px; }
    .st-card h4 { font-size:11.5px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; color:var(--pn-muted); margin-bottom:10px; }
    .st-big { font-size:26px; font-weight:900; letter-spacing:-.5px; line-height:1.1; }
    .st-sub { font-size:12px; color:var(--pn-muted); font-weight:600; margin-top:4px; }
    .st-bar { height:9px; border-radius:20px; background:#F1F0F5; overflow:hidden; margin:12px 0 7px; display:flex; }
    .st-bar i { display:block; height:100%; }
    .st-legend { font-size:11.5px; color:var(--pn-muted); font-weight:600; line-height:1.7; }
    .st-legend i { display:inline-block; width:9px; height:9px; border-radius:3px; margin-right:6px; vertical-align:middle; }
    .st-two { display:grid; grid-template-columns:minmax(220px,300px) 1fr; gap:24px; align-items:center; }
    @media (max-width:720px){ .st-two { grid-template-columns:1fr; } }
    .st-donut { position:relative; width:100%; max-width:210px; margin:0 auto; }
    .st-donut svg { width:100%; height:auto; transform:rotate(-90deg); }
    .st-donut__mid { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
    .st-donut__mid b { font-size:28px; font-weight:900; line-height:1; }
    .st-donut__mid span { font-size:11px; color:var(--pn-muted); font-weight:700; text-transform:uppercase; letter-spacing:.4px; }
    .st-rows { width:100%; }
    .st-row { display:flex; align-items:center; gap:10px; padding:9px 0; border-bottom:1px solid var(--pn-border); font-size:13px; }
    .st-row:last-child { border-bottom:none; }
    .st-row i { width:10px; height:10px; border-radius:3px; flex-shrink:0; }
    .st-row strong { flex:1; font-weight:700; }
    .st-row span { font-weight:800; color:var(--pn-ink-2); }
    .st-row small { color:var(--pn-muted); font-weight:600; font-size:11.5px; }
    .st-mini { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:10px; }
    .st-mini div { background:#FBFAFD; border:1px solid var(--pn-border); border-radius:12px; padding:12px 14px; }
    .st-mini b { display:block; font-size:19px; font-weight:900; line-height:1.15; }
    .st-mini span { font-size:11px; color:var(--pn-muted); font-weight:700; }
    .st-flag { display:inline-block; padding:2px 9px; border-radius:999px; font-size:10.5px; font-weight:800; text-transform:uppercase; letter-spacing:.3px; }
    .st-flag--ok { background:#DEF7EC; color:#03543F; }
    .st-flag--warn { background:#FEF3C7; color:#92400E; }
    .st-comp { overflow-x:auto; }
    .st-comp table { width:100%; border-collapse:collapse; font-size:12.5px; min-width:640px; }
    .st-comp th { text-align:left; font-size:10.5px; font-weight:800; letter-spacing:.4px; text-transform:uppercase; color:var(--pn-muted); padding:0 10px 9px 0; border-bottom:1px solid var(--pn-border); }
    .st-comp td { padding:11px 10px 11px 0; border-bottom:1px solid var(--pn-border); font-weight:700; color:var(--pn-ink-2); white-space:nowrap; }
    .st-comp tr:last-child td { border-bottom:none; }
    .st-comp tr.is-activa td { background:var(--pn-purple-soft); }
    .st-comp tr.is-activa td:first-child { border-radius:9px 0 0 9px; padding-left:9px; }
    .st-comp tr.is-activa td:last-child { border-radius:0 9px 9px 0; }
    .st-dot { display:inline-block; width:9px; height:9px; border-radius:3px; margin-right:7px; vertical-align:middle; }
    .st-minibar { display:inline-block; width:52px; height:6px; border-radius:20px; background:#F1F0F5; overflow:hidden; vertical-align:middle; margin-right:7px; }
    .st-minibar i { display:block; height:100%; }
  </style>

  <p class="st-note">Todo lo de aquí se <strong>cuenta solo</strong> a partir de lo cargado en el panel; no hay cifras escritas a mano.
    Lo que depende del año se mide sobre la <strong>edición activa</strong>{{#if stats.edicion}} (<strong>{{stats.edicion.title}}</strong>){{/if}};
    los códigos, prospectos y contenido son del negocio completo.</p>

  <!-- Capital -->
  <div class="st-grid">
    <div class="pn-card st-card">
      <h4>Capital comprometido</h4>
      <div class="st-big">{{stats.capital.edicion}}</div>
      <div class="st-sub">{{stats.capital.inversiones}} inversión(es) en esta edición</div>
      <div class="st-bar"><i style="width:{{stats.capital.cubiertoPct}}%; background:var(--pn-purple);"></i></div>
      <div class="st-legend">{{stats.capital.cubiertoPct}}% del presupuesto ({{stats.capital.presupuesto}})</div>
    </div>
    <div class="pn-card st-card">
      <h4>Falta por levantar</h4>
      {{#if stats.capital.sinPresupuesto}}
      <div class="st-big" style="color:var(--pn-muted);">—</div>
      <div class="st-sub">esta edición no tiene presupuesto definido</div>
      {{else}}
      <div class="st-big">{{stats.capital.faltante}}</div>
      <div class="st-sub">para cubrir el presupuesto de la edición</div>
      {{/if}}
    </div>
    <div class="pn-card st-card">
      <h4>Retorno proyectado</h4>
      <div class="st-big">{{stats.capital.retorno}}</div>
      <div class="st-sub">utilidad a repartir, con la misma fórmula que ve el inversionista</div>
    </div>
    <div class="pn-card st-card">
      <h4>Capital en todas las ediciones</h4>
      <div class="st-big">{{stats.capital.total}}</div>
      <div class="st-sub">{{stats.capital.inversionesTotal}} inversión(es) en total</div>
    </div>
  </div>

  <!-- Modalidad + categorías -->
  <div class="st-grid">
    <div class="pn-card st-card">
      <h4>Reparto por modalidad</h4>
      <div class="st-bar">
        <i style="width:{{stats.modalidad.fijoPct}}%; background:#6C3CE0;"></i>
        <i style="width:{{stats.modalidad.riesgoPct}}%; background:#D97706;"></i>
      </div>
      <div class="st-legend">
        <i style="background:#6C3CE0;"></i>Retorno fijo · {{stats.modalidad.fijo}} ({{stats.modalidad.fijoN}})<br>
        <i style="background:#D97706;"></i>Participación a riesgo · {{stats.modalidad.riesgo}} ({{stats.modalidad.riesgoN}})
      </div>
    </div>
    <div class="pn-card st-card">
      <h4>Cuentas</h4>
      <div class="st-mini">
        <div><b>{{stats.inversionistas.activos}}</b><span>Activos</span></div>
        <div><b>{{stats.inversionistas.invitados}}</b><span>Invitados</span></div>
        <div><b>{{stats.inversionistas.inactivos}}</b><span>Inactivos</span></div>
        <div><b>{{stats.inversionistas.patrocinadores}}</b><span>Patrocinadores</span></div>
      </div>
    </div>
    <div class="pn-card st-card">
      <h4>Taquilla</h4>
      <div class="st-big">{{stats.taquilla.vendidos}}</div>
      <div class="st-sub">de {{stats.taquilla.aforo}} lugares · {{stats.taquilla.ingreso}}</div>
      <div class="st-bar"><i style="width:{{stats.taquilla.ocupacionPct}}%; background:#0E9F6E;"></i></div>
      <div class="st-legend">
        {{#if stats.taquilla.superado}}<span class="st-flag st-flag--ok">Punto de equilibrio superado</span>
        {{else}}<span class="st-flag st-flag--warn">Faltan {{stats.taquilla.faltan}} boletos</span>{{/if}}
        <br>Equilibrio en {{stats.taquilla.equilibrio}} boletos
      </div>
    </div>
  </div>

  <!-- Distribución de inversionistas -->
  <div class="pn-card st-card" style="margin-bottom:22px;">
    <h4>Inversionistas por categoría — reales contra cupo</h4>
    <div class="st-two">
      <div class="st-donut">
        <svg viewBox="0 0 120 120">
          <circle cx="60" cy="60" r="54" fill="none" stroke="#F1F0F5" stroke-width="12"></circle>
          {{#each stats.inversionistas.donut}}
          <circle cx="60" cy="60" r="54" fill="none" stroke="{{this.color}}" stroke-width="12"
            stroke-dasharray="{{this.len}} {{../stats.inversionistas.circ}}"
            transform="rotate({{this.angle}} 60 60)"></circle>
          {{/each}}
        </svg>
        <div class="st-donut__mid">
          <b>{{stats.inversionistas.real}}</b>
          <span>de {{stats.inversionistas.cupo}}</span>
        </div>
      </div>
      <div class="st-rows">
        {{#each stats.inversionistas.porCategoria}}
        <div class="st-row">
          <i style="background:{{this.color}}"></i>
          <strong>{{this.label}}</strong>
          <span>{{this.real}}</span>
          <small>de {{this.cupo}}</small>
        </div>
        {{else}}
        <div class="st-row"><small>No hay categorías configuradas.</small></div>
        {{/each}}
      </div>
    </div>
  </div>

  <!-- Comparativo entre ediciones -->
  <div class="pn-card st-card" style="margin-bottom:22px;">
    <h4>Comparativo entre ediciones</h4>
    <div class="st-comp">
      <table>
        <thead>
          <tr><th>Edición</th><th>Capital</th><th>Presupuesto</th><th>Cubierto</th><th>Inv.</th><th>Paq.</th><th>Docs</th><th>Avances</th></tr>
        </thead>
        <tbody>
          {{#each stats.comparativo}}
          <tr{{#if this.activa}} class="is-activa"{{/if}}>
            <td>
              <span class="st-dot" style="background:{{this.accent}}"></span>
              <strong>{{this.year}}</strong> {{this.title}}
              {{#if this.activa}}<span class="st-flag st-flag--ok">Activa</span>{{/if}}
            </td>
            <td>{{this.capital}}</td>
            <td>{{this.presupuesto}}</td>
            <td>
              {{#if this.sinPresupuesto}}—{{else}}
              <span class="st-minibar"><i style="width:{{this.cubiertoPct}}%; background:{{this.accent}}"></i></span>
              {{this.cubiertoPct}}%
              {{/if}}
            </td>
            <td>{{this.inversiones}}</td>
            <td>{{this.paquetes}}</td>
            <td>{{this.documentos}}</td>
            <td>{{this.avances}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Documentos, códigos, prospectos, contenido -->
  <div class="st-grid">
    <div class="pn-card st-card">
      <h4>Data room de la edición</h4>
      <div class="st-rows">
        {{#each stats.documentos.porEstatus}}
        <div class="st-row"><strong>{{this.label}}</strong><span>{{this.n}}</span></div>
        {{/each}}
        <div class="st-row"><strong>Documentos por cuenta</strong><span>{{stats.documentos.porCuenta}}</span></div>
      </div>
    </div>

    <div class="pn-card st-card">
      <h4>Códigos 2027</h4>
      <div class="st-mini">
        <div><b>{{stats.codigos.usados}}</b><span>Usados</span></div>
        <div><b>{{stats.codigos.porUsar}}</b><span>Por usar</span></div>
        <div><b>{{stats.codigos.conDueno}}</b><span>Con dueño</span></div>
        <div><b>{{stats.codigos.ajenos}}</b><span>Usados por otro</span></div>
      </div>
      <div class="st-legend" style="margin-top:10px;">{{stats.codigos.accesos}} acceso(s) · {{stats.codigos.dispositivosNuevos}} dispositivo(s) nuevo(s)</div>
    </div>

    <div class="pn-card st-card">
      <h4>Prospectos</h4>
      <div class="st-rows">
        {{#each stats.prospectos}}
        <div class="st-row"><strong>{{this.label}}</strong><span>{{this.n}}</span></div>
        {{/each}}
      </div>
    </div>

    <div class="pn-card st-card">
      <h4>Contenido publicado</h4>
      <div class="st-mini">
        <div><b>{{stats.contenido.noticias}}</b><span>Noticias</span></div>
        <div><b>{{stats.contenido.avances}}</b><span>Avances</span></div>
        <div><b>{{stats.contenido.medios}}</b><span>En medios</span></div>
        <div><b>{{stats.contenido.actividades}}</b><span>Actividades</span></div>
        <div><b>{{stats.contenido.etapas}}</b><span>Etapas</span></div>
        <div><b>{{stats.contenido.faqs}}</b><span>FAQ</span></div>
        <div><b>{{stats.contenido.notificaciones}}</b><span>Notificaciones</span></div>
      </div>
    </div>
  </div>
</section>

<!-- NOTICIAS -->
<section class="ad-sec" id="sec-noticias">
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/news" enctype="multipart/form-data">
      <h3>Publicar noticia</h3>
      <div class="ad-f"><label>Categoría</label><select name="tag"><option>Anuncio</option><option>Actualización</option><option>Prensa</option></select></div>
      <div class="ad-f"><label>Título</label><input type="text" name="title" required></div>
      <div class="ad-f"><label>Extracto</label><textarea name="excerpt" placeholder="Resumen corto que se ve en la tarjeta"></textarea></div>
      <div class="ad-f"><label>Contenido completo</label><textarea name="body" rows="5" placeholder="Texto completo de la nota (se muestra al abrir 'Leer más')"></textarea></div>
      <div class="ad-f"><label>Imagen</label><input type="file" name="imageFile" accept="image/*">
        <div class="ad-hint">{{#if s3}}Se subirá a Amazon S3.{{else}}Se guardará localmente (configura S3 para producción).{{/if}} O pega una URL abajo.</div>
      </div>
      <div class="ad-f"><label>URL de imagen (opcional)</label><input type="text" name="image" placeholder="/assets/images/gallery/cup2025/6.jpg"></div>
      <div class="ad-f"><label>URL de la nota (opcional)</label><input type="url" name="source_url" placeholder="https://ejemplo.com/nota-original">
        <div class="ad-hint">Enlace al artículo original. Se muestra como «Ver original» y abre en pestaña nueva.</div>
      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Fecha (texto)</label><input type="text" name="date_label" placeholder="12 Jul 2026"></div>
        <div class="ad-f"><label>Tamaño</label><select name="size"><option value="short">Normal</option><option value="tall">Grande</option></select></div>
      </div>
      <label class="ad-check"><input type="checkbox" name="featured" value="1"> Destacada</label>
      <button type="submit" class="ad-btn" style="margin-top:14px;">Publicar</button>
    </form>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Noticias ({{news.length}})</h3></div>
      <div class="ad-list">
        {{#each news}}
        <div class="ad-item">
          <img class="ad-item__thumb" src="{{this.image}}" alt="">
          <div class="ad-item__b">
            <span class="ad-tagpill" style="color:{{this.tag_color}}; background:{{this.tag_color}}1A;">{{this.tag}}</span>
            <strong style="margin-top:4px;">{{this.title}}</strong>
            <small>{{this.date_label}}{{#if this.featured}} · Destacada{{/if}}</small>
          </div>
          <div class="ad-actions">
            <button type="button" class="primary" onclick="openNews(this)"
              data-id="{{this.id}}" data-tag="{{this.tag}}" data-title="{{this.title}}" data-excerpt="{{this.excerpt}}" data-body="{{this.body}}" data-image="{{this.image}}" data-date="{{this.date_label}}" data-size="{{this.size}}" data-featured="{{#if this.featured}}1{{/if}}" data-source="{{this.source_url}}">Editar</button>
            <form method="POST" action="/panel/admin/news/{{this.id}}/notify" data-confirm="¿Compartir esta noticia como notificación (email) a todos los usuarios?"><button type="submit">Compartir</button></form>
            <form method="POST" action="/panel/admin/news/{{this.id}}/delete" data-confirm="¿Eliminar noticia?"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">No hay noticias.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- CALENDARIO -->
<section class="ad-sec" id="sec-calendario">
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/event">
      <h3>Agregar actividad</h3>
      <p class="ad-hint" style="margin:-4px 0 12px;">Todo lo que se haga, no solo las fechas del evento: juntas, prensa, logística, meet &amp; greets.</p>
      <div class="ad-f"><label>Título</label><input type="text" name="title" required placeholder="Junta con inversionistas"></div>
      <div class="ad-row2">
        <div class="ad-f"><label>Tipo</label>
          <select name="type" id="ac-type" onchange="acTipo('ac')">
            {{#each actTypes}}<option value="{{this}}">{{this}}</option>{{/each}}
          </select>
        </div>
        <div class="ad-f"><label>Edición</label>
          <select name="event_id">
            <option value="">Todas (sin edición)</option>
            {{#each portfolioEditions}}<option value="{{this.id}}"{{#if this.isActiveEdition}} selected{{/if}}>{{this.year}} · {{this.title}}</option>{{/each}}
          </select>
        </div>
      </div>
      <div class="ad-f" id="ac-custom-wrap" style="display:none;"><label>¿Qué tipo de actividad es?</label>
        <input type="text" name="custom_type" id="ac-custom" maxlength="40" placeholder="Ej. Firma de contrato">
      </div>
      <div class="ad-row3">
        <div class="ad-f"><label>Día</label><input type="number" name="day" min="1" max="31" required></div>
        <div class="ad-f"><label>Mes</label><input type="number" name="month" min="1" max="12" value="3"></div>
        <div class="ad-f"><label>Año</label><input type="number" name="year" value="2027"></div>
      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Hora <em>(opcional)</em></label><input type="text" name="time_label" placeholder="19:00"></div>
        <div class="ad-f"><label>Nota <em>(opcional)</em></label><input type="text" name="note" placeholder="Sala de juntas"></div>
      </div>
      <button type="submit" class="ad-btn">Agregar al calendario</button>
    </form>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Actividades ({{events.length}})</h3></div>
      <div class="ad-list">
        {{#each events}}
        <div class="ad-item">
          <div class="ad-item__av" style="background: {{this.color}}">{{this.day}}</div>
          <div class="ad-item__b">
            <strong>{{this.title}}</strong>
            <small>{{this.day}}/{{this.month}}/{{this.year}}{{#if this.time}} · {{this.time}}{{/if}} · {{this.typeLabel}}{{#if this.editionLabel}} · {{this.editionLabel}}{{else}} · todas las ediciones{{/if}}</small>
          </div>
          <div class="ad-actions">
            <button type="button" class="primary" onclick="openEvent(this)"
              data-id="{{this.id}}" data-title="{{this.title}}" data-day="{{this.day}}" data-month="{{this.month}}" data-year="{{this.year}}" data-type="{{this.type}}"
              data-custom="{{this.customType}}" data-time="{{this.time}}" data-note="{{this.note}}" data-event="{{this.eventId}}">Editar</button>
            <form method="POST" action="/panel/admin/event/{{this.id}}/delete" data-confirm="¿Eliminar evento?"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">Todavía no hay actividades en el calendario.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- CRONOGRAMA -->
<section class="ad-sec" id="sec-cronograma">
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/milestone">
      <h3>Agregar etapa</h3>
      <p class="ad-hint" style="margin:-4px 0 12px;">Las etapas son las tuyas: agrega, edita, reordena y borra las que quieras.
        Planeación → Negociación → Producción → Evento → Cierre es solo un punto de partida.</p>
      <div class="ad-f"><label>Nombre de la etapa</label><input type="text" name="title" required placeholder="Negociación de sede"></div>
      <div class="ad-row2">
        <div class="ad-f"><label>Fecha (texto)</label><input type="text" name="date_label" placeholder="Sep 2026"></div>
        <div class="ad-f"><label>Estado</label>
          <select name="status"><option value="pendiente">Pendiente</option><option value="en_curso">En curso</option><option value="completado">Completado</option></select>
        </div>
      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Inicio <em>(opcional)</em></label><input type="date" name="start_date"></div>
        <div class="ad-f"><label>Fin <em>(opcional)</em></label><input type="date" name="end_date"></div>
      </div>
      <div class="ad-f"><label>Edición</label>
        <select name="event_id">
          <option value="">Todas (sin edición)</option>
          {{#each portfolioEditions}}<option value="{{this.id}}"{{#if this.isActiveEdition}} selected{{/if}}>{{this.year}} · {{this.title}}</option>{{/each}}
        </select>
      </div>
      <div class="ad-f"><label>Responsable</label><input type="text" name="owner" placeholder="Ej. Dirección financiera"></div>
      <div class="ad-f"><label>Descripción <em>(opcional)</em></label><textarea name="description" rows="2" placeholder="Qué incluye esta etapa."></textarea></div>
      <label class="ad-check"><input type="checkbox" name="highlight" value="1"> Destacar (partido)</label>
      <button type="submit" class="ad-btn" style="margin-top:14px;">Agregar etapa</button>
    </form>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Etapas ({{milestones.length}})</h3></div>
      <div class="ad-list">
        {{#each milestones}}
        <div class="ad-item">
          <div class="ad-item__av" style="background: {{#eq this.status 'completado'}}#1E8E5A{{else}}{{#eq this.status 'en_curso'}}#6C3CE0{{else}}#8A8F98{{/eq}}{{/eq}}">{{#eq this.status 'completado'}}✓{{else}}{{#eq this.status 'en_curso'}}◐{{else}}○{{/eq}}{{/eq}}</div>
          <div class="ad-item__b">
            <strong>{{this.title}}</strong>
            <small>{{this.date_label}} · {{this.statusLabel}}{{#if this.owner}} · {{this.owner}}{{/if}}{{#if this.editionLabel}} · {{this.editionLabel}}{{else}} · todas las ediciones{{/if}}{{#if this.highlight}} · Destacado{{/if}}</small>
            {{#if this.description}}<small>{{this.description}}</small>{{/if}}
          </div>
          <div class="ad-move">
            <form method="POST" action="/panel/admin/milestone/{{this.id}}/move"><input type="hidden" name="dir" value="up"><button type="submit" {{#if @first}}disabled{{/if}} title="Subir"><svg viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg></button></form>
            <form method="POST" action="/panel/admin/milestone/{{this.id}}/move"><input type="hidden" name="dir" value="down"><button type="submit" {{#if @last}}disabled{{/if}} title="Bajar"><svg viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></button></form>
          </div>
          <div class="ad-actions">
            <button type="button" class="primary" onclick="openMile(this)"
              data-id="{{this.id}}" data-title="{{this.title}}" data-date="{{this.date_label}}" data-status="{{this.status}}" data-owner="{{this.owner}}" data-highlight="{{#if this.highlight}}1{{/if}}"
              data-desc="{{this.description}}" data-start="{{this.startDate}}" data-end="{{this.endDate}}" data-event="{{this.eventId}}">Editar</button>
            <form method="POST" action="/panel/admin/milestone/{{this.id}}/delete" data-confirm="¿Eliminar esta etapa?"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">Todavía no hay etapas en el cronograma.</div>
        {{/each}}
      </div>
    </div>
  </div>
</section>

<!-- NOTIFICACIONES -->
<section class="ad-sec" id="sec-notificaciones">
  <div class="ad-grid">
    <form class="pn-card ad-form" method="POST" action="/panel/admin/notify">
      <h3>Enviar notificación</h3>
      <div class="ad-f"><label>Título</label><input type="text" name="title" required placeholder="Ej. Nueva fecha confirmada"></div>
      <div class="ad-f"><label>Mensaje</label><textarea name="body" placeholder="Escribe el comunicado..."></textarea></div>

      <div class="ad-f"><label>¿A quién?</label>
        <div class="nf-seg">
          <label><input type="radio" name="target" value="audience" checked onchange="nfTarget()"> A un segmento</label>
          <label><input type="radio" name="target" value="user" onchange="nfTarget()"> A una persona</label>
        </div>
      </div>

      <div id="nf-aud">
        <div class="ad-row2">
          <div class="ad-f"><label>Audiencia</label>
            <select name="audience"><option value="all">Todos</option><option value="investor">Solo inversionistas</option><option value="sponsor">Solo patrocinadores</option></select>
          </div>
          <div class="ad-f"><label>Tipo</label>
            <select name="notif_type">
              {{#each notifTypes}}<option value="{{this.key}}"{{#eq this.key 'comunicado'}} selected{{/eq}}>{{this.label}}</option>{{/each}}
            </select>
          </div>
        </div>
      </div>

      <div class="ad-f" id="nf-user" style="display:none;">
        <label>Destinatario</label>
        <select name="user_id">
          <option value="">— Elige a la persona —</option>
          {{#each notifyPeople}}
          <option value="{{this.id}}">{{this.name}} · {{this.roleLabel}}{{#unless this.hasPhone}} (sin teléfono){{/unless}}</option>
          {{/each}}
        </select>
        <div class="ad-hint">Solo esa persona la ve en su panel. Nadie más.</div>
      </div>

      <div class="ad-f"><label>Canales</label>
        <label class="ad-check"><input type="checkbox" checked disabled> En el panel (siempre)</label>
        <label class="ad-check"><input type="checkbox" name="ch_email" value="1" checked> Email</label>
        <label class="ad-check"><input type="checkbox" name="ch_sms" value="1"{{#unless twilio.ready}} disabled{{/unless}}> SMS{{#unless twilio.ready}} — pega las llaves de Twilio en Configuración para activarlo{{/unless}}</label>
        <div class="ad-hint">Se respeta lo que cada persona eligió en su perfil: si apagó el email o el SMS, no le llega por ahí (en el panel sí).</div>
      </div>

      <button type="submit" class="ad-btn" style="margin-top:14px;">Enviar notificación</button>
    </form>

    <div class="pn-card">
      <div class="pn-card__head"><h3>Enviadas ({{notifications.length}})</h3><span class="ad-hint">lo que tú mandaste</span></div>
      <div class="ad-list">
        {{#each notifications}}
        <div class="ad-item">
          <div class="ad-item__av" style="background:#6C3CE0">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          </div>
          <div class="ad-item__b">
            <strong>{{this.title}}</strong>
            <small>
              <span class="nf-tag" style="background:{{this.typeColor}}1a;color:{{this.typeColor}};">{{this.typeLabel}}</span>
              {{this.date}} ·
              {{#if this.toLabel}}{{this.toLabel}}{{else}}{{#eq this.audience 'all'}}Todos{{/eq}}{{#eq this.audience 'investor'}}Inversionistas{{/eq}}{{#eq this.audience 'sponsor'}}Patrocinadores{{/eq}}{{/if}}
              · {{this.channelsLabel}}{{#if this.sentEmail}} · {{this.sentEmail}} email{{/if}}{{#if this.sentSms}} · {{this.sentSms}} SMS{{/if}}
            </small>
          </div>
          <div class="ad-actions">
            <form method="POST" action="/panel/admin/notification/{{this.id}}/delete" data-confirm="¿Eliminar notificación?"><button type="submit" class="danger">Eliminar</button></form>
          </div>
        </div>
        {{else}}
        <div class="ad-empty">No has enviado notificaciones.</div>
        {{/each}}
      </div>
    </div>
  </div>
  <div class="pn-card" style="margin-top:18px;">
    <div class="pn-card__head"><h3>Tu bandeja ({{adminInbox.length}})</h3><span class="ad-hint">avisos del sistema para el organizador</span></div>
    <div class="ad-list">
      {{#each adminInbox}}
      <div class="ad-item">
        <div class="ad-item__b">
          <strong>{{this.title}}</strong>
          <small><span class="nf-tag" style="background:{{this.typeColor}}1a;color:{{this.typeColor}};">{{this.typeLabel}}</span>{{this.date}}</small>
          {{#if this.body}}<small>{{this.body}}</small>{{/if}}
        </div>
      </div>
      {{else}}
      <div class="ad-empty">Sin avisos por ahora. Aquí caen los accesos con código y los envíos.</div>
      {{/each}}
    </div>
  </div>
  <style>
    .nf-seg { display:flex; gap:18px; flex-wrap:wrap; }
    .nf-seg label { display:flex; align-items:center; gap:7px; font-size:13.5px; font-weight:600; color:var(--pn-ink-2); cursor:pointer; }
    .nf-tag { display:inline-block; padding:2px 8px; border-radius:999px; font-size:10.5px; font-weight:800; letter-spacing:.3px; margin-right:6px; text-transform:uppercase; }
  </style>
  <script>
    function nfTarget() {
      var toUser = document.querySelector('input[name="target"][value="user"]').checked;
      document.getElementById('nf-user').style.display = toUser ? '' : 'none';
      document.getElementById('nf-aud').style.display = toUser ? 'none' : '';
    }
  </script>
</section>

<!-- CATEGORÍAS -->
<section class="ad-sec" id="sec-categorias">
  <div class="ad-sechead">
    <p class="ad-note" style="margin:0;">Edita nombre, color, monto, cupo y beneficios de cada categoría. Se reflejan en el panel de inversionistas y patrocinadores.</p>
    <a class="ad-seelink" href="/panel/admin/preview/investor" target="_blank" rel="noopener">Ver en el panel
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
    </a>
  </div>
  <div class="ad-catgrid">
    {{#each tiers}}
    <form class="pn-card ad-tier" method="POST" action="/panel/admin/tier/{{this.id}}/update">
      <div class="ad-tier__head">
        <span class="ad-tier__dot" style="background:{{this.color}}"></span>
        <strong>{{this.label}}</strong>
        <span class="ad-tier__role">{{this.roleLabel}}</span>
      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Nombre</label><input type="text" name="label" value="{{this.label}}" required></div>
        <div class="ad-f"><label>Color</label><input type="color" name="color" value="{{this.color}}" style="height:42px; padding:4px;"></div>
      </div>
      <div class="ad-row2">
        <div class="ad-f"><label>Monto (USD)</label><input type="number" name="amount" value="{{this.amount}}" step="1000" min="0"></div>
