        <div class="ad-f"><label>Número de etapa</label><input type="number" name="stage_step" value="{{dashboardConfig.stageStep}}" min="0" step="1"></div>
        <div class="ad-f"><label>Total de etapas</label><input type="number" name="stage_total" value="{{dashboardConfig.stageTotal}}" min="1" step="1"></div>
      </div>
      <div class="ad-f"><label>Nota de la etapa</label><input type="text" name="stage_note" value="{{dashboardConfig.stageNote}}" placeholder="Venta de patrocinios y preventa en curso."></div>
      <div class="ad-f"><label>Actualizado el</label><input type="date" name="stage_updated" value="{{dashboardConfig.stageUpdated}}"></div>
      <button type="submit" class="ad-btn">Guardar etapa</button>
    </form>

    <form class="pn-card ad-form" method="POST" action="/panel/admin/settings/dashboard">
      <input type="hidden" name="group" value="trace">
      <h3>Trazabilidad de las cifras</h3>
      <div class="ad-f"><label>Fuente de los datos</label><input type="text" name="return_source" value="{{dashboardConfig.returnSource}}" placeholder="Modelo financiero SOCCER iD"></div>
      <div class="ad-f"><label>Actualizado el</label><input type="date" name="return_updated" value="{{dashboardConfig.returnUpdated}}"></div>
      <button type="submit" class="ad-btn">Guardar trazabilidad</button>
    </form>

    <div class="pn-card ad-form tw-card">
      <h3>SMS (Twilio)
        {{#if twilio.ready}}<span class="tw-pill tw-on">Activo</span>
        {{else}}{{#if twilio.partial}}<span class="tw-pill tw-off">Falta {{twilio.missingLabel}}</span>
        {{else}}<span class="tw-pill tw-off">Sin llaves</span>{{/if}}{{/if}}
      </h3>
      <p class="ad-hint" style="margin:-4px 0 14px;">Las llaves se pegan aquí, no hacen falta variables de entorno ni desplegar.
        Están en <strong>Twilio Console → Account Info</strong>. El token se guarda en la base de datos del panel y ya no se vuelve a mostrar completo.</p>
      <p class="tw-rule">En cuanto estén las tres llaves, el canal SMS <strong>se activa solo</strong>. No hay otro
        interruptor que prender. Para apagarlo, borra las credenciales con el botón de abajo.</p>

      <form method="POST" action="/panel/admin/settings/twilio">
        <div class="ad-f"><label>Account SID</label>
          <input type="text" name="account_sid" value="{{twilio.account_sid}}" placeholder="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" autocomplete="off">
        </div>
        <div class="ad-f"><label>Auth Token</label>
          <input type="password" name="auth_token" placeholder="{{#if twilio.hasToken}}{{twilio.tokenMask}} — déjalo vacío para conservarlo{{else}}Pega el Auth Token{{/if}}" autocomplete="new-password">
          <div class="ad-hint">{{#if twilio.hasToken}}Ya hay un token guardado. Solo escribe aquí si lo vas a cambiar.{{else}}Todavía no hay token guardado.{{/if}}</div>
        </div>
        <div class="ad-f"><label>Remitente</label>
          <input type="text" name="from" value="{{twilio.from}}" placeholder="+15551234567" autocomplete="off">
          <div class="ad-hint">El número que compraste en Twilio (formato +52...) o un Messaging Service SID (MG...).</div>
        </div>
        <button type="submit" class="ad-btn">Guardar Twilio</button>
      </form>

      {{#if twilio.ready}}
      <form method="POST" action="/panel/admin/settings/twilio/test" class="tw-test">
        <div class="ad-f"><label>Probar envío</label>
          <input type="text" name="to" placeholder="+521234567890" autocomplete="off">
          <div class="ad-hint">Manda un SMS de prueba a ese número. Twilio lo cobra como cualquier mensaje.</div>
        </div>
        <button type="submit" class="ad-btn ad-btn--ghost">Enviar SMS de prueba</button>
      </form>
      <form method="POST" action="/panel/admin/settings/twilio/clear" data-confirm="¿Borrar las credenciales de Twilio? El SMS dejará de funcionar.">
        <button type="submit" class="ad-btn ad-btn--ghost tw-danger">Borrar credenciales y apagar el SMS</button>
      </form>
      {{/if}}
    </div>
  </div>
  <style>
    .tw-pill { display:inline-block; margin-left:9px; padding:3px 10px; border-radius:999px; font-size:10.5px; font-weight:800; letter-spacing:.4px; text-transform:uppercase; vertical-align:middle; }
    .tw-on { background:#DEF7EC; color:#03543F; }
    .tw-off { background:#F3F4F6; color:#6B7280; }
    .tw-card .tw-test { margin-top:18px; padding-top:16px; border-top:1px solid var(--pn-border); }
    .tw-rule { margin:0 0 16px; padding:11px 13px; border-radius:11px; background:var(--pn-purple-soft); color:var(--pn-ink-2); font-size:12.5px; line-height:1.55; }
    .ad-btn--ghost { background:#fff; color:var(--pn-purple); border:1px solid var(--pn-border); }
    .ad-btn--ghost:hover { background:var(--pn-purple-soft); }
    .tw-danger { margin-top:10px; color:#B42318; }
    .tw-danger:hover { background:#FEF2F2; }
  </style>
</section>

