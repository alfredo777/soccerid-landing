      </div>
      <div class="ad-f"><label>Etiqueta del evento</label><input type="text" name="event_label" value="{{dashboardConfig.eventLabel}}" placeholder="Sábado, 27 de marzo 2027"></div>
      <button type="submit" class="ad-btn">Guardar evento</button>
