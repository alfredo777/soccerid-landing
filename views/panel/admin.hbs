<script>
  var INVESTOR_TIERS = {{{jsonScript investorTiers}}};
  var SPONSOR_TIERS = {{{jsonScript sponsorTiers}}};
  var USER_DOCS = {{{jsonScript docsByUser}}};
  function setEditionLang(l){
    document.querySelectorAll('.ad-langtab').forEach(function(b){ b.classList.toggle('is-active', b.dataset.lang === l); });
    document.querySelectorAll('.ad-langsec').forEach(function(s){ s.classList.toggle('is-active', s.dataset.langsec === l); });
  }
  // ── Editor de filas repetibles de las ediciones ──
  // Sustituye a los textareas con formato "valor | etiqueta | sub", que obligaban
  // a recordar el orden de las columnas y se rompían con un pipe de más.
  var ED_KINDS = {
    stats: { uno: 'estadística', fields: [
      { k: 'value', l: 'Valor', ph: '13K' },
      { k: 'label', l: 'Etiqueta', ph: 'ASISTENTES' },
      { k: 'sub', l: 'Subtítulo', ph: 'Q2 Stadium' } ] },
    media: { uno: 'nota', fields: [
      { k: 'title', l: 'Título', ph: 'La CUP llenó el estadio' },
      { k: 'source', l: 'Fuente', ph: 'ESPN' },
      { k: 'url', l: 'Enlace', ph: 'https://...' },
      { k: 'image', l: 'Imagen', img: true } ] },
    images: { uno: 'imagen', fields: [
      { k: 'src', l: 'Imagen', img: true },
      { k: 'alt', l: 'Texto alternativo', ph: 'Acción del partido' } ] },
    sponsors: { uno: 'patrocinador', fields: [
      { k: 'src', l: 'Logo', img: true },
      { k: 'alt', l: 'Nombre', ph: 'Adidas' } ] },
    videos: { uno: 'video', fields: [
      { k: 'id', l: 'ID de YouTube', ph: 'dQw4w9WgXcQ' },
      { k: 'title', l: 'Título', ph: 'Resumen del partido' } ] }
  };
  var edState = {};

  function edCaja(name){ return document.querySelector('.ed-rows[data-rows="' + name + '"]'); }

  function edRender(name){
    var caja = edCaja(name);
    if (!caja) return;
    var kind = ED_KINDS[caja.dataset.kind];
    var filas = edState[name] || [];
    var html = '';
    if (!filas.length){
      html += '<div class="ed-empty-rows">Sin ' + kind.uno + 's todavía.</div>';
    }
    filas.forEach(function(fila, i){
      html += '<div class="ed-row" data-i="' + i + '">'
        + '<div class="ed-row__head">'
        + '<span class="ed-row__n">' + kind.uno.toUpperCase() + ' ' + (i + 1) + '</span>'
        + '<span class="ed-row__btns">'
        + '<button type="button" title="Subir" ' + (i === 0 ? 'disabled' : '') + ' onclick="edMove(\'' + name + '\',' + i + ',-1)">&uarr;</button>'
        + '<button type="button" title="Bajar" ' + (i === filas.length - 1 ? 'disabled' : '') + ' onclick="edMove(\'' + name + '\',' + i + ',1)">&darr;</button>'
        + '<button type="button" class="danger" title="Eliminar" onclick="edDel(\'' + name + '\',' + i + ')">&times;</button>'
        + '</span></div>';
      kind.fields.forEach(function(f){
        var val = fila[f.k] == null ? '' : String(fila[f.k]);
        html += '<div class="ed-fld"><label>' + f.l + '</label>';
        if (f.img){
          html += '<div class="ed-img">'
            + '<input type="text" data-k="' + f.k + '" value="' + esc(val) + '" placeholder="URL o sube un archivo">'
            + '<button type="button" onclick="edUploadRow(\'' + name + '\',' + i + ',\'' + f.k + '\',this)">Subir</button>'
            + (val ? '<img src="' + esc(val) + '" alt="">' : '')
            + '</div>';
        } else {
          html += '<input type="text" data-k="' + f.k + '" value="' + esc(val) + '" placeholder="' + esc(f.ph || '') + '">';
        }
        html += '</div>';
      });
      html += '</div>';
    });
    html += '<button type="button" class="ed-add" onclick="edAdd(\'' + name + '\')">+ Agregar ' + kind.uno + '</button>';
    // La galería suele cargarse de golpe: pedir el archivo uno por uno era absurdo
    if (name === 'images'){
      html += '<button type="button" class="ed-add" style="margin-top:7px;" onclick="edSubirVarias(this)">Subir varias imágenes</button>';
    }
    caja.innerHTML = html;
  }

  function edAdd(name){
    var kind = ED_KINDS[edCaja(name).dataset.kind];
    var fila = {};
    kind.fields.forEach(function(f){ fila[f.k] = ''; });
    (edState[name] = edState[name] || []).push(fila);
    edRender(name);
  }
  function edDel(name, i){
    edState[name].splice(i, 1);
    edRender(name);
  }
  function edMove(name, i, d){
    var arr = edState[name], j = i + d;
    if (j < 0 || j >= arr.length) return;
    var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
    edRender(name);
  }

  // Se escribe directo en el estado, sin redibujar: si redibujáramos en cada
  // tecla, el cursor saltaría fuera del campo.
  document.addEventListener('input', function(e){
    var input = e.target.closest ? e.target.closest('.ed-rows input[data-k]') : null;
    if (!input) return;
    var caja = input.closest('.ed-rows'), fila = input.closest('.ed-row');
    if (!caja || !fila) return;
    var name = caja.dataset.rows, i = parseInt(fila.dataset.i, 10);
    if (edState[name] && edState[name][i]) edState[name][i][input.dataset.k] = input.value;
  });

  // Subida de imágenes al mismo endpoint que ya existía (S3 si está configurado)
  function edPickFile(cb){
    var inp = document.createElement('input');
    inp.type = 'file';
    inp.accept = 'image/*';
    inp.addEventListener('change', function(){
      if (inp.files && inp.files[0]) cb(inp.files[0]);
    });
    inp.click();
  }
  function edSubir(file, btn, cb){
    var texto = btn.textContent;
    btn.textContent = 'Subiendo...';
    btn.disabled = true;
    var fd = new FormData();
    fd.append('image', file);
    fetch('/panel/admin/upload', { method: 'POST', body: fd, credentials: 'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(j){
        btn.textContent = texto; btn.disabled = false;
        if (j && j.url) cb(j.url);
        else alert('No se pudo subir: ' + ((j && j.error) || 'error desconocido'));
      })
      .catch(function(err){
        btn.textContent = texto; btn.disabled = false;
        alert('No se pudo subir: ' + err.message);
      });
  }
  function edUploadRow(name, i, key, btn){
    edPickFile(function(file){
      edSubir(file, btn, function(url){
        edState[name][i][key] = url;
        edRender(name);
      });
    });
  }
  // Sube varios archivos y agrega una fila por cada uno, en orden.
  function edSubirVarias(btn){
    var inp = document.createElement('input');
    inp.type = 'file';
    inp.accept = 'image/*';
    inp.multiple = true;
    inp.addEventListener('change', function(){
      var files = [].slice.call(inp.files || []);
      if (!files.length) return;
      var texto = btn.textContent, hechas = 0, fallidas = 0;
      btn.disabled = true;
      // De una en una: subir 20 en paralelo satura el dyno y S3 responde 503
      var siguiente = function(i){
        if (i >= files.length){
          btn.textContent = texto; btn.disabled = false;
          edRender('images');
          if (fallidas) alert(fallidas + ' de ' + files.length + ' imagen(es) no se pudieron subir.');
          return;
        }
        btn.textContent = 'Subiendo ' + (i + 1) + ' de ' + files.length + '...';
        var fd = new FormData();
        fd.append('image', files[i]);
        fetch('/panel/admin/upload', { method: 'POST', body: fd, credentials: 'same-origin' })
          .then(function(r){ return r.json(); })
          .then(function(j){
            if (j && j.url){
              (edState.images = edState.images || []).push({ src: j.url, alt: '' });
              hechas++;
            } else { fallidas++; }
            siguiente(i + 1);
          })
          .catch(function(){ fallidas++; siguiente(i + 1); });
      };
      siguiente(0);
    });
    inp.click();
  }

  function edUploadInto(id, btn){
    edPickFile(function(file){
      edSubir(file, btn, function(url){
        document.getElementById(id).value = url;
        var th = document.getElementById(id + '-thumb');
        if (th){ th.src = url; th.hidden = false; }
      });
    });
  }

  function edSerialize(){
    Object.keys(ED_JSON_FIELDS).forEach(function(name){
      var el = document.getElementById('ed-json-' + name);
      if (el) el.value = JSON.stringify(edState[name] || []);
    });
  }
  var ED_JSON_FIELDS = { stats_es: 1, stats_en: 1, media_es: 1, media_en: 1, images: 1, sponsors: 1, videos: 1 };

  // Vista previa: lo que se va a guardar, con los datos que hay en el formulario
  // ahora mismo (no lo que está en la base).
  var edPrevLang = 'es';
  function edPreviewLang(l){ edPrevLang = l; edPreview(); }

  function edPreview(){
    var box = document.getElementById('ed-preview');
    var v = function(id){ var el = document.getElementById(id); return el ? el.value.trim() : ''; };
    var en = edPrevLang === 'en';
    var banner = v('ed-banner');
    // En inglés se cae al español cuando el campo está vacío, igual que el sitio
    var titulo = (en ? (v('ed-title_en') || v('ed-title_es')) : v('ed-title_es')) || v('pf-title') || '(sin título)';
    var descripcion = en ? (v('ed-description_en') || v('ed-description_es')) : v('ed-description_es');
    var meta = [v('pf-year'), v('pf-match'), v('pf-event_date'), v('pf-city'), v('pf-venue')].filter(Boolean).join(' · ');
    var statsFuente = en ? (edState.stats_en && edState.stats_en.length ? edState.stats_en : edState.stats_es) : edState.stats_es;
    var stats = (statsFuente || []).filter(function(x){ return x.value || x.label; });
    var imgs = (edState.images || []).filter(function(x){ return x.src; });
    var spons = (edState.sponsors || []).filter(function(x){ return x.src || x.alt; });
    var notasFuente = en ? (edState.media_en && edState.media_en.length ? edState.media_en : edState.media_es) : edState.media_es;
    var notas = (notasFuente || []).filter(function(x){ return x.title || x.url; });
    var vids = (edState.videos || []).filter(function(x){ return x.id; });

    var avisos = [];
    if (!/^\d{4}$/.test(v('pf-year'))) avisos.push('el año debe tener 4 dígitos');
    if (!v('pf-title')) avisos.push('falta el título de la edición');
    if (en && !v('ed-title_en')) avisos.push('sin título en inglés: la página en inglés usará el español');
    notas.forEach(function(n){ if (n.url && !/^https?:\/\//i.test(n.url)) avisos.push('la nota "' + (n.title || n.source) + '" tiene un enlace que no empieza con http'); });
    vids.forEach(function(x){ if (!/^[\w-]{6,20}$/.test(x.id)) avisos.push('"' + x.id + '" no parece un ID de YouTube'); });

    var html = '<div class="ed-preview__lang">'
      + '<button type="button" class="' + (en ? '' : 'is-on') + '" onclick="edPreviewLang(\'es\')">Español</button>'
      + '<button type="button" class="' + (en ? 'is-on' : '') + '" onclick="edPreviewLang(\'en\')">English</button>'
      + '</div>';
    if (avisos.length) html += '<p class="ed-preview__warn">Revisa: ' + esc(avisos.join(' · ')) + '</p>';
    html += '<div class="ed-preview__banner"' + (banner ? ' style="background-image:url(\'' + esc(banner) + '\')"' : '') + '></div>';
    html += '<div class="ed-preview__b">';
    html += '<h4>' + esc(titulo) + '</h4>';
    if (meta) html += '<p class="ed-preview__meta">' + esc(meta) + '</p>';
    if (descripcion) html += '<p class="ed-preview__desc">' + esc(descripcion) + '</p>';
    if (stats.length){
      html += '<div class="ed-preview__stats">';
      stats.forEach(function(x){
        html += '<div class="ed-preview__stat"><b>' + esc(x.value) + '</b><span>' + esc(x.label) + '</span></div>';
      });
      html += '</div>';
    }
    if (imgs.length){
      html += '<div class="ed-preview__thumbs">';
      imgs.slice(0, 12).forEach(function(x){ html += '<img src="' + esc(x.src) + '" alt="' + esc(x.alt || '') + '">'; });
      html += '</div>';
    }
    var resumen = [];
    if (notas.length) resumen.push(notas.length + ' nota(s) en medios');
    if (spons.length) resumen.push(spons.length + ' patrocinador(es)');
    if (vids.length) resumen.push(vids.length + ' video(s)');
    if (resumen.length) html += '<p class="ed-preview__list" style="margin-top:10px;">' + esc(resumen.join(' · ')) + '</p>';
    html += '</div>';

    box.innerHTML = html;
    box.hidden = false;
    box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

