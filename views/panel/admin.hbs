<script>
  window.__portfolioPackages = {{{jsonScript portfolioPackages}}};
  var __pkEventId = null;
  function resetPackageForm(){
    var f = document.getElementById('form-package');
    f.reset(); document.getElementById('pk-is_active').checked = true;
    document.getElementById('pk-form-title').textContent = 'Nuevo paquete';
    if (__pkEventId) f.action = '/panel/admin/portfolio/' + __pkEventId + '/package';
  }
  function renderPackages(eventId){
    var list = document.getElementById('pk-list');
    var pkgs = (window.__portfolioPackages || {})[eventId] || [];
    if (!pkgs.length){ list.innerHTML = '<div class="ad-empty" style="padding:16px;">Sin paquetes. Agrega el primero abajo.</div>'; return; }
    list.innerHTML = pkgs.map(function(p){
      return '<div class="ad-item" style="padding:12px 4px;">'
        + '<div class="ad-item__b"><strong>' + p.name + (p.user_id?(' · 🔒 ' + p.assignee):' · General') + (p.is_active?'':' · (inactivo)') + '</strong>'
        + '<small>' + p.modalityLabel + ' · ' + p.amountLabel + (p.return_pct?(' · ' + p.return_pct + '%'):'') + (p.count?(' · cupo ' + p.count):'') + '</small></div>'
        + '<div class="ad-actions">'
        + '<button type="button" class="primary" onclick="editPackage(' + p.id + ')">Editar</button>'
        + '<form method="POST" action="/panel/admin/package/' + p.id + '/delete" data-confirm="¿Eliminar el paquete ' + p.name.replace(/"/g,'') + '?"><button type="submit" class="danger">Eliminar</button></form>'
        + '</div></div>';
    }).join('');
  }
  function openPackages(eventId){
    __pkEventId = eventId;
    var ed = (window.__portfolioForms || []).filter(function(x){ return String(x.id) === String(eventId); })[0];
    document.getElementById('pk-ev-title').textContent = ed ? ed.title : '';
    renderPackages(eventId);
    resetPackageForm();
    openModal('modal-packages');
  }
  function editPackage(id){
    var pkgs = (window.__portfolioPackages || {})[__pkEventId] || [];
    var p = pkgs.filter(function(x){ return String(x.id) === String(id); })[0];
    if (!p) return;
    document.getElementById('pk-form-title').textContent = 'Editar paquete';
    document.getElementById('form-package').action = '/panel/admin/package/' + id + '/update';
    document.getElementById('pk-name').value = p.name || '';
    document.getElementById('pk-modality').value = p.modality || 'fijo';
    document.getElementById('pk-amount').value = p.amount || '';
    document.getElementById('pk-return_pct').value = p.return_pct || '';
    document.getElementById('pk-count').value = p.count || '';
    document.getElementById('pk-benefits').value = p.benefits || '';
    document.getElementById('pk-user_id').value = p.user_id ? String(p.user_id) : '';
    document.getElementById('pk-is_active').checked = !!p.is_active;
  }
</script>

